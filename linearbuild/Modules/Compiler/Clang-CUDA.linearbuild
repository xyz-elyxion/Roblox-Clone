include(Compiler/Clang)
__compiler_clang(CUDA)

# Set explicitly, because __compiler_clang() doesn't set this if we're simulating MSVC.
set(LINEARBUILD_DEPFILE_FLAGS_CUDA "-MD -MT <DEP_TARGET> -MF <DEP_FILE>")
if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake")
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_CUDA_DEPFILE_FORMAT gcc)
  set(LINEARBUILD_CUDA_DEPENDS_USE_COMPILER TRUE)
endif()

# C++03 isn't supported for CXX, but is for CUDA, so we need to set these manually.
# Do this before __compiler_clang_cxx_standards() since that adds the feature.
set(LINEARBUILD_CUDA03_STANDARD_COMPILE_OPTION "-std=c++03")
set(LINEARBUILD_CUDA03_EXTENSION_COMPILE_OPTION "-std=gnu++03")
__compiler_clang_cxx_standards(CUDA)

set(LINEARBUILD_CUDA_COMPILER_HAS_DEVICE_LINK_PHASE TRUE)
set(_LINEARBUILD_COMPILE_AS_CUDA_FLAG "-x cuda")
set(_LINEARBUILD_CUDA_WHOLE_FLAG "-c")
set(_LINEARBUILD_CUDA_RDC_FLAG "-fgpu-rdc")
set(_LINEARBUILD_CUDA_PTX_FLAG "--cuda-device-only -S")

if (LINEARBUILD_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 20.0)
  # Starting in 20.0, clang supports device linking as part of the host link phase
  set(LINEARBUILD_CUDA_COMPILER_HAS_DEVICE_LINK_PHASE FALSE)
  if(LINEARBUILD_CUDA_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(_LINEARBUILD_CUDA_RDC_LINK_FLAG "-clang:--offload-link")
  else()
    set(_LINEARBUILD_CUDA_RDC_LINK_FLAG "--offload-link")
  endif()
endif()

# Device linking is just regular linking so these are the same.
set(LINEARBUILD_CUDA_DEVICE_LINKER_WRAPPER_FLAG ${LINEARBUILD_CUDA_LINKER_WRAPPER_FLAG})
set(LINEARBUILD_CUDA_DEVICE_LINKER_WRAPPER_FLAG_SEP ${LINEARBUILD_CUDA_LINKER_WRAPPER_FLAG_SEP})

set(LINEARBUILD_CUDA_DEVICE_LINK_MODE DRIVER)

# RulePlaceholderExpander expands crosscompile variables like sysroot and target only for LINEARBUILD_<LANG>_COMPILER. Override the default.
set(LINEARBUILD_CUDA_LINK_EXECUTABLE "<LINEARBUILD_CUDA_COMPILER> <FLAGS> <LINK_FLAGS> ${_LINEARBUILD_CUDA_RDC_LINK_FLAG} <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
set(LINEARBUILD_CUDA_CREATE_SHARED_LIBRARY "<LINEARBUILD_CUDA_COMPILER> <LINEARBUILD_SHARED_LIBRARY_CUDA_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${_LINEARBUILD_CUDA_RDC_LINK_FLAG} <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")

set(LINEARBUILD_CUDA_RUNTIME_LIBRARY_DEFAULT "STATIC")
set(LINEARBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_STATIC "cudadevrt;cudart_static")
set(LINEARBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_SHARED "cudadevrt;cudart")
set(LINEARBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_NONE   "")

# Clang doesn't support CUDA device LTO
set(_LINEARBUILD_CUDA_IPO_SUPPORTED_BY_LINEARBUILD NO)
set(_LINEARBUILD_CUDA_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)

if(UNIX)
  list(APPEND LINEARBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_STATIC "rt" "pthread" "dl")
endif()
