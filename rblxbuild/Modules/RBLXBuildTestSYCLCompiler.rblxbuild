if(RBLXBUILD_SYCL_COMPILER_FORCED)
  set(RBLXBUILD_SYCL_COMPILER_WORKS TRUE)
  return()
endif()

include(RBLXBuildTestCompilerCommon)

set(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${RBLXBUILD_TRY_COMPILE_TARGET_TYPE})
if(_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

unset(RBLXBUILD_SYCL_COMPILER_WORKS CACHE)

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerABI.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_ABI(SYCL ${RBLXBUILD_ROOT}/Modules/RBLXBuildSYCLCompilerABI.sycl)

if(RBLXBUILD_SYCL_ABI_COMPILED)
  set(RBLXBUILD_SYCL_COMPILER_WORKS TRUE)
  message(STATUS "Check for working SYCL compiler: ${RBLXBUILD_SYCL_COMPILER} - skipped")
endif()

if(NOT RBLXBUILD_SYCL_COMPILER_WORKS)
  PrintTestCompilerStatus("SYCL")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testSYCLCompilerSource
    "#ifndef __cplusplus\n"
    "# error \"The RBLXBUILD_SYCL_COMPILER is not compiling as C++\"\n"
    "#endif\n"
    "#include <sycl/sycl.hpp>\n"
    "class RBLXBuildSYCLCompilerTest;\n"
    "int main() {\n"
    "  sycl::queue queue;\n"
    "  queue.single_task<RBLXBuildSYCLCompilerTest>([] {}).wait();\n"
    "  return 0;\n"
    "}\n")
  unset(RBLXBUILD_SYCL_COMPILER_WORKS)
  try_compile(RBLXBUILD_SYCL_COMPILER_WORKS
    SOURCE_FROM_VAR testSYCLCompiler.sycl __TestCompiler_testSYCLCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __RBLXBUILD_SYCL_COMPILER_OUTPUT)
  __TestCompiler_restoreTryCompileTargetType()
  unset(__TestCompiler_testSYCLCompilerSource)
  if(NOT RBLXBUILD_SYCL_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__RBLXBUILD_SYCL_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The SYCL compiler\n  \"${RBLXBUILD_SYCL_COMPILER}\"\n"
      "is not able to compile a SYCL test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "RBLXBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

if(NOT RBLXBUILD_SYCL_IMPLICIT_LINK_LIBRARIES)
  set(RBLXBUILD_SYCL_IMPLICIT_LINK_LIBRARIES "${RBLXBUILD_SYCL_HOST_IMPLICIT_LINK_LIBRARIES}")
  set(RBLXBUILD_SYCL_IMPLICIT_LINK_DIRECTORIES "${RBLXBUILD_SYCL_HOST_IMPLICIT_LINK_DIRECTORIES}")
  set(RBLXBUILD_SYCL_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES "${RBLXBUILD_SYCL_HOST_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES}")
endif()
include(Internal/RBLXBuildSYCLFilterImplicitLibs)
rblxbuild_sycl_filter_implicit_libs(RBLXBUILD_SYCL_IMPLICIT_LINK_LIBRARIES)

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerSupport.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_SUPPORT(SYCL)

configure_file(
  ${RBLXBUILD_ROOT}/Modules/RBLXBuildSYCLCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildSYCLCompiler.rblxbuild
  @ONLY
  )
include(${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildSYCLCompiler.rblxbuild)

if(RBLXBUILD_SYCL_SIZEOF_DATA_PTR)
  foreach(f ${RBLXBUILD_SYCL_ABI_FILES})
    include(${f})
  endforeach()
  unset(RBLXBUILD_SYCL_ABI_FILES)
endif()

set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__RBLXBUILD_SYCL_COMPILER_OUTPUT)
