#define LINEARBUILD_DATA_DIR "/@LINEARBUILD_DATA_DIR@"
#define LINEARBUILD_DOC_DIR "/@LINEARBUILD_DOC_DIR@"

#define CM_FALLTHROUGH cmsys_FALLTHROUGH

