//========================================================================
// As rblxwin_config.h.in, this file is used by CMake to produce the
// rblxwin_config.h configuration header file.  If you are adding a feature
// requiring conditional compilation, this is where to add the macro.
//========================================================================
// As rblxwin_config.h, this file defines compile-time option macros for a
// specific platform and development environment.  If you are using the
// RBLXWIN CMake files, modify rblxwin_config.h.in instead of this file.  If you
// are using your own build system, make this file define the appropriate
// macros in whatever way is suitable.
//========================================================================

// Define this to 1 if building RBLXWIN for X11
#cmakedefine _RBLXWIN_X11
// Define this to 1 if building RBLXWIN for Win32
#cmakedefine _RBLXWIN_WIN32
// Define this to 1 if building RBLXWIN for Cocoa
#cmakedefine _RBLXWIN_COCOA
// Define this to 1 if building RBLXWIN for Wayland
#cmakedefine _RBLXWIN_WAYLAND
// Define this to 1 if building RBLXWIN for OSMesa
#cmakedefine _RBLXWIN_OSMESA

// Define this to 1 if building as a shared library / dynamic library / DLL
#cmakedefine _RBLXWIN_BUILD_DLL
// Define this to 1 to use Vulkan loader linked statically into application
#cmakedefine _RBLXWIN_VULKAN_STATIC

// Define this to 1 to force use of high-performance GPU on hybrid systems
#cmakedefine _RBLXWIN_USE_HYBRID_HPG

// Define this to 1 if the libc supports memfd_create()
#cmakedefine HAVE_MEMFD_CREATE

