# This module is shared by multiple languages; use include blocker.
include_guard()

set(LINEARBUILD_BUILD_TYPE_INIT Debug)

string(APPEND LINEARBUILD_EXE_LINKER_FLAGS_INIT " system linux opt noextension")
string(APPEND LINEARBUILD_MODULE_LINKER_FLAGS_INIT " system linux")
string(APPEND LINEARBUILD_SHARED_LINKER_FLAGS_INIT " system linux")

linearbuild_policy(GET CMP0136 __LINUX_WATCOM_CMP0136)
if(__LINUX_WATCOM_CMP0136 STREQUAL "NEW")
  set(LINEARBUILD_WATCOM_RUNTIME_LIBRARY_DEFAULT "SingleThreaded")
else()
  set(LINEARBUILD_WATCOM_RUNTIME_LIBRARY_DEFAULT "")
endif()
unset(__LINUX_WATCOM_CMP0136)

# single/multi-threaded                 /-bm
# default is setup for single-threaded libraries
string(APPEND LINEARBUILD_C_FLAGS_INIT " -bt=linux")
string(APPEND LINEARBUILD_CXX_FLAGS_INIT " -bt=linux -xs")

macro(__linux_open_watcom lang)
  if(LINEARBUILD_CROSSCOMPILING)
    if(NOT LINEARBUILD_${lang}_STANDARD_INCLUDE_DIRECTORIES)
      set(LINEARBUILD_${lang}_STANDARD_INCLUDE_DIRECTORIES $ENV{WATCOM}/lh)
    endif()
  endif()
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_SingleThreaded         "")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_MultiThreaded          -bm)
endmacro()
