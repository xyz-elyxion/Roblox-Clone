# This module is shared by multiple languages; use include blocker.
if(__COMPILER_LLVM_INTEL)
  return()
endif()
set(__COMPILER_LLVM_INTEL 1)

include(Compiler/RBLXBuildCommonCompilerMacros)

set(__pch_header_C "c-header")
set(__pch_header_CXX "c++-header")
set(__pch_header_OBJC "objective-c-header")
set(__pch_header_OBJCXX "objective-c++-header")

# Variables that are common across front-end variants
macro(__compiler_intel_llvm_common lang)
  set(_RBLXBUILD_${lang}_IPO_SUPPORTED_BY_RBLXBUILD YES)
  set(_RBLXBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
  set(RBLXBUILD_${lang}_ARCHIVE_CREATE_IPO "\"${RBLXBUILD_${lang}_COMPILER_AR}\" qc <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_APPEND_IPO "\"${RBLXBUILD_${lang}_COMPILER_AR}\" q <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_FINISH_IPO "\"${RBLXBUILD_${lang}_COMPILER_RANLIB}\" <TARGET>")

  set(RBLXBUILD_${lang}_LINK_MODE DRIVER)
endmacro()

if(RBLXBUILD_HOST_WIN32)
  # MSVC-like
  macro(__compiler_intel_llvm lang)
    if("x${lang}" STREQUAL "xFortran")
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-warn:errors")
    else()
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_INVALID_PCH -Winvalid-pch)
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-WX")
      if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL "2021.4")
        set(RBLXBUILD_INCLUDE_SYSTEM_FLAG_${lang} "-external:I")
        if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL "2022.2")
          set(RBLXBUILD_INCLUDE_SYSTEM_FLAG_${lang}_WARNING "-external:W0 ")
        endif()
      endif()
    endif()
    __compiler_intel_llvm_common(${lang})
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_IPO "-Qipo")
    set(RBLXBUILD_${lang}_LINK_OPTIONS_IPO "-Qipo")
  endmacro()
else()
  # GNU-like
  macro(__compiler_intel_llvm lang)
    set(RBLXBUILD_${lang}_VERBOSE_FLAG "-v")

    string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
    string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
    if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 2023.0.0)
      if("x${lang}" STREQUAL "xFortran")
        string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -diag-disable:10440")
      else()
        string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -Rno-debug-disables-optimization")
      endif()
    endif()
    string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -Os")
    string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -O3")
    string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -g")

    set(_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER YES)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIC "-fPIC")
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE "-fPIE")
    set(RBLXBUILD_${lang}_LINK_OPTIONS_PIE ${RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE} "-pie")
    set(RBLXBUILD_${lang}_LINK_OPTIONS_NO_PIE "-no-pie")

    set(RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS "-fPIC")
    set(RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-shared")

    set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
    set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

    set(RBLXBUILD_${lang}_LINK_MODE DRIVER)

    # distcc does not transform -o to -MT when invoking the preprocessor
    # internally, as it ought to.  Work around this bug by setting -MT here
    # even though it isn't strictly necessary.
    set(RBLXBUILD_DEPFILE_FLAGS_${lang} "-MD -MT <DEP_TARGET> -MF <DEP_FILE>")

    set(RBLXBUILD_INCLUDE_SYSTEM_FLAG_${lang} "-isystem ")
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_VISIBILITY "-fvisibility=")
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_TARGET "--target=")
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_SYSROOT "--sysroot=")
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN "--gcc-toolchain=")
    set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Xlinker" " ")
    set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP)

    __compiler_intel_llvm_common(${lang})
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_IPO "-ipo")
    set(RBLXBUILD_${lang}_LINK_OPTIONS_IPO "-ipo")

    set(RBLXBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
    set(RBLXBUILD_${lang}_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")

    if("${lang}" STREQUAL "CXX")
      set(RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "${RBLXBUILD_${lang}_COMPILER}")
      if(RBLXBUILD_${lang}_COMPILER_ARG1)
        separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${RBLXBUILD_${lang}_COMPILER_ARG1}")
        list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
        unset(_COMPILER_ARGS)
      endif()
      list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "-w" "-dM" "-E" "${RBLXBUILD_ROOT}/Modules/RBLXBuildCXXCompilerABI.cpp")
      if(RBLXBUILD_${lang}_COMPILER_TARGET)
        list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "--target=${RBLXBUILD_${lang}_COMPILER_TARGET}")
      endif()
    endif()

    if("x${lang}" STREQUAL "xFortran")
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-warn" "errors")
    else()
      # Precompile Headers
      set(RBLXBUILD_PCH_EXTENSION .pch)
      if (NOT RBLXBUILD_GENERATOR MATCHES "Xcode")
        set(RBLXBUILD_PCH_SYSTEM_HEADER_PRAGMA "#pragma clang system_header")
      endif()
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_INSTANTIATE_TEMPLATES_PCH -fpch-instantiate-templates)
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_INVALID_PCH -Winvalid-pch)
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_USE_PCH -Xclang -include-pch -Xclang <PCH_FILE> -Xclang -include -Xclang <PCH_HEADER>)
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_CREATE_PCH -Xclang -emit-pch -Xclang -include -Xclang <PCH_HEADER> -x ${__pch_header_${lang}})

      # COMPILE_WARNING_AS_ERROR
      set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-Werror")
    endif()
  endmacro()
endif()
