# This module is shared by multiple languages; use include blocker.
if(__LINUX_COMPILER_PGI)
  return()
endif()
set(__LINUX_COMPILER_PGI 1)

macro(__linux_compiler_pgi lang)
  # Shared library compile and link flags.
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIC "-fPIC")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE "")
  set(_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER NO)
  set(RBLXBUILD_${lang}_LINK_OPTIONS_PIE "")
  set(RBLXBUILD_${lang}_LINK_OPTIONS_NO_PIE "")
  set(RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS "-fPIC")
  set(RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-shared")
  set(RBLXBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS " ")
endmacro()
