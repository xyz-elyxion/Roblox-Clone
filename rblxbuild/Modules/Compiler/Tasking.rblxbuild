# This module is shared by multiple languages; use include blocker.
if(_Tasking_RBLXBUILD_LOADED)
  return()
endif()
set(_Tasking_RBLXBUILD_LOADED TRUE)
include(Compiler/RBLXBuildCommonCompilerMacros)

set(RBLXBUILD_EXECUTABLE_SUFFIX ".elf")
set(RBLXBUILD_STATIC_LIBRARY_SUFFIX ".a")
set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)
set(BUILD_SHARED_LIBS FALSE CACHE BOOL "")
set(RBLXBUILD_FIND_LIBRARY_SUFFIXES ".a")
set(RBLXBUILD_LINK_SEARCH_START_STATIC TRUE)

if(NOT RBLXBUILD_TASKING_TOOLSET)
  set(RBLXBUILD_TASKING_TOOLSET "Standalone")
endif()

macro(__compiler_tasking lang)
  set(RBLXBUILD_${lang}_OUTPUT_EXTENSION ".o")

  set(RBLXBUILD_${lang}_VERBOSE_FLAG "-v")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIC "--pic")
  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl" " ")
  set(RBLXBUILD_${lang}_RESPONSE_FILE_FLAG      "-f ")
  set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "-f ")
  set(RBLXBUILD_DEPFILE_FLAGS_${lang} "--dep-file=<DEP_FILE>")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "--warnings-as-errors")

  set(RBLXBUILD_${lang}_LINK_MODE DRIVER)
  # Features for LINK_LIBRARY generator expression
  if(    RBLXBUILD_TASKING_TOOLSET STREQUAL "SmartCode"
     OR (RBLXBUILD_TASKING_TOOLSET STREQUAL "TriCore" AND RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 4.2))
    ## WHOLE_ARCHIVE: Force loading all members of an archive
    set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE "LINKER:--whole-archive=<LINK_ITEM>")
    set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED TRUE)
    set(RBLXBUILD_${lang}_LINK_LIBRARY_WHOLE_ARCHIVE_ATTRIBUTES LIBRARY_TYPE=STATIC DEDUPLICATION=YES OVERRIDE=DEFAULT)
  endif()

  string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -O0 -g")
  string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -O2 -t4 -DNDEBUG")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -O2 -t2 -DNDEBUG")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -t2 -g -DNDEBUG")

  set(RBLXBUILD_${lang}_ARCHIVE_CREATE "\"${RBLXBUILD_${lang}_COMPILER_AR}\" -r <TARGET> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_APPEND "\"${RBLXBUILD_${lang}_COMPILER_AR}\" -r <TARGET> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_FINISH "")

  set(RBLXBUILD_${lang}_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -cs <SOURCE> -o <ASSEMBLY_SOURCE>")
  set(RBLXBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -Ep <SOURCE> > <PREPROCESSED_SOURCE>")

  if("${lang}" STREQUAL "CXX")
    set(RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "${RBLXBUILD_${lang}_COMPILER}")
    if(RBLXBUILD_${lang}_COMPILER_ARG1)
      separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${RBLXBUILD_${lang}_COMPILER_ARG1}")
      list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
      unset(_COMPILER_ARGS)
    endif()
    list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "-Ep" "${RBLXBUILD_ROOT}/Modules/RBLXBuildCXXCompilerABI.cpp")
  endif()

endmacro()
