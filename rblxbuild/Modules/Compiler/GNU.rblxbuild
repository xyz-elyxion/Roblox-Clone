# This module is shared by multiple languages; use include blocker.
if(__COMPILER_GNU)
  return()
endif()
set(__COMPILER_GNU 1)

include(Compiler/RBLXBuildCommonCompilerMacros)

set(__pch_header_C "c-header")
set(__pch_header_CXX "c++-header")
set(__pch_header_OBJC "objective-c-header")
set(__pch_header_OBJCXX "objective-c++-header")

macro(__compiler_gnu lang)
  # Feature flags.
  set(RBLXBUILD_${lang}_VERBOSE_FLAG "-v")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-Werror")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIC "-fPIC")
  set (_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER NO)
  if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 3.4)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE "-fPIE")
    # Support of PIE at link stage depends on various elements : platform, compiler, linker
    # so to activate it, module CheckPIESupported must be used.
    set (_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER YES)
    set(RBLXBUILD_${lang}_LINK_OPTIONS_PIE ${RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE} "-pie")
    set(RBLXBUILD_${lang}_LINK_OPTIONS_NO_PIE "-no-pie")
  endif()
  if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.0)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_VISIBILITY "-fvisibility=")
  endif()
  set(RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS "-fPIC")
  set(RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-shared")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_SYSROOT "--sysroot=")

  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  set(RBLXBUILD_${lang}_LINK_MODE DRIVER)

  # Older versions of gcc (< 4.5) contain a bug causing them to report a missing
  # header file as a warning if depfiles are enabled, causing check_header_file
  # tests to always succeed.  Work around this by disabling dependency tracking
  # in try_compile mode.
  get_property(_IN_TC GLOBAL PROPERTY IN_TRY_COMPILE)
  if(RBLXBUILD_${lang}_COMPILER_ID STREQUAL "GNU" AND _IN_TC AND NOT RBLXBUILD_FORCE_DEPFILES)
  else()
    # distcc does not transform -o to -MT when invoking the preprocessor
    # internally, as it ought to.  Work around this bug by setting -MT here
    # even though it isn't strictly necessary.
    set(RBLXBUILD_DEPFILE_FLAGS_${lang} "-MD -MT <DEP_TARGET> -MF <DEP_FILE>")
  endif()

  # Initial configuration flags.
  string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -Os")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -O3")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -g")
  if(NOT "x${lang}" STREQUAL "xFortran")
    string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -DNDEBUG")
    string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -DNDEBUG")
    string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -DNDEBUG")
  endif()
  set(RBLXBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
  set(RBLXBUILD_${lang}_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
  if(NOT APPLE OR NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4) # work around #4462
    set(RBLXBUILD_INCLUDE_SYSTEM_FLAG_${lang} "-isystem ")
  endif()

  set(_RBLXBUILD_${lang}_IPO_SUPPORTED_BY_RBLXBUILD YES)
  set(_RBLXBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)

  # '-flto' introduced since GCC 4.5:
  # * https://gcc.gnu.org/onlinedocs/gcc-4.4.7/gcc/Option-Summary.html (no)
  # * https://gcc.gnu.org/onlinedocs/gcc-4.5.4/gcc/Option-Summary.html (yes)
  # * It does not support AIX.
  if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.5 AND NOT RBLXBUILD_SYSTEM_NAME STREQUAL "AIX")
    set(_RBLXBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)

    set(__lto_flags "")

    # '-flto=auto' introduced since GCC 10.1:
    # * https://gcc.gnu.org/onlinedocs/gcc-9.5.0/gcc/Optimize-Options.html#Optimize-Options (no)
    # * https://gcc.gnu.org/onlinedocs/gcc-10.1.0/gcc/Optimize-Options.html#Optimize-Options (yes)
    # Since GCC 12.1, the abundance of a parameter produces a warning if compiling multiple targets.
    # FIXME: What version of GCC for Windows added support for -flto=auto?  10.3 does not have it.
    if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 11.0)
      list(APPEND __lto_flags -flto=auto)
    elseif(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 10.1)
      if (RBLXBUILD_HOST_WIN32)
        list(APPEND __lto_flags -flto=1)
      else()
        list(APPEND __lto_flags -flto=auto)
      endif()
    else()
      list(APPEND __lto_flags -flto)
    endif()

    if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.7 AND NOT APPLE)
      # '-ffat-lto-objects' introduced since GCC 4.7:
      # * https://gcc.gnu.org/onlinedocs/gcc-4.6.4/gcc/Option-Summary.html (no)
      # * https://gcc.gnu.org/onlinedocs/gcc-4.7.4/gcc/Option-Summary.html (yes)
      list(APPEND __lto_flags -fno-fat-lto-objects)
    endif()

    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_IPO ${__lto_flags})

    # Need to use version of 'ar'/'ranlib' with plugin support.
    # Quote from [documentation][1]:
    #
    #   To create static libraries suitable for LTO,
    #   use gcc-ar and gcc-ranlib instead of ar and ranlib
    #
    # [1]: https://gcc.gnu.org/onlinedocs/gcc-4.9.4/gcc/Optimize-Options.html
    set(RBLXBUILD_${lang}_ARCHIVE_CREATE_IPO
      "\"${RBLXBUILD_${lang}_COMPILER_AR}\" qc <TARGET> <LINK_FLAGS> <OBJECTS>"
    )

    set(RBLXBUILD_${lang}_ARCHIVE_APPEND_IPO
      "\"${RBLXBUILD_${lang}_COMPILER_AR}\" q <TARGET> <LINK_FLAGS> <OBJECTS>"
    )

    set(RBLXBUILD_${lang}_ARCHIVE_FINISH_IPO
      "\"${RBLXBUILD_${lang}_COMPILER_RANLIB}\" <TARGET>"
    )
  endif()

  if("${lang}" STREQUAL "CXX")
    set(RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "${RBLXBUILD_${lang}_COMPILER}")
    if(RBLXBUILD_${lang}_COMPILER_ARG1)
      separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${RBLXBUILD_${lang}_COMPILER_ARG1}")
      list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
      unset(_COMPILER_ARGS)
    endif()
    list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "-w" "-dM" "-E" "${RBLXBUILD_ROOT}/Modules/RBLXBuildCXXCompilerABI.cpp")
  endif()

  if(NOT "x${lang}" STREQUAL "xFortran")
    set(RBLXBUILD_PCH_EXTENSION .gch)
    if (NOT RBLXBUILD_GENERATOR MATCHES "Xcode")
      set(RBLXBUILD_PCH_SYSTEM_HEADER_PRAGMA "#pragma GCC system_header")
    endif()
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_INVALID_PCH -Winvalid-pch)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_USE_PCH -include <PCH_HEADER>)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_CREATE_PCH -x ${__pch_header_${lang}} -include <PCH_HEADER>)
  endif()

  # '-fdiagnostics-color=always' introduced since GCC 4.9
  # https://gcc.gnu.org/gcc-4.9/changes.html
  if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 4.9)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_COLOR_DIAGNOSTICS "-fdiagnostics-color=always")
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_COLOR_DIAGNOSTICS_OFF "-fno-diagnostics-color")
  endif()
endmacro()

macro(__compiler_gnu_c_standards lang)
  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.5)
    set(RBLXBUILD_${lang}90_STANDARD_COMPILE_OPTION "-std=c90")
    set(RBLXBUILD_${lang}90_EXTENSION_COMPILE_OPTION "-std=gnu90")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 90)
  elseif (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 3.4)
    set(RBLXBUILD_${lang}90_STANDARD_COMPILE_OPTION "-std=c89")
    set(RBLXBUILD_${lang}90_EXTENSION_COMPILE_OPTION "-std=gnu89")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 90)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 3.4)
    set(RBLXBUILD_${lang}90_STANDARD__HAS_FULL_SUPPORT ON)
    set(RBLXBUILD_${lang}99_STANDARD_COMPILE_OPTION "-std=c99")
    set(RBLXBUILD_${lang}99_EXTENSION_COMPILE_OPTION "-std=gnu99")
    set(RBLXBUILD_${lang}99_STANDARD__HAS_FULL_SUPPORT ON)
    set(RBLXBUILD_${lang}_STANDARD_LATEST 99)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.7)
    set(RBLXBUILD_${lang}11_STANDARD_COMPILE_OPTION "-std=c11")
    set(RBLXBUILD_${lang}11_EXTENSION_COMPILE_OPTION "-std=gnu11")
    set(RBLXBUILD_${lang}11_STANDARD__HAS_FULL_SUPPORT ON)
    set(RBLXBUILD_${lang}_STANDARD_LATEST 11)
  elseif (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.6)
    set(RBLXBUILD_${lang}11_STANDARD_COMPILE_OPTION "-std=c1x")
    set(RBLXBUILD_${lang}11_EXTENSION_COMPILE_OPTION "-std=gnu1x")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 11)
  endif()

  if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 8.1)
    set(RBLXBUILD_${lang}17_STANDARD_COMPILE_OPTION "-std=c17")
    set(RBLXBUILD_${lang}17_EXTENSION_COMPILE_OPTION "-std=gnu17")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 17)
  endif()

  if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 9.1)
    set(RBLXBUILD_${lang}23_STANDARD_COMPILE_OPTION "-std=c2x")
    set(RBLXBUILD_${lang}23_EXTENSION_COMPILE_OPTION "-std=gnu2x")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 23)
  endif()
endmacro()

macro(__compiler_gnu_cxx_standards lang)
  if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 3.4)
    set(RBLXBUILD_${lang}98_STANDARD_COMPILE_OPTION "-std=c++98")
    set(RBLXBUILD_${lang}98_EXTENSION_COMPILE_OPTION "-std=gnu++98")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 98)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.7)
    set(RBLXBUILD_${lang}98_STANDARD__HAS_FULL_SUPPORT ON)
    set(RBLXBUILD_${lang}11_STANDARD_COMPILE_OPTION "-std=c++11")
    set(RBLXBUILD_${lang}11_EXTENSION_COMPILE_OPTION "-std=gnu++11")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 11)
  elseif (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.4)
    # 4.3 supports 0x variants
    set(RBLXBUILD_${lang}11_STANDARD_COMPILE_OPTION "-std=c++0x")
    set(RBLXBUILD_${lang}11_EXTENSION_COMPILE_OPTION "-std=gnu++0x")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 11)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.8.1)
    set(RBLXBUILD_${lang}11_STANDARD__HAS_FULL_SUPPORT ON)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.9)
    set(RBLXBUILD_${lang}14_STANDARD_COMPILE_OPTION "-std=c++14")
    set(RBLXBUILD_${lang}14_EXTENSION_COMPILE_OPTION "-std=gnu++14")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 14)
  elseif (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 4.8)
    set(RBLXBUILD_${lang}14_STANDARD_COMPILE_OPTION "-std=c++1y")
    set(RBLXBUILD_${lang}14_EXTENSION_COMPILE_OPTION "-std=gnu++1y")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 14)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 5.0)
    set(RBLXBUILD_${lang}14_STANDARD__HAS_FULL_SUPPORT ON)
  endif()

  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 8.0)
    set(RBLXBUILD_${lang}17_STANDARD_COMPILE_OPTION "-std=c++17")
    set(RBLXBUILD_${lang}17_EXTENSION_COMPILE_OPTION "-std=gnu++17")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 17)
  elseif (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 5.1)
    set(RBLXBUILD_${lang}17_STANDARD_COMPILE_OPTION "-std=c++1z")
    set(RBLXBUILD_${lang}17_EXTENSION_COMPILE_OPTION "-std=gnu++1z")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 17)
  endif()

  if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 11.1)
    set(RBLXBUILD_${lang}20_STANDARD_COMPILE_OPTION "-std=c++20")
    set(RBLXBUILD_${lang}20_EXTENSION_COMPILE_OPTION "-std=gnu++20")
    set(RBLXBUILD_${lang}23_STANDARD_COMPILE_OPTION "-std=c++23")
    set(RBLXBUILD_${lang}23_EXTENSION_COMPILE_OPTION "-std=gnu++23")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 23)
  elseif(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 8.0)
    set(RBLXBUILD_${lang}20_STANDARD_COMPILE_OPTION "-std=c++2a")
    set(RBLXBUILD_${lang}20_EXTENSION_COMPILE_OPTION "-std=gnu++2a")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 20)
  endif()

  if(RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL 14.0)
    set(RBLXBUILD_${lang}26_STANDARD_COMPILE_OPTION "-std=c++26")
    set(RBLXBUILD_${lang}26_EXTENSION_COMPILE_OPTION "-std=gnu++26")
    set(RBLXBUILD_${lang}_STANDARD_LATEST 26)
  endif()
endmacro()
