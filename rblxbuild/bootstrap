  rblxbuild_make_flags="${rblxbuild_make_flags} -j ${rblxbuild_parallel_make}"
fi
for a in ${rblxbuild_make_processors}; do
  if test -z "${rblxbuild_make_processor}" && rblxbuild_try_make "${a}" "${rblxbuild_make_flags}" >> ../rblxbuild_bootstrap.log 2>&1; then
    rblxbuild_make_processor="${a}"
  fi
done
rblxbuild_full_make_flags="${rblxbuild_make_flags}"
if test "x${rblxbuild_original_make_flags}" != "x${rblxbuild_make_flags}"; then
  if test -z "${rblxbuild_make_processor}"; then
    rblxbuild_make_flags="${rblxbuild_original_make_flags}"
    for a in ${rblxbuild_make_processors}; do
      if test -z "${rblxbuild_make_processor}" && rblxbuild_try_make "${a}" "${rblxbuild_make_flags}" >> ../rblxbuild_bootstrap.log 2>&1; then
        rblxbuild_make_processor="${a}"
      fi
    done
  fi
fi
cd "${rblxbuild_bootstrap_dir}"

