# determine the compiler to use for ASM using AT&T syntax, e.g. GNU as

set(ASM_DIALECT "-ATT")
set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LIST ${_RBLXBUILD_TOOLCHAIN_PREFIX}gas ${_RBLXBUILD_TOOLCHAIN_PREFIX}as)
include(RBLXBuildDetermineASMCompiler)
set(ASM_DIALECT)
