include(Compiler/XL)
__compiler_xl(Fortran)

set(RBLXBUILD_Fortran_SUBMODULE_SEP "_")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".smod")

set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-qfixed") # [=<right_margin>]
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-qfree") # [=f90|ibm]

set(RBLXBUILD_Fortran_MODDIR_FLAG "-qmoddir=")
set(RBLXBUILD_Fortran_MODDIR_INCLUDE_FLAG "-I") # -qmoddir= does not affect search path

set(RBLXBUILD_Fortran_DEFINE_FLAG "-WF,-D")

# -qthreaded     = Ensures that all optimizations will be thread-safe
# -qhalt=e       = Halt on error messages (rather than just severe errors)
string(APPEND RBLXBUILD_Fortran_FLAGS_INIT " -qthreaded -qhalt=e")

# xlf: 1501-214 (W) command option E reserved for future use - ignored
set(RBLXBUILD_Fortran_CREATE_PREPROCESSED_SOURCE)
set(RBLXBUILD_Fortran_CREATE_ASSEMBLY_SOURCE)

set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
  "<RBLXBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -qpreprocess -qnoobject -qsuppress=1517-020 -tF -B \"${RBLXBUILD_CURRENT_LIST_DIR}/XL-Fortran/\" -WF,--cpp,\"${RBLXBUILD_Fortran_XL_CPP}\",--out,<PREPROCESSED_SOURCE> <SOURCE>"
  )

if (NOT RBLXBUILD_Fortran_COMPILER_VERSION VERSION_LESS 15.1.6)
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-qpreprocess")
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-qnopreprocess")
endif()
