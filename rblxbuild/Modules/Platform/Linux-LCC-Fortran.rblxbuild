include(Platform/Linux-LCC)
__linux_compiler_lcc(Fortran)
if (RBLXBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL "1.26.03")
  set(RBLXBUILD_SHARED_LIBRARY_LINK_Fortran_FLAGS "-lgfortran")
elseif (RBLXBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL "1.24.01")
  set(RBLXBUILD_SHARED_LIBRARY_LINK_Fortran_FLAGS "-llfortran")
else()
  unset(RBLXBUILD_Fortran_CREATE_PREPROCESSED_SOURCE)
endif()
