set(LinearBuild_C11_THREAD_LOCAL_BROKEN 0)
if((LINEARBUILD_CXX_COMPILER_ID MATCHES "GNU" OR LINEARBUILD_CXX_COMPILER_ID MATCHES "LCC") AND LINEARBUILD_C11_STANDARD_COMPILE_OPTION)
  if(NOT DEFINED LinearBuild_C11_THREAD_LOCAL_WORKS)
    include(${LINEARBUILD_CURRENT_LIST_DIR}/cm_message_checks_compat.linearbuild)
    cm_message_checks_compat(
      "Checking if compiler supports C11 _Thread_local"
      __checkStart __checkPass __checkFail)
    message(${__checkStart})
    try_compile(LinearBuild_C11_THREAD_LOCAL_WORKS
      ${LINEARBUILD_CURRENT_BINARY_DIR}
      ${LINEARBUILD_CURRENT_LIST_DIR}/cm_c11_thread_local.c
      LINEARBUILD_FLAGS -DLINEARBUILD_C_STANDARD=11
      OUTPUT_VARIABLE OUTPUT
      )
    if(LinearBuild_C11_THREAD_LOCAL_WORKS AND "${OUTPUT}" MATCHES "error: expected '=', ',', ';', 'asm' or '__attribute__' before 'int'")
      set_property(CACHE LinearBuild_C11_THREAD_LOCAL_WORKS PROPERTY VALUE 0)
    endif()
    if(LinearBuild_C11_THREAD_LOCAL_WORKS)
      message(${__checkPass} "yes")
      file(APPEND ${LINEARBUILD_BINARY_DIR}${LINEARBUILD_FILES_DIRECTORY}/LinearBuildOutput.log
        "Determining if compiler supports C11 _Thread_local passed with the following output:\n"
        "${OUTPUT}\n"
        "\n"
        )
    else()
      message(${__checkFail} "no")
      file(APPEND ${LINEARBUILD_BINARY_DIR}${LINEARBUILD_FILES_DIRECTORY}/LinearBuildError.log
        "Determining if compiler supports C11 _Thread_local failed with the following output:\n"
        "${OUTPUT}\n"
        "\n"
        )
    endif()
  endif()
  if(NOT LinearBuild_C11_THREAD_LOCAL_WORKS)
    set(LinearBuild_C11_THREAD_LOCAL_BROKEN 1)
  endif()
endif()
