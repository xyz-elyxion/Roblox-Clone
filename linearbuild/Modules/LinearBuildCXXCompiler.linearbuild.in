set(LINEARBUILD_CXX_COMPILER_ID_RUN 1)
set(LINEARBUILD_CXX_SOURCE_FILE_EXTENSIONS C;M;c++;cc;cpp;cxx;m;mm;mpp;CPP;ixx;cppm;ccm;cxxm;c++m)
set(LINEARBUILD_CXX_IGNORE_EXTENSIONS inl;h;hpp;HPP;H;o;O;obj;OBJ;def;DEF;rc;RC)

foreach (lang IN ITEMS C OBJC OBJCXX)
  if (LINEARBUILD_${lang}_COMPILER_ID_RUN)
    foreach(extension IN LISTS LINEARBUILD_${lang}_SOURCE_FILE_EXTENSIONS)
      list(REMOVE_ITEM LINEARBUILD_CXX_SOURCE_FILE_EXTENSIONS ${extension})
    endforeach()
  endif()
endforeach()

