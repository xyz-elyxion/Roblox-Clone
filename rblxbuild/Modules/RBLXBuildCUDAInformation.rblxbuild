# file LICENSE.rst or https://rblxbuild.org/licensing for details.

if(UNIX)
  set(RBLXBUILD_CUDA_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_CUDA_OUTPUT_EXTENSION .obj)
endif()
set(RBLXBUILD_INCLUDE_FLAG_CUDA "-I")

# Set implicit links early so compiler-specific modules can use them.
set(__IMPLICIT_LINKS)
foreach(dir ${RBLXBUILD_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES})
  string(APPEND __IMPLICIT_LINKS " -L\"${dir}\"")
endforeach()
foreach(lib ${RBLXBUILD_CUDA_HOST_IMPLICIT_LINK_LIBRARIES})
  if(${lib} MATCHES "/")
    string(APPEND __IMPLICIT_LINKS " \"${lib}\"")
  else()
    string(APPEND __IMPLICIT_LINKS " -l${lib}")
  endif()
endforeach()

# Load compiler-specific information.
if(RBLXBUILD_CUDA_COMPILER_ID)
  include(Compiler/${RBLXBUILD_CUDA_COMPILER_ID}-CUDA OPTIONAL)
endif()

# load the system- and compiler specific files
if(RBLXBUILD_CUDA_COMPILER_ID)
  # load a hardware specific file, mostly useful for embedded compilers
  if(RBLXBUILD_SYSTEM_PROCESSOR)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_CUDA_COMPILER_ID}-CUDA-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_CUDA_COMPILER_ID}-CUDA OPTIONAL)
endif()


# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_CUDA)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE_CUDA} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_CUDA "${_override}")
endif()



# add the flags to the cache based
# on the initial values computed in the platform/*.rblxbuild files
# use _INIT variables so that this only happens the first time
# and you can set these flags in the rblxbuild cache
set(RBLXBUILD_CUDA_FLAGS_INIT "$ENV{CUDAFLAGS} ${RBLXBUILD_CUDA_FLAGS_INIT}")

rblxbuild_initialize_per_config_variable(RBLXBUILD_CUDA_FLAGS "Flags used by the CUDA compiler")

if(RBLXBUILD_CUDA_STANDARD_LIBRARIES_INIT)
  set(RBLXBUILD_CUDA_STANDARD_LIBRARIES "${RBLXBUILD_CUDA_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all CUDA applications.")
  mark_as_advanced(RBLXBUILD_CUDA_STANDARD_LIBRARIES)
endif()

if(NOT RBLXBUILD_CUDA_COMPILER_LAUNCHER AND DEFINED ENV{RBLXBUILD_CUDA_COMPILER_LAUNCHER})
  set(RBLXBUILD_CUDA_COMPILER_LAUNCHER "$ENV{RBLXBUILD_CUDA_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for CUDA.")
endif()

if(NOT RBLXBUILD_CUDA_LINKER_LAUNCHER AND DEFINED ENV{RBLXBUILD_CUDA_LINKER_LAUNCHER})
  set(RBLXBUILD_CUDA_LINKER_LAUNCHER "$ENV{RBLXBUILD_CUDA_LINKER_LAUNCHER}"
          CACHE STRING "Linker launcher for CUDA.")
endif()

include(RBLXBuildCommonLanguageInclude)
_rblxbuild_common_language_platform_flags(CUDA)

# now define the following rules:
# RBLXBUILD_CUDA_CREATE_SHARED_LIBRARY
# RBLXBUILD_CUDA_CREATE_SHARED_MODULE
# RBLXBUILD_CUDA_COMPILE_WHOLE_COMPILATION
# RBLXBUILD_CUDA_COMPILE_SEPARABLE_COMPILATION
# RBLXBUILD_CUDA_LINK_EXECUTABLE

# create a shared library
if(NOT RBLXBUILD_CUDA_CREATE_SHARED_LIBRARY)
  set(RBLXBUILD_CUDA_CREATE_SHARED_LIBRARY
      "<RBLXBUILD_CUDA_HOST_LINK_LAUNCHER> <RBLXBUILD_SHARED_LIBRARY_CUDA_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
endif()

# create a shared module copy the shared library rule by default
if(NOT RBLXBUILD_CUDA_CREATE_SHARED_MODULE)
  set(RBLXBUILD_CUDA_CREATE_SHARED_MODULE ${RBLXBUILD_CUDA_CREATE_SHARED_LIBRARY})
endif()

# Create a static archive incrementally for large object file counts.
if(NOT DEFINED RBLXBUILD_CUDA_ARCHIVE_CREATE)
  set(RBLXBUILD_CUDA_ARCHIVE_CREATE "<RBLXBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_CUDA_ARCHIVE_APPEND)
  set(RBLXBUILD_CUDA_ARCHIVE_APPEND "<RBLXBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_CUDA_ARCHIVE_FINISH)
  set(RBLXBUILD_CUDA_ARCHIVE_FINISH "<RBLXBUILD_RANLIB> <TARGET>")
endif()

if(NOT RBLXBUILD_CUDA_COMPILE_OBJECT)
  set(RBLXBUILD_CUDA_COMPILE_OBJECT
    "<RBLXBUILD_CUDA_COMPILER> ${_RBLXBUILD_CUDA_EXTRA_FLAGS} <DEFINES> <INCLUDES> <FLAGS> ${_RBLXBUILD_COMPILE_AS_CUDA_FLAG} <CUDA_COMPILE_MODE> <SOURCE> -o <OBJECT>")
endif()

# compile a cu file into an executable
if(NOT RBLXBUILD_CUDA_LINK_EXECUTABLE)
  set(RBLXBUILD_CUDA_LINK_EXECUTABLE
    "<RBLXBUILD_CUDA_HOST_LINK_LAUNCHER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
endif()

# Add implicit host link directories that contain device libraries
# to the device link line.
set(__IMPLICIT_DLINK_DIRS ${RBLXBUILD_CUDA_IMPLICIT_LINK_DIRECTORIES})
if(__IMPLICIT_DLINK_DIRS)
  list(REMOVE_ITEM __IMPLICIT_DLINK_DIRS ${RBLXBUILD_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES})
endif()
set(__IMPLICIT_DLINK_FLAGS)
foreach(dir ${__IMPLICIT_DLINK_DIRS})
  if(EXISTS "${dir}/libcurand_static.a")
    string(APPEND __IMPLICIT_DLINK_FLAGS " -L\"${dir}\"")
  endif()
endforeach()
unset(__IMPLICIT_DLINK_DIRS)


#These are used when linking relocatable (dc) cuda code
if(NOT RBLXBUILD_CUDA_DEVICE_LINK_LIBRARY)
  set(RBLXBUILD_CUDA_DEVICE_LINK_LIBRARY
    "<RBLXBUILD_CUDA_COMPILER> ${_RBLXBUILD_CUDA_EXTRA_FLAGS} <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${RBLXBUILD_CUDA_COMPILE_OPTIONS_PIC} ${_RBLXBUILD_CUDA_EXTRA_DEVICE_LINK_FLAGS} -shared -dlink <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_DLINK_FLAGS}")
endif()
if(NOT RBLXBUILD_CUDA_DEVICE_LINK_EXECUTABLE)
  set(RBLXBUILD_CUDA_DEVICE_LINK_EXECUTABLE
    "<RBLXBUILD_CUDA_COMPILER> ${_RBLXBUILD_CUDA_EXTRA_FLAGS} <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${RBLXBUILD_CUDA_COMPILE_OPTIONS_PIC} ${_RBLXBUILD_CUDA_EXTRA_DEVICE_LINK_FLAGS} -shared -dlink <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_DLINK_FLAGS}")
endif()

# Used when device linking is handled by RBLXBuild.
if(NOT RBLXBUILD_CUDA_DEVICE_LINK_COMPILE)
  set(RBLXBUILD_CUDA_DEVICE_LINK_COMPILE "<RBLXBUILD_CUDA_COMPILER> ${_RBLXBUILD_CUDA_EXTRA_FLAGS} <FLAGS> <LINK_FLAGS> -D__CUDA_INCLUDE_COMPILER_INTERNAL_HEADERS__ -D__NV_EXTRA_INITIALIZATION=\"\" -D__NV_EXTRA_FINALIZATION=\"\" -DREGISTERLINKBINARYFILE=\\\"<REGISTER_FILE>\\\" -DFATBINFILE=\\\"<FATBINARY>\\\" ${_RBLXBUILD_COMPILE_AS_CUDA_FLAG} -c \"${RBLXBUILD_CUDA_COMPILER_TOOLKIT_LIBRARY_ROOT}/bin/crt/link.stub\" -o <OBJECT>")
endif()

unset(__IMPLICIT_DLINK_FLAGS)

set(RBLXBUILD_CUDA_USE_LINKER_INFORMATION TRUE)

set(RBLXBUILD_CUDA_INFORMATION_LOADED 1)
