# This file sets the basic flags for the Objective-C++ language in RBLXBuild.
# It also loads the available platform file for the system-compiler
# if it exists.
# It also loads a system - compiler - processor (or target hardware)
# specific file, which is mainly useful for crosscompiling and embedded systems.

include(RBLXBuildLanguageInformation)

# some compilers use different extensions (e.g. sdcc uses .rel)
# so set the extension here first so it can be overridden by the compiler specific file
set(RBLXBUILD_OBJCXX_OUTPUT_EXTENSION .o)

set(_INCLUDED_FILE 0)

# Load compiler-specific information.
if(RBLXBUILD_OBJCXX_COMPILER_ID)
  include(Compiler/${RBLXBUILD_OBJCXX_COMPILER_ID}-OBJCXX OPTIONAL)
endif()

set(RBLXBUILD_BASE_NAME)
get_filename_component(RBLXBUILD_BASE_NAME "${RBLXBUILD_OBJCXX_COMPILER}" NAME_WE)
# since the gnu compiler has several names force g++
if(RBLXBUILD_OBJCXX_COMPILER_ID STREQUAL "GNU")
  set(RBLXBUILD_BASE_NAME g++)
endif()


# load a hardware specific file, mostly useful for embedded compilers
if(RBLXBUILD_SYSTEM_PROCESSOR)
  if(RBLXBUILD_OBJCXX_COMPILER_ID)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_OBJCXX_COMPILER_ID}-OBJCXX-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
  endif()
  if (NOT _INCLUDED_FILE)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME}-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif ()
endif()

# load the system- and compiler specific files
if(RBLXBUILD_OBJCXX_COMPILER_ID)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_OBJCXX_COMPILER_ID}-OBJCXX OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()
if (NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME} OPTIONAL
          RESULT_VARIABLE _INCLUDED_FILE)
endif ()

# load any compiler-wrapper specific information
if (RBLXBUILD_OBJCXX_COMPILER_WRAPPER)
  __rblxbuild_include_compiler_wrapper(OBJCXX)
endif ()

# We specify the compiler information in the system file for some
# platforms, but this language may not have been enabled when the file
# was first included.  Include it again to get the language info.
# Remove this when all compiler info is removed from system files.
if (NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_SYSTEM_NAME} OPTIONAL)
endif ()

if(RBLXBUILD_OBJCXX_SIZEOF_DATA_PTR)
  foreach(f IN LISTS RBLXBUILD_OBJCXX_ABI_FILES)
    include(${f})
  endforeach()
  unset(RBLXBUILD_OBJCXX_ABI_FILES)
endif()

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_OBJCXX)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE_OBJCXX} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_OBJCXX "${_override}")
endif()


# add the flags to the cache based
# on the initial values computed in the platform/*.rblxbuild files
# use _INIT variables so that this only happens the first time
# and you can set these flags in the rblxbuild cache
set(RBLXBUILD_OBJCXX_FLAGS_INIT "$ENV{OBJCXXFLAGS} ${RBLXBUILD_OBJCXX_FLAGS_INIT}")

rblxbuild_initialize_per_config_variable(RBLXBUILD_OBJCXX_FLAGS "Flags used by the Objective-C++ compiler")

if(RBLXBUILD_OBJCXX_STANDARD_LIBRARIES_INIT)
  set(RBLXBUILD_OBJCXX_STANDARD_LIBRARIES "${RBLXBUILD_OBJCXX_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all Objective-C++ applications.")
  mark_as_advanced(RBLXBUILD_OBJCXX_STANDARD_LIBRARIES)
endif()

if(NOT RBLXBUILD_OBJCXX_COMPILER_LAUNCHER AND DEFINED ENV{RBLXBUILD_OBJCXX_COMPILER_LAUNCHER})
  set(RBLXBUILD_OBJCXX_COMPILER_LAUNCHER "$ENV{RBLXBUILD_OBJCXX_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for OBJCXX.")
endif()

if(NOT RBLXBUILD_OBJCXX_LINKER_LAUNCHER AND DEFINED ENV{RBLXBUILD_OBJCXX_LINKER_LAUNCHER})
  set(RBLXBUILD_OBJCXX_LINKER_LAUNCHER "$ENV{RBLXBUILD_OBJCXX_LINKER_LAUNCHER}"
    CACHE STRING "Linker launcher for OBJCXX.")
endif()

include(RBLXBuildCommonLanguageInclude)
_rblxbuild_common_language_platform_flags(OBJCXX)

# now define the following rules:
# RBLXBUILD_OBJCXX_CREATE_SHARED_LIBRARY
# RBLXBUILD_OBJCXX_CREATE_SHARED_MODULE
# RBLXBUILD_OBJCXX_COMPILE_OBJECT
# RBLXBUILD_OBJCXX_LINK_EXECUTABLE

# variables supplied by the generator at use time
# <TARGET>
# <TARGET_BASE> the target without the suffix
# <OBJECTS>
# <OBJECT>
# <LINK_LIBRARIES>
# <FLAGS>
# <LINK_FLAGS>

# Objective-C++ compiler information
# <RBLXBUILD_OBJCXX_COMPILER>

# Static library tools
# <RBLXBUILD_AR>
# <RBLXBUILD_RANLIB>


# create a shared Objective-C++ library
if(NOT RBLXBUILD_OBJCXX_CREATE_SHARED_LIBRARY)
  set(RBLXBUILD_OBJCXX_CREATE_SHARED_LIBRARY
      "<RBLXBUILD_OBJCXX_COMPILER> <RBLXBUILD_SHARED_LIBRARY_OBJCXX_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
endif()

# create an Objective-C++ shared module copy the shared library rule by default
if(NOT RBLXBUILD_OBJCXX_CREATE_SHARED_MODULE)
  set(RBLXBUILD_OBJCXX_CREATE_SHARED_MODULE ${RBLXBUILD_OBJCXX_CREATE_SHARED_LIBRARY})
endif()


# Create a static archive incrementally for large object file counts.
# If RBLXBUILD_OBJCXX_CREATE_STATIC_LIBRARY is set it will override these.
if(NOT DEFINED RBLXBUILD_OBJCXX_ARCHIVE_CREATE)
  set(RBLXBUILD_OBJCXX_ARCHIVE_CREATE "<RBLXBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_OBJCXX_ARCHIVE_APPEND)
  set(RBLXBUILD_OBJCXX_ARCHIVE_APPEND "<RBLXBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_OBJCXX_ARCHIVE_FINISH)
  set(RBLXBUILD_OBJCXX_ARCHIVE_FINISH "<RBLXBUILD_RANLIB> <TARGET>")
endif()

# compile an Objective-C++ file into an object file
if(NOT RBLXBUILD_OBJCXX_COMPILE_OBJECT)
  set(RBLXBUILD_OBJCXX_COMPILE_OBJECT
    "<RBLXBUILD_OBJCXX_COMPILER> <DEFINES> <INCLUDES> -x objective-c++ <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT RBLXBUILD_OBJCXX_LINK_EXECUTABLE)
  set(RBLXBUILD_OBJCXX_LINK_EXECUTABLE
    "<RBLXBUILD_OBJCXX_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

mark_as_advanced(
RBLXBUILD_VERBOSE_MAKEFILE
)

set(RBLXBUILD_OBJCXX_USE_LINKER_INFORMATION TRUE)

set(RBLXBUILD_OBJCXX_INFORMATION_LOADED 1)
