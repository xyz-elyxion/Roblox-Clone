# This module is shared by multiple languages; use include blocker.
include_guard()

set(RBLXBUILD_BUILD_TYPE_INIT Debug)

string(APPEND RBLXBUILD_SHARED_LINKER_FLAGS_INIT " system nt_dll")
string(APPEND RBLXBUILD_MODULE_LINKER_FLAGS_INIT " system nt_dll")

set(RBLXBUILD_C_COMPILE_OPTIONS_DLL "-bd") # Note: This variable is a ';' separated list
set(RBLXBUILD_SHARED_LIBRARY_C_FLAGS "-bd") # ... while this is a space separated string.

set(RBLXBUILD_RC_COMPILER "rc" )

rblxbuild_policy(GET CMP0136 __WINDOWS_WATCOM_CMP0136)
if(__WINDOWS_WATCOM_CMP0136 STREQUAL "NEW")
  set(RBLXBUILD_WATCOM_RUNTIME_LIBRARY_DEFAULT "MultiThreadedDLL")
  set(_br_bm "")
else()
  set(RBLXBUILD_WATCOM_RUNTIME_LIBRARY_DEFAULT "")
  set(_br_bm "-br -bm")
endif()

string(APPEND RBLXBUILD_C_FLAGS_INIT " -bt=nt -dWIN32 ${_br_bm}")
string(APPEND RBLXBUILD_CXX_FLAGS_INIT " -bt=nt -xs -dWIN32 ${_br_bm}")

unset(__WINDOWS_WATCOM_CMP0136)
unset(_br_bm)

macro(__windows_open_watcom lang)
  if(RBLXBUILD_CROSSCOMPILING)
    if(NOT RBLXBUILD_${lang}_STANDARD_INCLUDE_DIRECTORIES)
      set(RBLXBUILD_${lang}_STANDARD_INCLUDE_DIRECTORIES $ENV{WATCOM}/h $ENV{WATCOM}/h/nt)
    endif()
  endif()
  set(RBLXBUILD_${lang}_CREATE_WIN32_EXE "system nt_win")
  set(RBLXBUILD_${lang}_CREATE_CONSOLE_EXE "system nt")

  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_SingleThreaded         "")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_SingleThreadedDLL      -br)
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_MultiThreaded          -bm)
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_MultiThreadedDLL       -bm -br)
endmacro()
