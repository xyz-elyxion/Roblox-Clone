include(Compiler/IntelLLVM)
__compiler_intel_llvm(SYCL)

set(_LINEARBUILD_SYCL_REQUIRED_FLAG "-fsycl")

if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2026.0)
  include(Compiler/IntelLLVM-SYCL-DeviceLink)
endif()

set(LINEARBUILD_SYCL_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN
  "-fvisibility-inlines-hidden")

set(LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND "${LINEARBUILD_SYCL_COMPILER}")
if(LINEARBUILD_SYCL_COMPILER_ARG1)
  separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${LINEARBUILD_SYCL_COMPILER_ARG1}")
  list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
  unset(_COMPILER_ARGS)
endif()
list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
  ${_LINEARBUILD_SYCL_REQUIRED_FLAG} "-x" "c++" "-w" "-dM" "-E"
  "${LINEARBUILD_ROOT}/Modules/LinearBuildSYCLCompilerABI.sycl")
if(LINEARBUILD_SYCL_COMPILER_TARGET)
  list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
    "--target=${LINEARBUILD_SYCL_COMPILER_TARGET}")
endif()

if(LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
  set(LINEARBUILD_SYCL17_STANDARD_COMPILE_OPTION  "-std=c++17")
  set(LINEARBUILD_SYCL17_EXTENSION_COMPILE_OPTION "-std=gnu++17")

  set(LINEARBUILD_SYCL20_STANDARD_COMPILE_OPTION  "-std=c++20")
  set(LINEARBUILD_SYCL20_EXTENSION_COMPILE_OPTION "-std=gnu++20")

  set(LINEARBUILD_SYCL_STANDARD_LATEST 20)

  if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(LINEARBUILD_SYCL23_STANDARD_COMPILE_OPTION "-std=c++23")
    set(LINEARBUILD_SYCL23_EXTENSION_COMPILE_OPTION "-std=gnu++23")
    set(LINEARBUILD_SYCL_STANDARD_LATEST 23)
  elseif(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2021.2.0)
    set(LINEARBUILD_SYCL23_STANDARD_COMPILE_OPTION  "-std=c++2b")
    set(LINEARBUILD_SYCL23_EXTENSION_COMPILE_OPTION "-std=gnu++2b")
    set(LINEARBUILD_SYCL_STANDARD_LATEST 23)
  endif()

  if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(LINEARBUILD_SYCL26_STANDARD_COMPILE_OPTION "-std=c++26")
    set(LINEARBUILD_SYCL26_EXTENSION_COMPILE_OPTION "-std=gnu++26")
    set(LINEARBUILD_SYCL_STANDARD_LATEST 26)
  endif()
else()
  set(LINEARBUILD_SYCL17_STANDARD_COMPILE_OPTION  "-Qstd:c++17")
  set(LINEARBUILD_SYCL17_EXTENSION_COMPILE_OPTION "-Qstd:c++17")

  set(LINEARBUILD_SYCL20_STANDARD_COMPILE_OPTION  "-Qstd:c++20")
  set(LINEARBUILD_SYCL20_EXTENSION_COMPILE_OPTION "-Qstd:c++20")

  set(LINEARBUILD_SYCL_STANDARD_LATEST 20)

  if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(LINEARBUILD_SYCL23_STANDARD_COMPILE_OPTION "-Qstd=c++23")
    set(LINEARBUILD_SYCL23_EXTENSION_COMPILE_OPTION "-Qstd=c++23")
    set(LINEARBUILD_SYCL_STANDARD_LATEST 23)
  elseif(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2021.2.0)
    set(LINEARBUILD_SYCL23_STANDARD_COMPILE_OPTION  "-Qstd:c++2b")
    set(LINEARBUILD_SYCL23_EXTENSION_COMPILE_OPTION "-Qstd:c++2b")
    set(LINEARBUILD_SYCL_STANDARD_LATEST 23)
  endif()

  if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(LINEARBUILD_SYCL26_STANDARD_COMPILE_OPTION "-Qstd=c++26")
    set(LINEARBUILD_SYCL26_EXTENSION_COMPILE_OPTION "-Qstd=c++26")
    set(LINEARBUILD_SYCL_STANDARD_LATEST 26)
  endif()
endif()

if(LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
  set(_LINEARBUILD_SYCL_NDEBUG_FLAG " /DNDEBUG")
else()
  set(_LINEARBUILD_SYCL_NDEBUG_FLAG " -DNDEBUG")
endif()
string(APPEND LINEARBUILD_SYCL_FLAGS_MINSIZEREL_INIT "${_LINEARBUILD_SYCL_NDEBUG_FLAG}")
string(APPEND LINEARBUILD_SYCL_FLAGS_RELEASE_INIT "${_LINEARBUILD_SYCL_NDEBUG_FLAG}")
string(APPEND LINEARBUILD_SYCL_FLAGS_RELWITHDEBINFO_INIT "${_LINEARBUILD_SYCL_NDEBUG_FLAG}")
unset(_LINEARBUILD_SYCL_NDEBUG_FLAG)

__compiler_check_default_language_standard(SYCL 2020 17)
