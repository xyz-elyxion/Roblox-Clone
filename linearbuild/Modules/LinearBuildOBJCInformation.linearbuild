# This file sets the basic flags for the Objective-C language in LinearBuild.
# It also loads the available platform file for the system-compiler
# if it exists.
# It also loads a system - compiler - processor (or target hardware)
# specific file, which is mainly useful for crosscompiling and embedded systems.

include(LinearBuildLanguageInformation)

# some compilers use different extensions (e.g. sdcc uses .rel)
# so set the extension here first so it can be overridden by the compiler specific file
set(LINEARBUILD_OBJC_OUTPUT_EXTENSION .o)

if(NOT LINEARBUILD_INCLUDE_FLAG_OBJC)
  set(LINEARBUILD_INCLUDE_FLAG_OBJC ${LINEARBUILD_INCLUDE_FLAG_C})
endif()

set(_INCLUDED_FILE 0)

# Load compiler-specific information.
if(LINEARBUILD_OBJC_COMPILER_ID)
  include(Compiler/${LINEARBUILD_OBJC_COMPILER_ID}-OBJC OPTIONAL)
endif()

set(LINEARBUILD_BASE_NAME)
get_filename_component(LINEARBUILD_BASE_NAME "${LINEARBUILD_OBJC_COMPILER}" NAME_WE)
if(LINEARBUILD_OBJC_COMPILER_ID STREQUAL "GNU")
  set(LINEARBUILD_BASE_NAME gcc)
endif()


# load a hardware specific file, mostly useful for embedded compilers
if(LINEARBUILD_SYSTEM_PROCESSOR)
  if(LINEARBUILD_OBJC_COMPILER_ID)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_OBJC_COMPILER_ID}-OBJC-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
  endif()
  if (NOT _INCLUDED_FILE)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME}-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif ()
endif()


# load the system- and compiler specific files
if(LINEARBUILD_OBJC_COMPILER_ID)
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_OBJC_COMPILER_ID}-OBJC
    OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()
if (NOT _INCLUDED_FILE)
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME}
    OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif ()

# load any compiler-wrapper specific information
if (LINEARBUILD_OBJC_COMPILER_WRAPPER)
  __linearbuild_include_compiler_wrapper(OBJC)
endif ()

# We specify the compiler information in the system file for some
# platforms, but this language may not have been enabled when the file
# was first included.  Include it again to get the language info.
# Remove this when all compiler info is removed from system files.
if (NOT _INCLUDED_FILE)
  include(Platform/${LINEARBUILD_SYSTEM_NAME} OPTIONAL)
endif ()

if(LINEARBUILD_OBJC_SIZEOF_DATA_PTR)
  foreach(f IN LISTS LINEARBUILD_OBJC_ABI_FILES)
    include(${f})
  endforeach()
  unset(LINEARBUILD_OBJC_ABI_FILES)
endif()

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE_OBJC)
  # Save the full path of the file so try_compile can use it.
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE_OBJC} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE_OBJC "${_override}")
endif()

set(LINEARBUILD_OBJC_FLAGS_INIT "$ENV{OBJCFLAGS} ${LINEARBUILD_OBJC_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_OBJC_FLAGS "Flags used by the Objective-C compiler")

if(LINEARBUILD_OBJC_STANDARD_LIBRARIES_INIT)
  set(LINEARBUILD_OBJC_STANDARD_LIBRARIES "${LINEARBUILD_OBJC_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all Objective-C applications.")
  mark_as_advanced(LINEARBUILD_OBJC_STANDARD_LIBRARIES)
endif()

if(NOT LINEARBUILD_OBJC_COMPILER_LAUNCHER AND DEFINED ENV{LINEARBUILD_OBJC_COMPILER_LAUNCHER})
  set(LINEARBUILD_OBJC_COMPILER_LAUNCHER "$ENV{LINEARBUILD_OBJC_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for OBJC.")
endif()

if(NOT LINEARBUILD_OBJC_LINKER_LAUNCHER AND DEFINED ENV{LINEARBUILD_OBJC_LINKER_LAUNCHER})
  set(LINEARBUILD_OBJC_LINKER_LAUNCHER "$ENV{LINEARBUILD_OBJC_LINKER_LAUNCHER}"
    CACHE STRING "Linker launcher for OBJC.")
endif()

include(LinearBuildCommonLanguageInclude)
_linearbuild_common_language_platform_flags(OBJC)

# now define the following rule variables

# LINEARBUILD_OBJC_CREATE_SHARED_LIBRARY
# LINEARBUILD_OBJC_CREATE_SHARED_MODULE
# LINEARBUILD_OBJC_COMPILE_OBJECT
# LINEARBUILD_OBJC_LINK_EXECUTABLE

# variables supplied by the generator at use time
# <TARGET>
# <TARGET_BASE> the target without the suffix
# <OBJECTS>
# <OBJECT>
# <LINK_LIBRARIES>
# <FLAGS>
# <LINK_FLAGS>

# Objective-C compiler information
# <LINEARBUILD_OBJC_COMPILER>

# Static library tools
# <LINEARBUILD_AR>
# <LINEARBUILD_RANLIB>


# create an Objective-C shared library
if(NOT LINEARBUILD_OBJC_CREATE_SHARED_LIBRARY)
  set(LINEARBUILD_OBJC_CREATE_SHARED_LIBRARY
      "<LINEARBUILD_OBJC_COMPILER> <LINEARBUILD_SHARED_LIBRARY_OBJC_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
endif()

# create an Objective-C shared module just copy the shared library rule
if(NOT LINEARBUILD_OBJC_CREATE_SHARED_MODULE)
  set(LINEARBUILD_OBJC_CREATE_SHARED_MODULE ${LINEARBUILD_OBJC_CREATE_SHARED_LIBRARY})
endif()

# Create an static archive incrementally for large object file counts.
# If LINEARBUILD_OBJC_CREATE_STATIC_LIBRARY is set it will override these.
if(NOT DEFINED LINEARBUILD_OBJC_ARCHIVE_CREATE)
  set(LINEARBUILD_OBJC_ARCHIVE_CREATE "<LINEARBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_OBJC_ARCHIVE_APPEND)
  set(LINEARBUILD_OBJC_ARCHIVE_APPEND "<LINEARBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_OBJC_ARCHIVE_FINISH)
  set(LINEARBUILD_OBJC_ARCHIVE_FINISH "<LINEARBUILD_RANLIB> <TARGET>")
endif()

# compile an Objective-C file into an object file
if(NOT LINEARBUILD_OBJC_COMPILE_OBJECT)
  set(LINEARBUILD_OBJC_COMPILE_OBJECT
    "<LINEARBUILD_OBJC_COMPILER> <DEFINES> <INCLUDES> -x objective-c <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT LINEARBUILD_OBJC_LINK_EXECUTABLE)
  set(LINEARBUILD_OBJC_LINK_EXECUTABLE
    "<LINEARBUILD_OBJC_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(NOT LINEARBUILD_EXECUTABLE_RUNTIME_OBJC_FLAG)
  set(LINEARBUILD_EXECUTABLE_RUNTIME_OBJC_FLAG ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_OBJC_FLAG})
endif()

if(NOT LINEARBUILD_EXECUTABLE_RUNTIME_OBJC_FLAG_SEP)
  set(LINEARBUILD_EXECUTABLE_RUNTIME_OBJC_FLAG_SEP ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_OBJC_FLAG_SEP})
endif()

if(NOT LINEARBUILD_EXECUTABLE_RPATH_LINK_OBJC_FLAG)
  set(LINEARBUILD_EXECUTABLE_RPATH_LINK_OBJC_FLAG ${LINEARBUILD_SHARED_LIBRARY_RPATH_LINK_OBJC_FLAG})
endif()

set(LINEARBUILD_OBJC_USE_LINKER_INFORMATION TRUE)

set(LINEARBUILD_OBJC_INFORMATION_LOADED 1)
