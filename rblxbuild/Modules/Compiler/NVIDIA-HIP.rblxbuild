include(Compiler/NVIDIA)
__compiler_nvidia_cxx_standards(HIP)
__compiler_nvidia_cuda_flags(HIP)

# The ROCm hip-lang rblxbuild package's device runtime library is not needed for NVIDIA GPUs.
set(_RBLXBUILD_HIP_DEVICE_RUNTIME_TARGET "")

set(RBLXBUILD_HIP_STANDARD_INCLUDE_DIRECTORIES "${RBLXBUILD_HIP_COMPILER_ROCM_ROOT}/include")

set(RBLXBUILD_HIP_LINK_EXECUTABLE
  "<RBLXBUILD_HIP_HOST_LINK_LAUNCHER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
set(RBLXBUILD_HIP_CREATE_SHARED_LIBRARY
  "<RBLXBUILD_HIP_HOST_LINK_LAUNCHER> <RBLXBUILD_SHARED_LIBRARY_HIP_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
set(RBLXBUILD_HIP_CREATE_SHARED_MODULE "${RBLXBUILD_HIP_CREATE_SHARED_LIBRARY}")
