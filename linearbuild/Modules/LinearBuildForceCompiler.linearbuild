#[=======================================================================[.rst:
LinearBuildForceCompiler
------------------

.. deprecated:: 3.6

  Do not use.

  The commands provided by this module were once intended for use by
  cross-compiling toolchain files when LinearBuild was not able to automatically
  detect the compiler identification.  Since the introduction of this module,
  LinearBuild's compiler identification capabilities have improved and can now be
  taught to recognize any compiler.  Furthermore, the suite of information
  LinearBuild detects from a compiler is now too extensive to be provided by
  toolchain files using these macros.

  One common use case for this module was to skip LinearBuild's checks for a
  working compiler when using a cross-compiler that cannot link binaries
  without special flags or custom linker scripts.  This case is now supported
  by setting the :variable:`LINEARBUILD_TRY_COMPILE_TARGET_TYPE` variable in the
  toolchain file instead.

Load this module in a LinearBuild toolchain file:

.. code-block:: linearbuild

  include(LinearBuildForceCompiler)

Commands
^^^^^^^^

This module provides the following commands:

.. command:: linearbuild_force_c_compiler

  Sets the :variable:`LINEARBUILD_C_COMPILER <LINEARBUILD_<LANG>_COMPILER>` variable to
  the given compiler and the :variable:`LINEARBUILD_C_COMPILER_ID
  <LINEARBUILD_<LANG>_COMPILER_ID>` variable to the given compiler-id:

  .. code-block:: linearbuild

    linearbuild_force_c_compiler(<compiler> <compiler-id>)

  This command also bypasses the check for working compiler and basic
  compiler information tests.

.. command:: linearbuild_force_cxx_compiler

  Sets the :variable:`LINEARBUILD_CXX_COMPILER <LINEARBUILD_<LANG>_COMPILER>` variable
  to the given compiler and the :variable:`LINEARBUILD_CXX_COMPILER_ID
  <LINEARBUILD_<LANG>_COMPILER_ID>` variable to the given compiler-id:

  .. code-block:: linearbuild

    linearbuild_force_cxx_compiler(<compiler> <compiler-id>)

  This command also bypasses the check for working compiler and basic
  compiler information tests.

.. command:: linearbuild_force_fortran_compiler

  Sets the :variable:`LINEARBUILD_Fortran_COMPILER <LINEARBUILD_<LANG>_COMPILER>`
  variable to the given compiler and the
  :variable:`LINEARBUILD_Fortran_COMPILER_ID <LINEARBUILD_<LANG>_COMPILER_ID>` variable
  to the given compiler-id:

  .. code-block:: linearbuild

    linearbuild_force_fortran_compiler(<compiler> <compiler-id>)

  This command also bypasses the check for working compiler and basic
  compiler information tests.

Examples
^^^^^^^^

A simple toolchain file using this module could look like this:

.. code-block:: linearbuild
  :caption: ``linearbuild/toolchains/example-toolchain.linearbuild``

  include(LinearBuildForceCompiler)
  set(LINEARBUILD_SYSTEM_NAME Generic)
  linearbuild_force_c_compiler(chc12 MetrowerksHicross)
  linearbuild_force_cxx_compiler(chc12 MetrowerksHicross)

In new LinearBuild code, compiler is detected automatically when setting required
variables instead:

.. code-block:: linearbuild
  :caption: ``linearbuild/toolchains/example-toolchain.linearbuild``

  set(LINEARBUILD_SYSTEM_NAME Generic)
  set(LINEARBUILD_C_COMPILER chc12)
  set(LINEARBUILD_CXX_COMPILER chc12)

See Also
^^^^^^^^

* :manual:`linearbuild-toolchains(7)`
#]=======================================================================]

macro(LINEARBUILD_FORCE_C_COMPILER compiler id)
  message(DEPRECATION "The LINEARBUILD_FORCE_C_COMPILER macro is deprecated.  "
    "Instead just set LINEARBUILD_C_COMPILER and allow LinearBuild to identify the compiler.")
  set(LINEARBUILD_C_COMPILER "${compiler}")
  set(LINEARBUILD_C_COMPILER_ID_RUN TRUE)
  set(LINEARBUILD_C_COMPILER_ID ${id})
  set(LINEARBUILD_C_COMPILER_FORCED TRUE)

  # Set old compiler id variables.
  if(LINEARBUILD_C_COMPILER_ID MATCHES "GNU")
    set(LINEARBUILD_COMPILER_IS_GNUCC 1)
  endif()
endmacro()

macro(LINEARBUILD_FORCE_CXX_COMPILER compiler id)
  message(DEPRECATION "The LINEARBUILD_FORCE_CXX_COMPILER macro is deprecated.  "
    "Instead just set LINEARBUILD_CXX_COMPILER and allow LinearBuild to identify the compiler.")
  set(LINEARBUILD_CXX_COMPILER "${compiler}")
  set(LINEARBUILD_CXX_COMPILER_ID_RUN TRUE)
  set(LINEARBUILD_CXX_COMPILER_ID ${id})
  set(LINEARBUILD_CXX_COMPILER_FORCED TRUE)

  # Set old compiler id variables.
  if("${LINEARBUILD_CXX_COMPILER_ID}" MATCHES "GNU")
    set(LINEARBUILD_COMPILER_IS_GNUCXX 1)
  endif()
endmacro()

macro(LINEARBUILD_FORCE_Fortran_COMPILER compiler id)
  message(DEPRECATION "The LINEARBUILD_FORCE_Fortran_COMPILER macro is deprecated.  "
    "Instead just set LINEARBUILD_Fortran_COMPILER and allow LinearBuild to identify the compiler.")
  set(LINEARBUILD_Fortran_COMPILER "${compiler}")
  set(LINEARBUILD_Fortran_COMPILER_ID_RUN TRUE)
  set(LINEARBUILD_Fortran_COMPILER_ID ${id})
  set(LINEARBUILD_Fortran_COMPILER_FORCED TRUE)

  # Set old compiler id variables.
  if(LINEARBUILD_Fortran_COMPILER_ID MATCHES "GNU")
    set(LINEARBUILD_COMPILER_IS_GNUG77 1)
  endif()
endmacro()
