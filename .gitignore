# Build directories
build/
build2/
build_old/
build-*/
cmake-build-*/
rblxbuild-build-*/

# Packaging output
/dist/
# A release published for the website to hand out (package-build.ps1 -Publish)
web/public/updates/

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.obj
*.o

# Build-tool generated files (either spelling)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
RBLXBuildCache.txt
RBLXBuildFiles/
rblxbuild_install.rblxbuild
*.vcxproj
*.vcxproj.filters
*.sln
*.slnx
*.user
*.suo
*.sdf
*.opensdf
*.db
*.VC.db

# IDE files
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Database files
*.db
*.sqlite
*.sqlite3
web/game-worlds/

# Environment/local config
.env
.env.*
!.env.example

# Logs
*.log
*.tlog
client_log.txt
client_error_log.txt

# Temporary files
*.tmp
*.temp
*.cache
*.bak
*.backup

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Game release (keep structure but ignore binaries)
GameRelease/Client/*.exe
GameRelease/Server/*.exe

# Auth tokens (sensitive)
auth_token.txt
avatar.txt
*.token

# ImGui config
imgui.ini

# Test images (optional - uncomment if you don't want to commit these)
# deer-mouse-2.jpg
# emoji-fudido.png
# face.png
# face_hex.txt


# The vendored RBLXAntiCheat links against prebuilt curl/brotli/zlib files that
# ship with its source. They are inputs to the linker, not build output, so they
# stay tracked even though *.lib and *.dll are ignored above.
!RBLXAntiCheat/Libs/*.lib
!RBLXAntiCheat/DLLs/*.dll

# Policies produced by AiTrainer
models/

# Runtime signing secret written by a development start
web/jwt-secret
