# Keep formatting here consistent with bootstrap script expectations.
if(BEOS)
  set(LINEARBUILD_BIN_DIR_DEFAULT "bin") # HAIKU
  set(LINEARBUILD_DATA_DIR_DEFAULT "share/linearbuild-${LinearBuild_VERSION_MAJOR}.${LinearBuild_VERSION_MINOR}") # HAIKU
  set(LINEARBUILD_DOC_DIR_DEFAULT "documentation/doc/linearbuild-${LinearBuild_VERSION_MAJOR}.${LinearBuild_VERSION_MINOR}") # HAIKU
  set(LINEARBUILD_INFO_DIR_DEFAULT "documentation/info") # HAIKU
  set(LINEARBUILD_MAN_DIR_DEFAULT "documentation/man") # HAIKU
  set(LINEARBUILD_XDGDATA_DIR_DEFAULT "share") # HAIKU
elseif(CYGWIN)
  set(LINEARBUILD_BIN_DIR_DEFAULT "bin") # CYGWIN
  set(LINEARBUILD_DATA_DIR_DEFAULT "share/linearbuild-${LinearBuild_VERSION}") # CYGWIN
  set(LINEARBUILD_DOC_DIR_DEFAULT "share/doc/linearbuild-${LinearBuild_VERSION}") # CYGWIN
  set(LINEARBUILD_INFO_DIR_DEFAULT "share/info") # CYGWIN
  set(LINEARBUILD_MAN_DIR_DEFAULT "share/man") # CYGWIN
  set(LINEARBUILD_XDGDATA_DIR_DEFAULT "share") # CYGWIN
else()
  set(LINEARBUILD_BIN_DIR_DEFAULT "bin") # OTHER
  set(LINEARBUILD_DATA_DIR_DEFAULT "share/linearbuild-${LinearBuild_VERSION_MAJOR}.${LinearBuild_VERSION_MINOR}") # OTHER
  set(LINEARBUILD_DOC_DIR_DEFAULT "doc/linearbuild-${LinearBuild_VERSION_MAJOR}.${LinearBuild_VERSION_MINOR}") # OTHER
  set(LINEARBUILD_INFO_DIR_DEFAULT "info") # OTHER
  set(LINEARBUILD_MAN_DIR_DEFAULT "man") # OTHER
  set(LINEARBUILD_XDGDATA_DIR_DEFAULT "share") # OTHER
endif()

set(LINEARBUILD_BIN_DIR_DESC "bin")
set(LINEARBUILD_DATA_DIR_DESC "data")
set(LINEARBUILD_DOC_DIR_DESC "docs")
set(LINEARBUILD_INFO_DIR_DESC "Info manual")
set(LINEARBUILD_MAN_DIR_DESC "man pages")
set(LINEARBUILD_XDGDATA_DIR_DESC "XDG specific files")

set(LinearBuild_INSTALL_INFIX "" CACHE STRING "")
set_property(CACHE LinearBuild_INSTALL_INFIX PROPERTY HELPSTRING
  "Intermediate installation path (empty by default)"
  )
mark_as_advanced(LinearBuild_INSTALL_INFIX)

if(APPLE AND BUILD_QtDialog)
  set(LinearBuild_INSTALL_APP_DIR "LinearBuild.app/Contents")
  set(LinearBuild_INSTALL_APP_DIR_SLASH "${LinearBuild_INSTALL_APP_DIR}/")
else()
  set(LinearBuild_INSTALL_APP_DIR ".")
  set(LinearBuild_INSTALL_APP_DIR_SLASH "")
endif()

foreach(v
    BIN
    DATA
    DOC
    INFO
    MAN
    XDGDATA
    )
  # Populate the cache with empty values so we know when the user sets them.
  set(LINEARBUILD_${v}_DIR "" CACHE STRING "")
  set_property(CACHE LINEARBUILD_${v}_DIR PROPERTY HELPSTRING
    "Location under install prefix for ${LINEARBUILD_${v}_DIR_DESC} (default \"${LINEARBUILD_${v}_DIR_DEFAULT}\")"
    )
  set_property(CACHE LINEARBUILD_${v}_DIR PROPERTY ADVANCED 1)

  # Use the default when the user did not set this variable.
  if(NOT LINEARBUILD_${v}_DIR)
    set(LINEARBUILD_${v}_DIR "${LinearBuild_INSTALL_INFIX}${LINEARBUILD_${v}_DIR_DEFAULT}")
  endif()
  # Remove leading slash to treat as relative to install prefix.
  string(REGEX REPLACE "^/" "" LINEARBUILD_${v}_DIR "${LINEARBUILD_${v}_DIR}")

  # Install under a base path within the prefix.
  set(LinearBuild_INSTALL_${v}_DIR "${LinearBuild_INSTALL_APP_DIR_SLASH}${LINEARBUILD_${v}_DIR}")
endforeach()
