include(Compiler/Clang)

__compiler_clang(HIP)
__compiler_clang_cxx_standards(HIP)

set(_RBLXBUILD_COMPILE_AS_HIP_FLAG "-x hip")
set(_RBLXBUILD_HIP_RDC_FLAG "-fgpu-rdc")

if(NOT "x${RBLXBUILD_HIP_SIMULATE_ID}" STREQUAL "xMSVC")
  set(RBLXBUILD_HIP_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")

  string(APPEND RBLXBUILD_HIP_FLAGS_DEBUG_INIT " -g")
endif()

set(RBLXBUILD_HIP_RUNTIME_LIBRARY_DEFAULT "SHARED")
set(RBLXBUILD_HIP_RUNTIME_LIBRARY_LINK_OPTIONS_STATIC  "")
set(RBLXBUILD_HIP_RUNTIME_LIBRARY_LINK_OPTIONS_SHARED  "")

# Populated by RBLXBuildHIPInformation.rblxbuild
set(RBLXBUILD_HIP_RUNTIME_LIBRARIES_STATIC "")
set(RBLXBUILD_HIP_RUNTIME_LIBRARIES_SHARED "")
