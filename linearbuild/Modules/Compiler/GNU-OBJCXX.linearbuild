include(Compiler/GNU)
__compiler_gnu(OBJCXX)
__compiler_gnu_cxx_standards(OBJCXX)

if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND LINEARBUILD_DEPFILE_FLAGS_OBJCXX)
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_OBJCXX_DEPFILE_FORMAT gcc)
  set(LINEARBUILD_OBJCXX_DEPENDS_USE_COMPILER TRUE)
endif()


if(NOT LINEARBUILD_OBJCXX_COMPILER_VERSION VERSION_LESS 4.2)
  set(LINEARBUILD_OBJCXX_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")
endif()
