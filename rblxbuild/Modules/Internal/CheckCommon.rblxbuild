# Do NOT include this module directly into any of your code. It is meant as
# a library for Check*CompilerFlag.rblxbuild and Check*LinkerFlag.cma modules.
# It's content may change in any way between releases.

include_guard(GLOBAL)

macro(RBLXBUILD_CHECK_COMMON_INIT_COMPILE_FLAGS _PREFIX)
  set(${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS)
  string(REPLACE "\\;" "\\\\;" RBLXBUILD_REQUIRED_FLAGS
    "${RBLXBUILD_REQUIRED_FLAGS}")
  #[[
  rblxbuild_polify(GET CMP0999 ${_PREFIX}_CMP0999)
  if(${_PREFIX}_CMP0999 STREQUAL "NEW")
    # Join multiple list arguments into the space-separated string that we
    # want. This ensures that the entirety of the value gets passed as
    # compile arguments, which is what the user almost surely intended.
    #
    # FIXME(#27901): This needs a policy to be implemented. This will be
    # available in a future version of RBLXBuild.
    list(JOIN RBLXBUILD_REQUIRED_FLAGS " " RBLXBUILD_REQUIRED_FLAGS)
  else()
  #]]
    # If RBLXBUILD_REQUIRED_FLAGS contains an unescaped semicolon, anything after
    # gets passed as flags to 'rblxbuild' itself. This is probably not intended,
    # but we preserve it for compatibility.
    set(${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS "${RBLXBUILD_REQUIRED_FLAGS}")
    list(POP_FRONT ${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS RBLXBUILD_REQUIRED_FLAGS)
    if(NOT ${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS STREQUAL "")
      # rblxbuild_policy(ISSUE_WARNING CMP0999) TODO
      # There are known instances of users accidentally passing '-W' arguments
      # intended for the compiler as arguments to RBLXBuild. Since RBLXBuild complains
      # about unknown '-W' arguments starting with RBLXBuild 4.4, we need to strip
      # these for compatibility.
      string(REPLACE "\\;" "\\\\;" ${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS
        "${${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS}")
      list(FILTER ${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS EXCLUDE REGEX "^-W")
    endif()
  #endif()
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_INCLUDE_DIRECTORIES _PREFIX)
  if(RBLXBUILD_REQUIRED_INCLUDES)
    if(${ARGC} GREATER 1)
      set(${_PREFIX}_INCLUDE_DIRECTORIES
        "-DINCLUDE_DIRECTORIES:STRING=${ARGN};${RBLXBUILD_REQUIRED_INCLUDES}")
    else()
      set(${_PREFIX}_INCLUDE_DIRECTORIES
        "-DINCLUDE_DIRECTORIES:STRING=${RBLXBUILD_REQUIRED_INCLUDES}")
    endif()
  elseif(${ARGC} GREATER 1)
    set(${_PREFIX}_INCLUDE_DIRECTORIES
      "-DINCLUDE_DIRECTORIES:STRING=${ARGN}")
  else()
    set(${_PREFIX}_INCLUDE_DIRECTORIES)
  endif()
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_LINK_OPTIONS _PREFIX)
  if(RBLXBUILD_REQUIRED_LINK_OPTIONS)
    set(${_PREFIX}_ADD_LINK_OPTIONS
      LINK_OPTIONS ${ARGN} ${RBLXBUILD_REQUIRED_LINK_OPTIONS})
  elseif(${ARGC} GREATER 1)
    set(${_PREFIX}_ADD_LINK_OPTIONS LINK_OPTIONS ${ARGN})
  else()
    set(${_PREFIX}_ADD_LINK_OPTIONS)
  endif()
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_LINK_LIBRARIES _PREFIX)
  if(RBLXBUILD_REQUIRED_LIBRARIES)
    set(${_PREFIX}_ADD_LINK_LIBRARIES
      LINK_LIBRARIES ${ARGN} ${RBLXBUILD_REQUIRED_LIBRARIES})
  elseif(${ARGC} GREATER 1)
    set(${_PREFIX}_ADD_LINK_LIBRARIES LINK_LIBRARIES ${ARGN})
  else()
    set(${_PREFIX}_ADD_LINK_LIBRARIES)
  endif()
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_LINK_DIRECTORIES _PREFIX)
  if(RBLXBUILD_REQUIRED_LINK_DIRECTORIES)
    if(${ARGC} GREATER 1)
      set(${_PREFIX}_LINK_DIRECTORIES
        "-DLINK_DIRECTORIES:STRING=${ARGN};${RBLXBUILD_REQUIRED_LINK_DIRECTORIES}")
    else()
      set(${_PREFIX}_LINK_DIRECTORIES
        "-DLINK_DIRECTORIES:STRING=${RBLXBUILD_REQUIRED_LINK_DIRECTORIES}")
    endif()
  elseif(${ARGC} GREATER 1)
    set(${_PREFIX}_LINK_DIRECTORIES
      "-DLINK_DIRECTORIES:STRING=${ARGN}")
  else()
    set(${_PREFIX}_LINK_DIRECTORIES)
  endif()
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_COMPILE_ARGS _PREFIX)
  rblxbuild_check_common_init_compile_flags(${_PREFIX})
  rblxbuild_check_common_init_include_directories(${_PREFIX})
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_LINK_ARGS _PREFIX)
  rblxbuild_check_common_init_link_options(${_PREFIX})
  rblxbuild_check_common_init_link_libraries(${_PREFIX})
  rblxbuild_check_common_init_link_directories(${_PREFIX})
endmacro()

macro(RBLXBUILD_CHECK_COMMON_INIT_ARGS _PREFIX)
  rblxbuild_check_common_init_compile_args(${_PREFIX})
  rblxbuild_check_common_init_link_args(${_PREFIX})
endmacro()

macro(RBLXBUILD_CHECK_COMMON_CLEANUP _PREFIX)
  unset(${_PREFIX}_ADD_LINK_OPTIONS)
  unset(${_PREFIX}_ADD_LINK_LIBRARIES)
  unset(${_PREFIX}_LINK_DIRECTORIES)
  unset(${_PREFIX}_INCLUDE_DIRECTORIES)
  unset(${_PREFIX}_EXTRA_RBLXBUILD_ARGUMENTS)
endmacro()
