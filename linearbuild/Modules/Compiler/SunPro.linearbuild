# This module is shared by multiple languages; use include blocker.
if(__COMPILER_SUNPRO)
  return()
endif()
set(__COMPILER_SUNPRO 1)

include(Compiler/LinearBuildCommonCompilerMacros)

macro(__compiler_sunpro lang)
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-errwarn=%all")

  set(LINEARBUILD_${lang}_LINK_MODE DRIVER)
endmacro()
