# This module is shared by multiple languages; use include blocker.
if(__COMPILER_XL)
  return()
endif()
set(__COMPILER_XL 1)

include(Compiler/LinearBuildCommonCompilerMacros)

macro(__compiler_xl lang)
  # Feature flags.
  set(LINEARBUILD_${lang}_VERBOSE_FLAG "-V")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIC "-qpic")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIE "-qpic")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-qhalt=i")
  set(LINEARBUILD_${lang}_RESPONSE_FILE_FLAG "-qoptfile=")
  set(LINEARBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "-qoptfile=")

  set(LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-qmkshrobj")

  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  set(LINEARBUILD_${lang}_LINK_MODE DRIVER)

  string(APPEND LINEARBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELEASE_INIT " -O")
  string(APPEND LINEARBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -O")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -g")
  set(LINEARBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<LINEARBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
  set(LINEARBUILD_${lang}_CREATE_ASSEMBLY_SOURCE     "<LINEARBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")

  set(LINEARBUILD_DEPFILE_FLAGS_${lang} "-MF <DEP_FILE> -qmakedep=gcc")
endmacro()
