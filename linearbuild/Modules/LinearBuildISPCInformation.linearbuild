if(UNIX)
  set(LINEARBUILD_ISPC_OUTPUT_EXTENSION .o)
else()
  set(LINEARBUILD_ISPC_OUTPUT_EXTENSION .obj)
endif()
set(LINEARBUILD_INCLUDE_FLAG_ISPC "-I")

# Load compiler-specific information.
if(LINEARBUILD_ISPC_COMPILER_ID)
  include(Compiler/${LINEARBUILD_ISPC_COMPILER_ID}-ISPC OPTIONAL)
endif()

# load the system- and compiler specific files
if(LINEARBUILD_ISPC_COMPILER_ID)
  # load a hardware specific file, mostly useful for embedded compilers
  if(LINEARBUILD_SYSTEM_PROCESSOR)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_ISPC_COMPILER_ID}-ISPC-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_ISPC_COMPILER_ID}-ISPC OPTIONAL)
endif()

# add the flags to the cache based
# on the initial values computed in the platform/*.linearbuild files
# use _INIT variables so that this only happens the first time
# and you can set these flags in the linearbuild cache
set(LINEARBUILD_ISPC_FLAGS_INIT "$ENV{ISPCFLAGS} ${LINEARBUILD_ISPC_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_ISPC_FLAGS "Flags used by the ISPC compiler")

if(LINEARBUILD_ISPC_STANDARD_LIBRARIES_INIT)
  set(LINEARBUILD_ISPC_STANDARD_LIBRARIES "${LINEARBUILD_ISPC_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all ISPC applications.")
  mark_as_advanced(LINEARBUILD_ISPC_STANDARD_LIBRARIES)
endif()

if(NOT LINEARBUILD_ISPC_COMPILER_LAUNCHER AND DEFINED ENV{LINEARBUILD_ISPC_COMPILER_LAUNCHER})
  set(LINEARBUILD_ISPC_COMPILER_LAUNCHER "$ENV{LINEARBUILD_ISPC_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for ISPC.")
endif()

include(LinearBuildCommonLanguageInclude)

# now define the following rules:
# LINEARBUILD_ISPC_COMPILE_OBJECT

# Create a static archive incrementally for large object file counts.
if(NOT DEFINED LINEARBUILD_ISPC_ARCHIVE_CREATE)
  set(LINEARBUILD_ISPC_ARCHIVE_CREATE "<LINEARBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_ISPC_ARCHIVE_APPEND)
  set(LINEARBUILD_ISPC_ARCHIVE_APPEND "<LINEARBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_ISPC_ARCHIVE_FINISH)
  set(LINEARBUILD_ISPC_ARCHIVE_FINISH "<LINEARBUILD_RANLIB> <TARGET>")
endif()

if(NOT LINEARBUILD_ISPC_COMPILE_OBJECT)
  set(LINEARBUILD_ISPC_COMPILE_OBJECT
    "<LINEARBUILD_ISPC_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> --emit-obj <SOURCE> -h <ISPC_HEADER>")
endif()

set(LINEARBUILD_ISPC_USE_LINKER_INFORMATION FALSE)

set(LINEARBUILD_ISPC_INFORMATION_LOADED 1)
