# file LICENSE.rst or https://rblxbuild.org/licensing for details.

if(UNIX)
  set(RBLXBUILD_ISPC_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_ISPC_OUTPUT_EXTENSION .obj)
endif()
set(RBLXBUILD_INCLUDE_FLAG_ISPC "-I")

# Load compiler-specific information.
if(RBLXBUILD_ISPC_COMPILER_ID)
  include(Compiler/${RBLXBUILD_ISPC_COMPILER_ID}-ISPC OPTIONAL)
endif()

# load the system- and compiler specific files
if(RBLXBUILD_ISPC_COMPILER_ID)
  # load a hardware specific file, mostly useful for embedded compilers
  if(RBLXBUILD_SYSTEM_PROCESSOR)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_ISPC_COMPILER_ID}-ISPC-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_ISPC_COMPILER_ID}-ISPC OPTIONAL)
endif()

# add the flags to the cache based
# on the initial values computed in the platform/*.rblxbuild files
# use _INIT variables so that this only happens the first time
# and you can set these flags in the rblxbuild cache
set(RBLXBUILD_ISPC_FLAGS_INIT "$ENV{ISPCFLAGS} ${RBLXBUILD_ISPC_FLAGS_INIT}")

rblxbuild_initialize_per_config_variable(RBLXBUILD_ISPC_FLAGS "Flags used by the ISPC compiler")

if(RBLXBUILD_ISPC_STANDARD_LIBRARIES_INIT)
  set(RBLXBUILD_ISPC_STANDARD_LIBRARIES "${RBLXBUILD_ISPC_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all ISPC applications.")
  mark_as_advanced(RBLXBUILD_ISPC_STANDARD_LIBRARIES)
endif()

if(NOT RBLXBUILD_ISPC_COMPILER_LAUNCHER AND DEFINED ENV{RBLXBUILD_ISPC_COMPILER_LAUNCHER})
  set(RBLXBUILD_ISPC_COMPILER_LAUNCHER "$ENV{RBLXBUILD_ISPC_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for ISPC.")
endif()

include(RBLXBuildCommonLanguageInclude)

# now define the following rules:
# RBLXBUILD_ISPC_COMPILE_OBJECT

# Create a static archive incrementally for large object file counts.
if(NOT DEFINED RBLXBUILD_ISPC_ARCHIVE_CREATE)
  set(RBLXBUILD_ISPC_ARCHIVE_CREATE "<RBLXBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_ISPC_ARCHIVE_APPEND)
  set(RBLXBUILD_ISPC_ARCHIVE_APPEND "<RBLXBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_ISPC_ARCHIVE_FINISH)
  set(RBLXBUILD_ISPC_ARCHIVE_FINISH "<RBLXBUILD_RANLIB> <TARGET>")
endif()

if(NOT RBLXBUILD_ISPC_COMPILE_OBJECT)
  set(RBLXBUILD_ISPC_COMPILE_OBJECT
    "<RBLXBUILD_ISPC_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> --emit-obj <SOURCE> -h <ISPC_HEADER>")
endif()

set(RBLXBUILD_ISPC_USE_LINKER_INFORMATION FALSE)

set(RBLXBUILD_ISPC_INFORMATION_LOADED 1)
