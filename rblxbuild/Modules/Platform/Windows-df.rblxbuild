# compiler support for fortran CVF compiler on windows

set(RBLXBUILD_WINDOWS_OBJECT_PATH 1)
set(RBLXBUILD_LIBRARY_PATH_FLAG "-LIBPATH:")
set(RBLXBUILD_LINK_LIBRARY_FLAG "")
set(WIN32 1)
if(RBLXBUILD_VERBOSE_MAKEFILE)
  set(RBLXBUILD_CL_NOLOGO)
else()
  set(RBLXBUILD_CL_NOLOGO "/nologo")
endif()

set(RBLXBUILD_Fortran_MODDIR_FLAG "-module:")

set(RBLXBUILD_Fortran_CREATE_SHARED_LIBRARY
 "link ${RBLXBUILD_CL_NOLOGO} ${RBLXBUILD_START_TEMP_FILE} /out:<TARGET> /dll <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES> ${RBLXBUILD_END_TEMP_FILE}")

set(RBLXBUILD_Fortran_CREATE_SHARED_MODULE ${RBLXBUILD_Fortran_CREATE_SHARED_LIBRARY})

# create a C++ static library
set(RBLXBUILD_Fortran_CREATE_STATIC_LIBRARY  "lib ${RBLXBUILD_CL_NOLOGO} <LINK_FLAGS> /out:<TARGET> <OBJECTS> ")

# compile a C++ file into an object file
set(RBLXBUILD_Fortran_COMPILE_OBJECT
    "<RBLXBUILD_Fortran_COMPILER> ${RBLXBUILD_START_TEMP_FILE} ${RBLXBUILD_CL_NOLOGO} /object:<OBJECT> <FLAGS> /compile_only <SOURCE>${RBLXBUILD_END_TEMP_FILE}")

set(RBLXBUILD_Fortran_LINK_EXECUTABLE
    "<RBLXBUILD_Fortran_COMPILER> ${RBLXBUILD_CL_NOLOGO} ${RBLXBUILD_START_TEMP_FILE} <FLAGS> /exe:<TARGET> <OBJECTS> /link <LINK_FLAGS> <LINK_LIBRARIES>${RBLXBUILD_END_TEMP_FILE}")

set(RBLXBUILD_Fortran_CREATE_WIN32_EXE /winapp)
set(RBLXBUILD_Fortran_CREATE_CONSOLE_EXE )

# does the compiler support pdbtype and is it the newer compiler

set(RBLXBUILD_BUILD_TYPE_INIT Debug)
set (RBLXBUILD_Fortran_FLAGS_INIT "")
set (RBLXBUILD_Fortran_FLAGS_DEBUG_INIT "/debug:full")
set (RBLXBUILD_Fortran_FLAGS_MINSIZEREL_INIT "/Optimize:2 /Define:NDEBUG")
set (RBLXBUILD_Fortran_FLAGS_RELEASE_INIT "/Optimize:1 /Define:NDEBUG")
set (RBLXBUILD_Fortran_FLAGS_RELWITHDEBINFO_INIT "/Optimize:1 /debug:full /Define:NDEBUG")

set (RBLXBUILD_Fortran_STANDARD_LIBRARIES_INIT "user32.lib")

# executable linker flags
set (RBLXBUILD_LINK_DEF_FILE_FLAG "/DEF:")
set (RBLXBUILD_EXE_LINKER_FLAGS_INIT " /INCREMENTAL:YES")
if (RBLXBUILD_COMPILER_SUPPORTS_PDBTYPE)
  set (RBLXBUILD_EXE_LINKER_FLAGS_DEBUG_INIT "/debug /pdbtype:sept")
  set (RBLXBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT "/debug /pdbtype:sept")
else ()
  set (RBLXBUILD_EXE_LINKER_FLAGS_DEBUG_INIT "/debug")
  set (RBLXBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT "/debug")
endif ()

set (RBLXBUILD_SHARED_LINKER_FLAGS_INIT ${RBLXBUILD_EXE_LINKER_FLAGS_INIT})
set (RBLXBUILD_SHARED_LINKER_FLAGS_DEBUG_INIT ${RBLXBUILD_EXE_LINKER_FLAGS_DEBUG_INIT})
set (RBLXBUILD_SHARED_LINKER_FLAGS_RELWITHDEBINFO_INIT ${RBLXBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT})
set (RBLXBUILD_MODULE_LINKER_FLAGS_INIT ${RBLXBUILD_SHARED_LINKER_FLAGS_INIT})
set (RBLXBUILD_MODULE_LINKER_FLAGS_DEBUG_INIT ${RBLXBUILD_SHARED_LINKER_FLAGS_DEBUG_INIT})
set (RBLXBUILD_MODULE_LINKER_FLAGS_RELWITHDEBINFO_INIT ${RBLXBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT})
