# This module is shared by multiple languages; use include blocker.
include_guard()

macro(__apple_compiler_pgi lang)
  set(RBLXBUILD_${lang}_OSX_COMPATIBILITY_VERSION_FLAG "-Wl,-compatibility_version,")
  set(RBLXBUILD_${lang}_OSX_CURRENT_VERSION_FLAG "-Wl,-current_version,")
  set(RBLXBUILD_SHARED_LIBRARY_SONAME_${lang}_FLAG "-Wl,-install_name")
endmacro()
