  set(LINEARBUILD_SIZEOF_VOID_P "${LINEARBUILD_Fortran_SIZEOF_DATA_PTR}")
endif()

if(LINEARBUILD_Fortran_COMPILER_ABI)
  set(LINEARBUILD_INTERNAL_PLATFORM_ABI "${LINEARBUILD_Fortran_COMPILER_ABI}")
endif()

if(LINEARBUILD_Fortran_LIBRARY_ARCHITECTURE)
  set(LINEARBUILD_LIBRARY_ARCHITECTURE "@LINEARBUILD_Fortran_LIBRARY_ARCHITECTURE@")
endif()

