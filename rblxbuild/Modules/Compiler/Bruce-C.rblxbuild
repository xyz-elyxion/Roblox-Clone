# Bruce C Compiler ignores "-g" flag and optimization cannot be
# enabled here (it is implemented only for 8086 target).
string(APPEND RBLXBUILD_C_FLAGS_INIT " -D__CLASSIC_C__")
string(APPEND RBLXBUILD_C_FLAGS_DEBUG_INIT " -g")
string(APPEND RBLXBUILD_C_FLAGS_MINSIZEREL_INIT " -DNDEBUG")
string(APPEND RBLXBUILD_C_FLAGS_RELEASE_INIT " -DNDEBUG")
string(APPEND RBLXBUILD_C_FLAGS_RELWITHDEBINFO_INIT " -g -DNDEBUG")

set(RBLXBUILD_C_LINKER_WRAPPER_FLAG "-X")

set(RBLXBUILD_C_LINK_MODE DRIVER)
