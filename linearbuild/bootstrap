  echo "#define LINEARBUILD_USE_SYSTEM_LIBRHASH" >> "${linearbuild_bootstrap_dir}/cmThirdParty.h.tmp"
fi
linearbuild_generate_file_tmp "${linearbuild_bootstrap_dir}/cmThirdParty.h" "${linearbuild_bootstrap_dir}/cmThirdParty.h.tmp"

# Generate Makefile
dep="cmConfigure.h ${cmsys_header_files}"
for h in "${linearbuild_source_dir}"/Source/*.hxx; do
  dep="${dep} `linearbuild_escape_artifact \"${h}\"`"
done
for h in "${linearbuild_source_dir}"/Source/*.h; do
  dep="${dep} `linearbuild_escape_artifact \"${h}\"`"
done
for h in ${LINEARBUILD_STD_CXX_HEADERS}; do
  dep="${dep} `linearbuild_escape_artifact \"${linearbuild_source_dir}\"`/Utilities/std/cm/${h}"
done
objs=""
for a in ${LINEARBUILD_CXX_SOURCES} ${LINEARBUILD_C_SOURCES} ${LINEARBUILD_STD_CXX_SOURCES} ${LexerParser_CXX_SOURCES} ${LexerParser_C_SOURCES} ${KWSYS_CXX_SOURCES} ${KWSYS_C_SOURCES}; do
  objs="${objs} ${a}.o"
done
if test "x${bootstrap_system_libuv}" = "x"; then
  for a in ${LIBUV_C_SOURCES}; do
    objs="${objs} uv-`linearbuild_obj ${a}`"
  done
fi
if test "x${bootstrap_system_librhash}" = "x"; then
  for a in ${LIBRHASH_C_SOURCES}; do
    objs="${objs} rhash-`linearbuild_obj ${a}`"
  done
fi
if test "x${bootstrap_system_jsoncpp}" = "x"; then
  for a in ${JSONCPP_CXX_SOURCES}; do
    objs="${objs} jsoncpp-`linearbuild_obj ${a}`"
  done
fi

libs=""

uv_c_flags=""
if ${linearbuild_system_mingw}; then
  uv_c_flags="${uv_c_flags} -DWIN32_LEAN_AND_MEAN -D_WIN32_WINNT=0x0600"
  libs="${libs} -ladvapi32 -ldbghelp -liphlpapi -lole32 -loleaut32 -lpsapi -lshell32 -luser32 -luserenv -luuid -lws2_32"
else
  case "${linearbuild_system}" in
    *AIX*)
      uv_c_flags="${uv_c_flags} -D_ALL_SOURCE -D_XOPEN_SOURCE=500 -D_LINUX_SOURCE_COMPAT"
      libs="${libs} -lperfstat"
      ;;
    *Darwin*)
      uv_c_flags="${uv_c_flags} -D_DARWIN_USE_64_BIT_INODE=1 -D_DARWIN_UNLIMITED_SELECT=1"
      ;;
    *HP-UX*)
      uv_c_flags="${uv_c_flags} -D_XOPEN_SOURCE_EXTENDED"
      ;;
    *Linux*)
      uv_c_flags="${uv_c_flags} -D_GNU_SOURCE"
      libs="${libs} -ldl -lrt"
      ;;
    *NetBSD*)
      libs="${libs} -lkvm"
      ;;
    *BSD*)
      ;;
    *SunOS*)
      uv_c_flags="${uv_c_flags} -D__EXTENSIONS__ -D_XOPEN_SOURCE=600"
      libs="${libs} -lkstat -lnsl -lsendfile -lsocket -lrt"
      ;;
    *QNX*)
      uv_c_flags="${uv_c_flags} -D_XOPEN_SOURCE=700"
      libs="${libs} -lsocket"
      ;;
  esac
fi
if test "x${bootstrap_system_libuv}" = "x"; then
  uv_c_flags="${uv_c_flags} `linearbuild_escape_shell "-I${linearbuild_source_dir}/Utilities/cmlibuv/include"`"
  if ${linearbuild_system_mingw}; then
    uv_c_flags="${uv_c_flags} `linearbuild_escape_shell "-I${linearbuild_source_dir}/Utilities/cmlibuv/src/win"`"
  else
    uv_c_flags="${uv_c_flags} `linearbuild_escape_shell "-I${linearbuild_source_dir}/Utilities/cmlibuv/src/unix"`"
  fi
  uv_c_flags="${uv_c_flags} `linearbuild_escape_shell "-I${linearbuild_source_dir}/Utilities/cmlibuv/src"`"
else
  if test `which pkg-config`; then
    use_uv_flags="`pkg-config --cflags libuv`"
    use_uv_ldflags="`pkg-config --libs libuv`"
    linearbuild_c_flags="${linearbuild_c_flags} ${use_uv_flags}"
    linearbuild_cxx_flags="${linearbuild_cxx_flags} ${use_uv_flags}"
  else
    use_uv_ldflags="-luv"
  fi
  libs="${libs} ${use_uv_ldflags}"
fi

librhash_c_flags="-DNO_IMPORT_EXPORT"
if test "x${bootstrap_system_librhash}" != "x"; then
  if test `which pkg-config`; then
    use_librhash_flags="`pkg-config --cflags librhash`"
    use_librhash_ldflags="`pkg-config --libs librhash`"
    linearbuild_c_flags="${linearbuild_c_flags} ${use_librhash_flags}"
    linearbuild_cxx_flags="${linearbuild_cxx_flags} ${use_librhash_flags}"
  else
    use_librhash_ldflags="-lrhash"
  fi
  libs="${libs} ${use_librhash_ldflags}"
fi

jsoncpp_cxx_flags=
if test "x${bootstrap_system_jsoncpp}" = "x"; then
  jsoncpp_cxx_flags="${jsoncpp_cxx_flags} `linearbuild_escape_shell "-I${linearbuild_source_dir}/Utilities/cmjsoncpp/include"`"
else
  if test `which pkg-config`; then
    use_jsoncpp_flags="`pkg-config --cflags jsoncpp`"
    use_jsoncpp_ldflags="`pkg-config --libs jsoncpp`"
    linearbuild_cxx_flags="${linearbuild_cxx_flags} ${use_jsoncpp_flags}"
  else
    use_jsoncpp_ldflags="-ljsoncpp"
  fi
  libs="${libs} ${use_jsoncpp_ldflags}"
fi

if test "x${linearbuild_ansi_cxx_flags}" != "x"; then
  linearbuild_cxx_flags="${linearbuild_ansi_cxx_flags} ${linearbuild_cxx_flags}"
fi

system_flags=''
case "${linearbuild_system}" in
  # Ensure filesystem access uses 64-bit offsets even on 32-bit hosts.
  *Linux*) system_flags='-D_FILE_OFFSET_BITS=64 -D_TIME_BITS=64' ;;
esac
if test "x${system_flags}" != "x"; then
  linearbuild_c_flags="${linearbuild_c_flags} ${system_flags}"
  linearbuild_cxx_flags="${linearbuild_cxx_flags} ${system_flags}"
fi

if test "x${linearbuild_c_flags}" != "x"; then
  linearbuild_c_flags="${linearbuild_c_flags} "
fi

if test "x${linearbuild_cxx_flags}" != "x"; then
  linearbuild_cxx_flags="${linearbuild_cxx_flags} "
fi

write_source_rule() {
  lang="$1"
  obj="$2"
  src="$3"
  src_flags="$4"

  if test "${lang}" = "c"; then
    ninja_rule=cc
    compiler="${linearbuild_c_compiler}"
    flags="${linearbuild_c_flags}"
  elif test "${lang}" = "cxx"; then
    ninja_rule=cxx
    compiler="${linearbuild_cxx_compiler}"
    flags="${linearbuild_cxx_flags}"
  fi

  if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
    echo "build ${obj} : ${ninja_rule} ${src} | ${dep}" >> "${linearbuild_bootstrap_dir}/build.ninja"
    echo "  srcflags = ${src_flags}" >> "${linearbuild_bootstrap_dir}/build.ninja"
  else
    echo "${obj} : ${src} ${dep}" >> "${linearbuild_bootstrap_dir}/Makefile"
    echo "${tab}${compiler} ${flags} ${src_flags} -c ${src} -o ${obj}" >> "${linearbuild_bootstrap_dir}/Makefile"
  fi
}

linearbuild_c_flags_String="-DKWSYS_STRING_C"
if ${linearbuild_system_mingw}; then
  linearbuild_c_flags_EncodingC="-DKWSYS_ENCODING_DEFAULT_CODEPAGE=CP_ACP"
  linearbuild_cxx_flags_EncodingCXX="${linearbuild_c_flags_EncodingC}"
  linearbuild_cxx_flags_cmProcessOutput="${linearbuild_c_flags_EncodingC}"
fi
linearbuild_cxx_flags_SystemTools="
  -DKWSYS_CXX_HAS_SETENV=${KWSYS_CXX_HAS_SETENV}
  -DKWSYS_CXX_HAS_UNSETENV=${KWSYS_CXX_HAS_UNSETENV}
  -DKWSYS_CXX_HAS_ENVIRON_IN_STDLIB_H=${KWSYS_CXX_HAS_ENVIRON_IN_STDLIB_H}
  -DKWSYS_CXX_HAS_UTIMENSAT=${KWSYS_CXX_HAS_UTIMENSAT}
  -DKWSYS_CXX_HAS_UTIMES=${KWSYS_CXX_HAS_UTIMES}
"
linearbuild_c_flags="${linearbuild_c_flags} \
  -DLINEARBUILD_BOOTSTRAP \
  -I`linearbuild_escape_shell \"${linearbuild_bootstrap_dir}\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Source\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Source/LexerParser\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Utilities\"`"
linearbuild_cxx_flags="${linearbuild_cxx_flags} \
  -DLINEARBUILD_BOOTSTRAP \
  ${linearbuild_have_cxx_features} \
  -I`linearbuild_escape_shell \"${linearbuild_bootstrap_dir}\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Source\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Source/LexerParser\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Utilities/std\"` \
  -I`linearbuild_escape_shell \"${linearbuild_source_dir}/Utilities\"`"
if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  echo "cc = ${linearbuild_c_compiler}" > "${linearbuild_bootstrap_dir}/build.ninja"
  echo "cxx = ${linearbuild_cxx_compiler}" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "cflags = ${linearbuild_c_flags}" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "cxxflags = ${linearbuild_cxx_flags}" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "ldflags = ${linearbuild_ld_flags}" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "rule cc" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "  command = \$cc \$cflags \$srcflags -c \$in -o \$out" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "rule cxx" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "  command = \$cxx \$cxxflags \$srcflags -c \$in -o \$out" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "rule link" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "  command = \$cxx \$ldflags \$cxxflags \$in \$libs -o \$out" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "build linearbuild: link ${objs}" >> "${linearbuild_bootstrap_dir}/build.ninja"
  echo "  libs = ${libs}" >> "${linearbuild_bootstrap_dir}/build.ninja"
else
  echo "linearbuild: ${objs}" > "${linearbuild_bootstrap_dir}/Makefile"
  echo "${tab}${linearbuild_cxx_compiler} ${linearbuild_ld_flags} ${linearbuild_cxx_flags} ${objs} ${libs} -o linearbuild" >> "${linearbuild_bootstrap_dir}/Makefile"
fi
for a in ${LINEARBUILD_CXX_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Source/${a}.cxx"`
  src_flags=`eval echo \\${linearbuild_cxx_flags_\${a}}`
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
for a in ${LINEARBUILD_C_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Source/${a}.c"`
  write_source_rule "c" "${a}.o" "${src}" ""
done
for a in ${LINEARBUILD_STD_CXX_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Utilities/std/cm/bits/${a}.cxx"`
  src_flags=`eval echo \\${linearbuild_cxx_flags_\${a}}`
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
for a in ${LexerParser_CXX_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Source/LexerParser/${a}.cxx"`
  src_flags=`eval echo \\${linearbuild_cxx_flags_\${a}}`
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
for a in ${LexerParser_C_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Source/LexerParser/${a}.c"`
  write_source_rule "c" "${a}.o" "${src}" ""
done
for a in ${KWSYS_C_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Source/kwsys/${a}.c"`
  src_flags="`eval echo \\${linearbuild_c_flags_\${a}}` -DKWSYS_NAMESPACE=cmsys"
  write_source_rule "c" "${a}.o" "${src}" "${src_flags}"
done
for a in ${KWSYS_CXX_SOURCES}; do
  src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Source/kwsys/${a}.cxx"`
  src_flags="`eval echo \\${linearbuild_cxx_flags_\${a}}` -DKWSYS_NAMESPACE=cmsys"
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
if test "x${bootstrap_system_libuv}" = "x"; then
  for a in ${LIBUV_C_SOURCES}; do
    src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Utilities/cmlibuv/${a}"`
    write_source_rule "c" "uv-`linearbuild_obj ${a}`" "${src}" "${uv_c_flags}"
  done
fi
if test "x${bootstrap_system_librhash}" = "x"; then
  for a in ${LIBRHASH_C_SOURCES}; do
    src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Utilities/cmlibrhash/${a}"`
    write_source_rule "c" "rhash-`linearbuild_obj ${a}`" "${src}" "${librhash_c_flags}"
  done
fi
if test "x${bootstrap_system_jsoncpp}" = "x"; then
  for a in ${JSONCPP_CXX_SOURCES}; do
    src=`linearbuild_escape_artifact "${linearbuild_source_dir}/Utilities/cmjsoncpp/${a}"`
    write_source_rule "cxx" "jsoncpp-`linearbuild_obj ${a}`" "${src}" "${jsoncpp_cxx_flags}"
  done
fi
if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  echo "
rule rebuild_cache
  command = cd \"${linearbuild_binary_dir}\" && \"${linearbuild_source_dir}/bootstrap\" --generator=\"${linearbuild_bootstrap_generator}\"
  generator = 1
build build.ninja : rebuild_cache
" >> "${linearbuild_bootstrap_dir}/build.ninja"
else
  echo "
rebuild_cache:
${tab}cd \"${linearbuild_binary_dir}\" && \"${linearbuild_source_dir}/bootstrap\" --generator=\"${linearbuild_bootstrap_generator}\"
" >> "${linearbuild_bootstrap_dir}/Makefile"
fi

# Write our default settings to Bootstrap${_cmk}/InitialCacheFlags.linearbuild.
echo '
# Generated by '"${linearbuild_source_dir}"'/bootstrap
# Default linearbuild settings.  These may be overridden any settings below.
set (LINEARBUILD_BUILD_TYPE "Release" CACHE STRING "Choose the type of build.") # not FORCE to preserve defaults specified elsewhere
set (LINEARBUILD_INSTALL_PREFIX "'"${linearbuild_prefix_dir}"'" CACHE PATH "Install path prefix, prepended onto install directories." FORCE)
set (LINEARBUILD_DOC_DIR "'"${linearbuild_doc_dir}"'" CACHE PATH "Install location for documentation (relative to prefix)." FORCE)
set (LINEARBUILD_MAN_DIR "'"${linearbuild_man_dir}"'" CACHE PATH "Install location for man pages (relative to prefix)." FORCE)
set (LINEARBUILD_BIN_DIR "'"${linearbuild_bin_dir}"'" CACHE PATH "Install location for binaries (relative to prefix)." FORCE)
set (LINEARBUILD_DATA_DIR "'"${linearbuild_data_dir}"'" CACHE PATH "Install location for data (relative to prefix)." FORCE)
set (LINEARBUILD_XDGDATA_DIR "'"${linearbuild_xdgdata_dir}"'" CACHE PATH "Install location for XDG specific files (relative to prefix)." FORCE)
' > "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"

# Add configuration settings given as command-line options.
if test "x${linearbuild_bootstrap_qt_gui}" != "x"; then
  echo '
set (BUILD_QtDialog '"${linearbuild_bootstrap_qt_gui}"' CACHE BOOL "Build Qt dialog for LinearBuild" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_bootstrap_qt_qmake}" != "x"; then
  echo '
set (QT_QMAKE_EXECUTABLE "'"${linearbuild_bootstrap_qt_qmake}"'" CACHE FILEPATH "Location of Qt qmake" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_bootstrap_debugger}" != "x"; then
  echo '
set (LinearBuild_ENABLE_DEBUGGER '"${linearbuild_bootstrap_debugger}"' CACHE BOOL "Enable LinearBuild debugger support" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_html_copybutton}" != "x"; then
  echo '
set (SPHINX_HTML_COPYBUTTON "'"${linearbuild_sphinx_html_copybutton}"'" CACHE BOOL "Build html help with the sphinx-copybutton extension" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_info}" != "x"; then
  echo '
set (SPHINX_INFO "'"${linearbuild_sphinx_info}"'" CACHE BOOL "Build Info manual with Sphinx" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_man}" != "x"; then
  echo '
set (SPHINX_MAN "'"${linearbuild_sphinx_man}"'" CACHE BOOL "Build man pages with Sphinx" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_html}" != "x"; then
  echo '
set (SPHINX_HTML "'"${linearbuild_sphinx_html}"'" CACHE BOOL "Build html help with Sphinx" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_qthelp}" != "x"; then
  echo '
set (SPHINX_QTHELP "'"${linearbuild_sphinx_qthelp}"'" CACHE BOOL "Build qch help with Sphinx" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_latexpdf}" != "x"; then
  echo '
set (SPHINX_LATEXPDF "'"${linearbuild_sphinx_latexpdf}"'" CACHE BOOL "Build PDF help with Sphinx using LaTeX" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_build}" != "x"; then
  echo '
set (SPHINX_EXECUTABLE "'"${linearbuild_sphinx_build}"'" CACHE FILEPATH "Location of Qt sphinx-build" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
if test "x${linearbuild_sphinx_flags}" != "x"; then
  echo '
set (SPHINX_FLAGS [==['"${linearbuild_sphinx_flags}"']==] CACHE STRING "Flags to pass to sphinx-build" FORCE)
' >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi

# Add user-specified settings.  Handle relative-path case for
# specification of linearbuild_init_file.
(
cd "${linearbuild_binary_dir}"
if test -f "${linearbuild_init_file}"; then
  cat "${linearbuild_init_file}" >> "${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild"
fi
)

echo "---------------------------------------------"

# Run make to build bootstrap linearbuild
if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  ninja_v=-v
else
  ninja_v=
fi
if test "x${linearbuild_parallel_make}" != "x"; then
  ${linearbuild_make_processor} ${linearbuild_make_flags} ${ninja_v}
else
  ${linearbuild_make_processor} ${ninja_v}
fi
RES=$?
if test "${RES}" -ne "0"; then
  linearbuild_error 9 "Problem while running ${linearbuild_make_processor}"
fi
cd "${linearbuild_binary_dir}"

# Set C, CXX, and MAKE environment variables, so that real real linearbuild will be
# build with same compiler and make
CC="${linearbuild_c_compiler}"
CXX="${linearbuild_cxx_compiler}"
MAKE="${linearbuild_make_processor}"
export CC
export CXX
export MAKE
export CFLAGS
export CXXFLAGS
export LDFLAGS

# Run bootstrap LinearBuild to configure real LinearBuild
linearbuild_options="-DLINEARBUILD_BOOTSTRAP=1"
if test -n "${linearbuild_verbose}"; then
  linearbuild_options="${linearbuild_options} -DLINEARBUILD_VERBOSE_MAKEFILE=1"
fi
"${linearbuild_bootstrap_dir}/linearbuild" "${linearbuild_source_dir}" "-C${linearbuild_bootstrap_dir}/InitialCacheFlags.linearbuild" "-G${linearbuild_bootstrap_generator}" ${linearbuild_options} ${linearbuild_bootstrap_system_libs} "$@"
RES=$?
if test "${RES}" -ne "0"; then
  linearbuild_error 11 "Problem while running initial LinearBuild"
fi

echo "---------------------------------------------"

# And we are done. Now just run make
echo "LinearBuild has bootstrapped.  Now run ${linearbuild_make_processor}."
