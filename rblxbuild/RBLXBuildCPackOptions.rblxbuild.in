# This file is configured at rblxbuild time, and loaded at cpack time.
# To pass variables to cpack from rblxbuild, they must be configured
# in this file.

if(CPACK_GENERATOR MATCHES "NSIS")
  set(CPACK_NSIS_INSTALL_ROOT "@CPACK_NSIS_INSTALL_ROOT@")

  # set the install/uninstall icon used for the installer itself
  # There is a bug in NSI that does not handle full unix paths properly.
  set(CPACK_NSIS_MUI_ICON "@RBLXBuild_SOURCE_DIR@/Utilities/Release\\RBLXBuildLogo.ico")
  set(CPACK_NSIS_MUI_UNIICON "@RBLXBuild_SOURCE_DIR@/Utilities/Release\\RBLXBuildLogo.ico")
  # set the package header icon for MUI
  set(CPACK_PACKAGE_ICON "@RBLXBuild_SOURCE_DIR@/Utilities/Release\\RBLXBuildInstall.bmp")
  # tell cpack to create links to the doc files
  set(CPACK_NSIS_MENU_LINKS
    "@RBLXBuild_INSTALL_DOC_DIR@/html/index.html" "RBLXBuild Documentation"
    "https://rblxbuild.org" "RBLXBuild Web Site"
    )
  # Use the icon from rblxbuild-gui for add-remove programs
  set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\rblxbuild-gui.exe")

  set(CPACK_NSIS_PACKAGE_NAME "@CPACK_NSIS_PACKAGE_NAME@")
  set(CPACK_NSIS_DISPLAY_NAME "@CPACK_NSIS_PACKAGE_NAME@, a cross-platform, open-source build system")
  set(CPACK_NSIS_HELP_LINK "https://rblxbuild.org")
  set(CPACK_NSIS_URL_INFO_ABOUT "http://www.kitware.com")
  set(CPACK_NSIS_CONTACT @CPACK_PACKAGE_CONTACT@)
  set(CPACK_NSIS_MODIFY_PATH ON)
endif()

# include the cpack options for qt dialog if they exist
# they might not if qt was not enabled for the build
include("@QT_DIALOG_CPACK_OPTIONS_FILE@" OPTIONAL)

if(CPACK_GENERATOR MATCHES "IFW")

  # Installer configuration
  set(CPACK_IFW_PACKAGE_TITLE "RBLXBuild Build Tool")
  set(CPACK_IFW_PRODUCT_URL "https://rblxbuild.org")
  @_CPACK_IFW_PACKAGE_ICON@
  set(CPACK_IFW_PACKAGE_WINDOW_ICON
    "@RBLXBuild_SOURCE_DIR@/Source/QtDialog/RBLXBuildSetup128.png")
  set(CPACK_IFW_PACKAGE_CONTROL_SCRIPT
    "@RBLXBuild_SOURCE_DIR@/Source/QtIFW/controlscript.qs")

  # Uninstaller configuration
  set(CPACK_IFW_PACKAGE_MAINTENANCE_TOOL_NAME "rblxbuild-maintenance")
  @_CPACK_IFW_COMPONENTS_CONFIGURATION@
  # Unspecified
  set(CPACK_IFW_COMPONENT_@_CPACK_IFW_COMPONENT_UNSPECIFIED_UNAME@_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  # Package configuration group
  set(CPACK_IFW_PACKAGE_GROUP RBLXBuild)

  # Group configuration

  # RBLXBuild
  set(CPACK_COMPONENT_GROUP_RBLXBUILD_DISPLAY_NAME
    "@CPACK_PACKAGE_NAME@")
  set(CPACK_COMPONENT_GROUP_RBLXBUILD_DESCRIPTION
    "@CPACK_PACKAGE_DESCRIPTION_SUMMARY@")
  @_CPACK_IFW_COMPONENT_GROUP_RBLXBUILD@

  # Tools
  set(CPACK_COMPONENT_GROUP_TOOLS_DISPLAY_NAME "Command-Line Tools")
  set(CPACK_COMPONENT_GROUP_TOOLS_DESCRIPTION
    "Command-Line Tools: rblxbuild, ctest and cpack")
  set(CPACK_COMPONENT_GROUP_TOOLS_PARENT_GROUP RBLXBuild)
  set(CPACK_IFW_COMPONENT_GROUP_TOOLS_PRIORITY 90)
  set(CPACK_IFW_COMPONENT_GROUP_TOOLS_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_RBLXBUILD_DISPLAY_NAME "rblxbuild")
  set(CPACK_COMPONENT_RBLXBUILD_DESCRIPTION
    "The \"rblxbuild\" executable is the RBLXBuild command-line interface")
  set(CPACK_COMPONENT_RBLXBUILD_REQUIRED TRUE)
  set(CPACK_COMPONENT_RBLXBUILD_GROUP Tools)
  set(CPACK_IFW_COMPONENT_RBLXBUILD_NAME "RBLXBuild")
  set(CPACK_IFW_COMPONENT_RBLXBUILD_PRIORITY 89)
  set(CPACK_IFW_COMPONENT_RBLXBUILD_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_CTEST_DISPLAY_NAME "ctest")
  set(CPACK_COMPONENT_CTEST_DESCRIPTION
    "The \"ctest\" executable is the RBLXBuild test driver program")
  set(CPACK_COMPONENT_CTEST_REQUIRED TRUE)
  set(CPACK_COMPONENT_CTEST_GROUP Tools)
  set(CPACK_IFW_COMPONENT_CTEST_NAME "CTest")
  set(CPACK_IFW_COMPONENT_CTEST_PRIORITY 88)
  set(CPACK_IFW_COMPONENT_CTEST_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_CPACK_DISPLAY_NAME "cpack")
  set(CPACK_COMPONENT_CPACK_DESCRIPTION
    "The \"cpack\" executable is the RBLXBuild packaging program")
  set(CPACK_COMPONENT_CPACK_REQUIRED TRUE)
  set(CPACK_COMPONENT_CPACK_GROUP Tools)
  set(CPACK_IFW_COMPONENT_CPACK_NAME "CPack")
  set(CPACK_IFW_COMPONENT_CPACK_PRIORITY 87)
  set(CPACK_IFW_COMPONENT_CPACK_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_CMCLDEPS_DISPLAY_NAME "cmcldeps")
  set(CPACK_COMPONENT_CMCLDEPS_DESCRIPTION
    "The \"cmcldeps\" executable is wrapper around \"cl\" program")
  set(CPACK_COMPONENT_CMCLDEPS_GROUP Tools)
  set(CPACK_IFW_COMPONENT_CMCLDEPS_NAME "CMClDeps")
  set(CPACK_IFW_COMPONENT_CMCLDEPS_PRIORITY 86)
  set(CPACK_IFW_COMPONENT_CMCLDEPS_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  # Dialogs
  set(CPACK_COMPONENT_GROUP_DIALOGS_DISPLAY_NAME "Interactive Dialogs")
  set(CPACK_COMPONENT_GROUP_DIALOGS_DESCRIPTION
    "Interactive Dialogs with Console and GUI interfaces")
  set(CPACK_COMPONENT_GROUP_DIALOGS_PARENT_GROUP RBLXBuild)
  set(CPACK_IFW_COMPONENT_GROUP_DIALOGS_PRIORITY 80)
  set(CPACK_IFW_COMPONENT_GROUP_DIALOGS_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_RBLXBUILD-GUI_DISPLAY_NAME "rblxbuild-gui")
  set(CPACK_COMPONENT_RBLXBUILD-GUI_GROUP Dialogs)
  set(CPACK_IFW_COMPONENT_RBLXBUILD-GUI_NAME "QtGUI")
  set(CPACK_IFW_COMPONENT_RBLXBUILD-GUI_SCRIPT
    "@RBLXBuild_BINARY_DIR@/RBLXBuild.Dialogs.QtGUI.qs")
  set(CPACK_IFW_COMPONENT_RBLXBUILD-GUI_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")
  @_CPACK_IFW_COMPONENT_RBLXBUILD-GUI_LICENSES@

  set(CPACK_COMPONENT_CRBLXBUILD_DISPLAY_NAME "crblxbuild")
  set(CPACK_COMPONENT_CRBLXBUILD_GROUP Dialogs)
  set(CPACK_IFW_COMPONENT_CRBLXBUILD_NAME "CursesGUI")
  set(CPACK_IFW_COMPONENT_CRBLXBUILD_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  # Documentation
  set(CPACK_COMPONENT_GROUP_DOCUMENTATION_DISPLAY_NAME "Documentation")
  set(CPACK_COMPONENT_GROUP_DOCUMENTATION_DESCRIPTION
    "RBLXBuild Documentation in different formats (html, man, qch)")
  set(CPACK_COMPONENT_GROUP_DOCUMENTATION_PARENT_GROUP RBLXBuild)
  set(CPACK_IFW_COMPONENT_GROUP_DOCUMENTATION_PRIORITY 60)
  set(CPACK_IFW_COMPONENT_GROUP_DOCUMENTATION_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_SPHINX-MAN_DISPLAY_NAME "man")
  set(CPACK_COMPONENT_SPHINX-MAN_GROUP Documentation)
  set(CPACK_COMPONENT_SPHINX-MAN_DISABLED TRUE)
  set(CPACK_IFW_COMPONENT_SPHINX-MAN_NAME "SphinxMan")
  set(CPACK_IFW_COMPONENT_SPHINX-MAN_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_SPHINX-HTML_DISPLAY_NAME "HTML")
  set(CPACK_COMPONENT_SPHINX-HTML_GROUP Documentation)
  set(CPACK_IFW_COMPONENT_SPHINX-HTML_NAME "SphinxHTML")
  set(CPACK_IFW_COMPONENT_SPHINX-HTML_SCRIPT
    "@RBLXBuild_BINARY_DIR@/RBLXBuild.Documentation.SphinxHTML.qs")
  set(CPACK_IFW_COMPONENT_SPHINX-HTML_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_SPHINX-SINGLEHTML_DISPLAY_NAME "Single HTML")
  set(CPACK_COMPONENT_SPHINX-SINGLEHTML_GROUP Documentation)
  set(CPACK_COMPONENT_SPHINX-SINGLEHTML_DISABLED TRUE)
  set(CPACK_IFW_COMPONENT_SPHINX-SINGLEHTML_NAME "SphinxSingleHTML")
  set(CPACK_IFW_COMPONENT_SPHINX-SINGLEHTML_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_SPHINX-QTHELP_DISPLAY_NAME "Qt Compressed Help")
  set(CPACK_COMPONENT_SPHINX-QTHELP_GROUP Documentation)
  set(CPACK_COMPONENT_SPHINX-QTHELP_DISABLED TRUE)
  set(CPACK_IFW_COMPONENT_SPHINX-QTHELP_NAME "SphinxQtHelp")
  set(CPACK_IFW_COMPONENT_SPHINX-QTHELP_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  # Developer Reference
  set(CPACK_COMPONENT_GROUP_DEVELOPERREFERENCE_DISPLAY_NAME "Developer Reference")
  set(CPACK_COMPONENT_GROUP_DEVELOPERREFERENCE_DESCRIPTION
    "RBLXBuild Reference in different formats (html, qch)")
  set(CPACK_COMPONENT_GROUP_DEVELOPERREFERENCE_PARENT_GROUP RBLXBuild)
  set(CPACK_IFW_COMPONENT_GROUP_DEVELOPERREFERENCE_PRIORITY 50)
  set(CPACK_IFW_COMPONENT_GROUP_DEVELOPERREFERENCE_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-HTML_DISPLAY_NAME "HTML")
  set(CPACK_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-HTML_GROUP DeveloperReference)
  set(CPACK_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-HTML_DISABLED TRUE)
  set(CPACK_IFW_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-HTML_NAME "HTML")
  set(CPACK_IFW_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-HTML_SCRIPT
    "@RBLXBuild_BINARY_DIR@/RBLXBuild.DeveloperReference.HTML.qs")
  set(CPACK_IFW_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-HTML_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

  set(CPACK_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-QTHELP_DISPLAY_NAME "Qt Compressed Help")
  set(CPACK_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-QTHELP_GROUP DeveloperReference)
  set(CPACK_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-QTHELP_DISABLED TRUE)
  set(CPACK_IFW_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-QTHELP_NAME "QtHelp")
  set(CPACK_IFW_COMPONENT_RBLXBUILD-DEVELOPER-REFERENCE-QTHELP_VERSION
    "@RBLXBuild_IFW_ROOT_COMPONENT_VERSION@")

endif()

if("${CPACK_GENERATOR}" STREQUAL "DragNDrop")
  set(CPACK_DMG_BACKGROUND_IMAGE
      "@RBLXBuild_SOURCE_DIR@/Packaging/RBLXBuildDMGBackground.tif")
  set(CPACK_DMG_DS_STORE_SETUP_SCRIPT
      "@RBLXBuild_SOURCE_DIR@/Packaging/RBLXBuildDMGSetup.scpt")
endif()

if("${CPACK_GENERATOR}" STREQUAL "WIX")
  set(CPACK_WIX_VERSION 4)
  set(CPACK_WIX_BUILD_EXTRA_FLAGS "")

  # Reset CPACK_PACKAGE_VERSION to deal with WiX restriction.
  # But the file names still use the full RBLXBuild_VERSION value:
  set(CPACK_PACKAGE_FILE_NAME
    "rblxbuild-@RBLXBuild_VERSION@-${CPACK_SYSTEM_NAME}")
  set(CPACK_SOURCE_PACKAGE_FILE_NAME
    "rblxbuild-@RBLXBuild_VERSION@")

  if(NOT CPACK_WIX_SIZEOF_VOID_P)
    set(CPACK_WIX_SIZEOF_VOID_P "@RBLXBUILD_SIZEOF_VOID_P@")
  endif()

  set(CPACK_PACKAGE_VERSION
    "@RBLXBuild_VERSION_MAJOR@.@RBLXBuild_VERSION_MINOR@")
  # WIX installers require at most a 4 component version number, where
  # each component is an integer between 0 and 65534 inclusive
  set(patch "@RBLXBuild_VERSION_PATCH@")
  if(patch MATCHES "^[0-9]+$" AND patch LESS 65535)
    set(CPACK_PACKAGE_VERSION "${CPACK_PACKAGE_VERSION}.${patch}")
  endif()

  set(CPACK_WIX_PROPERTY_ARPURLINFOABOUT "https://rblxbuild.org")

  set(CPACK_WIX_PROPERTY_ARPCONTACT "@CPACK_PACKAGE_CONTACT@")

  set(CPACK_WIX_PROPERTY_ARPCOMMENTS
    "RBLXBuild is a cross-platform, open-source build system."
  )

  set(CPACK_WIX_PRODUCT_ICON
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/RBLXBuildLogo.ico"
  )

  set_property(INSTALL "@RBLXBuild_INSTALL_DOC_DIR@/html/index.html" PROPERTY
    CPACK_START_MENU_SHORTCUTS "RBLXBuild Documentation"
  )

  set_property(INSTALL "rblxbuild.org.html" PROPERTY
    CPACK_START_MENU_SHORTCUTS "RBLXBuild Web Site"
  )

  list(APPEND CPACK_WIX_BUILD_EXTRA_FLAGS -dcl high)

  set(CPACK_WIX_UI_BANNER
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/ui_banner.jpg"
  )

  set(CPACK_WIX_UI_DIALOG
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/ui_dialog.jpg"
  )

  set(CPACK_WIX_EXTRA_SOURCES
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/install_dir.wxs"
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/options.wxs"
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/options_dlg.wxs"
  )

  set(_WIX_CUSTOM_ACTION_ENABLED "@RBLXBuild_BUILD_WIX_CUSTOM_ACTION@")
  if(_WIX_CUSTOM_ACTION_ENABLED)
    list(APPEND CPACK_WIX_EXTRA_SOURCES
      "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/rblxbuild_nsis_overwrite_dialog.wxs"
      )
    list(APPEND CPACK_WIX_BUILD_EXTRA_FLAGS -d CHECK_NSIS=1)

    set(_WIX_CUSTOM_ACTION_MULTI_CONFIG "@RBLXBuild_BUILD_WIX_CUSTOM_ACTION_MULTI_CONFIG@")
    if(_WIX_CUSTOM_ACTION_MULTI_CONFIG)
      if(CPACK_BUILD_CONFIG)
        set(_WIX_CUSTOM_ACTION_CONFIG "${CPACK_BUILD_CONFIG}")
      else()
        set(_WIX_CUSTOM_ACTION_CONFIG "Release")
      endif()

      list(APPEND CPACK_WIX_EXTRA_SOURCES
        "@RBLXBuild_BINARY_DIR@/Utilities/Release/WiX/custom_action_dll-${_WIX_CUSTOM_ACTION_CONFIG}.wxs")
    else()
      list(APPEND CPACK_WIX_EXTRA_SOURCES
        "@RBLXBuild_BINARY_DIR@/Utilities/Release/WiX/custom_action_dll.wxs")
    endif()
  endif()

  set(CPACK_WIX_UI_REF "RBLXBuildUI_InstallDir_$(sys.BUILDARCHSHORT)")

  set(CPACK_WIX_PATCH_FILE
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/patch_path_env.xml"
  )

  set(CPACK_WIX_TEMPLATE
    "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/WIX.template.in"
  )

  set(BUILD_QtDialog "@BUILD_QtDialog@")

  if(BUILD_QtDialog)
    list(APPEND CPACK_WIX_PATCH_FILE
      "@RBLXBuild_SOURCE_DIR@/Utilities/Release/WiX/patch_desktop_shortcut.xml"
      )
    list(APPEND CPACK_WIX_BUILD_EXTRA_FLAGS -d BUILD_QtDialog=1)
  endif()
endif()
