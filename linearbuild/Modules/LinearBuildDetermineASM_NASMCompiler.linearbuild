# Find the nasm assembler. yasm (http://www.tortall.net/projects/yasm/) is nasm compatible

set(LINEARBUILD_ASM_NASM_COMPILER_LIST nasm yasm)

if(NOT LINEARBUILD_ASM_NASM_COMPILER)
  set(_LINEARBUILD_ENV_VARX86 "ProgramFiles(x86)")
  set(_LINEARBUILD_ASM_NASM_COMPILER_PATHS
    "[HKEY_CURRENT_USER\\SOFTWARE\\nasm]"
    "$ENV{ProgramFiles}/NASM"
    "$ENV{${_LINEARBUILD_ENV_VARX86}}/NASM"
    "$ENV{LOCALAPPDATA}/NASM"
  )
  unset(_LINEARBUILD_ENV_VARX86)
endif()

# Load the generic DetermineASM compiler file with the DIALECT set properly:
set(ASM_DIALECT "_NASM")
include(LinearBuildDetermineASMCompiler)
set(ASM_DIALECT)
unset(_LINEARBUILD_ASM_NASM_COMPILER_PATHS)
