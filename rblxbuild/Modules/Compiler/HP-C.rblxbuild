set(RBLXBUILD_C_VERBOSE_FLAG "-v")

set(RBLXBUILD_C_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_C_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
set(RBLXBUILD_C_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_C_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")

set(RBLXBUILD_C_LINKER_WRAPPER_FLAG "-Wl,")
set(RBLXBUILD_C_LINKER_WRAPPER_FLAG_SEP ",")

set(RBLXBUILD_C_LINK_MODE DRIVER)
