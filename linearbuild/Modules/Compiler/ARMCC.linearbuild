if(_ARMCC_LINEARBUILD_LOADED)
  return()
endif()
set(_ARMCC_LINEARBUILD_LOADED TRUE)

# See ARM Compiler documentation at:
# http://infocenter.arm.com/help/topic/com.arm.doc.set.swdev/index.html

get_filename_component(_LINEARBUILD_C_TOOLCHAIN_LOCATION "${LINEARBUILD_C_COMPILER}" PATH)
get_filename_component(_LINEARBUILD_CXX_TOOLCHAIN_LOCATION "${LINEARBUILD_CXX_COMPILER}" PATH)

set(LINEARBUILD_EXECUTABLE_SUFFIX ".elf")

find_program(LINEARBUILD_ARMCC_LINKER armlink HINTS "${_LINEARBUILD_C_TOOLCHAIN_LOCATION}" "${_LINEARBUILD_CXX_TOOLCHAIN_LOCATION}" )
find_program(LINEARBUILD_ARMCC_AR     armar   HINTS "${_LINEARBUILD_C_TOOLCHAIN_LOCATION}" "${_LINEARBUILD_CXX_TOOLCHAIN_LOCATION}" )

set(LINEARBUILD_LINKER "${LINEARBUILD_ARMCC_LINKER}" CACHE FILEPATH "The ARMCC linker" FORCE)
mark_as_advanced(LINEARBUILD_ARMCC_LINKER)
set(LINEARBUILD_AR "${LINEARBUILD_ARMCC_AR}" CACHE FILEPATH "The ARMCC archiver" FORCE)
mark_as_advanced(LINEARBUILD_ARMCC_AR)

macro(__compiler_armcc lang)
  string(APPEND LINEARBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND LINEARBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND LINEARBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -Ospace -DNDEBUG")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELEASE_INIT " -Otime -DNDEBUG")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -g")

  set(LINEARBUILD_${lang}_OUTPUT_EXTENSION ".o")
  set(LINEARBUILD_${lang}_OUTPUT_EXTENSION_REPLACE 1)
  set(LINEARBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "--via=")

  set(LINEARBUILD_${lang}_LINK_MODE LINKER)

  set(LINEARBUILD_${lang}_LINK_EXECUTABLE      "<LINEARBUILD_LINKER> <LINK_FLAGS> <LINK_LIBRARIES> <OBJECTS> -o <TARGET> --list <TARGET_BASE>.map")
  set(LINEARBUILD_${lang}_CREATE_STATIC_LIBRARY  "<LINEARBUILD_AR> --create -cr <TARGET> <LINK_FLAGS> <OBJECTS>")

  set(LINEARBUILD_DEPFILE_FLAGS_${lang} "--depend=<DEP_FILE> --depend_single_line --no_depend_system_headers")

  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG "-Xlinker" " ")
endmacro()
