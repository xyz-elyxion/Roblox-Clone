set(LINEARBUILD_Java_COMPILER "@LINEARBUILD_Java_COMPILER@")
set(LINEARBUILD_Java_COMPILER_ARG1 "@LINEARBUILD_Java_COMPILER_ARG1@")
set(LINEARBUILD_Java_RUNTIME  "@LINEARBUILD_Java_RUNTIME@")
set(LINEARBUILD_Java_ARCHIVE  "@LINEARBUILD_Java_ARCHIVE@")
set(LINEARBUILD_Java_COMPILER_LOADED 1)

set(LINEARBUILD_Java_SOURCE_FILE_EXTENSIONS java)
set(LINEARBUILD_Java_LINKER_PREFERENCE 40)
set(LINEARBUILD_Java_OUTPUT_EXTENSION .class)
set(LINEARBUILD_Java_OUTPUT_EXTENSION_REPLACE 1)
set(LINEARBUILD_STATIC_LIBRARY_PREFIX_Java "")
set(LINEARBUILD_STATIC_LIBRARY_SUFFIX_Java ".jar")
set(LINEARBUILD_Java_COMPILER_ENV_VAR "JAVA_COMPILER")
