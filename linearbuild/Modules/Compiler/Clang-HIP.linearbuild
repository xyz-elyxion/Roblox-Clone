include(Compiler/Clang)

__compiler_clang(HIP)
__compiler_clang_cxx_standards(HIP)

set(_LINEARBUILD_COMPILE_AS_HIP_FLAG "-x hip")
set(_LINEARBUILD_HIP_RDC_FLAG "-fgpu-rdc")

if(NOT "x${LINEARBUILD_HIP_SIMULATE_ID}" STREQUAL "xMSVC")
  set(LINEARBUILD_HIP_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")

  string(APPEND LINEARBUILD_HIP_FLAGS_DEBUG_INIT " -g")
endif()

set(LINEARBUILD_HIP_RUNTIME_LIBRARY_DEFAULT "SHARED")
set(LINEARBUILD_HIP_RUNTIME_LIBRARY_LINK_OPTIONS_STATIC  "")
set(LINEARBUILD_HIP_RUNTIME_LIBRARY_LINK_OPTIONS_SHARED  "")

# Populated by LinearBuildHIPInformation.linearbuild
set(LINEARBUILD_HIP_RUNTIME_LIBRARIES_STATIC "")
set(LINEARBUILD_HIP_RUNTIME_LIBRARIES_SHARED "")
