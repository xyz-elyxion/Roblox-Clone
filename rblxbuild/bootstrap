  echo '
rule cc
  command = '"${rblxbuild_c_compiler}"' '"${rblxbuild_ld_flags} ${rblxbuild_c_flags}"' -o $out $in
build test: cc test.c
'>"build.ninja"
else
  echo '
test: test.c
'"${tab}${rblxbuild_c_compiler}"' '"${rblxbuild_ld_flags} ${rblxbuild_c_flags}"' -o test test.c
'>"Makefile"
