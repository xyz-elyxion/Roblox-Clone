if(NOT EXISTS "${LINEARBUILD_SYSROOT}/etc/centos-release")
  return()
endif()

# Get the first string only
file(
    STRINGS "${LINEARBUILD_SYSROOT}/etc/centos-release" LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT
    LIMIT_COUNT 1
  )

#
# Example:
#   CentOS release 6.10 (Final)
#
if(LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT MATCHES "CentOS release ([0-9\.]+) .*")

  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME CentOS)
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_PRETTY_NAME "${LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT}")
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID centos)
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID_LIKE rhel)
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION ${LINEARBUILD_MATCH_1})
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID ${LINEARBUILD_MATCH_1})

  list(
      APPEND LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_PRETTY_NAME
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID_LIKE
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID
    )

endif()

unset(LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT)
