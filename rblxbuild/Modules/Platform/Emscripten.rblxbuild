# Emscripten provides a combined toolchain file and platform module
# that predates RBLXBuild upstream support.  As a toolchain file it sets
# RBLXBUILD_SYSTEM_VERSION to 1 and points RBLXBUILD_MODULE_PATH to itself.
# Include it here to preserve its role as a platform module.
if(RBLXBUILD_SYSTEM_VERSION EQUAL 1 AND RBLXBUILD_MODULE_PATH)
  find_file(_EMSCRIPTEN_PLATFORM_MODULE NAMES "Platform/Emscripten.rblxbuild"
    NO_CACHE NO_DEFAULT_PATH NO_RBLXBUILD_FIND_ROOT_PATH PATHS ${RBLXBUILD_MODULE_PATH})
  if(_EMSCRIPTEN_PLATFORM_MODULE)
    include("${_EMSCRIPTEN_PLATFORM_MODULE}")
    unset(_EMSCRIPTEN_PLATFORM_MODULE)
    return()
  endif()
  unset(_EMSCRIPTEN_PLATFORM_MODULE)
endif()

set(RBLXBUILD_SHARED_LIBRARY_LINK_C_WITH_RUNTIME_PATH ON)

set(RBLXBUILD_SHARED_LIBRARY_SUFFIX ".wasm")
set(RBLXBUILD_EXECUTABLE_SUFFIX ".js")

set(RBLXBUILD_DL_LIBS "")
