# determine the compiler to use for Objective-C programs
# NOTE, a generator may set RBLXBUILD_OBJC_COMPILER before
# loading this file to force a compiler.
# use environment variable OBJC first if defined by user, next use
# the rblxbuild variable RBLXBUILD_GENERATOR_OBJC which can be defined by a generator
# as a default compiler
#
# Sets the following variables:
#   RBLXBUILD_OBJC_COMPILER
#   RBLXBUILD_AR
#   RBLXBUILD_RANLIB
#
# If not already set before, it also sets
#   _RBLXBUILD_TOOLCHAIN_PREFIX

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompiler.rblxbuild)

# Load system-specific compiler preferences for this language.
include(Platform/${RBLXBUILD_SYSTEM_NAME}-Determine-OBJC OPTIONAL)
include(Platform/${RBLXBUILD_SYSTEM_NAME}-OBJC OPTIONAL)
if(NOT RBLXBUILD_OBJC_COMPILER_NAMES)
  set(RBLXBUILD_OBJC_COMPILER_NAMES clang)
endif()

if("${RBLXBUILD_GENERATOR}" MATCHES "Xcode")
  set(RBLXBUILD_OBJC_COMPILER_XCODE_TYPE sourcecode.c.objc)
else()
  if(NOT RBLXBUILD_OBJC_COMPILER)
    set(RBLXBUILD_OBJC_COMPILER_INIT NOTFOUND)

    # prefer the environment variable OBJC or CC
    foreach(var OBJC CC)
      if($ENV{${var}} MATCHES ".+")
        get_filename_component(RBLXBUILD_OBJC_COMPILER_INIT $ENV{${var}} PROGRAM PROGRAM_ARGS RBLXBUILD_OBJC_FLAGS_ENV_INIT)
        if(RBLXBUILD_OBJC_FLAGS_ENV_INIT)
          set(RBLXBUILD_OBJC_COMPILER_ARG1 "${RBLXBUILD_OBJC_FLAGS_ENV_INIT}" CACHE STRING "Arguments to Objective-C compiler")
        endif()
        if(NOT EXISTS ${RBLXBUILD_OBJC_COMPILER_INIT})
          message(FATAL_ERROR "Could not find the compiler specified in the environment variable ${var}:\n  $ENV{${var}}")
        endif()
        break()
      endif()
    endforeach()

    # next try prefer the compiler specified by the generator
    if(RBLXBUILD_GENERATOR_OBJC)
      if(NOT RBLXBUILD_OBJC_COMPILER_INIT)
        set(RBLXBUILD_OBJC_COMPILER_INIT ${RBLXBUILD_GENERATOR_OBJC})
      endif()
    endif()

    # finally list compilers to try
    if(NOT RBLXBUILD_OBJC_COMPILER_INIT)
      set(RBLXBUILD_OBJC_COMPILER_LIST ${_RBLXBUILD_TOOLCHAIN_PREFIX}cc ${_RBLXBUILD_TOOLCHAIN_PREFIX}gcc clang)
    endif()

    _rblxbuild_find_compiler(OBJC)

  else()
    # we only get here if RBLXBUILD_OBJC_COMPILER was specified using -D or a pre-made RBLXBuildCache.txt
    # (e.g. via ctest) or set in RBLXBUILD_TOOLCHAIN_FILE
    # if RBLXBUILD_OBJC_COMPILER is a list, use the first item as
    # RBLXBUILD_OBJC_COMPILER and the rest as RBLXBUILD_OBJC_COMPILER_ARG1
    set(RBLXBUILD_OBJC_COMPILER_ARG1 "${RBLXBUILD_OBJC_COMPILER}")
    list(POP_FRONT RBLXBUILD_OBJC_COMPILER_ARG1 RBLXBUILD_OBJC_COMPILER)
    list(JOIN RBLXBUILD_OBJC_COMPILER_ARG1 " " RBLXBUILD_OBJC_COMPILER_ARG1)

    # if a compiler was specified by the user but without path,
    # now try to find it with the full path
    # if it is found, force it into the cache,
    # if not, don't overwrite the setting (which was given by the user) with "NOTFOUND"
    # if the C compiler already had a path, reuse it for searching the CXX compiler
    get_filename_component(_RBLXBUILD_USER_OBJC_COMPILER_PATH "${RBLXBUILD_OBJC_COMPILER}" PATH)
    if(NOT _RBLXBUILD_USER_OBJC_COMPILER_PATH)
      find_program(RBLXBUILD_OBJC_COMPILER_WITH_PATH NO_CACHE NAMES ${RBLXBUILD_OBJC_COMPILER})
      if(RBLXBUILD_OBJC_COMPILER_WITH_PATH)
        set(RBLXBUILD_OBJC_COMPILER ${RBLXBUILD_OBJC_COMPILER_WITH_PATH} CACHE STRING "Objective-C compiler" FORCE)
      endif()
    endif()
  endif()
  mark_as_advanced(RBLXBUILD_OBJC_COMPILER)

  # Each entry in this list is a set of extra flags to try
  # adding to the compile line to see if it helps produce
  # a valid identification file.
  set(RBLXBUILD_OBJC_COMPILER_ID_TEST_FLAGS_FIRST)
  set(RBLXBUILD_OBJC_COMPILER_ID_TEST_FLAGS
    # Try compiling to an object file only.
    "-c"

    )
endif()

# Build a small source file to identify the compiler.
if(NOT RBLXBUILD_OBJC_COMPILER_ID_RUN)
  set(RBLXBUILD_OBJC_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(RBLXBUILD_OBJC_COMPILER_ID)
  file(READ ${RBLXBUILD_ROOT}/Modules/RBLXBuildPlatformId.h.in
    RBLXBUILD_OBJC_COMPILER_ID_PLATFORM_CONTENT)

  # Match the link line from xcodebuild output of the form
  #  Ld ...
  #      ...
  #      /path/to/cc ...CompilerIdOBJC/...
  # to extract the compiler front-end for the language.
  set(RBLXBUILD_OBJC_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdOBJC/(\\./)?(CompilerIdOBJC.(framework|xctest|build/[^ \t\r\n]+)/)?CompilerIdOBJC[ \t\n\\\"]")
  set(RBLXBUILD_OBJC_COMPILER_ID_TOOL_MATCH_INDEX 2)

  include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerId.rblxbuild)
  RBLXBUILD_DETERMINE_COMPILER_ID(OBJC OBJCCFLAGS RBLXBuildOBJCCompilerId.m)

  # Set old compiler and platform id variables.
  if(RBLXBUILD_OBJC_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_COMPILER_IS_GNUOBJC 1)
  endif()
  if(RBLXBUILD_OBJC_COMPILER_ID STREQUAL "Clang")
    set(RBLXBUILD_COMPILER_IS_CLANGOBJC 1)
  endif()
endif()

if (NOT _RBLXBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_RBLXBUILD_TOOLCHAIN_LOCATION "${RBLXBUILD_OBJC_COMPILER}" PATH)
endif ()

# If we have a gcc cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-gcc, arm-elf-gcc or i586-mingw32msvc-gcc, optionally
# with a 3-component version number at the end (e.g. arm-eabi-gcc-4.5.2).
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gcc.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"
if (RBLXBUILD_CROSSCOMPILING  AND NOT _RBLXBUILD_TOOLCHAIN_PREFIX)

  if(RBLXBUILD_OBJC_COMPILER_ID MATCHES "GNU|Clang|QCC")
    get_filename_component(COMPILER_BASENAME "${RBLXBUILD_OBJC_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+-)(clang|g?cc)(-[0-9]+(\\.[0-9]+)*)?(-[^.]+)?(\\.exe)?$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
      set(_RBLXBUILD_COMPILER_SUFFIX ${RBLXBUILD_MATCH_5})
    elseif(RBLXBUILD_OBJC_COMPILER_ID MATCHES "Clang")
      if(RBLXBUILD_OBJC_COMPILER_TARGET)
        set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_OBJC_COMPILER_TARGET}-)
      endif()
    elseif(COMPILER_BASENAME MATCHES "qcc(\\.exe)?$")
      if(RBLXBUILD_OBJC_COMPILER_TARGET MATCHES "gcc_nto([a-z0-9]+_[0-9]+|[^_le]+)(le)?")
        set(_RBLXBUILD_TOOLCHAIN_PREFIX nto${RBLXBUILD_MATCH_1}-)
      endif()
    endif ()

    # if "llvm-" is part of the prefix, remove it, since llvm doesn't have its own binutils
    # but uses the regular ar, objcopy, etc. (instead of llvm-objcopy etc.)
    if ("${_RBLXBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
    endif ()
  endif()

endif ()

set(_RBLXBUILD_PROCESSING_LANGUAGE "OBJC")
include(RBLXBuildFindBinUtils)
include(Compiler/${RBLXBUILD_OBJC_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_RBLXBUILD_PROCESSING_LANGUAGE)

if(RBLXBUILD_OBJC_XCODE_ARCHS)
  set(SET_RBLXBUILD_XCODE_ARCHS
    "set(RBLXBUILD_XCODE_ARCHS \"${RBLXBUILD_OBJC_XCODE_ARCHS}\")")
endif()

# configure variables set in this file for fast reload later on
configure_file(${RBLXBUILD_ROOT}/Modules/RBLXBuildOBJCCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildOBJCCompiler.rblxbuild
  @ONLY
  )
set(RBLXBUILD_OBJC_COMPILER_ENV_VAR "OBJC")
