# compiler support for fortran CVF compiler on windows

set(LINEARBUILD_WINDOWS_OBJECT_PATH 1)
set(LINEARBUILD_LIBRARY_PATH_FLAG "-LIBPATH:")
set(LINEARBUILD_LINK_LIBRARY_FLAG "")
set(WIN32 1)
if(LINEARBUILD_VERBOSE_MAKEFILE)
  set(LINEARBUILD_CL_NOLOGO)
else()
  set(LINEARBUILD_CL_NOLOGO "/nologo")
endif()

set(LINEARBUILD_Fortran_MODDIR_FLAG "-module:")

set(LINEARBUILD_Fortran_CREATE_SHARED_LIBRARY
 "link ${LINEARBUILD_CL_NOLOGO} ${LINEARBUILD_START_TEMP_FILE} /out:<TARGET> /dll <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES> ${LINEARBUILD_END_TEMP_FILE}")

set(LINEARBUILD_Fortran_CREATE_SHARED_MODULE ${LINEARBUILD_Fortran_CREATE_SHARED_LIBRARY})

# create a C++ static library
set(LINEARBUILD_Fortran_CREATE_STATIC_LIBRARY  "lib ${LINEARBUILD_CL_NOLOGO} <LINK_FLAGS> /out:<TARGET> <OBJECTS> ")

# compile a C++ file into an object file
set(LINEARBUILD_Fortran_COMPILE_OBJECT
    "<LINEARBUILD_Fortran_COMPILER> ${LINEARBUILD_START_TEMP_FILE} ${LINEARBUILD_CL_NOLOGO} /object:<OBJECT> <FLAGS> /compile_only <SOURCE>${LINEARBUILD_END_TEMP_FILE}")

set(LINEARBUILD_Fortran_LINK_EXECUTABLE
    "<LINEARBUILD_Fortran_COMPILER> ${LINEARBUILD_CL_NOLOGO} ${LINEARBUILD_START_TEMP_FILE} <FLAGS> /exe:<TARGET> <OBJECTS> /link <LINK_FLAGS> <LINK_LIBRARIES>${LINEARBUILD_END_TEMP_FILE}")

set(LINEARBUILD_Fortran_CREATE_WIN32_EXE /winapp)
set(LINEARBUILD_Fortran_CREATE_CONSOLE_EXE )

# does the compiler support pdbtype and is it the newer compiler

set(LINEARBUILD_BUILD_TYPE_INIT Debug)
set (LINEARBUILD_Fortran_FLAGS_INIT "")
set (LINEARBUILD_Fortran_FLAGS_DEBUG_INIT "/debug:full")
set (LINEARBUILD_Fortran_FLAGS_MINSIZEREL_INIT "/Optimize:2 /Define:NDEBUG")
set (LINEARBUILD_Fortran_FLAGS_RELEASE_INIT "/Optimize:1 /Define:NDEBUG")
set (LINEARBUILD_Fortran_FLAGS_RELWITHDEBINFO_INIT "/Optimize:1 /debug:full /Define:NDEBUG")

set (LINEARBUILD_Fortran_STANDARD_LIBRARIES_INIT "user32.lib")

# executable linker flags
set (LINEARBUILD_LINK_DEF_FILE_FLAG "/DEF:")
set (LINEARBUILD_EXE_LINKER_FLAGS_INIT " /INCREMENTAL:YES")
if (LINEARBUILD_COMPILER_SUPPORTS_PDBTYPE)
  set (LINEARBUILD_EXE_LINKER_FLAGS_DEBUG_INIT "/debug /pdbtype:sept")
  set (LINEARBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT "/debug /pdbtype:sept")
else ()
  set (LINEARBUILD_EXE_LINKER_FLAGS_DEBUG_INIT "/debug")
  set (LINEARBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT "/debug")
endif ()

set (LINEARBUILD_SHARED_LINKER_FLAGS_INIT ${LINEARBUILD_EXE_LINKER_FLAGS_INIT})
set (LINEARBUILD_SHARED_LINKER_FLAGS_DEBUG_INIT ${LINEARBUILD_EXE_LINKER_FLAGS_DEBUG_INIT})
set (LINEARBUILD_SHARED_LINKER_FLAGS_RELWITHDEBINFO_INIT ${LINEARBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT})
set (LINEARBUILD_MODULE_LINKER_FLAGS_INIT ${LINEARBUILD_SHARED_LINKER_FLAGS_INIT})
set (LINEARBUILD_MODULE_LINKER_FLAGS_DEBUG_INIT ${LINEARBUILD_SHARED_LINKER_FLAGS_DEBUG_INIT})
set (LINEARBUILD_MODULE_LINKER_FLAGS_RELWITHDEBINFO_INIT ${LINEARBUILD_EXE_LINKER_FLAGS_RELWITHDEBINFO_INIT})
