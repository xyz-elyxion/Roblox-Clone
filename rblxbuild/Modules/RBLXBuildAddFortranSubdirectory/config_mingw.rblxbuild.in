set(ENV{PATH} "@MINGW_PATH@\;$ENV{PATH}")
set(RBLXBUILD_COMMAND_LINE "@ARGS_RBLXBUILD_COMMAND_LINE@")
execute_process(
  COMMAND "@RBLXBUILD_COMMAND@" "-GMinGW Makefiles"
  -DRBLXBUILD_Fortran_COMPILER:PATH=@MINGW_GFORTRAN@
  -DBUILD_SHARED_LIBS=ON
  -DRBLXBUILD_GNUtoMS=ON
  ${RBLXBUILD_COMMAND_LINE}
  "@source_dir@"
  COMMAND_ERROR_IS_FATAL ANY)
