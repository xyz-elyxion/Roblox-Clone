set(LINEARBUILD_Fortran_COMPILER_LOADED 1)
set(LINEARBUILD_Fortran_COMPILER_WORKS @LINEARBUILD_Fortran_COMPILER_WORKS@)
set(LINEARBUILD_Fortran_ABI_COMPILED @LINEARBUILD_Fortran_ABI_COMPILED@)

set(LINEARBUILD_Fortran_COMPILER_ENV_VAR "FC")

set(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90 @LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90@)

set(LINEARBUILD_Fortran_COMPILER_ID_RUN 1)
set(LINEARBUILD_Fortran_SOURCE_FILE_EXTENSIONS f;F;fpp;FPP;f77;F77;f90;F90;for;For;FOR;f95;F95;f03;F03;f08;F08@LINEARBUILD_Fortran_VENDOR_SOURCE_FILE_EXTENSIONS@)
set(LINEARBUILD_Fortran_IGNORE_EXTENSIONS h;H;o;O;obj;OBJ;def;DEF;rc;RC)
set(LINEARBUILD_Fortran_LINKER_PREFERENCE 20)
set(LINEARBUILD_Fortran_LINKER_DEPFILE_SUPPORTED @LINEARBUILD_Fortran_LINKER_DEPFILE_SUPPORTED@)
set(LINEARBUILD_LINKER_PUSHPOP_STATE_SUPPORTED @LINEARBUILD_LINKER_PUSHPOP_STATE_SUPPORTED@)
set(LINEARBUILD_Fortran_LINKER_PUSHPOP_STATE_SUPPORTED @LINEARBUILD_Fortran_LINKER_PUSHPOP_STATE_SUPPORTED@)
if(UNIX)
  set(LINEARBUILD_Fortran_OUTPUT_EXTENSION .o)
else()
  set(LINEARBUILD_Fortran_OUTPUT_EXTENSION .obj)
endif()

# Save compiler ABI information.
set(LINEARBUILD_Fortran_SIZEOF_DATA_PTR "@LINEARBUILD_Fortran_SIZEOF_DATA_PTR@")
