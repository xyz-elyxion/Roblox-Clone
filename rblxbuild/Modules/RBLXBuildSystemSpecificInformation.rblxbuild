# This file is included by cmGlobalGenerator::EnableLanguage.
# It is included after the compiler has been determined, so
# we know things like the compiler name and if the compiler is gnu.

function(_rblxbuild_record_install_prefix )
  set(_RBLXBUILD_SYSTEM_PREFIX_PATH_INSTALL_PREFIX_VALUE "${RBLXBUILD_INSTALL_PREFIX}" PARENT_SCOPE)
  set(_RBLXBUILD_SYSTEM_PREFIX_PATH_STAGING_PREFIX_VALUE "${RBLXBUILD_STAGING_PREFIX}" PARENT_SCOPE)
  set(icount 0)
  set(scount 0)
  foreach(value IN LISTS RBLXBUILD_SYSTEM_PREFIX_PATH)
    if(value STREQUAL RBLXBUILD_INSTALL_PREFIX)
      math(EXPR icount "${icount}+1")
    endif()
    if(value STREQUAL RBLXBUILD_STAGING_PREFIX)
      math(EXPR scount "${scount}+1")
    endif()
  endforeach()
  set(_RBLXBUILD_SYSTEM_PREFIX_PATH_INSTALL_PREFIX_COUNT "${icount}" PARENT_SCOPE)
  set(_RBLXBUILD_SYSTEM_PREFIX_PATH_STAGING_PREFIX_COUNT "${scount}" PARENT_SCOPE)
endfunction()

# include Generic system information
include(RBLXBuildGenericSystem)

# 2. now include SystemName.rblxbuild file to set the system specific information
set(RBLXBUILD_SYSTEM_INFO_FILE Platform/${RBLXBUILD_SYSTEM_NAME})

include(${RBLXBUILD_SYSTEM_INFO_FILE} OPTIONAL RESULT_VARIABLE _INCLUDED_SYSTEM_INFO_FILE)

if(NOT _INCLUDED_SYSTEM_INFO_FILE)
  message("System is unknown to rblxbuild, create:\n${RBLXBUILD_SYSTEM_INFO_FILE}"
          " to use this system, please post your config file on "
          "discourse.rblxbuild.org so it can be added to rblxbuild")
  if(EXISTS ${RBLXBUILD_BINARY_DIR}/RBLXBuildCache.txt)
    configure_file(${RBLXBUILD_BINARY_DIR}/RBLXBuildCache.txt
                   ${RBLXBUILD_BINARY_DIR}/CopyOfRBLXBuildCache.txt COPYONLY)
    message("Your RBLXBuildCache.txt file was copied to CopyOfRBLXBuildCache.txt. "
            "Please post that file on discourse.rblxbuild.org.")
  endif()
endif()

# optionally include a file which can do extra-generator specific things, e.g.
# RBLXBuildFindEclipseCDT4.rblxbuild asks gcc for the system include dirs for the Eclipse CDT4 generator
if(RBLXBUILD_EXTRA_GENERATOR)
  string(REPLACE " " "" _RBLXBUILD_EXTRA_GENERATOR_NO_SPACES ${RBLXBUILD_EXTRA_GENERATOR} )
  include("RBLXBuildFind${_RBLXBUILD_EXTRA_GENERATOR_NO_SPACES}" OPTIONAL)
endif()


# for most systems a module is the same as a shared library
# so unless the variable RBLXBUILD_MODULE_EXISTS is set just
# copy the values from the LIBRARY variables
# this has to be done after the system information has been loaded
if(NOT RBLXBUILD_MODULE_EXISTS)
  set(RBLXBUILD_SHARED_MODULE_PREFIX "${RBLXBUILD_SHARED_LIBRARY_PREFIX}")
  set(RBLXBUILD_SHARED_MODULE_SUFFIX "${RBLXBUILD_SHARED_LIBRARY_SUFFIX}")
endif()


set(RBLXBUILD_SYSTEM_SPECIFIC_INFORMATION_LOADED 1)
