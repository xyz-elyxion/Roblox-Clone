include(Compiler/Clang)
__compiler_clang(OBJC)

if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND LINEARBUILD_DEPFILE_FLAGS_OBJC)
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_OBJC_DEPFILE_FORMAT gcc)
  set(LINEARBUILD_OBJC_DEPENDS_USE_COMPILER TRUE)
endif()


if(NOT LINEARBUILD_OBJC_COMPILER_VERSION VERSION_LESS 3.4)
  set(LINEARBUILD_OBJC90_STANDARD_COMPILE_OPTION "-std=c90")
  set(LINEARBUILD_OBJC90_EXTENSION_COMPILE_OPTION "-std=gnu90")
  set(LINEARBUILD_OBJC90_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_OBJC99_STANDARD_COMPILE_OPTION "-std=c99")
  set(LINEARBUILD_OBJC99_EXTENSION_COMPILE_OPTION "-std=gnu99")
  set(LINEARBUILD_OBJC99_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_OBJC11_STANDARD_COMPILE_OPTION "-std=c11")
  set(LINEARBUILD_OBJC11_EXTENSION_COMPILE_OPTION "-std=gnu11")
  set(LINEARBUILD_OBJC11_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_OBJC_STANDARD_LATEST 11)
endif()

if(NOT LINEARBUILD_OBJC_COMPILER_VERSION VERSION_LESS 6.0)
  set(LINEARBUILD_OBJC17_STANDARD_COMPILE_OPTION "-std=c17")
  set(LINEARBUILD_OBJC17_EXTENSION_COMPILE_OPTION "-std=gnu17")
  set(LINEARBUILD_OBJC17_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_OBJC_STANDARD_LATEST 17)
endif()

if(NOT LINEARBUILD_OBJC_COMPILER_VERSION VERSION_LESS 9.0)
  set(LINEARBUILD_OBJC23_STANDARD_COMPILE_OPTION "-std=c2x")
  set(LINEARBUILD_OBJC23_EXTENSION_COMPILE_OPTION "-std=gnu2x")
  set(LINEARBUILD_OBJC23_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_OBJC_STANDARD_LATEST 23)
endif()

__compiler_check_default_language_standard(OBJC 3.4 99 3.6 11)
