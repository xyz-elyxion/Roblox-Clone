include(LinearBuildLanguageInformation)

if(UNIX)
  set(LINEARBUILD_SYCL_OUTPUT_EXTENSION .o)
else()
  set(LINEARBUILD_SYCL_OUTPUT_EXTENSION .obj)
endif()

set(_INCLUDED_FILE 0)

if(LINEARBUILD_SYCL_COMPILER_ID)
  include(Compiler/${LINEARBUILD_SYCL_COMPILER_ID}-SYCL OPTIONAL)
endif()

set(LINEARBUILD_BASE_NAME)
get_filename_component(LINEARBUILD_BASE_NAME "${LINEARBUILD_SYCL_COMPILER}" NAME_WE)
if(LINEARBUILD_SYSTEM_PROCESSOR)
  if(LINEARBUILD_SYCL_COMPILER_ID)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_SYCL_COMPILER_ID}-SYCL-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
  endif()
  if(NOT _INCLUDED_FILE)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME}-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
endif()

if(LINEARBUILD_SYCL_COMPILER_ID)
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_SYCL_COMPILER_ID}-SYCL OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()
if(NOT _INCLUDED_FILE)
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()

if(LINEARBUILD_SYCL_COMPILER_WRAPPER)
  __linearbuild_include_compiler_wrapper(SYCL)
endif()

if(NOT _INCLUDED_FILE)
  include(Platform/${LINEARBUILD_SYSTEM_NAME} OPTIONAL)
endif()

if(LINEARBUILD_GENERATOR MATCHES "Visual Studio")
  if(NOT LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    message(FATAL_ERROR "Visual Studio SYCL support requires an MSVC-like compiler frontend.")
  endif()
endif()

if(LINEARBUILD_SYCL_SIZEOF_DATA_PTR)
  foreach(f IN LISTS LINEARBUILD_SYCL_ABI_FILES)
    include(${f})
  endforeach()
  unset(LINEARBUILD_SYCL_ABI_FILES)
endif()

if(_LINEARBUILD_SYCL_REQUIRED_FLAG AND LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
  foreach(rule CREATE_PREPROCESSED_SOURCE CREATE_ASSEMBLY_SOURCE)
    if(LINEARBUILD_SYCL_${rule})
      string(REPLACE "<LINEARBUILD_SYCL_COMPILER>" "<LINEARBUILD_SYCL_COMPILER> ${_LINEARBUILD_SYCL_REQUIRED_FLAG}"
        LINEARBUILD_SYCL_${rule} "${LINEARBUILD_SYCL_${rule}}")
    endif()
  endforeach()
endif()

if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE)
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE_SYCL)
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE_SYCL} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE_SYCL "${_override}")
endif()

set(LINEARBUILD_SYCL_FLAGS_INIT "$ENV{SYCLFLAGS} ${LINEARBUILD_SYCL_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_SYCL_FLAGS "Flags used by the SYCL compiler")

if(LINEARBUILD_SYCL_STANDARD_LIBRARIES_INIT)
  set(LINEARBUILD_SYCL_STANDARD_LIBRARIES "${LINEARBUILD_SYCL_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all SYCL applications.")
  mark_as_advanced(LINEARBUILD_SYCL_STANDARD_LIBRARIES)
endif()

if(NOT LINEARBUILD_SYCL_COMPILER_LAUNCHER AND DEFINED ENV{LINEARBUILD_SYCL_COMPILER_LAUNCHER})
  set(LINEARBUILD_SYCL_COMPILER_LAUNCHER "$ENV{LINEARBUILD_SYCL_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for SYCL.")
endif()

if(NOT LINEARBUILD_SYCL_LINKER_LAUNCHER AND DEFINED ENV{LINEARBUILD_SYCL_LINKER_LAUNCHER})
  set(LINEARBUILD_SYCL_LINKER_LAUNCHER "$ENV{LINEARBUILD_SYCL_LINKER_LAUNCHER}"
    CACHE STRING "Linker launcher for SYCL.")
endif()

include(LinearBuildCommonLanguageInclude)
_linearbuild_common_language_platform_flags(SYCL)

if(NOT LINEARBUILD_SYCL_CREATE_SHARED_LIBRARY)
  set(LINEARBUILD_SYCL_CREATE_SHARED_LIBRARY
      "<LINEARBUILD_SYCL_COMPILER> ${_LINEARBUILD_SYCL_REQUIRED_FLAG} <LINEARBUILD_SHARED_LIBRARY_SYCL_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
endif()

if(NOT LINEARBUILD_SYCL_CREATE_SHARED_MODULE)
  set(LINEARBUILD_SYCL_CREATE_SHARED_MODULE ${LINEARBUILD_SYCL_CREATE_SHARED_LIBRARY})
endif()

if(NOT DEFINED LINEARBUILD_SYCL_ARCHIVE_CREATE)
  set(LINEARBUILD_SYCL_ARCHIVE_CREATE "<LINEARBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_SYCL_ARCHIVE_APPEND)
  set(LINEARBUILD_SYCL_ARCHIVE_APPEND "<LINEARBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_SYCL_ARCHIVE_FINISH)
  set(LINEARBUILD_SYCL_ARCHIVE_FINISH "<LINEARBUILD_RANLIB> <TARGET>")
endif()

if(NOT LINEARBUILD_SYCL_COMPILE_OBJECT)
  set(LINEARBUILD_SYCL_COMPILE_OBJECT
    "<LINEARBUILD_SYCL_COMPILER> ${_LINEARBUILD_SYCL_REQUIRED_FLAG} <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT LINEARBUILD_SYCL_LINK_EXECUTABLE)
  set(LINEARBUILD_SYCL_LINK_EXECUTABLE
    "<LINEARBUILD_SYCL_COMPILER> ${_LINEARBUILD_SYCL_REQUIRED_FLAG} <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(LINEARBUILD_SYCL_DEVICE_LINK_OPTIONS)
  set(LINEARBUILD_SYCL_DEVICE_LINK_MODE DRIVER)
  set(LINEARBUILD_SYCL_DEVICE_LINKER_WRAPPER_FLAG ${LINEARBUILD_SYCL_LINKER_WRAPPER_FLAG})
  set(LINEARBUILD_SYCL_DEVICE_LINKER_WRAPPER_FLAG_SEP ${LINEARBUILD_SYCL_LINKER_WRAPPER_FLAG_SEP})
  set(LINEARBUILD_SYCL_RESPONSE_FILE_DEVICE_LINK_FLAG "@")
  string(JOIN " " pic_options ${LINEARBUILD_SYCL_COMPILE_OPTIONS_PIC})
  string(JOIN " " device_options ${LINEARBUILD_SYCL_DEVICE_LINK_OPTIONS})
  if(NOT LINEARBUILD_SYCL_DEVICE_LINK_LIBRARY)
    set(LINEARBUILD_SYCL_DEVICE_LINK_LIBRARY
      "<LINEARBUILD_SYCL_COMPILER> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${pic_options} ${device_options} -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
  endif()
  if(NOT LINEARBUILD_SYCL_DEVICE_LINK_EXECUTABLE)
    set(LINEARBUILD_SYCL_DEVICE_LINK_EXECUTABLE "${LINEARBUILD_SYCL_DEVICE_LINK_LIBRARY}")
  endif()
  unset(device_options)
  unset(pic_options)
endif()

mark_as_advanced(LINEARBUILD_VERBOSE_MAKEFILE)

set(LINEARBUILD_SYCL_USE_LINKER_INFORMATION TRUE)

set(LINEARBUILD_SYCL_INFORMATION_LOADED 1)
