#[=======================================================================[.rst:
RBLXBuildBackwardCompatibilityCXX
-----------------------------

This module defines several backward compatibility cache variables for the
``CXX`` language to support early C++ (pre-C++98, ANSI C++).

Load this module in a RBLXBuild project with:

.. code-block:: rblxbuild

  include(RBLXBuildBackwardCompatibilityCXX)

The following modules are included by this module:

* :module:`TestForANSIForScope`
* :module:`TestForANSIStreamHeaders`
* :module:`TestForSSTREAM`
* :module:`TestForSTDNamespace`

Additionally, the following cache variable may be defined:

``RBLXBUILD_ANSI_CXXFLAGS``
  A space-separated string of compiler options for enabling ANSI C++ mode, if
  available.

.. note::

  This module is intended for C++ code written before ``C++ 98``.  As of the
  ``C++ 98`` standard, these issues have been formally addressed, making such
  checks obsolete.

Examples
^^^^^^^^

Including this module provides backward compatibility cache variables, which
can be used in C++.  For example:

.. code-block:: rblxbuild
  :caption: ``RBLXBuildLists.txt``

  include(RBLXBuildBackwardCompatibilityCXX)
  file(
    CONFIGURE
    OUTPUT config.h
    CONTENT [[
      #rblxbuilddefine RBLXBUILD_NO_ANSI_FOR_SCOPE
      #rblxbuilddefine RBLXBUILD_NO_ANSI_STRING_STREAM
      #rblxbuilddefine RBLXBUILD_NO_ANSI_STREAM_HEADERS
      #rblxbuilddefine RBLXBUILD_NO_STD_NAMESPACE
    ]]
  )
#]=======================================================================]

if(NOT RBLXBUILD_SKIP_COMPATIBILITY_TESTS)
  # check for some ANSI flags in the CXX compiler if it is not gnu
  if(NOT RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
    include(TestCXXAcceptsFlag)
    set(RBLXBUILD_TRY_ANSI_CXX_FLAGS "")
    if(RBLXBUILD_SYSTEM_NAME MATCHES "OSF")
      set(RBLXBUILD_TRY_ANSI_CXX_FLAGS "-std strict_ansi -nopure_cname")
    endif()
    # if RBLXBUILD_TRY_ANSI_CXX_FLAGS has something in it, see
    # if the compiler accepts it
    if(NOT RBLXBUILD_TRY_ANSI_CXX_FLAGS STREQUAL "")
      check_cxx_accepts_flag(${RBLXBUILD_TRY_ANSI_CXX_FLAGS} RBLXBUILD_CXX_ACCEPTS_FLAGS)
      # if the compiler liked the flag then set RBLXBUILD_ANSI_CXXFLAGS
      # to the flag
      if(RBLXBUILD_CXX_ACCEPTS_FLAGS)
        set(RBLXBUILD_ANSI_CXXFLAGS ${RBLXBUILD_TRY_ANSI_CXX_FLAGS} CACHE INTERNAL
        "What flags are required by the c++ compiler to make it ansi." )
      endif()
    endif()
  endif()
  set(RBLXBUILD_CXX_FLAGS_SAVE ${RBLXBUILD_CXX_FLAGS})
  string(APPEND RBLXBUILD_CXX_FLAGS " ${RBLXBUILD_ANSI_CXXFLAGS}")
  include(TestForANSIStreamHeaders)
  include(CheckIncludeFileCXX)
  include(TestForSTDNamespace)
  include(TestForANSIForScope)
  include(TestForSSTREAM)
  set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS_SAVE}")
endif()
