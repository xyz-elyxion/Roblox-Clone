# This module is shared by multiple languages; use include blocker.
include_guard()

# Probe whether the linker supports --push-state/--pop-state and cache the result
# in RBLXBUILD_[<LANG>_]LINKER_PUSHPOP_STATE_SUPPORTED.
function(__rblxbuild_check_linker_pushpop_state __linker __linker_options)
  unset(__lang)
  if(ARGC EQUAL "3")
    set(__lang "${ARGV2}_")
  endif()

  if(DEFINED RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED)
    return()
  endif()

  if(NOT __linker)
    set(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED FALSE PARENT_SCOPE)
    return()
  endif()

  execute_process(COMMAND "${__linker}" ${__linker_options} --push-state --pop-state
                  OUTPUT_VARIABLE __linker_log
                  ERROR_VARIABLE __linker_log
                  COMMAND_ERROR_IS_FATAL NONE)
  if(__linker_log MATCHES "--push-state" OR __linker_log MATCHES "--pop-state")
    set(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED FALSE PARENT_SCOPE)
  else()
    set(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED TRUE PARENT_SCOPE)
  endif()
endfunction()

# WHOLE_ARCHIVE Feature for LINK_LIBRARY generator expression
function(__rblxbuild_set_whole_archive_feature __linker __linker_options)
  unset(__lang)
  if(ARGC EQUAL "3")
    set(__lang "${ARGV2}_")
  endif()

  __rblxbuild_check_linker_pushpop_state("${__linker}" "${__linker_options}" ${ARGV2})

  ## WHOLE_ARCHIVE: Force loading all members of an archive
  if(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED)
    set(RBLXBUILD_${__lang}LINK_LIBRARY_USING_WHOLE_ARCHIVE "LINKER:--push-state,--whole-archive"
                                                        "<LINK_ITEM>"
                                                        "LINKER:--pop-state" PARENT_SCOPE)
  else()
    set(RBLXBUILD_${__lang}LINK_LIBRARY_USING_WHOLE_ARCHIVE "LINKER:--whole-archive"
                                                        "<LINK_ITEM>"
                                                        "LINKER:--no-whole-archive" PARENT_SCOPE)
  endif()
  set(RBLXBUILD_${__lang}LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED TRUE PARENT_SCOPE)
  set(RBLXBUILD_${__lang}LINK_LIBRARY_WHOLE_ARCHIVE_ATTRIBUTES LIBRARY_TYPE=STATIC DEDUPLICATION=YES OVERRIDE=DEFAULT PARENT_SCOPE)
  set(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED "${RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED}" PARENT_SCOPE)
endfunction()

# NEEDED_LIBRARY Feature for LINK_LIBRARY generator expression
## Force a shared library into DT_NEEDED even when no symbols are referenced
function(__rblxbuild_set_needed_library_feature __linker __linker_options)
  unset(__lang)
  if(ARGC EQUAL "3")
    set(__lang "${ARGV2}_")
  endif()

  __rblxbuild_check_linker_pushpop_state("${__linker}" "${__linker_options}" ${ARGV2})

  ## NEEDED_LIBRARY: Force DT_NEEDED entry for a shared library
  if(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED)
    set(RBLXBUILD_${__lang}LINK_LIBRARY_USING_NEEDED_LIBRARY "LINKER:--push-state,--no-as-needed"
                                                         "<LINK_ITEM>"
                                                         "LINKER:--pop-state" PARENT_SCOPE)
  else()
    set(RBLXBUILD_${__lang}LINK_LIBRARY_USING_NEEDED_LIBRARY "LINKER:--no-as-needed"
                                                         "<LINK_ITEM>"
                                                         "LINKER:--as-needed" PARENT_SCOPE)
  endif()
  set(RBLXBUILD_${__lang}LINK_LIBRARY_USING_NEEDED_LIBRARY_SUPPORTED TRUE PARENT_SCOPE)
  set(RBLXBUILD_${__lang}LINK_LIBRARY_NEEDED_LIBRARY_ATTRIBUTES LIBRARY_TYPE=SHARED DEDUPLICATION=DEFAULT OVERRIDE=DEFAULT PARENT_SCOPE)
  set(RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED "${RBLXBUILD_${__lang}LINKER_PUSHPOP_STATE_SUPPORTED}" PARENT_SCOPE)
endfunction()

## Configure system linker
__rblxbuild_set_whole_archive_feature("${RBLXBUILD_LINKER}" "")
__rblxbuild_set_needed_library_feature("${RBLXBUILD_LINKER}" "")
