set(RBLXBUILD_Fortran_COMPILER_VERSION "@RBLXBUILD_Fortran_COMPILER_VERSION@")
set(RBLXBUILD_Fortran_COMPILER_WRAPPER "@RBLXBUILD_Fortran_COMPILER_WRAPPER@")
set(RBLXBUILD_Fortran_PLATFORM_ID "@RBLXBUILD_Fortran_PLATFORM_ID@")
set(RBLXBUILD_Fortran_SIMULATE_ID "@RBLXBUILD_Fortran_SIMULATE_ID@")
set(RBLXBUILD_Fortran_COMPILER_FRONTEND_VARIANT "@RBLXBUILD_Fortran_COMPILER_FRONTEND_VARIANT@")
set(RBLXBUILD_Fortran_SIMULATE_VERSION "@RBLXBUILD_Fortran_SIMULATE_VERSION@")
@_SET_RBLXBUILD_Fortran_XL_CPP@
set(RBLXBUILD_Fortran_COMPILER_ARCHITECTURE_ID "@RBLXBUILD_Fortran_COMPILER_ARCHITECTURE_ID@")
@_SET_RBLXBUILD_Fortran_COMPILER_SYSROOT@
@SET_MSVC_Fortran_ARCHITECTURE_ID@
set(RBLXBUILD_AR "@RBLXBUILD_AR@")
set(RBLXBUILD_Fortran_COMPILER_AR "@RBLXBUILD_Fortran_COMPILER_AR@")
set(RBLXBUILD_RANLIB "@RBLXBUILD_RANLIB@")
set(RBLXBUILD_LINKER "@RBLXBUILD_LINKER@")
set(RBLXBUILD_Fortran_COMPILER_LINKER "@RBLXBUILD_Fortran_COMPILER_LINKER@")
set(RBLXBUILD_Fortran_COMPILER_LINKER_ARCHITECTURE_FLAGS "@RBLXBUILD_Fortran_COMPILER_LINKER_ARCHITECTURE_FLAGS@")
set(RBLXBUILD_Fortran_COMPILER_LINKER_ID "@RBLXBUILD_Fortran_COMPILER_LINKER_ID@")
set(RBLXBUILD_Fortran_COMPILER_LINKER_VERSION "@RBLXBUILD_Fortran_COMPILER_LINKER_VERSION@")
set(RBLXBUILD_Fortran_COMPILER_LINKER_FRONTEND_VARIANT "@RBLXBUILD_Fortran_COMPILER_LINKER_FRONTEND_VARIANT@")
set(RBLXBUILD_Fortran_COMPILER_RANLIB "@RBLXBUILD_Fortran_COMPILER_RANLIB@")
set(RBLXBUILD_TAPI "@RBLXBUILD_TAPI@")
set(RBLXBUILD_COMPILER_IS_GNUG77 @RBLXBUILD_COMPILER_IS_GNUG77@)
set(RBLXBUILD_Fortran_COMPILER_LOADED 1)
set(RBLXBUILD_Fortran_COMPILER_WORKS @RBLXBUILD_Fortran_COMPILER_WORKS@)
set(RBLXBUILD_Fortran_ABI_COMPILED @RBLXBUILD_Fortran_ABI_COMPILED@)

set(RBLXBUILD_Fortran_COMPILER_ENV_VAR "FC")

set(RBLXBUILD_Fortran_COMPILER_SUPPORTS_F90 @RBLXBUILD_Fortran_COMPILER_SUPPORTS_F90@)

set(RBLXBUILD_Fortran_COMPILER_ID_RUN 1)
set(RBLXBUILD_Fortran_SOURCE_FILE_EXTENSIONS f;F;fpp;FPP;f77;F77;f90;F90;for;For;FOR;f95;F95;f03;F03;f08;F08@RBLXBUILD_Fortran_VENDOR_SOURCE_FILE_EXTENSIONS@)
set(RBLXBUILD_Fortran_IGNORE_EXTENSIONS h;H;o;O;obj;OBJ;def;DEF;rc;RC)
set(RBLXBUILD_Fortran_LINKER_PREFERENCE 20)
set(RBLXBUILD_Fortran_LINKER_DEPFILE_SUPPORTED @RBLXBUILD_Fortran_LINKER_DEPFILE_SUPPORTED@)
set(RBLXBUILD_LINKER_PUSHPOP_STATE_SUPPORTED @RBLXBUILD_LINKER_PUSHPOP_STATE_SUPPORTED@)
set(RBLXBUILD_Fortran_LINKER_PUSHPOP_STATE_SUPPORTED @RBLXBUILD_Fortran_LINKER_PUSHPOP_STATE_SUPPORTED@)
if(UNIX)
  set(RBLXBUILD_Fortran_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_Fortran_OUTPUT_EXTENSION .obj)
endif()

# Save compiler ABI information.
set(RBLXBUILD_Fortran_SIZEOF_DATA_PTR "@RBLXBUILD_Fortran_SIZEOF_DATA_PTR@")
set(RBLXBUILD_Fortran_COMPILER_ABI "@RBLXBUILD_Fortran_COMPILER_ABI@")
set(RBLXBUILD_Fortran_LIBRARY_ARCHITECTURE "@RBLXBUILD_Fortran_LIBRARY_ARCHITECTURE@")

if(RBLXBUILD_Fortran_SIZEOF_DATA_PTR AND NOT RBLXBUILD_SIZEOF_VOID_P)
  set(RBLXBUILD_SIZEOF_VOID_P "${RBLXBUILD_Fortran_SIZEOF_DATA_PTR}")
endif()

if(RBLXBUILD_Fortran_COMPILER_ABI)
  set(RBLXBUILD_INTERNAL_PLATFORM_ABI "${RBLXBUILD_Fortran_COMPILER_ABI}")
endif()

if(RBLXBUILD_Fortran_LIBRARY_ARCHITECTURE)
  set(RBLXBUILD_LIBRARY_ARCHITECTURE "@RBLXBUILD_Fortran_LIBRARY_ARCHITECTURE@")
endif()

@RBLXBUILD_Fortran_COMPILER_CUSTOM_CODE@
