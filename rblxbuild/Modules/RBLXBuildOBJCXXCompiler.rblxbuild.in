set(RBLXBUILD_OBJCXX_COMPILER_ENV_VAR "OBJCXX")

set(RBLXBUILD_OBJCXX_COMPILER_ID_RUN 1)
set(RBLXBUILD_OBJCXX_SOURCE_FILE_EXTENSIONS M;m;mm)
set(RBLXBUILD_OBJCXX_IGNORE_EXTENSIONS inl;h;hpp;HPP;H;o;O)

if (RBLXBUILD_OBJC_COMPILER_ID_RUN)
  foreach(extension IN LISTS RBLXBUILD_OBJC_SOURCE_FILE_EXTENSIONS)
    list(REMOVE_ITEM RBLXBUILD_OBJCXX_SOURCE_FILE_EXTENSIONS ${extension})
  endforeach()
endif()

foreach (lang IN ITEMS C CXX OBJC)
  foreach(extension IN LISTS RBLXBUILD_OBJCXX_SOURCE_FILE_EXTENSIONS)
    if (RBLXBUILD_${lang}_COMPILER_ID_RUN)
      list(REMOVE_ITEM RBLXBUILD_${lang}_SOURCE_FILE_EXTENSIONS ${extension})
    endif()
  endforeach()
endforeach()

