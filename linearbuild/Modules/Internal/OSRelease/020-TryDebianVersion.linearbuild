if(NOT EXISTS "${LINEARBUILD_SYSROOT}/etc/debian_version")
  return()
endif()

# Get the first string only
file(
    STRINGS "${LINEARBUILD_SYSROOT}/etc/debian_version" LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT
    LIMIT_COUNT 1
  )

#
# Example:
#   6.0.10          # Old debian
#   wheezy/sid      # Ubuntu
#
if(LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT MATCHES "[0-9]+(\.[0-9]+)*")

  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME Debian)
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID debian)
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION ${LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT})
  set(LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID ${LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT})

  list(
      APPEND LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION
      LINEARBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID
    )

endif()

unset(LINEARBUILD_GET_OS_RELEASE_FALLBACK_CONTENT)
