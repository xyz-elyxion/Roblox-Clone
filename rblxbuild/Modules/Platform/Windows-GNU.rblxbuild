# This module is shared by multiple languages; use include blocker.
if(__WINDOWS_GNU)
  return()
endif()
set(__WINDOWS_GNU 1)

set(MINGW 1)

# On Windows hosts, in MSYSTEM environments, search standard prefixes.
if(RBLXBUILD_HOST_WIN32)
  # Bootstrap RBLXBuild does not have rblxbuild_host_system_information.
  if(COMMAND rblxbuild_host_system_information)
    rblxbuild_host_system_information(RESULT _MSYSTEM_PREFIX QUERY MSYSTEM_PREFIX)
  elseif(IS_DIRECTORY "$ENV{MSYSTEM_PREFIX}")
    set(_MSYSTEM_PREFIX "$ENV{MSYSTEM_PREFIX}")
  endif()

  # Search this MSYSTEM environment's equivalent to /usr/local and /usr.
  if(_MSYSTEM_PREFIX)
    list(PREPEND RBLXBUILD_SYSTEM_PREFIX_PATH "${_MSYSTEM_PREFIX}")
    if(IS_DIRECTORY "${_MSYSTEM_PREFIX}/local")
      list(PREPEND RBLXBUILD_SYSTEM_PREFIX_PATH "${_MSYSTEM_PREFIX}/local")
    endif()
  endif()
  unset(_MSYSTEM_PREFIX)
endif()

set(RBLXBUILD_IMPORT_LIBRARY_PREFIX "lib")
set(RBLXBUILD_SHARED_LIBRARY_PREFIX "lib")
set(RBLXBUILD_SHARED_MODULE_PREFIX  "lib")
set(RBLXBUILD_STATIC_LIBRARY_PREFIX "lib")

set(RBLXBUILD_EXECUTABLE_SUFFIX     ".exe")
set(RBLXBUILD_IMPORT_LIBRARY_SUFFIX ".dll.a")
set(RBLXBUILD_SHARED_LIBRARY_SUFFIX ".dll")
set(RBLXBUILD_SHARED_MODULE_SUFFIX  ".dll")
set(RBLXBUILD_STATIC_LIBRARY_SUFFIX ".a")

set(RBLXBUILD_EXTRA_LINK_EXTENSIONS ".lib") # MinGW can also link to a MS .lib

set(RBLXBUILD_FIND_LIBRARY_PREFIXES "lib" "")
set(RBLXBUILD_FIND_LIBRARY_SUFFIXES ".dll.a" ".a" ".lib")
set(RBLXBUILD_C_STANDARD_LIBRARIES_INIT "-lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32")
set(RBLXBUILD_CXX_STANDARD_LIBRARIES_INIT "${RBLXBUILD_C_STANDARD_LIBRARIES_INIT}")

set(RBLXBUILD_DL_LIBS "")
set(RBLXBUILD_LIBRARY_PATH_FLAG "-L")
set(RBLXBUILD_LINK_LIBRARY_FLAG "-l")
set(RBLXBUILD_LINK_DEF_FILE_FLAG "") # Empty string: passing the file is enough
set(RBLXBUILD_LINK_LIBRARY_SUFFIX "")

set(RBLXBUILD_GNULD_IMAGE_VERSION
  "-Wl,--major-image-version,<TARGET_VERSION_MAJOR>,--minor-image-version,<TARGET_VERSION_MINOR>")

# Check if GNU ld is too old to support @FILE syntax.
set(__WINDOWS_GNU_LD_RESPONSE 1)
execute_process(COMMAND ld -v OUTPUT_VARIABLE _help ERROR_VARIABLE _help RESULT_VARIABLE _res)
if(_res EQUAL 0 AND "${_help}" MATCHES "GNU ld .* 2\\.1[1-6]")
  set(__WINDOWS_GNU_LD_RESPONSE 0)
endif()


# Features for LINK_GROUP generator expression
## RESCAN: request the linker to rescan static libraries until there is
## no pending undefined symbols
set(RBLXBUILD_LINK_GROUP_USING_RESCAN "LINKER:--start-group" "LINKER:--end-group")
set(RBLXBUILD_LINK_GROUP_USING_RESCAN_SUPPORTED TRUE)


macro(__windows_compiler_gnu lang)

  # Create archiving rules to support large object file lists for static libraries.
  set(RBLXBUILD_${lang}_ARCHIVE_CREATE "<RBLXBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_APPEND "<RBLXBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_FINISH "<RBLXBUILD_RANLIB> <TARGET>")

  # Initialize C link type selection flags.  These flags are used when
  # building a shared library, shared module, or executable that links
  # to other libraries to select whether to use the static or shared
  # versions of the libraries.
  foreach(type SHARED_LIBRARY SHARED_MODULE EXE)
    set(RBLXBUILD_${type}_LINK_STATIC_${lang}_FLAGS "-Wl,-Bstatic")
    set(RBLXBUILD_${type}_LINK_DYNAMIC_${lang}_FLAGS "-Wl,-Bdynamic")
  endforeach()

  set(RBLXBUILD_${lang}_VERBOSE_LINK_FLAG "-Wl,-v")

  # linker selection
  set(RBLXBUILD_${lang}_USING_LINKER_SYSTEM "")
  set(RBLXBUILD_${lang}_USING_LINKER_BFD "-fuse-ld=bfd")
  set(RBLXBUILD_${lang}_USING_LINKER_LLD "-fuse-ld=lld")

  # No -fPIC on Windows
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIC "")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE "")
  set(_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER NO)
  set(RBLXBUILD_${lang}_LINK_OPTIONS_PIE "")
  set(RBLXBUILD_${lang}_LINK_OPTIONS_NO_PIE "")
  set(RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS "")

  set(RBLXBUILD_${lang}_USE_RESPONSE_FILE_FOR_OBJECTS ${__WINDOWS_GNU_LD_RESPONSE})
  set(RBLXBUILD_${lang}_USE_RESPONSE_FILE_FOR_LIBRARIES ${__WINDOWS_GNU_LD_RESPONSE})
  set(RBLXBUILD_${lang}_USE_RESPONSE_FILE_FOR_INCLUDES 1)

  # We prefer "@" for response files but it is not supported by gcc 3.
  execute_process(COMMAND ${RBLXBUILD_${lang}_COMPILER} --version OUTPUT_VARIABLE _ver ERROR_VARIABLE _ver RESULT_VARIABLE _res)
  if(_res EQUAL 0 AND "${_ver}" MATCHES "\\(GCC\\) 3\\.")
    if("${lang}" STREQUAL "Fortran")
      # The GNU Fortran compiler reports an error:
      #   no input files; unwilling to write output files
      # when the response file is passed with "-Wl,@".
      set(RBLXBUILD_Fortran_USE_RESPONSE_FILE_FOR_OBJECTS 0)
    else()
      # Use "-Wl,@" to pass the response file to the linker.
      set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "-Wl,@")
    endif()
    # The GNU 3.x compilers do not support response files (only linkers).
    set(RBLXBUILD_${lang}_USE_RESPONSE_FILE_FOR_INCLUDES 0)
    # Link libraries are generated only for the front-end.
    set(RBLXBUILD_${lang}_USE_RESPONSE_FILE_FOR_LIBRARIES 0)
  else()
    # Use "@" to pass the response file to the front-end.
    set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "@")
  endif()

  set(RBLXBUILD_${lang}_LINK_DEF_FILE_FLAG "") # Empty string: passing the file is enough

  # Binary link rules.
  set(RBLXBUILD_${lang}_CREATE_SHARED_MODULE
    "<RBLXBUILD_${lang}_COMPILER> <RBLXBUILD_SHARED_MODULE_${lang}_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> -o <TARGET> ${RBLXBUILD_GNULD_IMAGE_VERSION} <OBJECTS> <LINK_LIBRARIES>")
  set(RBLXBUILD_${lang}_CREATE_SHARED_LIBRARY
    "<RBLXBUILD_${lang}_COMPILER> <RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> -o <TARGET> -Wl,--out-implib,<TARGET_IMPLIB> ${RBLXBUILD_GNULD_IMAGE_VERSION} <OBJECTS> <LINK_LIBRARIES>")
  set(RBLXBUILD_${lang}_LINK_EXECUTABLE
    "<RBLXBUILD_${lang}_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> -Wl,--out-implib,<TARGET_IMPLIB> ${RBLXBUILD_GNULD_IMAGE_VERSION} <LINK_LIBRARIES>")
  set(RBLXBUILD_${lang}_CREATE_WIN32_EXE "-mwindows")

  list(APPEND RBLXBUILD_${lang}_ABI_FILES "Platform/Windows-GNU-${lang}-ABI")

  # Support very long lists of object files.
  # TODO: check for which gcc versions this is still needed, not needed for gcc >= 4.4.
  # Ninja generator doesn't support this work around.
  if("${RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG}" STREQUAL "@" AND NOT RBLXBUILD_GENERATOR MATCHES "Ninja")
    foreach(rule CREATE_SHARED_MODULE CREATE_SHARED_LIBRARY LINK_EXECUTABLE)
      # The gcc/collect2/ld toolchain does not use response files
      # internally so we cannot pass long object lists.  Instead pass
      # the object file list in a response file to the archiver to put
      # them in a temporary archive.  Hand the archive to the linker.
      string(REPLACE "<OBJECTS>" "-Wl,--whole-archive <OBJECT_DIR>/objects.a -Wl,--no-whole-archive"
        RBLXBUILD_${lang}_${rule} "${RBLXBUILD_${lang}_${rule}}")
      set(RBLXBUILD_${lang}_${rule}
        "<RBLXBUILD_COMMAND> -E rm -f <OBJECT_DIR>/objects.a"
        "<RBLXBUILD_AR> qc <OBJECT_DIR>/objects.a <OBJECTS>"
        "${RBLXBUILD_${lang}_${rule}}"
        )
    endforeach()
  endif()

  if(NOT RBLXBUILD_RC_COMPILER_INIT AND NOT RBLXBUILD_GENERATOR_RC)
    set(_RBLXBUILD_RC_COMPILER_LIST ${_RBLXBUILD_TOOLCHAIN_PREFIX}windres windres)
    set(_RBLXBUILD_RC_COMPILER_FALLBACK windres)
  endif()

  enable_language(RC)
endmacro()

macro(__windows_compiler_gnu_abi lang)
  if(RBLXBUILD_NO_GNUtoMS)
    set(RBLXBUILD_GNUtoMS 0)
  else()
    option(RBLXBUILD_GNUtoMS "Convert GNU import libraries to MS format (requires Visual Studio)" OFF)
  endif()

  if(RBLXBUILD_GNUtoMS AND NOT RBLXBUILD_GNUtoMS_LIB)
    # Find MS development environment setup script for this architecture.
    # We need to use the MS Librarian tool (lib.exe).
    # Find the most recent version available.

    # Query the VS Installer tool for locations of VS 2017 and above.
    set(_vs_installer_paths "")
    foreach(vs RANGE 18 15 -1) # change the first number to the largest supported version
      rblxbuild_host_system_information(RESULT _vs_dir QUERY VS_${vs}_DIR)
      if(_vs_dir)
        list(APPEND _vs_installer_paths "${_vs_dir}/VC/Auxiliary/Build")
      endif()
    endforeach()

    if("${RBLXBUILD_SIZEOF_VOID_P}" EQUAL 4)
      find_program(RBLXBUILD_GNUtoMS_VCVARS NAMES vcvars32.bat
        DOC "Visual Studio vcvars32.bat"
        PATHS
        ${_vs_installer_paths}
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\12.0\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\11.0\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\10.0\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\9.0\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\8.0\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\7.1\\Setup\\VC;ProductDir]/bin"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\6.0\\Setup\\Microsoft Visual C++;ProductDir]/bin"
        )
      set(RBLXBUILD_GNUtoMS_ARCH x86)
    elseif("${RBLXBUILD_SIZEOF_VOID_P}" EQUAL 8)
      find_program(RBLXBUILD_GNUtoMS_VCVARS NAMES vcvars64.bat vcvarsamd64.bat
        DOC "Visual Studio vcvarsamd64.bat"
        PATHS
        ${_vs_installer_paths}
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\Setup\\VC;ProductDir]/bin/amd64"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\12.0\\Setup\\VC;ProductDir]/bin/amd64"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\11.0\\Setup\\VC;ProductDir]/bin/amd64"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\10.0\\Setup\\VC;ProductDir]/bin/amd64"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\9.0\\Setup\\VC;ProductDir]/bin/amd64"
        "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\VisualStudio\\8.0\\Setup\\VC;ProductDir]/bin/amd64"
        )
      set(RBLXBUILD_GNUtoMS_ARCH amd64)
    endif()
    unset(_vs_installer_paths)
    set_property(CACHE RBLXBUILD_GNUtoMS_VCVARS PROPERTY ADVANCED 1)
    if(RBLXBUILD_GNUtoMS_VCVARS)
      # Create helper script to run lib.exe from MS environment.
      string(REPLACE "/" "\\" RBLXBUILD_GNUtoMS_BAT "${RBLXBUILD_GNUtoMS_VCVARS}")
      set(RBLXBUILD_GNUtoMS_LIB ${RBLXBUILD_BINARY_DIR}/RBLXBuildFiles/RBLXBuildGNUtoMS_lib.bat)
      configure_file(${RBLXBUILD_ROOT}/Modules/Platform/GNUtoMS_lib.bat.in ${RBLXBUILD_GNUtoMS_LIB})
    else()
      message(WARNING "Disabling RBLXBUILD_GNUtoMS option because RBLXBUILD_GNUtoMS_VCVARS is not set.")
      set(RBLXBUILD_GNUtoMS 0)
    endif()
  endif()

  if(RBLXBUILD_GNUtoMS)
    # Teach RBLXBuild how to create a MS import library at link time.
    set(RBLXBUILD_${lang}_GNUtoMS_RULE " -Wl,--output-def,<TARGET_NAME>.def"
      "<RBLXBUILD_COMMAND> -Dlib=\"${RBLXBUILD_GNUtoMS_LIB}\" -Ddef=<TARGET_NAME>.def -Ddll=<TARGET> -Dimp=<TARGET_IMPLIB> -P \"${RBLXBUILD_ROOT}/Modules/Platform/GNUtoMS_lib.rblxbuild\""
      )
  endif()
endmacro()
