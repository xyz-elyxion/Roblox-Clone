# This module is shared by multiple languages; use include blocker.
include_guard()

include(Platform/Linker/GNU)

macro(__freebsd_linker_gnu lang)
  set(LINEARBUILD_${lang}_PLATFORM_LINKER_ID GNU)
  if(LINEARBUILD_${lang}_COMPILER_LINKER)
    __linearbuild_set_whole_archive_feature("${LINEARBUILD_${lang}_COMPILER_LINKER}"
                                      "${LINEARBUILD_${lang}_COMPILER_LINKER_ARCHITECTURE_FLAGS}"
                                      "${lang}")
  endif()
endmacro()
