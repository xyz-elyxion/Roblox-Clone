macro(_record_compiler_features_hip std)
  list(APPEND RBLXBUILD_HIP${std}_COMPILE_FEATURES hip_std_${std})

  get_property(lang_level_has_features GLOBAL PROPERTY RBLXBUILD_HIP${std}_KNOWN_FEATURES)
  if(lang_level_has_features)
    _record_compiler_features(HIP "${RBLXBUILD_HIP${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_HIP${std}_COMPILE_FEATURES)
  endif()
