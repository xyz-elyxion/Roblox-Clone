# This module is shared by multiple linkers; use include blocker.
include_guard()


macro(__linker_msvc lang)
  # Linker warning as error
  set(RBLXBUILD_${lang}_LINK_OPTIONS_WARNING_AS_ERROR "LINKER:-WX")
endmacro()
