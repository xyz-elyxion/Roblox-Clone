if(UNIX)
  set(LINEARBUILD_HIP_OUTPUT_EXTENSION .o)
else()
  set(LINEARBUILD_HIP_OUTPUT_EXTENSION .obj)
endif()
set(LINEARBUILD_INCLUDE_FLAG_HIP "-I")

# Set implicit links early so compiler-specific modules can use them.
set(__IMPLICIT_LINKS)
foreach(dir ${LINEARBUILD_HIP_HOST_IMPLICIT_LINK_DIRECTORIES})
  string(APPEND __IMPLICIT_LINKS " -L\"${dir}\"")
endforeach()
foreach(lib ${LINEARBUILD_HIP_HOST_IMPLICIT_LINK_LIBRARIES})
  if(${lib} MATCHES "/")
    string(APPEND __IMPLICIT_LINKS " \"${lib}\"")
  else()
    string(APPEND __IMPLICIT_LINKS " -l${lib}")
  endif()
endforeach()

# Load compiler-specific information.
if(LINEARBUILD_HIP_COMPILER_ID)
  include(Compiler/${LINEARBUILD_HIP_COMPILER_ID}-HIP OPTIONAL)
endif()

# load the system- and compiler specific files
if(LINEARBUILD_HIP_COMPILER_ID)
  # load a hardware specific file, mostly useful for embedded compilers
  if(LINEARBUILD_SYSTEM_PROCESSOR)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_HIP_COMPILER_ID}-HIP-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_HIP_COMPILER_ID}-HIP OPTIONAL)
endif()


# add the flags to the cache based
# on the initial values computed in the platform/*.linearbuild files
# use _INIT variables so that this only happens the first time
# and you can set these flags in the linearbuild cache
set(LINEARBUILD_HIP_FLAGS_INIT "$ENV{HIPFLAGS} ${LINEARBUILD_HIP_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_HIP_FLAGS "Flags used by the HIP compiler")

if(LINEARBUILD_HIP_STANDARD_LIBRARIES_INIT)
  set(LINEARBUILD_HIP_STANDARD_LIBRARIES "${LINEARBUILD_HIP_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all HIP applications.")
  mark_as_advanced(LINEARBUILD_HIP_STANDARD_LIBRARIES)
endif()

if(NOT LINEARBUILD_HIP_COMPILER_LAUNCHER AND DEFINED ENV{LINEARBUILD_HIP_COMPILER_LAUNCHER})
  set(LINEARBUILD_HIP_COMPILER_LAUNCHER "$ENV{LINEARBUILD_HIP_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for HIP.")
endif()

if(NOT LINEARBUILD_HIP_LINKER_LAUNCHER AND DEFINED ENV{LINEARBUILD_HIP_LINKER_LAUNCHER})
  set(LINEARBUILD_HIP_LINKER_LAUNCHER "$ENV{LINEARBUILD_HIP_LINKER_LAUNCHER}"
          CACHE STRING "Linker launcher for HIP.")
endif()

include(LinearBuildCommonLanguageInclude)
_linearbuild_common_language_platform_flags(HIP)

# now define the following rules:
# LINEARBUILD_HIP_CREATE_SHARED_LIBRARY
# LINEARBUILD_HIP_CREATE_SHARED_MODULE
# LINEARBUILD_HIP_COMPILE_OBJECT
# LINEARBUILD_HIP_LINK_EXECUTABLE

# For spirv platform (chipStar), set compile and link commands
if(LINEARBUILD_HIP_PLATFORM STREQUAL "spirv")
  include(Internal/LinearBuildChipStarHIP)
  _linearbuild_chipstar_set_compiler_flags()
  _linearbuild_chipstar_set_link_commands()
endif()

# create a shared library
if(NOT LINEARBUILD_HIP_CREATE_SHARED_LIBRARY)
  set(LINEARBUILD_HIP_CREATE_SHARED_LIBRARY
      "<LINEARBUILD_HIP_COMPILER> <LINEARBUILD_SHARED_LIBRARY_HIP_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
endif()

# create a shared module copy the shared library rule by default
if(NOT LINEARBUILD_HIP_CREATE_SHARED_MODULE)
  set(LINEARBUILD_HIP_CREATE_SHARED_MODULE ${LINEARBUILD_HIP_CREATE_SHARED_LIBRARY})
endif()

# Create a static archive incrementally for large object file counts.
if(NOT DEFINED LINEARBUILD_HIP_ARCHIVE_CREATE)
  set(LINEARBUILD_HIP_ARCHIVE_CREATE "<LINEARBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_HIP_ARCHIVE_APPEND)
  set(LINEARBUILD_HIP_ARCHIVE_APPEND "<LINEARBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED LINEARBUILD_HIP_ARCHIVE_FINISH)
  set(LINEARBUILD_HIP_ARCHIVE_FINISH "<LINEARBUILD_RANLIB> <TARGET>")
endif()

# compile a HIP file into an object file
if(NOT LINEARBUILD_HIP_COMPILE_OBJECT)
  set(LINEARBUILD_HIP_COMPILE_OBJECT
    "<LINEARBUILD_HIP_COMPILER> ${_LINEARBUILD_HIP_EXTRA_FLAGS} <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> ${_LINEARBUILD_COMPILE_AS_HIP_FLAG} -c <SOURCE>")
endif()

# compile a cu file into an executable
if(NOT LINEARBUILD_HIP_LINK_EXECUTABLE)
  set(LINEARBUILD_HIP_LINK_EXECUTABLE
    "<LINEARBUILD_HIP_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

set(LINEARBUILD_HIP_USE_LINKER_INFORMATION TRUE)

set(LINEARBUILD_HIP_INFORMATION_LOADED 1)

# Load the file and find the relevant HIP runtime.
if(NOT DEFINED _LINEARBUILD_HIP_DEVICE_RUNTIME_TARGET)
  set(hip-lang_DIR "${LINEARBUILD_HIP_COMPILER_ROCM_LIB}/linearbuild/hip-lang")
  find_package(hip-lang CONFIG QUIET NO_DEFAULT_PATH REQUIRED)
endif()
if(DEFINED _LINEARBUILD_HIP_DEVICE_RUNTIME_TARGET)
  list(APPEND LINEARBUILD_HIP_RUNTIME_LIBRARIES_STATIC ${_LINEARBUILD_HIP_DEVICE_RUNTIME_TARGET})
  list(APPEND LINEARBUILD_HIP_RUNTIME_LIBRARIES_SHARED ${_LINEARBUILD_HIP_DEVICE_RUNTIME_TARGET})
endif()
