#the compute nodes on BlueGene/L don't support shared libs
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)

set(RBLXBUILD_SHARED_LIBRARY_C_FLAGS "")            # -pic
set(RBLXBUILD_SHARED_LIBRARY_CREATE_C_FLAGS "")       # -shared
set(RBLXBUILD_SHARED_LIBRARY_LINK_C_FLAGS "")         # +s, flag for exe link to use shared lib
set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG "")       # -rpath
set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG_SEP "")   # : or empty

set(RBLXBUILD_LINK_LIBRARY_SUFFIX "")
set(RBLXBUILD_STATIC_LIBRARY_PREFIX "lib")
set(RBLXBUILD_STATIC_LIBRARY_SUFFIX ".a")
set(RBLXBUILD_SHARED_LIBRARY_PREFIX "lib")          # lib
set(RBLXBUILD_SHARED_LIBRARY_SUFFIX ".a")           # .a
set(RBLXBUILD_EXECUTABLE_SUFFIX "")          # .exe
set(RBLXBUILD_DL_LIBS "" )

set(RBLXBUILD_FIND_LIBRARY_PREFIXES "lib")
set(RBLXBUILD_FIND_LIBRARY_SUFFIXES ".a")


include(Platform/UnixPaths)

if(RBLXBUILD_C_COMPILER_ID STREQUAL "GNU")
  set(RBLXBUILD_C_LINK_EXECUTABLE
    "<RBLXBUILD_C_COMPILER> -Wl,-relax <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES> -Wl,-lgcc,-lc -lnss_files -lnss_dns -lresolv")
else()
  # when using IBM xlc we probably don't want to link to -lgcc
  set(RBLXBUILD_C_LINK_EXECUTABLE
    "<RBLXBUILD_C_COMPILER> -Wl,-relax <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES> -Wl,-lc -lnss_files -lnss_dns -lresolv")
endif()

if(RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
  set(RBLXBUILD_CXX_LINK_EXECUTABLE
    "<RBLXBUILD_CXX_COMPILER> -Wl,-relax <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES> -Wl,-lstdc++,-lgcc,-lc -lnss_files -lnss_dns -lresolv")
else()
  # when using the IBM xlC we probably don't want to link to -lgcc
  set(RBLXBUILD_CXX_LINK_EXECUTABLE
    "<RBLXBUILD_CXX_COMPILER> -Wl,-relax <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES> -Wl,-lstdc++,-lc -lnss_files -lnss_dns -lresolv")
endif()
