# Help RBLXBUILD_PARSE_IMPLICIT_LINK_INFO detect NAG Fortran object files.
if(NOT RBLXBUILD_Fortran_COMPILER_WORKS AND NOT RBLXBUILD_Fortran_COMPILER_FORCED)
  message(CHECK_START "Detecting NAG Fortran directory")
  # Run with -dryrun to see sample "link" line.
  execute_process(
    COMMAND ${RBLXBUILD_Fortran_COMPILER} dummy.o -dryrun
    OUTPUT_VARIABLE _dryrun
    ERROR_VARIABLE _dryrun
    RESULT_VARIABLE _dryrun_result
    )
  # Match an object file.
  string(REGEX MATCH "/[^ ]*/[^ /][^ /]*\\.o" _nag_obj "${_dryrun}")
  if(_nag_obj AND _dryrun_result EQUAL 0)
    # Parse object directory and convert to a regex.
    string(REGEX REPLACE "/[^/]*$" "" _nag_dir "${_nag_obj}")
    string(REGEX REPLACE "([][+.*()^])" "\\\\\\1" _nag_regex "${_nag_dir}")
    set(RBLXBUILD_Fortran_IMPLICIT_OBJECT_REGEX "^${_nag_regex}/")
    message(CONFIGURE_LOG
      "Detecting NAG Fortran directory with -dryrun found\n"
      "  object: ${_nag_obj}\n"
      "  directory: ${_nag_dir}\n"
      "  regex: ${RBLXBUILD_Fortran_IMPLICIT_OBJECT_REGEX}\n"
      "from output:\n${_dryrun}\n\n")
    message(CHECK_PASS "${_nag_dir}")
  else()
    message(CONFIGURE_LOG
      "Detecting NAG Fortran directory with -dryrun failed:\n${_dryrun}\n\n")
    message(CHECK_FAIL "failed")
  endif()
endif()

# Initial configuration flags.
string(APPEND RBLXBUILD_Fortran_FLAGS_INIT " ")
string(APPEND RBLXBUILD_Fortran_FLAGS_DEBUG_INIT " -g")
string(APPEND RBLXBUILD_Fortran_FLAGS_MINSIZEREL_INIT " -O2 -DNDEBUG")
string(APPEND RBLXBUILD_Fortran_FLAGS_RELEASE_INIT " -O4 -DNDEBUG")
string(APPEND RBLXBUILD_Fortran_FLAGS_RELWITHDEBINFO_INIT " -O2 -g -DNDEBUG")

set(RBLXBUILD_Fortran_SUBMODULE_SEP ".")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".sub")
set(RBLXBUILD_Fortran_MODDIR_FLAG "-mdir ")
set(RBLXBUILD_Fortran_MODDIR_INCLUDE_FLAG "-I") # -mdir does not affect search path
set(RBLXBUILD_SHARED_LIBRARY_Fortran_FLAGS "-PIC")
set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-fixed")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-free")
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PIC "-PIC")
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PIE "-PIC")
if(RBLXBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 6.2)
  set(RBLXBUILD_Fortran_RESPONSE_FILE_LINK_FLAG "-xldarg @")
  set(RBLXBUILD_Fortran_RESPONSE_FILE_ARCHIVE_FLAG "@")
  set(RBLXBUILD_Fortran_USE_RESPONSE_FILE_FOR_LIBRARIES 0)
else()
  set(RBLXBUILD_Fortran_RESPONSE_FILE_LINK_FLAG "@")
endif()
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-fpp")

set(RBLXBUILD_Fortran_LINK_MODE DRIVER)

set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
  "<RBLXBUILD_Fortran_COMPILER> -fpp <DEFINES> <INCLUDES> <FLAGS> -F <SOURCE> -o <PREPROCESSED_SOURCE>")
