# This file is included by cmGlobalGenerator::EnableLanguage.
# It is included after the compiler has been determined, so
# we know things like the compiler name and if the compiler is gnu.

function(_linearbuild_record_install_prefix )
  set(_LINEARBUILD_SYSTEM_PREFIX_PATH_INSTALL_PREFIX_VALUE "${LINEARBUILD_INSTALL_PREFIX}" PARENT_SCOPE)
  set(_LINEARBUILD_SYSTEM_PREFIX_PATH_STAGING_PREFIX_VALUE "${LINEARBUILD_STAGING_PREFIX}" PARENT_SCOPE)
  set(icount 0)
  set(scount 0)
  foreach(value IN LISTS LINEARBUILD_SYSTEM_PREFIX_PATH)
    if(value STREQUAL LINEARBUILD_INSTALL_PREFIX)
      math(EXPR icount "${icount}+1")
    endif()
    if(value STREQUAL LINEARBUILD_STAGING_PREFIX)
      math(EXPR scount "${scount}+1")
    endif()
  endforeach()
  set(_LINEARBUILD_SYSTEM_PREFIX_PATH_INSTALL_PREFIX_COUNT "${icount}" PARENT_SCOPE)
  set(_LINEARBUILD_SYSTEM_PREFIX_PATH_STAGING_PREFIX_COUNT "${scount}" PARENT_SCOPE)
endfunction()

# include Generic system information
include(LinearBuildGenericSystem)

# 2. now include SystemName.linearbuild file to set the system specific information
set(LINEARBUILD_SYSTEM_INFO_FILE Platform/${LINEARBUILD_SYSTEM_NAME})

include(${LINEARBUILD_SYSTEM_INFO_FILE} OPTIONAL RESULT_VARIABLE _INCLUDED_SYSTEM_INFO_FILE)

if(NOT _INCLUDED_SYSTEM_INFO_FILE)
  message("System is unknown to linearbuild, create:\n${LINEARBUILD_SYSTEM_INFO_FILE}"
          " to use this system, please post your config file on "
          "discourse.linearbuild.org so it can be added to linearbuild")
  if(EXISTS ${LINEARBUILD_BINARY_DIR}/LinearBuildCache.txt)
    configure_file(${LINEARBUILD_BINARY_DIR}/LinearBuildCache.txt
                   ${LINEARBUILD_BINARY_DIR}/CopyOfLinearBuildCache.txt COPYONLY)
    message("Your LinearBuildCache.txt file was copied to CopyOfLinearBuildCache.txt. "
            "Please post that file on discourse.linearbuild.org.")
  endif()
endif()

# optionally include a file which can do extra-generator specific things, e.g.
# LinearBuildFindEclipseCDT4.linearbuild asks gcc for the system include dirs for the Eclipse CDT4 generator
if(LINEARBUILD_EXTRA_GENERATOR)
  string(REPLACE " " "" _LINEARBUILD_EXTRA_GENERATOR_NO_SPACES ${LINEARBUILD_EXTRA_GENERATOR} )
  include("LinearBuildFind${_LINEARBUILD_EXTRA_GENERATOR_NO_SPACES}" OPTIONAL)
endif()


# for most systems a module is the same as a shared library
# so unless the variable LINEARBUILD_MODULE_EXISTS is set just
# copy the values from the LIBRARY variables
# this has to be done after the system information has been loaded
if(NOT LINEARBUILD_MODULE_EXISTS)
  set(LINEARBUILD_SHARED_MODULE_PREFIX "${LINEARBUILD_SHARED_LIBRARY_PREFIX}")
  set(LINEARBUILD_SHARED_MODULE_SUFFIX "${LINEARBUILD_SHARED_LIBRARY_SUFFIX}")
endif()


set(LINEARBUILD_SYSTEM_SPECIFIC_INFORMATION_LOADED 1)
