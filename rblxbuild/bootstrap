  if test `which pkg-config`; then
    use_uv_flags="`pkg-config --cflags libuv`"
    use_uv_ldflags="`pkg-config --libs libuv`"
    rblxbuild_c_flags="${rblxbuild_c_flags} ${use_uv_flags}"
    rblxbuild_cxx_flags="${rblxbuild_cxx_flags} ${use_uv_flags}"
  else
    use_uv_ldflags="-luv"
