function(linearbuild_determine_compiler_support lang)

  if("x${lang}" STREQUAL "xC" AND COMMAND linearbuild_record_c_compile_features)
    set(compile_feature_vars
      LINEARBUILD_C_COMPILE_FEATURES
      LINEARBUILD_C90_COMPILE_FEATURES
      LINEARBUILD_C99_COMPILE_FEATURES
      LINEARBUILD_C11_COMPILE_FEATURES
      LINEARBUILD_C17_COMPILE_FEATURES
      LINEARBUILD_C23_COMPILE_FEATURES
    )
    set(all_defined 1)
    set(any_non_empty 0)
    foreach (var IN LISTS compile_feature_vars)
      if (NOT DEFINED "${var}")
        set(all_defined 0)
      elseif (${var})
        set(any_non_empty 1)
      endif ()
    endforeach ()
    if (all_defined AND any_non_empty)
      return ()
    endif ()

    message(CHECK_START "Detecting ${lang} compile features")

    set(LINEARBUILD_C90_COMPILE_FEATURES)
    set(LINEARBUILD_C99_COMPILE_FEATURES)
    set(LINEARBUILD_C11_COMPILE_FEATURES)
    set(LINEARBUILD_C17_COMPILE_FEATURES)
    set(LINEARBUILD_C23_COMPILE_FEATURES)

    include("${LINEARBUILD_ROOT}/Modules/Internal/FeatureTesting.linearbuild")

    linearbuild_record_c_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (LINEARBUILD_C17_COMPILE_FEATURES AND LINEARBUILD_C23_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_C23_COMPILE_FEATURES ${LINEARBUILD_C17_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_C11_COMPILE_FEATURES AND LINEARBUILD_C17_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_C17_COMPILE_FEATURES ${LINEARBUILD_C11_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_C99_COMPILE_FEATURES AND LINEARBUILD_C11_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_C11_COMPILE_FEATURES ${LINEARBUILD_C99_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_C90_COMPILE_FEATURES AND LINEARBUILD_C99_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_C99_COMPILE_FEATURES ${LINEARBUILD_C90_COMPILE_FEATURES})
    endif()

    if(NOT LINEARBUILD_C_COMPILE_FEATURES)
      set(LINEARBUILD_C_COMPILE_FEATURES
        ${LINEARBUILD_C90_COMPILE_FEATURES}
        ${LINEARBUILD_C99_COMPILE_FEATURES}
        ${LINEARBUILD_C11_COMPILE_FEATURES}
        ${LINEARBUILD_C17_COMPILE_FEATURES}
        ${LINEARBUILD_C23_COMPILE_FEATURES}
      )
    endif()

    set(LINEARBUILD_C_COMPILE_FEATURES ${LINEARBUILD_C_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_C90_COMPILE_FEATURES ${LINEARBUILD_C90_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_C99_COMPILE_FEATURES ${LINEARBUILD_C99_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_C11_COMPILE_FEATURES ${LINEARBUILD_C11_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_C17_COMPILE_FEATURES ${LINEARBUILD_C17_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_C23_COMPILE_FEATURES ${LINEARBUILD_C23_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  elseif("x${lang}" STREQUAL "xCXX" AND COMMAND linearbuild_record_cxx_compile_features)
    set(compile_feature_vars
      LINEARBUILD_CXX_COMPILE_FEATURES
      LINEARBUILD_CXX98_COMPILE_FEATURES
      LINEARBUILD_CXX11_COMPILE_FEATURES
      LINEARBUILD_CXX14_COMPILE_FEATURES
      LINEARBUILD_CXX17_COMPILE_FEATURES
      LINEARBUILD_CXX20_COMPILE_FEATURES
      LINEARBUILD_CXX23_COMPILE_FEATURES
      LINEARBUILD_CXX26_COMPILE_FEATURES
    )
    set(all_defined 1)
    set(any_non_empty 0)
    foreach (var IN LISTS compile_feature_vars)
      if (NOT DEFINED "${var}")
        set(all_defined 0)
      elseif (${var})
        set(any_non_empty 1)
      endif ()
    endforeach ()
    set(need_feature_detection 1)
    if (all_defined AND any_non_empty)
      set(need_feature_detection 0)
    endif ()

    if (need_feature_detection)
      message(CHECK_START "Detecting ${lang} compile features")

      set(LINEARBUILD_CXX98_COMPILE_FEATURES)
      set(LINEARBUILD_CXX11_COMPILE_FEATURES)
      set(LINEARBUILD_CXX14_COMPILE_FEATURES)
      set(LINEARBUILD_CXX17_COMPILE_FEATURES)
      set(LINEARBUILD_CXX20_COMPILE_FEATURES)
      set(LINEARBUILD_CXX23_COMPILE_FEATURES)
      set(LINEARBUILD_CXX26_COMPILE_FEATURES)

      include("${LINEARBUILD_ROOT}/Modules/Internal/FeatureTesting.linearbuild")

      linearbuild_record_cxx_compile_features()

      if(NOT _result EQUAL 0)
        message(CHECK_FAIL "failed")
        return()
      endif()

      if (LINEARBUILD_CXX23_COMPILE_FEATURES AND LINEARBUILD_CXX26_COMPILE_FEATURES)
        list(REMOVE_ITEM LINEARBUILD_CXX26_COMPILE_FEATURES ${LINEARBUILD_CXX23_COMPILE_FEATURES})
      endif()
      if (LINEARBUILD_CXX20_COMPILE_FEATURES AND LINEARBUILD_CXX23_COMPILE_FEATURES)
        list(REMOVE_ITEM LINEARBUILD_CXX23_COMPILE_FEATURES ${LINEARBUILD_CXX20_COMPILE_FEATURES})
      endif()
      if (LINEARBUILD_CXX17_COMPILE_FEATURES AND LINEARBUILD_CXX20_COMPILE_FEATURES)
        list(REMOVE_ITEM LINEARBUILD_CXX20_COMPILE_FEATURES ${LINEARBUILD_CXX17_COMPILE_FEATURES})
      endif()
      if (LINEARBUILD_CXX14_COMPILE_FEATURES AND LINEARBUILD_CXX17_COMPILE_FEATURES)
        list(REMOVE_ITEM LINEARBUILD_CXX17_COMPILE_FEATURES ${LINEARBUILD_CXX14_COMPILE_FEATURES})
      endif()
      if (LINEARBUILD_CXX11_COMPILE_FEATURES AND LINEARBUILD_CXX14_COMPILE_FEATURES)
        list(REMOVE_ITEM LINEARBUILD_CXX14_COMPILE_FEATURES ${LINEARBUILD_CXX11_COMPILE_FEATURES})
      endif()
      if (LINEARBUILD_CXX98_COMPILE_FEATURES AND LINEARBUILD_CXX11_COMPILE_FEATURES)
        list(REMOVE_ITEM LINEARBUILD_CXX11_COMPILE_FEATURES ${LINEARBUILD_CXX98_COMPILE_FEATURES})
      endif()

      if(NOT LINEARBUILD_CXX_COMPILE_FEATURES)
        set(LINEARBUILD_CXX_COMPILE_FEATURES
          ${LINEARBUILD_CXX98_COMPILE_FEATURES}
          ${LINEARBUILD_CXX11_COMPILE_FEATURES}
          ${LINEARBUILD_CXX14_COMPILE_FEATURES}
          ${LINEARBUILD_CXX17_COMPILE_FEATURES}
          ${LINEARBUILD_CXX20_COMPILE_FEATURES}
          ${LINEARBUILD_CXX23_COMPILE_FEATURES}
          ${LINEARBUILD_CXX26_COMPILE_FEATURES}
        )
      endif()
    endif ()

    linearbuild_cxx_find_modules_json()

    set(LINEARBUILD_CXX_STDLIB_MODULES_JSON ${LINEARBUILD_CXX_STDLIB_MODULES_JSON} PARENT_SCOPE)
    set(LINEARBUILD_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE "${LINEARBUILD_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE}" PARENT_SCOPE)

    if (need_feature_detection)
      set(LINEARBUILD_CXX_COMPILE_FEATURES ${LINEARBUILD_CXX_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX98_COMPILE_FEATURES ${LINEARBUILD_CXX98_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX11_COMPILE_FEATURES ${LINEARBUILD_CXX11_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX14_COMPILE_FEATURES ${LINEARBUILD_CXX14_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX17_COMPILE_FEATURES ${LINEARBUILD_CXX17_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX20_COMPILE_FEATURES ${LINEARBUILD_CXX20_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX23_COMPILE_FEATURES ${LINEARBUILD_CXX23_COMPILE_FEATURES} PARENT_SCOPE)
      set(LINEARBUILD_CXX26_COMPILE_FEATURES ${LINEARBUILD_CXX26_COMPILE_FEATURES} PARENT_SCOPE)

      message(CHECK_PASS "done")
    endif ()

  elseif("x${lang}" STREQUAL "xCUDA" AND COMMAND linearbuild_record_cuda_compile_features)
    message(CHECK_START "Detecting ${lang} compile features")

    set(LINEARBUILD_CUDA03_COMPILE_FEATURES)
    set(LINEARBUILD_CUDA11_COMPILE_FEATURES)
    set(LINEARBUILD_CUDA14_COMPILE_FEATURES)
    set(LINEARBUILD_CUDA17_COMPILE_FEATURES)
    set(LINEARBUILD_CUDA20_COMPILE_FEATURES)
    set(LINEARBUILD_CUDA23_COMPILE_FEATURES)
    set(LINEARBUILD_CUDA26_COMPILE_FEATURES)

    include("${LINEARBUILD_ROOT}/Modules/Internal/FeatureTesting.linearbuild")

    linearbuild_record_cuda_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (LINEARBUILD_CUDA23_COMPILE_FEATURES AND LINEARBUILD_CUDA26_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_CUDA26_COMPILE_FEATURES ${LINEARBUILD_CUDA23_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_CUDA20_COMPILE_FEATURES AND LINEARBUILD_CUDA23_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_CUDA23_COMPILE_FEATURES ${LINEARBUILD_CUDA20_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_CUDA17_COMPILE_FEATURES AND LINEARBUILD_CUDA20_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_CUDA20_COMPILE_FEATURES ${LINEARBUILD_CUDA17_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_CUDA14_COMPILE_FEATURES AND LINEARBUILD_CUDA17_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_CUDA17_COMPILE_FEATURES ${LINEARBUILD_CUDA14_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_CUDA11_COMPILE_FEATURES AND LINEARBUILD_CUDA14_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_CUDA14_COMPILE_FEATURES ${LINEARBUILD_CUDA11_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_CUDA03_COMPILE_FEATURES AND LINEARBUILD_CUDA11_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_CUDA11_COMPILE_FEATURES ${LINEARBUILD_CUDA03_COMPILE_FEATURES})
    endif()

    if(NOT LINEARBUILD_CUDA_COMPILE_FEATURES)
      set(LINEARBUILD_CUDA_COMPILE_FEATURES
        ${LINEARBUILD_CUDA03_COMPILE_FEATURES}
        ${LINEARBUILD_CUDA11_COMPILE_FEATURES}
        ${LINEARBUILD_CUDA14_COMPILE_FEATURES}
        ${LINEARBUILD_CUDA17_COMPILE_FEATURES}
        ${LINEARBUILD_CUDA20_COMPILE_FEATURES}
        ${LINEARBUILD_CUDA23_COMPILE_FEATURES}
        ${LINEARBUILD_CUDA26_COMPILE_FEATURES}
      )
    endif()

    set(LINEARBUILD_CUDA_COMPILE_FEATURES ${LINEARBUILD_CUDA_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA03_COMPILE_FEATURES ${LINEARBUILD_CUDA03_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA11_COMPILE_FEATURES ${LINEARBUILD_CUDA11_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA14_COMPILE_FEATURES ${LINEARBUILD_CUDA14_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA17_COMPILE_FEATURES ${LINEARBUILD_CUDA17_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA20_COMPILE_FEATURES ${LINEARBUILD_CUDA20_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA23_COMPILE_FEATURES ${LINEARBUILD_CUDA23_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_CUDA26_COMPILE_FEATURES ${LINEARBUILD_CUDA26_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  elseif(lang STREQUAL HIP AND COMMAND linearbuild_record_hip_compile_features)
    message(CHECK_START "Detecting ${lang} compile features")

    set(LINEARBUILD_HIP98_COMPILE_FEATURES)
    set(LINEARBUILD_HIP11_COMPILE_FEATURES)
    set(LINEARBUILD_HIP14_COMPILE_FEATURES)
    set(LINEARBUILD_HIP17_COMPILE_FEATURES)
    set(LINEARBUILD_HIP20_COMPILE_FEATURES)
    set(LINEARBUILD_HIP23_COMPILE_FEATURES)
    set(LINEARBUILD_HIP26_COMPILE_FEATURES)


    include("${LINEARBUILD_ROOT}/Modules/Internal/FeatureTesting.linearbuild")

    linearbuild_record_hip_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (LINEARBUILD_HIP23_COMPILE_FEATURES AND LINEARBUILD_HIP26_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_HIP26_COMPILE_FEATURES ${LINEARBUILD_HIP23_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_HIP20_COMPILE_FEATURES AND LINEARBUILD_HIP23_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_HIP23_COMPILE_FEATURES ${LINEARBUILD_HIP20_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_HIP17_COMPILE_FEATURES AND LINEARBUILD_HIP20_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_HIP20_COMPILE_FEATURES ${LINEARBUILD_HIP17_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_HIP14_COMPILE_FEATURES AND LINEARBUILD_HIP17_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_HIP17_COMPILE_FEATURES ${LINEARBUILD_HIP14_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_HIP11_COMPILE_FEATURES AND LINEARBUILD_HIP14_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_HIP14_COMPILE_FEATURES ${LINEARBUILD_HIP11_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_HIP98_COMPILE_FEATURES AND LINEARBUILD_HIP11_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_HIP11_COMPILE_FEATURES ${LINEARBUILD_HIP98_COMPILE_FEATURES})
    endif()

    if(NOT LINEARBUILD_HIP_COMPILE_FEATURES)
      set(LINEARBUILD_HIP_COMPILE_FEATURES
        ${LINEARBUILD_HIP98_COMPILE_FEATURES}
        ${LINEARBUILD_HIP11_COMPILE_FEATURES}
        ${LINEARBUILD_HIP14_COMPILE_FEATURES}
        ${LINEARBUILD_HIP17_COMPILE_FEATURES}
        ${LINEARBUILD_HIP20_COMPILE_FEATURES}
        ${LINEARBUILD_HIP23_COMPILE_FEATURES}
        ${LINEARBUILD_HIP26_COMPILE_FEATURES}
      )
    endif()

    set(LINEARBUILD_HIP_COMPILE_FEATURES ${LINEARBUILD_HIP_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP98_COMPILE_FEATURES ${LINEARBUILD_HIP98_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP11_COMPILE_FEATURES ${LINEARBUILD_HIP11_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP14_COMPILE_FEATURES ${LINEARBUILD_HIP14_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP17_COMPILE_FEATURES ${LINEARBUILD_HIP17_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP20_COMPILE_FEATURES ${LINEARBUILD_HIP20_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP23_COMPILE_FEATURES ${LINEARBUILD_HIP23_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_HIP26_COMPILE_FEATURES ${LINEARBUILD_HIP26_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  elseif("x${lang}" STREQUAL "xSYCL" AND COMMAND linearbuild_record_sycl_compile_features)
    message(CHECK_START "Detecting ${lang} compile features")

    set(LINEARBUILD_SYCL98_COMPILE_FEATURES)
    set(LINEARBUILD_SYCL11_COMPILE_FEATURES)
    set(LINEARBUILD_SYCL14_COMPILE_FEATURES)
    set(LINEARBUILD_SYCL17_COMPILE_FEATURES)
    set(LINEARBUILD_SYCL20_COMPILE_FEATURES)
    set(LINEARBUILD_SYCL23_COMPILE_FEATURES)
    set(LINEARBUILD_SYCL26_COMPILE_FEATURES)

    include("${LINEARBUILD_ROOT}/Modules/Internal/FeatureTesting.linearbuild")

    linearbuild_record_sycl_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (LINEARBUILD_SYCL23_COMPILE_FEATURES AND LINEARBUILD_SYCL26_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_SYCL26_COMPILE_FEATURES ${LINEARBUILD_SYCL23_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_SYCL20_COMPILE_FEATURES AND LINEARBUILD_SYCL23_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_SYCL23_COMPILE_FEATURES ${LINEARBUILD_SYCL20_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_SYCL17_COMPILE_FEATURES AND LINEARBUILD_SYCL20_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_SYCL20_COMPILE_FEATURES ${LINEARBUILD_SYCL17_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_SYCL14_COMPILE_FEATURES AND LINEARBUILD_SYCL17_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_SYCL17_COMPILE_FEATURES ${LINEARBUILD_SYCL14_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_SYCL11_COMPILE_FEATURES AND LINEARBUILD_SYCL14_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_SYCL14_COMPILE_FEATURES ${LINEARBUILD_SYCL11_COMPILE_FEATURES})
    endif()
    if (LINEARBUILD_SYCL98_COMPILE_FEATURES AND LINEARBUILD_SYCL11_COMPILE_FEATURES)
      list(REMOVE_ITEM LINEARBUILD_SYCL11_COMPILE_FEATURES ${LINEARBUILD_SYCL98_COMPILE_FEATURES})
    endif()

    if(NOT LINEARBUILD_SYCL_COMPILE_FEATURES)
      set(LINEARBUILD_SYCL_COMPILE_FEATURES
        ${LINEARBUILD_SYCL98_COMPILE_FEATURES}
        ${LINEARBUILD_SYCL11_COMPILE_FEATURES}
        ${LINEARBUILD_SYCL14_COMPILE_FEATURES}
        ${LINEARBUILD_SYCL17_COMPILE_FEATURES}
        ${LINEARBUILD_SYCL20_COMPILE_FEATURES}
        ${LINEARBUILD_SYCL23_COMPILE_FEATURES}
        ${LINEARBUILD_SYCL26_COMPILE_FEATURES}
      )
    endif()

    set(LINEARBUILD_SYCL_COMPILE_FEATURES ${LINEARBUILD_SYCL_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL98_COMPILE_FEATURES ${LINEARBUILD_SYCL98_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL11_COMPILE_FEATURES ${LINEARBUILD_SYCL11_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL14_COMPILE_FEATURES ${LINEARBUILD_SYCL14_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL17_COMPILE_FEATURES ${LINEARBUILD_SYCL17_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL20_COMPILE_FEATURES ${LINEARBUILD_SYCL20_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL23_COMPILE_FEATURES ${LINEARBUILD_SYCL23_COMPILE_FEATURES} PARENT_SCOPE)
    set(LINEARBUILD_SYCL26_COMPILE_FEATURES ${LINEARBUILD_SYCL26_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  endif()

endfunction()
