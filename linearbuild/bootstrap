# Display LinearBuild bootstrap usage
linearbuild_usage()
{
echo '
Usage: '"$0"' [<options>...] [-- <linearbuild-options>...]
Options: [defaults in brackets after descriptions]
Configuration:
  --help                  print this message
  --version               only print version information
  --verbose               display more information
  --parallel=n            bootstrap linearbuild in parallel, where n is
                          number of nodes [1]
  --generator=<generator> generator to use (MSYS Makefiles, Unix Makefiles,
                          or Ninja)
  --enable-ccache         Enable ccache when building linearbuild
  --init=FILE             load FILE as script to populate cache
  --system-libs           use all system-installed third-party libraries
                          (for use only by package maintainers)
  --no-system-libs        use all linearbuild-provided third-party libraries
                          (default)
  --system-cppdap         use system-installed cppdap library
  --no-system-cppdap      use linearbuild-provided cppdap library (default)
  --system-curl           use system-installed curl library (default on macOS)
  --no-system-curl        use linearbuild-provided curl library (default elsewhere)
  --system-expat          use system-installed expat library
  --no-system-expat       use linearbuild-provided expat library (default)
  --system-jsoncpp        use system-installed jsoncpp library
  --no-system-jsoncpp     use linearbuild-provided jsoncpp library (default)
  --system-zlib           use system-installed zlib library
  --no-system-zlib        use linearbuild-provided zlib library (default)
  --system-bzip2          use system-installed bzip2 library
  --no-system-bzip2       use linearbuild-provided bzip2 library (default)
  --system-liblzma        use system-installed liblzma library
  --no-system-liblzma     use linearbuild-provided liblzma library (default)
  --system-nghttp2        use system-installed nghttp2 library
  --no-system-nghttp2     use linearbuild-provided nghttp2 library (default)
  --system-zstd           use system-installed zstd library
  --no-system-zstd        use linearbuild-provided zstd library (default)
  --system-libarchive     use system-installed libarchive library
  --no-system-libarchive  use linearbuild-provided libarchive library (default)
  --system-librhash       use system-installed librhash library
  --no-system-librhash    use linearbuild-provided librhash library (default)
  --system-libuv          use system-installed libuv library
  --no-system-libuv       use linearbuild-provided libuv library (default)

  --bootstrap-system-libuv use system-installed libuv library for bootstrap
  --bootstrap-system-jsoncpp use system-installed jsoncpp library for bootstrap
  --bootstrap-system-librhash use system-installed librhash library for bootstrap

  --qt-gui                build the Qt-based GUI (requires Qt >= 4.2)
  --no-qt-gui             do not build the Qt-based GUI (default)
  --qt-qmake=<qmake>      use <qmake> as the qmake executable to find Qt

  --debugger              enable debugger support (default if supported)
  --no-debugger           disable debugger support

  --sphinx-info             build Info manual with Sphinx
  --sphinx-man              build man pages with Sphinx
  --sphinx-html             build html help with Sphinx
  --sphinx-html-copybutton  build html help with the sphinx-copybutton extension
  --sphinx-qthelp           build qch help with Sphinx
  --sphinx-latexpdf         build PDF with Sphinx using LaTeX
  --sphinx-build=<sb>       use <sb> as the sphinx-build executable
  --sphinx-flags=<flags>    pass <flags> to sphinx-build executable

Directory and file names:
  --prefix=PREFIX         install files in tree rooted at PREFIX
                          ['"${linearbuild_default_prefix}"']
  --bindir=DIR            install binaries in PREFIX/DIR
                          ['"${linearbuild_bin_dir_default}"']
  --datadir=DIR           install data files in PREFIX/DIR
                          ['"${linearbuild_data_dir_default}"']
  --docdir=DIR            install documentation files in PREFIX/DIR
                          ['"${linearbuild_doc_dir_default}"']
  --mandir=DIR            install man pages files in PREFIX/DIR/manN
                          ['"${linearbuild_man_dir_default}"']
  --xdgdatadir=DIR        install XDG specific files in PREFIX/DIR
                          ['"${linearbuild_xdgdata_dir_default}"']
'
  exit 10
}

# Display LinearBuild bootstrap usage
linearbuild_version_display()
{
  echo "LinearBuild ${linearbuild_version}, ${linearbuild_copyright}"
}

# Display LinearBuild bootstrap error, display the log file and exit
linearbuild_error()
{
  res=$1
  shift 1
  echo "---------------------------------------------"
  echo "Error when bootstrapping LinearBuild:"
  echo "$*"
  echo "---------------------------------------------"
  if test -f linearbuild_bootstrap.log; then
    echo "Log of errors: `pwd`/linearbuild_bootstrap.log"
    #cat linearbuild_bootstrap.log
    echo "---------------------------------------------"
  fi
  exit ${res}
}

linearbuild_generate_file_tmp ()
{
  OUTFILE="$1"
  TMPFILE="$2"
  if "${_diff}" "$TMPFILE" "$OUTFILE" > /dev/null 2> /dev/null ; then
    rm -f "$TMPFILE"
  else
    mv -f "$TMPFILE" "$OUTFILE"
  fi
}

linearbuild_generate_file ()
{
  OUTFILE="$1"
  CONTENT="$2"
  echo "$CONTENT" > "$OUTFILE.tmp"
  linearbuild_generate_file_tmp "$OUTFILE" "$OUTFILE.tmp"
}

# Replace KWSYS_NAMESPACE with cmsys
linearbuild_replace_string ()
{
  INFILE="$1"
  OUTFILE="$2"
  SEARCHFOR="$3"
  REPLACEWITH="$4"
  if test -f "${INFILE}" || ${linearbuild_system_openvms}; then
    sed "s/\@${SEARCHFOR}\@/${REPLACEWITH}/g" "${INFILE}" > "${OUTFILE}${_tmp}"
    if test -f "${OUTFILE}${_tmp}"; then
      if "${_diff}" "${OUTFILE}" "${OUTFILE}${_tmp}" > /dev/null 2> /dev/null ; then
        #echo "Files are the same"
        rm -f "${OUTFILE}${_tmp}"
      else
        mv -f "${OUTFILE}${_tmp}" "${OUTFILE}"
      fi
    fi
  else
    linearbuild_error 1 "Cannot find file ${INFILE}"
  fi
}

linearbuild_kwsys_config_replace_string ()
{
  INFILE="$1"
  OUTFILE="$2"
  shift 2
  APPEND="$*"
  if test -f "${INFILE}" || ${linearbuild_system_openvms}; then
    echo "${APPEND}" > "${OUTFILE}${_tmp}"
    sed "/./ {s/\@KWSYS_NAMESPACE\@/cmsys/g;
              s/@KWSYS_BUILD_SHARED@/${KWSYS_BUILD_SHARED}/g;
              s/@KWSYS_LFS_AVAILABLE@/${KWSYS_LFS_AVAILABLE}/g;
              s/@KWSYS_LFS_REQUESTED@/${KWSYS_LFS_REQUESTED}/g;
              s/@KWSYS_NAME_IS_KWSYS@/${KWSYS_NAME_IS_KWSYS}/g;
              s/@KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H@/${KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H}/g;
             }" "${INFILE}" >> "${OUTFILE}${_tmp}"
    if test -f "${OUTFILE}${_tmp}"; then
      if "${_diff}" "${OUTFILE}" "${OUTFILE}${_tmp}" > /dev/null 2> /dev/null ; then
        #echo "Files are the same"
        rm -f "${OUTFILE}${_tmp}"
      else
        mv -f "${OUTFILE}${_tmp}" "${OUTFILE}"
      fi
    fi
  else
    linearbuild_error 2 "Cannot find file ${INFILE}"
  fi
}
# Write string into a file
linearbuild_report ()
{
  FILE=$1
  shift
  echo "$*" >> ${FILE}
}

# Escape spaces in strings for artifacts
linearbuild_escape_artifact ()
{
  if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
    echo $1 | sed "s/ /$ /g"
  else
    echo $1 | sed "s/ /\\\\ /g"
  fi
}

# Escape spaces in strings for shell
linearbuild_escape_shell ()
{
  echo $1 | sed "s/ /\\\\ /g"
}

# Encode object file names.
linearbuild_obj ()
{
  echo $1 | sed 's/\//-/g' | sed 's/$/\.o/'
}

# Strip prefix from argument
linearbuild_arg ()
{
  echo "$1" | sed "s/^${2-[^=]*=}//"
}

# Write message to the log
linearbuild_log ()
{
  echo "$*" >> linearbuild_bootstrap.log
}

# Return temp file
linearbuild_tmp_file ()
{
  echo "linearbuild_bootstrap_$$_test"
}

# Run a compiler test. First argument is compiler, second one are compiler
# flags, third one is test source file to be compiled
linearbuild_try_run ()
{
  COMPILER=$1
  FLAGS=$2
  TESTFILE=$3
  if test ! -f "${TESTFILE}"; then
    echo "Test file ${TESTFILE} missing. Please verify your LinearBuild source tree."
    exit 4
  fi
  TMPFILE=`linearbuild_tmp_file`
  echo "Try: ${COMPILER}"
  echo "Line: ${COMPILER} ${FLAGS} ${TESTFILE} -o ${TMPFILE}"
  echo "----------  file   -----------------------"
  cat "${TESTFILE}"
  echo "------------------------------------------"
  ${COMPILER} ${FLAGS} "${TESTFILE}" -o "${TMPFILE}"
  RES=$?
  if test "${RES}" -ne "0"; then
    echo "Test failed to compile"
    return 1
  fi
  if test ! -f "${TMPFILE}" && test ! -f "${TMPFILE}.exe"; then
    echo "Test failed to produce executable"
    return 2
  fi
  ./${TMPFILE}
  RES=$?
  rm -f "${TMPFILE}"
  if test "${RES}" -ne "0"; then
    echo "Test produced non-zero return code"
    return 3
  fi
  echo "Test succeeded"
  return 0
}

# Run a make test. First argument is the make interpreter.
linearbuild_try_make ()
{
  MAKE_PROC="$1"
  MAKE_FLAGS="$2"
  echo "Try: ${MAKE_PROC}"
  "${MAKE_PROC}" ${MAKE_FLAGS}
  RES=$?
  if test "${RES}" -ne "0"; then
    echo "${MAKE_PROC} does not work"
    return 1
  fi
  if test ! -f "test" && test ! -f "test.exe"; then
    echo "${COMPILER} does not produce output"
    return 2
  fi
  ./test
  RES=$?
  rm -f "test"
  if test "${RES}" -ne "0"; then
    echo "${MAKE_PROC} produces strange executable"
    return 3
  fi
  echo "${MAKE_PROC} works"
  return 0
}

# Parse arguments
linearbuild_verbose=
linearbuild_parallel_make=
linearbuild_ccache_enabled=
linearbuild_prefix_dir="${linearbuild_default_prefix}"
bootstrap_system_libuv=
bootstrap_system_jsoncpp=
bootstrap_system_librhash=
while test $# != 0; do
  case "$1" in
  --prefix=*) dir=`linearbuild_arg "$1"`
              linearbuild_prefix_dir=`linearbuild_fix_slashes "$dir"` ;;
  --parallel=*) linearbuild_parallel_make=`linearbuild_arg "$1"` ;;
  --generator=*) linearbuild_bootstrap_generator=`linearbuild_arg "$1"` ;;
  --bindir=*) linearbuild_bin_dir=`linearbuild_arg "$1"` ;;
  --datadir=*) linearbuild_data_dir=`linearbuild_arg "$1"` ;;
  --docdir=*) linearbuild_doc_dir=`linearbuild_arg "$1"` ;;
  --mandir=*) linearbuild_man_dir=`linearbuild_arg "$1"` ;;
  --xdgdatadir=*) linearbuild_xdgdata_dir=`linearbuild_arg "$1"` ;;
  --init=*) linearbuild_init_file=`linearbuild_arg "$1"` ;;
  --system-libs) linearbuild_bootstrap_system_libs="${linearbuild_bootstrap_system_libs} -DLINEARBUILD_USE_SYSTEM_LIBRARIES=1" ;;
  --no-system-libs) linearbuild_bootstrap_system_libs="${linearbuild_bootstrap_system_libs} -DLINEARBUILD_USE_SYSTEM_LIBRARIES=0" ;;
  --system-bzip2|--system-cppdap|--system-curl|--system-expat|--system-jsoncpp|--system-libarchive|--system-librhash|--system-zlib|--system-liblzma|--system-nghttp2|--system-zstd|--system-libuv)
    lib=`linearbuild_arg "$1" "--system-"`
    linearbuild_bootstrap_system_libs="${linearbuild_bootstrap_system_libs} -DLINEARBUILD_USE_SYSTEM_LIBRARY_`linearbuild_toupper $lib`=1" ;;
  --no-system-bzip2|--no-system-cppdap|--no-system-curl|--no-system-expat|--no-system-jsoncpp|--no-system-libarchive|--no-system-librhash|--no-system-zlib|--no-system-liblzma|--no-system-nghttp2|--no-system-zstd|--no-system-libuv)
    lib=`linearbuild_arg "$1" "--no-system-"`
    linearbuild_bootstrap_system_libs="${linearbuild_bootstrap_system_libs} -DLINEARBUILD_USE_SYSTEM_LIBRARY_`linearbuild_toupper $lib`=0" ;;
  --bootstrap-system-libuv) bootstrap_system_libuv="1" ;;
  --bootstrap-system-jsoncpp) bootstrap_system_jsoncpp="1" ;;
  --bootstrap-system-librhash) bootstrap_system_librhash="1" ;;
  --qt-gui) linearbuild_bootstrap_qt_gui="1" ;;
  --no-qt-gui) linearbuild_bootstrap_qt_gui="0" ;;
  --qt-qmake=*) linearbuild_bootstrap_qt_qmake=`linearbuild_arg "$1"` ;;
  --debugger) linearbuild_bootstrap_debugger="1" ;;
  --no-debugger) linearbuild_bootstrap_debugger="0" ;;
  --sphinx-info) linearbuild_sphinx_info="1" ;;
  --sphinx-man) linearbuild_sphinx_man="1" ;;
  --sphinx-html) linearbuild_sphinx_html="1" ;;
  --sphinx-html-copybutton) linearbuild_sphinx_html_copybutton="1" ;;
  --sphinx-qthelp) linearbuild_sphinx_qthelp="1" ;;
  --sphinx-latexpdf) linearbuild_sphinx_latexpdf="1" ;;
  --sphinx-build=*) linearbuild_sphinx_build=`linearbuild_arg "$1"` ;;
  --sphinx-flags=*) linearbuild_sphinx_flags=`linearbuild_arg "$1"` ;;
  --help) linearbuild_usage ;;
  --version) linearbuild_version_display ; exit 2 ;;
  --verbose) linearbuild_verbose=TRUE ;;
  --enable-ccache) linearbuild_ccache_enabled=TRUE ;;
  CC=*) CC=`linearbuild_arg "$1"` ;;
  CXX=*) CXX=`linearbuild_arg "$1"` ;;
  CFLAGS=*) CFLAGS=`linearbuild_arg "$1"` ;;
  CXXFLAGS=*) CXXFLAGS=`linearbuild_arg "$1"` ;;
  LDFLAGS=*) LDFLAGS=`linearbuild_arg "$1"` ;;
  --) shift; break ;;
  *) die "Unknown option: $1" ;;
  esac
  shift
done

# Make sure the generator is valid
case "${linearbuild_bootstrap_generator}" in
  'MSYS Makefiles'|'Unix Makefiles'|'Ninja') ;;
  *) linearbuild_error 10 "Invalid generator: ${linearbuild_bootstrap_generator}"
esac

# If verbose, display some information about bootstrap
if test -n "${linearbuild_verbose}"; then
  echo "---------------------------------------------"
  echo "Source directory: ${linearbuild_source_dir}"
  echo "Binary directory: ${linearbuild_binary_dir}"
  echo "Prefix directory: ${linearbuild_prefix_dir}"
  echo "System:           ${linearbuild_system}"
  echo "Generator:        ${linearbuild_bootstrap_generator}"
  if test "x${linearbuild_parallel_make}" != "x"; then
    echo "Doing parallel make: ${linearbuild_parallel_make}"
  fi
  echo ""
fi

echo "---------------------------------------------"
# Get LinearBuild version
echo "`linearbuild_version_display`"

# Check for in-source build
linearbuild_in_source_build=
if test -f "${linearbuild_binary_dir}/Source/linearbuild.cxx" &&
     test -f "${linearbuild_binary_dir}/Source/linearbuild.h"; then
  if test -n "${linearbuild_verbose}"; then
    echo "Warning: This is an in-source build"
  fi
  linearbuild_in_source_build=TRUE
fi

# If this is not an in-source build, then Bootstrap stuff should not exist.
if test -z "${linearbuild_in_source_build}"; then
  # Did somebody bootstrap in the source tree?
  if test -d "${linearbuild_source_dir}/Bootstrap${_cmk}"; then
    linearbuild_error 10 "Found directory \"${linearbuild_source_dir}/Bootstrap${_cmk}\".
Looks like somebody did bootstrap LinearBuild in the source tree, but now you are
trying to do bootstrap in the binary tree. Please remove Bootstrap${_cmk}
directory from the source tree."
  fi
  # Is there a cache in the source tree?
  for linearbuild_problematic_file in ${LINEARBUILD_PROBLEMATIC_FILES}; do
    if test -f "${linearbuild_source_dir}/${linearbuild_problematic_file}"; then
      linearbuild_error 10 "Found \"${linearbuild_source_dir}/${linearbuild_problematic_file}\".
Looks like somebody tried to build LinearBuild in the source tree, but now you are
trying to do bootstrap in the binary tree. Please remove \"${linearbuild_problematic_file}\"
from the source tree."
    fi
  done
fi

# Make bootstrap directory
test -d "${linearbuild_bootstrap_dir}" || mkdir "${linearbuild_bootstrap_dir}"
if test ! -d "${linearbuild_bootstrap_dir}"; then
  linearbuild_error 3 "Cannot create directory ${linearbuild_bootstrap_dir} to bootstrap LinearBuild."
fi
cd "${linearbuild_bootstrap_dir}"

test -d "cmsys" || mkdir "cmsys"
if test ! -d "cmsys"; then
  linearbuild_error 4 "Cannot create directory ${linearbuild_bootstrap_dir}/cmsys"
fi

# Delete all the bootstrap files
rm -f "${linearbuild_bootstrap_dir}/linearbuild_bootstrap.log"
rm -f "${linearbuild_bootstrap_dir}/cmConfigure.h${_tmp}"
rm -f "${linearbuild_bootstrap_dir}/cmVersionConfig.h${_tmp}"

# If building in-source, remove any cmConfigure.h that may
# have been created by a previous run of the bootstrap linearbuild.
if test -n "${linearbuild_in_source_build}"; then
  rm -f "${linearbuild_source_dir}/Source/cmConfigure.h"
fi

# If exist compiler flags, set them
linearbuild_c_flags=${CFLAGS}
linearbuild_cxx_flags=${CXXFLAGS}
linearbuild_ld_flags=${LDFLAGS}

# Add generator-specific files
if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  LINEARBUILD_CXX_SOURCES="${LINEARBUILD_CXX_SOURCES} \
    cmFortranParserImpl \
    cmGlobalNinjaGenerator \
    cmLocalNinjaGenerator \
    cmNinjaLinkLineComputer \
    cmNinjaLinkLineDeviceComputer \
    cmNinjaNormalTargetGenerator \
    cmNinjaTargetGenerator \
    cmNinjaUtilityTargetGenerator \
    "

  LexerParser_CXX_SOURCES="${LexerParser_CXX_SOURCES} \
    cmFortranLexer \
    cmFortranParser \
    "
else
  LINEARBUILD_CXX_SOURCES="${LINEARBUILD_CXX_SOURCES} \
    cmDepends \
    cmDependsC \
    cmDependsCompiler \
    cmGlobalUnixMakefileGenerator3 \
    cmLocalUnixMakefileGenerator3 \
    cmMakefileExecutableTargetGenerator \
    cmMakefileLibraryTargetGenerator \
    cmMakefileTargetGenerator \
    cmMakefileUtilityTargetGenerator \
    cmProcessTools \
    "
fi

# Add Cygwin-specific flags
if ${linearbuild_system_cygwin} || ${linearbuild_system_msys}; then
  linearbuild_ld_flags="${LDFLAGS} -Wl,--enable-auto-import"
fi

# Add CoreFoundation framework on Darwin
if ${linearbuild_system_darwin}; then
  linearbuild_ld_flags="${LDFLAGS} -framework CoreFoundation"
fi

# Add BeOS toolkits...
if ${linearbuild_system_beos}; then
  linearbuild_ld_flags="${LDFLAGS} -lroot -lbe"
fi

# Add Haiku toolkits...
if ${linearbuild_system_haiku}; then
  linearbuild_ld_flags="${LDFLAGS} -lroot -lbe"
fi

# Add AIX arch-specific link flags.
if ${linearbuild_system_aix}; then
  if uname -p | grep powerpc >/dev/null 2>&1; then
    linearbuild_ld_flags="${LDFLAGS} -Wl,-bbigtoc"
  fi
fi

#-----------------------------------------------------------------------------
# Detect known toolchains on some platforms.
linearbuild_toolchains=''
case "${linearbuild_system}" in
  *AIX*)   linearbuild_toolchains='XL GNU' ;;
  *CYGWIN*) linearbuild_toolchains='GNU' ;;
  *MSYS*) linearbuild_toolchains='GNU' ;;
  *Darwin*) linearbuild_toolchains='Clang GNU' ;;
  *Linux*) linearbuild_toolchains='GNU Clang XL PGI PathScale' ;;
  *MINGW*) linearbuild_toolchains='GNU' ;;
esac

# Toolchain compiler name table.
linearbuild_toolchain_Clang_CC='clang'
linearbuild_toolchain_Clang_CXX='clang++'
linearbuild_toolchain_GNU_CC='gcc'
linearbuild_toolchain_GNU_CXX='g++'
linearbuild_toolchain_PGI_CC='pgcc'
linearbuild_toolchain_PGI_CXX='pgCC'
linearbuild_toolchain_PathScale_CC='pathcc'
linearbuild_toolchain_PathScale_CXX='pathCC'
linearbuild_toolchain_XL_CC='xlc'
linearbuild_toolchain_XL_CXX='xlC'

linearbuild_toolchain_try()
{
  tc="$1"
  TMPFILE=`linearbuild_tmp_file`

  eval "tc_CC=\${linearbuild_toolchain_${tc}_CC}"
  echo 'int main() { return 0; }' > "${TMPFILE}.c"
  linearbuild_try_run "$tc_CC" "" "${TMPFILE}.c" >> linearbuild_bootstrap.log 2>&1
  tc_result_CC="$?"
  rm -f "${TMPFILE}.c"
  test "${tc_result_CC}" = "0" || return 1

  eval "tc_CXX=\${linearbuild_toolchain_${tc}_CXX}"
  echo 'int main() { return 0; }' > "${TMPFILE}.cpp"
  linearbuild_try_run "$tc_CXX" "" "${TMPFILE}.cpp" >> linearbuild_bootstrap.log 2>&1
  tc_result_CXX="$?"
  rm -f "${TMPFILE}.cpp"
  test "${tc_result_CXX}" = "0" || return 1

  linearbuild_toolchain="$tc"
}

linearbuild_toolchain_detect()
{
  linearbuild_toolchain=
  for tc in ${linearbuild_toolchains}; do
    echo "Checking for $tc toolchain" >> linearbuild_bootstrap.log 2>&1
    linearbuild_toolchain_try "$tc" &&
    echo "Found $tc toolchain" &&
    break
  done
}

if test -z "${CC}" && test -z "${CXX}"; then
  linearbuild_toolchain_detect
fi

thread_flags=''
case "${linearbuild_system}" in
  *AIX*)   thread_flags='-pthread' ;;
esac

#-----------------------------------------------------------------------------
# Test C compiler
linearbuild_c_compiler=

# If CC is set, use that for compiler, otherwise use list of known compilers
if test -n "${linearbuild_toolchain}"; then
  eval linearbuild_c_compilers="\${linearbuild_toolchain_${linearbuild_toolchain}_CC}"
else
  linearbuild_c_compilers="${LINEARBUILD_KNOWN_C_COMPILERS}"
fi

linearbuild_c_compiler_try_set()
{
  test_compiler="$1"
  test_thread_flags="$2"

  # Check if C compiler works
  TMPFILE=`linearbuild_tmp_file`
  echo '
#ifdef __cplusplus
# error "The LINEARBUILD_C_COMPILER is set to a C++ compiler"
#endif

#if defined(_AIX) && defined(__GNUC__) && !defined(_THREAD_SAFE)
#error "On AIX with GNU we need the -pthread flag."
#endif

#if defined(__sun) && __STDC_VERSION__ < 199901L
#error "On Solaris we need C99."
#endif

#if defined(__hpux) && !(defined(__GNUC__) && ((__GNUC__ * 100) + __GNUC_MINOR__) >= 409)
#error "On HP-UX we need GCC 4.9 or higher."
#endif

#include <stdio.h>

int main(int argc, char* argv[])
{
  printf("%d%c", (argv != 0), (char)0x0a);
  return argc - 1;
}
' > "${TMPFILE}.c"
  for std in 11 99 90; do
    std_flags="`linearbuild_extract_standard_flags \"${linearbuild_toolchain}\" C \"${std}\"`"
    for std_flag in '' $std_flags; do
      for thread_flag in '' $test_thread_flags; do
        echo "Checking whether '${test_compiler} ${linearbuild_c_flags} ${linearbuild_ld_flags} ${std_flag} ${thread_flag}' works." >> linearbuild_bootstrap.log 2>&1
        if linearbuild_try_run "${test_compiler}" "${linearbuild_c_flags} ${linearbuild_ld_flags} ${std_flag} ${thread_flag}" \
          "${TMPFILE}.c" >> linearbuild_bootstrap.log 2>&1; then
          linearbuild_c_compiler="${test_compiler}"
          linearbuild_c_flags="${linearbuild_c_flags} ${std_flag} ${thread_flag}"
          rm -f "${TMPFILE}.c"
          return 0
        fi
      done
    done
  done
  rm -f "${TMPFILE}.c"
  return 1
}

if test -n "${CC}"; then
  linearbuild_c_compiler_try_set "${CC}" "${thread_flags}"
else
  for compiler in ${linearbuild_c_compilers}; do
    if linearbuild_c_compiler_try_set "${compiler}" "${thread_flags}"; then
      break
    fi
  done
fi

if test -z "${linearbuild_c_compiler}"; then
  linearbuild_error 6 "Cannot find appropriate C compiler on this system.
Please specify one using environment variable CC.
See linearbuild_bootstrap.log for compilers attempted.
"
fi
echo "C compiler on this system is: ${linearbuild_c_compiler} ${linearbuild_c_flags}"

#-----------------------------------------------------------------------------
# Test CXX compiler
linearbuild_cxx_compiler=

# On Mac OSX, CC is the same as cc, so make sure not to try CC as c++ compiler.

# If CC is set, use that for compiler, otherwise use list of known compilers
if test -n "${linearbuild_toolchain}"; then
  eval linearbuild_cxx_compilers="\${linearbuild_toolchain_${linearbuild_toolchain}_CXX}"
else
  linearbuild_cxx_compilers="${LINEARBUILD_KNOWN_CXX_COMPILERS}"
fi

# Check if C++ compiler works
linearbuild_cxx_compiler_try_set()
{
  test_compiler="$1"
  test_thread_flags="$2"

  TMPFILE=`linearbuild_tmp_file`
echo '
#include <iostream>
#include <memory>
#include <unordered_map>

#if __cplusplus < 201103L
#error "Compiler is not in a mode aware of C++11."
#endif

#if defined(_AIX) && defined(__GNUC__) && !defined(_THREAD_SAFE)
#error "On AIX with GNU we need the -pthread flag."
#endif

#if defined(__SUNPRO_CC) && __SUNPRO_CC < 0x5140
#error "SunPro <= 5.13 mode not supported due to bug in move semantics."
#endif

#if defined(__hpux) && !(defined(__GNUC__) && ((__GNUC__ * 100) + __GNUC_MINOR__) >= 409)
#error "On HP-UX we need GCC 4.9 or higher."
#endif

#if __cplusplus > 201103L
#include <iterator>
int check_cxx14()
{
  int a[] = { 0, 1, 2 };
  auto ai = std::cbegin(a);

  int b[] = { 2, 1, 0 };
  auto bi = std::cend(b);

  return *ai + *(bi - 1);
}
#else
int check_cxx14()
{
  return 0;
}
#endif

#if (__cplusplus >= 201703L || defined(__INTEL_COMPILER) && defined(__cpp_deduction_guides))
#include <optional>
template <typename T,
          typename std::invoke_result<decltype(&T::get), T>::type = nullptr>
typename T::pointer get_ptr(T& item)
{
  return item.get();
}

int check_cxx17()
{
  // Intel compiler do not handle correctly 'decltype' inside 'invoke_result'
  std::unique_ptr<int> u(new int(0));
  get_ptr(u);
  std::optional<int> oi = 0;
  return oi.value();
}
#else
int check_cxx17()
{
  return 0;
}
#endif

class Class
{
public:
  int Get() const { return this->Member; }
private:
  int Member = 1;
};
int main()
{
  auto const c = std::unique_ptr<Class>(new Class);
  std::cout << c->Get() << check_cxx14() << check_cxx17() << std::endl;
  return 0;
}
' > "${TMPFILE}.cxx"
  for std in 17 14 11; do
    std_flags="`linearbuild_extract_standard_flags \"${linearbuild_toolchain}\" CXX \"${std}\"`"
    for std_flag in '' $std_flags; do
      for thread_flag in '' $test_thread_flags; do
        echo "Checking whether '${test_compiler} ${linearbuild_cxx_flags} ${linearbuild_ld_flags} ${std_flag} ${thread_flag}' works." >> linearbuild_bootstrap.log 2>&1
        if linearbuild_try_run "${test_compiler}" "${linearbuild_cxx_flags} ${linearbuild_ld_flags} ${std_flag} ${thread_flag}" \
          "${TMPFILE}.cxx" >> linearbuild_bootstrap.log 2>&1; then
          linearbuild_cxx_compiler="${test_compiler}"
          linearbuild_cxx_flags="${linearbuild_cxx_flags} ${std_flag} ${thread_flag} "
          rm -f "${TMPFILE}.cxx"
          return 0
        fi
      done
    done
  done
  rm -f "${TMPFILE}.cxx"
  return 1
}

if test -n "${CXX}"; then
  linearbuild_cxx_compiler_try_set "${CXX}" "${thread_flags}"
else
  for compiler in ${linearbuild_cxx_compilers}; do
    if linearbuild_cxx_compiler_try_set "${compiler}" "${thread_flags}"; then
      break
    fi
  done
fi

if test -z "${linearbuild_cxx_compiler}"; then
linearbuild_error 7 "Cannot find a C++ compiler that supports both C++11 and the specified C++ flags.
Please specify one using environment variable CXX.
The C++ flags are \"$linearbuild_cxx_flags\".
They can be changed using the environment variable CXXFLAGS.
See linearbuild_bootstrap.log for compilers attempted."
fi
echo "C++ compiler on this system is: ${linearbuild_cxx_compiler} ${linearbuild_cxx_flags}"

#-----------------------------------------------------------------------------
# Test CXX features

linearbuild_cxx_features="make_unique filesystem"

for feature in ${linearbuild_cxx_features}; do
  eval "linearbuild_have_cxx_${feature}=0"
  echo "Checking whether '${linearbuild_cxx_compiler} ${linearbuild_cxx_flags} ${linearbuild_ld_flags}' supports '${feature}'." >> linearbuild_bootstrap.log 2>&1
  if linearbuild_try_run "${linearbuild_cxx_compiler}" "${linearbuild_cxx_flags} ${linearbuild_ld_flags}" \
                   "${linearbuild_source_dir}/Source/Checks/cm_cxx_${feature}.cxx" >> linearbuild_bootstrap.log 2>&1; then
    eval "linearbuild_have_cxx_${feature}=1"
  fi
done

linearbuild_have_cxx_features=""
for feature in ${linearbuild_cxx_features}; do
  feature_variable="linearbuild_have_cxx_${feature}"
  eval "feature_value=\${${feature_variable}}"
  if test "${feature_value}" -eq "1"; then
    linearbuild_have_cxx_features="${linearbuild_have_cxx_features} -DLinearBuild_HAVE_CXX_`linearbuild_toupper ${feature}`=${feature_value}"
  fi
done

linearbuild_generate_file "${linearbuild_bootstrap_dir}/cmSTL.hxx" ""


#-----------------------------------------------------------------------------
# Test Make

linearbuild_make_processor=
linearbuild_make_flags=

# If MAKE is set, use that for make processor, otherwise use list of known make
if test -n "${MAKE}"; then
  linearbuild_make_processors="${MAKE}"
elif test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  linearbuild_make_processors="${LINEARBUILD_KNOWN_NINJA_PROCESSORS}"
else
  linearbuild_make_processors="${LINEARBUILD_KNOWN_MAKE_PROCESSORS}"
fi

tab="`printf '\t'`"
TMPFILE="`linearbuild_tmp_file`_dir"
rm -rf "${linearbuild_bootstrap_dir}/${TMPFILE}"
mkdir "${linearbuild_bootstrap_dir}/${TMPFILE}"
cd "${linearbuild_bootstrap_dir}/${TMPFILE}"
if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  echo '
rule cc
  command = '"${linearbuild_c_compiler}"' '"${linearbuild_ld_flags} ${linearbuild_c_flags}"' -o $out $in
build test: cc test.c
'>"build.ninja"
else
  echo '
test: test.c
'"${tab}${linearbuild_c_compiler}"' '"${linearbuild_ld_flags} ${linearbuild_c_flags}"' -o test test.c
'>"Makefile"
fi
echo '
#include <stdio.h>
int main(){ printf("1%c", (char)0x0a); return 0; }
' > "test.c"
linearbuild_original_make_flags="${linearbuild_make_flags}"
if test "x${linearbuild_parallel_make}" != "x"; then
  linearbuild_make_flags="${linearbuild_make_flags} -j ${linearbuild_parallel_make}"
fi
for a in ${linearbuild_make_processors}; do
  if test -z "${linearbuild_make_processor}" && linearbuild_try_make "${a}" "${linearbuild_make_flags}" >> ../linearbuild_bootstrap.log 2>&1; then
    linearbuild_make_processor="${a}"
  fi
done
linearbuild_full_make_flags="${linearbuild_make_flags}"
if test "x${linearbuild_original_make_flags}" != "x${linearbuild_make_flags}"; then
  if test -z "${linearbuild_make_processor}"; then
    linearbuild_make_flags="${linearbuild_original_make_flags}"
    for a in ${linearbuild_make_processors}; do
      if test -z "${linearbuild_make_processor}" && linearbuild_try_make "${a}" "${linearbuild_make_flags}" >> ../linearbuild_bootstrap.log 2>&1; then
        linearbuild_make_processor="${a}"
      fi
    done
  fi
fi
cd "${linearbuild_bootstrap_dir}"

if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  mf_str=Ninja
else
  mf_str=Makefile
fi
if test -z "${linearbuild_make_processor}"; then
  linearbuild_error 8 "Cannot find appropriate ${mf_str} processor on this system.
Please specify one using environment variable MAKE."
fi
rm -rf "${linearbuild_bootstrap_dir}/${TMPFILE}"
echo "${mf_str} processor on this system is: ${linearbuild_make_processor}"
if test "x${linearbuild_full_make_flags}" != "x${linearbuild_make_flags}"; then
  echo "---------------------------------------------"
  echo "${mf_str} processor ${linearbuild_make_processor} does not support parallel build"
  echo "---------------------------------------------"
fi

# Test for kwsys features
KWSYS_NAME_IS_KWSYS=0
KWSYS_BUILD_SHARED=0
KWSYS_LFS_AVAILABLE=0
KWSYS_LFS_REQUESTED=0
KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H=0
KWSYS_CXX_HAS_SETENV=0
KWSYS_CXX_HAS_UNSETENV=0
KWSYS_CXX_HAS_ENVIRON_IN_STDLIB_H=0
KWSYS_CXX_HAS_UTIMENSAT=0
KWSYS_CXX_HAS_UTIMES=0

if linearbuild_try_run "${linearbuild_cxx_compiler}" \
  "${linearbuild_cxx_flags} ${linearbuild_ld_flags} -DTEST_KWSYS_CXX_HAS_SETENV" \
  "${linearbuild_source_dir}/Source/kwsys/kwsysPlatformTestsCXX.cxx" >> linearbuild_bootstrap.log 2>&1; then
  KWSYS_CXX_HAS_SETENV=1
  echo "${linearbuild_cxx_compiler} has setenv"
else
  echo "${linearbuild_cxx_compiler} does not have setenv"
fi

if linearbuild_try_run "${linearbuild_cxx_compiler}" \
  "${linearbuild_cxx_flags} ${linearbuild_ld_flags} -DTEST_KWSYS_CXX_HAS_UNSETENV" \
  "${linearbuild_source_dir}/Source/kwsys/kwsysPlatformTestsCXX.cxx" >> linearbuild_bootstrap.log 2>&1; then
  KWSYS_CXX_HAS_UNSETENV=1
  echo "${linearbuild_cxx_compiler} has unsetenv"
else
  echo "${linearbuild_cxx_compiler} does not have unsetenv"
fi

if linearbuild_try_run "${linearbuild_cxx_compiler}" \
  "${linearbuild_cxx_flags} ${linearbuild_ld_flags} -DTEST_KWSYS_CXX_HAS_ENVIRON_IN_STDLIB_H" \
  "${linearbuild_source_dir}/Source/kwsys/kwsysPlatformTestsCXX.cxx" >> linearbuild_bootstrap.log 2>&1; then
  KWSYS_CXX_HAS_ENVIRON_IN_STDLIB_H=1
  echo "${linearbuild_cxx_compiler} has environ in stdlib.h"
else
  echo "${linearbuild_cxx_compiler} does not have environ in stdlib.h"
fi

if linearbuild_try_run "${linearbuild_cxx_compiler}" \
  "${linearbuild_cxx_flags} ${linearbuild_ld_flags} -DTEST_KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H" \
  "${linearbuild_source_dir}/Source/kwsys/kwsysPlatformTestsCXX.cxx" >> linearbuild_bootstrap.log 2>&1; then
  KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H=1
  echo "${linearbuild_cxx_compiler} has <ext/stdio_filebuf.h>"
else
  echo "${linearbuild_cxx_compiler} does not have <ext/stdio_filebuf.h>"
fi

if test -n "${linearbuild_ccache_enabled}"; then
  echo "Building LinearBuild with ccache"
  linearbuild_c_compiler="ccache ${linearbuild_c_compiler}"
  linearbuild_cxx_compiler="ccache ${linearbuild_cxx_compiler}"
fi

# Just to be safe, let us store compiler and flags to the header file

linearbuild_bootstrap_version='$Revision$'
linearbuild_compiler_settings_comment="/*
 * Generated by ${linearbuild_source_dir}/bootstrap
 * Version:     ${linearbuild_bootstrap_version}
 *
 * Source directory: ${linearbuild_source_dir}
 * Binary directory: ${linearbuild_bootstrap_dir}
 *
 * C compiler:   ${linearbuild_c_compiler}
 * C flags:      ${linearbuild_c_flags}
 *
 * C++ compiler: ${linearbuild_cxx_compiler}
 * C++ flags:    ${linearbuild_cxx_flags}
 *
 * Make:         ${linearbuild_make_processor}
 *
 * Sources:
 * ${LINEARBUILD_CXX_SOURCES} ${LINEARBUILD_C_SOURCES}
 * STD Sources:
 * ${LINEARBUILD_STD_CXX_HEADERS} ${LINEARBUILD_STD_CXX_SOURCES}
 * LexerParser Sources:
 * ${LexerParser_CXX_SOURCES} ${LexerParser_C_SOURCES}
 * kwSys Sources:
 * ${KWSYS_CXX_SOURCES} ${KWSYS_C_SOURCES}
 * libuv Sources:
 * ${LIBUV_C_SOURCES}
 * jsoncpp Sources:
 * ${JSONCPP_CXX_SOURCES}
 * librhash Sources:
 * ${LIBRHASH_C_SOURCES}
 */
"

linearbuild_report cmConfigure.h${_tmp} "${linearbuild_compiler_settings_comment}"

# When bootstrapping on MinGW with MSYS we must convert the source
# directory to a windows path.
if ${linearbuild_system_mingw}; then
    LINEARBUILD_BOOTSTRAP_SOURCE_DIR=`cd "${linearbuild_source_dir}"; pwd -W`
    LINEARBUILD_BOOTSTRAP_BINARY_DIR=`cd "${linearbuild_binary_dir}"; pwd -W`
else
    LINEARBUILD_BOOTSTRAP_SOURCE_DIR="${linearbuild_source_dir}"
    LINEARBUILD_BOOTSTRAP_BINARY_DIR="${linearbuild_binary_dir}"
fi

# Write LinearBuild version
linearbuild_report cmVersionConfig.h${_tmp} "#define LinearBuild_VERSION_MAJOR ${linearbuild_version_major}"
linearbuild_report cmVersionConfig.h${_tmp} "#define LinearBuild_VERSION_MINOR ${linearbuild_version_minor}"
linearbuild_report cmVersionConfig.h${_tmp} "#define LinearBuild_VERSION_PATCH ${linearbuild_version_patch}"
linearbuild_report cmVersionConfig.h${_tmp} "#define LinearBuild_VERSION \"${linearbuild_version}\""
linearbuild_report cmConfigure.h${_tmp} "#define LINEARBUILD_BOOTSTRAP_SOURCE_DIR \"${LINEARBUILD_BOOTSTRAP_SOURCE_DIR}\""
linearbuild_report cmConfigure.h${_tmp} "#define LINEARBUILD_BOOTSTRAP_BINARY_DIR \"${LINEARBUILD_BOOTSTRAP_BINARY_DIR}\""
linearbuild_report cmConfigure.h${_tmp} "#define LinearBuild_DEFAULT_RECURSION_LIMIT 400"
linearbuild_report cmConfigure.h${_tmp} "#define LINEARBUILD_BIN_DIR \"/bootstrap-not-installed\""
linearbuild_report cmConfigure.h${_tmp} "#define LINEARBUILD_DATA_DIR \"/bootstrap-not-installed\""
linearbuild_report cmConfigure.h${_tmp} "#define CM_FALLTHROUGH"

if test "${linearbuild_bootstrap_generator}" = "Ninja"; then
  linearbuild_report cmConfigure.h${_tmp} "#define LINEARBUILD_BOOTSTRAP_NINJA"
else
  linearbuild_report cmConfigure.h${_tmp} "#define LINEARBUILD_BOOTSTRAP_MAKEFILES"
fi

if ${linearbuild_system_darwin}; then
  linearbuild_report cmConfigure.h${_tmp} "#define LinearBuild_USE_MACH_PARSER"
fi

if ${linearbuild_system_mingw}; then
  linearbuild_report cmConfigure.h${_tmp} "#if defined(_WIN32) && !defined(NOMINMAX)"
  linearbuild_report cmConfigure.h${_tmp} "#  define NOMINMAX"
  linearbuild_report cmConfigure.h${_tmp} "#endif"
  linearbuild_report cmConfigure.h${_tmp} "#if defined(_WIN32) && !defined(KWSYS_ENCODING_DEFAULT_CODEPAGE)"
  linearbuild_report cmConfigure.h${_tmp} "#  define KWSYS_ENCODING_DEFAULT_CODEPAGE CP_UTF8"
  linearbuild_report cmConfigure.h${_tmp} "#endif"
fi

# Regenerate configured headers
for h in Configure VersionConfig; do
  if "${_diff}" cm${h}.h cm${h}.h${_tmp} > /dev/null 2> /dev/null; then
    rm -f cm${h}.h${_tmp}
  else
    mv -f cm${h}.h${_tmp} cm${h}.h
  fi
done

# Prepare KWSYS
cmsys_header_files="cmsys/Configure.h cmsys/Configure.hxx"
linearbuild_kwsys_config_replace_string \
  "${linearbuild_source_dir}/Source/kwsys/Configure.hxx.in" \
  "${linearbuild_bootstrap_dir}/cmsys/Configure.hxx" \
  "${linearbuild_compiler_settings_comment}"
linearbuild_kwsys_config_replace_string \
  "${linearbuild_source_dir}/Source/kwsys/Configure.h.in" \
  "${linearbuild_bootstrap_dir}/cmsys/Configure.h" \
  "${linearbuild_compiler_settings_comment}"

for a in ${KWSYS_FILES}; do
  linearbuild_replace_string "${linearbuild_source_dir}/Source/kwsys/${a}.in" \
     "${linearbuild_bootstrap_dir}/cmsys/${a}" KWSYS_NAMESPACE cmsys
  cmsys_header_files="${cmsys_header_files} cmsys/${a}"
done

echo "#pragma once" > "${linearbuild_bootstrap_dir}/cmThirdParty.h.tmp"
if test "x${bootstrap_system_libuv}" != "x"; then
  echo "#define LINEARBUILD_USE_SYSTEM_LIBUV" >> "${linearbuild_bootstrap_dir}/cmThirdParty.h.tmp"
