#-----------------------------------------------------------------------------
# set some special flags for different compilers
#
if(WIN32 AND RBLXBUILD_C_COMPILER_ID STREQUAL "Intel")
  set(_INTEL_WINDOWS 1)
endif()

if(WIN32 AND RBLXBUILD_C_COMPILER_ID MATCHES "^(Clang|IntelLLVM)$"
   AND "x${RBLXBUILD_CXX_SIMULATE_ID}" STREQUAL "xMSVC")
  set(_CLANG_MSVC_WINDOWS 1)
endif()

# Disable deprecation warnings for standard C functions.
# really only needed for newer versions of VS, but should
# not hurt other versions, and this will work into the
# future
if(MSVC OR _INTEL_WINDOWS OR _CLANG_MSVC_WINDOWS)
  add_compile_definitions(_CRT_SECURE_NO_DEPRECATE _CRT_NONSTDC_NO_DEPRECATE)
else()
endif()

# MSVC 14.28 enables C5105, but the Windows SDK 10.0.18362.0 triggers it.
if(RBLXBUILD_C_COMPILER_ID STREQUAL "MSVC" AND NOT RBLXBUILD_C_COMPILER_VERSION VERSION_LESS 19.28)
  set(RBLXBUILD_C_FLAGS "${RBLXBUILD_C_FLAGS} -wd5105")
  set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS} -wd5105")
endif()

# Use a stack size large enough for RBLXBuild_DEFAULT_RECURSION_LIMIT.
if(MSVC)
  string(APPEND RBLXBUILD_EXE_LINKER_FLAGS " ${RBLXBUILD_CXX_LINKER_WRAPPER_FLAG}-stack:10000000")
elseif(MINGW OR MSYS OR CYGWIN)
  string(APPEND RBLXBUILD_EXE_LINKER_FLAGS " -Wl,--stack,10000000")
elseif(_CLANG_MSVC_WINDOWS AND "x${RBLXBUILD_CXX_COMPILER_FRONTEND_VARIANT}" STREQUAL "xGNU")
  string(APPEND RBLXBUILD_EXE_LINKER_FLAGS " -Xlinker -stack:20000000")
endif()

# Silence "Additional optimization may be attained by recompiling and
# specifying MAXMEM option" warning on XLC (AIX)
if(RBLXBUILD_CXX_COMPILER_ID MATCHES "^(XL|XLClang)$")
  string(APPEND RBLXBUILD_CXX_FLAGS " -qmaxmem=-1")
endif()

# Silence duplicate symbol warnings on AIX
if(RBLXBUILD_SYSTEM_NAME MATCHES "AIX")
  if(NOT RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_EXE_LINKER_FLAGS "${RBLXBUILD_EXE_LINKER_FLAGS} -bhalt:5 ")
  endif()
endif()

if(RBLXBUILD_SYSTEM MATCHES "OSF1-V")
  if(NOT RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS} -timplicit_local -no_implicit_include ")
  endif()
endif()

# Workaround for short jump tables on PA-RISC
if(RBLXBUILD_SYSTEM_PROCESSOR MATCHES "^parisc")
  if(RBLXBUILD_C_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_C_FLAGS "${RBLXBUILD_C_FLAGS} -mlong-calls")
  endif()
  if(RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS} -mlong-calls")
  endif()
endif()

# Use 64-bit off_t on 32-bit Linux
if (RBLXBUILD_SYSTEM_NAME STREQUAL "Linux" AND RBLXBUILD_SIZEOF_VOID_P EQUAL 4)
  # Use 64-bit off_t even in 32-bit builds.
  add_compile_definitions(_FILE_OFFSET_BITS=64)

  # Use 64-bit time_t even in 32-bit builds.  Skip this with
  # system libarchive because its ABI uses the default time_t.
  if (NOT RBLXBUILD_USE_SYSTEM_LIBARCHIVE)
    add_compile_definitions(_TIME_BITS=64)
  endif()
endif()

# Workaround for TOC Overflow on ppc64
set(bigTocFlag "")
if(RBLXBUILD_SYSTEM_NAME STREQUAL "AIX" AND
   RBLXBUILD_SYSTEM_PROCESSOR MATCHES "powerpc")
  set(bigTocFlag "-Wl,-bbigtoc")
elseif(RBLXBUILD_SYSTEM_NAME STREQUAL "Linux" AND
   RBLXBUILD_SYSTEM_PROCESSOR MATCHES "ppc64")
  set(bigTocFlag "-Wl,--no-multi-toc")
endif()
if(bigTocFlag)
  include(CheckCXXLinkerFlag)
  check_cxx_linker_flag(${bigTocFlag} BIG_TOC_FLAG_SUPPORTED)
  if(BIG_TOC_FLAG_SUPPORTED)
    set(RBLXBUILD_EXE_LINKER_FLAGS "${RBLXBUILD_EXE_LINKER_FLAGS} ${bigTocFlag}")
  endif()
endif()

if (RBLXBUILD_CXX_COMPILER_ID STREQUAL SunPro AND
    NOT DEFINED RBLXBUILD_CXX${RBLXBUILD_CXX_STANDARD}_STANDARD_COMPILE_OPTION)
  if (NOT RBLXBUILD_CXX_COMPILER_VERSION VERSION_LESS 5.13)
    if (NOT RBLXBUILD_CXX_STANDARD OR RBLXBUILD_CXX_STANDARD EQUAL 98)
      set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS} -std=c++03")
    endif()
  else()
    set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS} -library=stlport4")
  endif()
endif()

foreach(lang IN ITEMS C CXX)
  # Suppress warnings from PGI compiler.
  if (RBLXBUILD_${lang}_COMPILER_ID STREQUAL "PGI")
    set(RBLXBUILD_${lang}_FLAGS "${RBLXBUILD_${lang}_FLAGS} -w")
  endif()
endforeach()

# RBLXBuild's own sources are UTF-8.  The Embarcadero (EMBTClang) bcc64x compiler
# defaults the narrow execution code page to the host ANSI code page, unlike
# Clang and MSVC which preserve UTF-8, so non-ASCII narrow string literals such
# as the localized regexes in Source/CTest/cmCTestBuildHandler.cxx are corrupted.
# Select UTF-8 (code page 65001) when building RBLXBuild itself with EMBTClang.
foreach(lang IN ITEMS C CXX)
  if(RBLXBUILD_${lang}_COMPILER_ID STREQUAL "EMBTClang")
    string(APPEND RBLXBUILD_${lang}_FLAGS " -fborland-exec-code-page=65001")
  endif()
endforeach()

# use the ansi CXX compile flag for building rblxbuild
if (RBLXBUILD_ANSI_CXXFLAGS)
  set(RBLXBUILD_CXX_FLAGS "${RBLXBUILD_CXX_FLAGS} ${RBLXBUILD_ANSI_CXXFLAGS}")
endif ()

if (RBLXBUILD_ANSI_CFLAGS)
  set(RBLXBUILD_C_FLAGS "${RBLXBUILD_C_FLAGS} ${RBLXBUILD_ANSI_CFLAGS}")
endif ()

# Allow per-translation-unit parallel builds when using MSVC
if(RBLXBUILD_GENERATOR MATCHES "Visual Studio" AND
   (RBLXBUILD_C_COMPILER_ID MATCHES "MSVC|Intel" OR
   RBLXBUILD_CXX_COMPILER_ID MATCHES "MSVC|Intel"))

  set(RBLXBuild_MSVC_PARALLEL ON CACHE STRING "\
Enables /MP flag for parallel builds using MSVC. Specify an \
integer value to control the number of threads used (Only \
works on some older versions of Visual Studio). Setting to \
ON lets the toolchain decide how many threads to use. Set to \
OFF to disable /MP completely." )

  if(RBLXBuild_MSVC_PARALLEL)
    if(RBLXBuild_MSVC_PARALLEL GREATER 0)
      string(APPEND RBLXBUILD_C_FLAGS " /MP${RBLXBuild_MSVC_PARALLEL}")
      string(APPEND RBLXBUILD_CXX_FLAGS " /MP${RBLXBuild_MSVC_PARALLEL}")
    else()
      string(APPEND RBLXBUILD_C_FLAGS " /MP")
      string(APPEND RBLXBUILD_CXX_FLAGS " /MP")
    endif()
  endif()
endif()

# Get rid of excess -Wunused-but-set-variable on release builds with LCC >= 1.26
foreach(l IN ITEMS C CXX)
  if(RBLXBUILD_${l}_COMPILER_ID STREQUAL "LCC" AND NOT RBLXBUILD_${l}_COMPILER_VERSION VERSION_LESS 1.26)
    foreach(c IN ITEMS MINSIZEREL RELEASE RELWITHDEBINFO)
      string(APPEND "RBLXBUILD_${l}_FLAGS_${c}" " -Wno-unused-but-set-variable")
    endforeach()
  endif()
endforeach()
