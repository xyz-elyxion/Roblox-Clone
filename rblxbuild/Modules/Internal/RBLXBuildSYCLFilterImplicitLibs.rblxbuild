macro(rblxbuild_sycl_filter_implicit_libs variable)
  foreach(library IN LISTS ${variable})
    get_filename_component(library_name "${library}" NAME)
    if(library_name MATCHES "^(lib)?sycl([0-9]+d?|-devicelib-host)?([.]lib|[.]a|[.]so([.][0-9]+)*|[.]dylib)?$")
      list(APPEND RBLXBUILD_SYCL_RUNTIME_LIBRARY_LINK_OPTIONS_DEFAULT "${library}")
      list(REMOVE_ITEM ${variable} "${library}")
    endif()
  endforeach()
  if(RBLXBUILD_SYCL_RUNTIME_LIBRARY_LINK_OPTIONS_DEFAULT)
    list(REMOVE_DUPLICATES RBLXBUILD_SYCL_RUNTIME_LIBRARY_LINK_OPTIONS_DEFAULT)
    set(RBLXBUILD_SYCL_RUNTIME_LIBRARY_DEFAULT DEFAULT)
  endif()
endmacro()
