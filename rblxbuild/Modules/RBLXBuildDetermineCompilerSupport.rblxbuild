function(rblxbuild_determine_compiler_support lang)

  if("x${lang}" STREQUAL "xC" AND COMMAND rblxbuild_record_c_compile_features)
    set(compile_feature_vars
      RBLXBUILD_C_COMPILE_FEATURES
      RBLXBUILD_C90_COMPILE_FEATURES
      RBLXBUILD_C99_COMPILE_FEATURES
      RBLXBUILD_C11_COMPILE_FEATURES
      RBLXBUILD_C17_COMPILE_FEATURES
      RBLXBUILD_C23_COMPILE_FEATURES
    )
    set(all_defined 1)
    set(any_non_empty 0)
    foreach (var IN LISTS compile_feature_vars)
      if (NOT DEFINED "${var}")
        set(all_defined 0)
      elseif (${var})
        set(any_non_empty 1)
      endif ()
    endforeach ()
    if (all_defined AND any_non_empty)
      return ()
    endif ()

    message(CHECK_START "Detecting ${lang} compile features")

    set(RBLXBUILD_C90_COMPILE_FEATURES)
    set(RBLXBUILD_C99_COMPILE_FEATURES)
    set(RBLXBUILD_C11_COMPILE_FEATURES)
    set(RBLXBUILD_C17_COMPILE_FEATURES)
    set(RBLXBUILD_C23_COMPILE_FEATURES)

    include("${RBLXBUILD_ROOT}/Modules/Internal/FeatureTesting.rblxbuild")

    rblxbuild_record_c_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (RBLXBUILD_C17_COMPILE_FEATURES AND RBLXBUILD_C23_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_C23_COMPILE_FEATURES ${RBLXBUILD_C17_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_C11_COMPILE_FEATURES AND RBLXBUILD_C17_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_C17_COMPILE_FEATURES ${RBLXBUILD_C11_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_C99_COMPILE_FEATURES AND RBLXBUILD_C11_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_C11_COMPILE_FEATURES ${RBLXBUILD_C99_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_C90_COMPILE_FEATURES AND RBLXBUILD_C99_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_C99_COMPILE_FEATURES ${RBLXBUILD_C90_COMPILE_FEATURES})
    endif()

    if(NOT RBLXBUILD_C_COMPILE_FEATURES)
      set(RBLXBUILD_C_COMPILE_FEATURES
        ${RBLXBUILD_C90_COMPILE_FEATURES}
        ${RBLXBUILD_C99_COMPILE_FEATURES}
        ${RBLXBUILD_C11_COMPILE_FEATURES}
        ${RBLXBUILD_C17_COMPILE_FEATURES}
        ${RBLXBUILD_C23_COMPILE_FEATURES}
      )
    endif()

    set(RBLXBUILD_C_COMPILE_FEATURES ${RBLXBUILD_C_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_C90_COMPILE_FEATURES ${RBLXBUILD_C90_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_C99_COMPILE_FEATURES ${RBLXBUILD_C99_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_C11_COMPILE_FEATURES ${RBLXBUILD_C11_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_C17_COMPILE_FEATURES ${RBLXBUILD_C17_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_C23_COMPILE_FEATURES ${RBLXBUILD_C23_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  elseif("x${lang}" STREQUAL "xCXX" AND COMMAND rblxbuild_record_cxx_compile_features)
    set(compile_feature_vars
      RBLXBUILD_CXX_COMPILE_FEATURES
      RBLXBUILD_CXX98_COMPILE_FEATURES
      RBLXBUILD_CXX11_COMPILE_FEATURES
      RBLXBUILD_CXX14_COMPILE_FEATURES
      RBLXBUILD_CXX17_COMPILE_FEATURES
      RBLXBUILD_CXX20_COMPILE_FEATURES
      RBLXBUILD_CXX23_COMPILE_FEATURES
      RBLXBUILD_CXX26_COMPILE_FEATURES
    )
    set(all_defined 1)
    set(any_non_empty 0)
    foreach (var IN LISTS compile_feature_vars)
      if (NOT DEFINED "${var}")
        set(all_defined 0)
      elseif (${var})
        set(any_non_empty 1)
      endif ()
    endforeach ()
    set(need_feature_detection 1)
    if (all_defined AND any_non_empty)
      set(need_feature_detection 0)
    endif ()

    if (need_feature_detection)
      message(CHECK_START "Detecting ${lang} compile features")

      set(RBLXBUILD_CXX98_COMPILE_FEATURES)
      set(RBLXBUILD_CXX11_COMPILE_FEATURES)
      set(RBLXBUILD_CXX14_COMPILE_FEATURES)
      set(RBLXBUILD_CXX17_COMPILE_FEATURES)
      set(RBLXBUILD_CXX20_COMPILE_FEATURES)
      set(RBLXBUILD_CXX23_COMPILE_FEATURES)
      set(RBLXBUILD_CXX26_COMPILE_FEATURES)

      include("${RBLXBUILD_ROOT}/Modules/Internal/FeatureTesting.rblxbuild")

      rblxbuild_record_cxx_compile_features()

      if(NOT _result EQUAL 0)
        message(CHECK_FAIL "failed")
        return()
      endif()

      if (RBLXBUILD_CXX23_COMPILE_FEATURES AND RBLXBUILD_CXX26_COMPILE_FEATURES)
        list(REMOVE_ITEM RBLXBUILD_CXX26_COMPILE_FEATURES ${RBLXBUILD_CXX23_COMPILE_FEATURES})
      endif()
      if (RBLXBUILD_CXX20_COMPILE_FEATURES AND RBLXBUILD_CXX23_COMPILE_FEATURES)
        list(REMOVE_ITEM RBLXBUILD_CXX23_COMPILE_FEATURES ${RBLXBUILD_CXX20_COMPILE_FEATURES})
      endif()
      if (RBLXBUILD_CXX17_COMPILE_FEATURES AND RBLXBUILD_CXX20_COMPILE_FEATURES)
        list(REMOVE_ITEM RBLXBUILD_CXX20_COMPILE_FEATURES ${RBLXBUILD_CXX17_COMPILE_FEATURES})
      endif()
      if (RBLXBUILD_CXX14_COMPILE_FEATURES AND RBLXBUILD_CXX17_COMPILE_FEATURES)
        list(REMOVE_ITEM RBLXBUILD_CXX17_COMPILE_FEATURES ${RBLXBUILD_CXX14_COMPILE_FEATURES})
      endif()
      if (RBLXBUILD_CXX11_COMPILE_FEATURES AND RBLXBUILD_CXX14_COMPILE_FEATURES)
        list(REMOVE_ITEM RBLXBUILD_CXX14_COMPILE_FEATURES ${RBLXBUILD_CXX11_COMPILE_FEATURES})
      endif()
      if (RBLXBUILD_CXX98_COMPILE_FEATURES AND RBLXBUILD_CXX11_COMPILE_FEATURES)
        list(REMOVE_ITEM RBLXBUILD_CXX11_COMPILE_FEATURES ${RBLXBUILD_CXX98_COMPILE_FEATURES})
      endif()

      if(NOT RBLXBUILD_CXX_COMPILE_FEATURES)
        set(RBLXBUILD_CXX_COMPILE_FEATURES
          ${RBLXBUILD_CXX98_COMPILE_FEATURES}
          ${RBLXBUILD_CXX11_COMPILE_FEATURES}
          ${RBLXBUILD_CXX14_COMPILE_FEATURES}
          ${RBLXBUILD_CXX17_COMPILE_FEATURES}
          ${RBLXBUILD_CXX20_COMPILE_FEATURES}
          ${RBLXBUILD_CXX23_COMPILE_FEATURES}
          ${RBLXBUILD_CXX26_COMPILE_FEATURES}
        )
      endif()
    endif ()

    rblxbuild_cxx_find_modules_json()

    set(RBLXBUILD_CXX_STDLIB_MODULES_JSON ${RBLXBUILD_CXX_STDLIB_MODULES_JSON} PARENT_SCOPE)
    set(RBLXBUILD_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE "${RBLXBUILD_CXX_COMPILER_IMPORT_STD_ERROR_MESSAGE}" PARENT_SCOPE)

    if (need_feature_detection)
      set(RBLXBUILD_CXX_COMPILE_FEATURES ${RBLXBUILD_CXX_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX98_COMPILE_FEATURES ${RBLXBUILD_CXX98_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX11_COMPILE_FEATURES ${RBLXBUILD_CXX11_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX14_COMPILE_FEATURES ${RBLXBUILD_CXX14_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX17_COMPILE_FEATURES ${RBLXBUILD_CXX17_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX20_COMPILE_FEATURES ${RBLXBUILD_CXX20_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX23_COMPILE_FEATURES ${RBLXBUILD_CXX23_COMPILE_FEATURES} PARENT_SCOPE)
      set(RBLXBUILD_CXX26_COMPILE_FEATURES ${RBLXBUILD_CXX26_COMPILE_FEATURES} PARENT_SCOPE)

      message(CHECK_PASS "done")
    endif ()

  elseif("x${lang}" STREQUAL "xCUDA" AND COMMAND rblxbuild_record_cuda_compile_features)
    message(CHECK_START "Detecting ${lang} compile features")

    set(RBLXBUILD_CUDA03_COMPILE_FEATURES)
    set(RBLXBUILD_CUDA11_COMPILE_FEATURES)
    set(RBLXBUILD_CUDA14_COMPILE_FEATURES)
    set(RBLXBUILD_CUDA17_COMPILE_FEATURES)
    set(RBLXBUILD_CUDA20_COMPILE_FEATURES)
    set(RBLXBUILD_CUDA23_COMPILE_FEATURES)
    set(RBLXBUILD_CUDA26_COMPILE_FEATURES)

    include("${RBLXBUILD_ROOT}/Modules/Internal/FeatureTesting.rblxbuild")

    rblxbuild_record_cuda_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (RBLXBUILD_CUDA23_COMPILE_FEATURES AND RBLXBUILD_CUDA26_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_CUDA26_COMPILE_FEATURES ${RBLXBUILD_CUDA23_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_CUDA20_COMPILE_FEATURES AND RBLXBUILD_CUDA23_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_CUDA23_COMPILE_FEATURES ${RBLXBUILD_CUDA20_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_CUDA17_COMPILE_FEATURES AND RBLXBUILD_CUDA20_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_CUDA20_COMPILE_FEATURES ${RBLXBUILD_CUDA17_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_CUDA14_COMPILE_FEATURES AND RBLXBUILD_CUDA17_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_CUDA17_COMPILE_FEATURES ${RBLXBUILD_CUDA14_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_CUDA11_COMPILE_FEATURES AND RBLXBUILD_CUDA14_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_CUDA14_COMPILE_FEATURES ${RBLXBUILD_CUDA11_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_CUDA03_COMPILE_FEATURES AND RBLXBUILD_CUDA11_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_CUDA11_COMPILE_FEATURES ${RBLXBUILD_CUDA03_COMPILE_FEATURES})
    endif()

    if(NOT RBLXBUILD_CUDA_COMPILE_FEATURES)
      set(RBLXBUILD_CUDA_COMPILE_FEATURES
        ${RBLXBUILD_CUDA03_COMPILE_FEATURES}
        ${RBLXBUILD_CUDA11_COMPILE_FEATURES}
        ${RBLXBUILD_CUDA14_COMPILE_FEATURES}
        ${RBLXBUILD_CUDA17_COMPILE_FEATURES}
        ${RBLXBUILD_CUDA20_COMPILE_FEATURES}
        ${RBLXBUILD_CUDA23_COMPILE_FEATURES}
        ${RBLXBUILD_CUDA26_COMPILE_FEATURES}
      )
    endif()

    set(RBLXBUILD_CUDA_COMPILE_FEATURES ${RBLXBUILD_CUDA_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA03_COMPILE_FEATURES ${RBLXBUILD_CUDA03_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA11_COMPILE_FEATURES ${RBLXBUILD_CUDA11_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA14_COMPILE_FEATURES ${RBLXBUILD_CUDA14_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA17_COMPILE_FEATURES ${RBLXBUILD_CUDA17_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA20_COMPILE_FEATURES ${RBLXBUILD_CUDA20_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA23_COMPILE_FEATURES ${RBLXBUILD_CUDA23_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_CUDA26_COMPILE_FEATURES ${RBLXBUILD_CUDA26_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  elseif(lang STREQUAL HIP AND COMMAND rblxbuild_record_hip_compile_features)
    message(CHECK_START "Detecting ${lang} compile features")

    set(RBLXBUILD_HIP98_COMPILE_FEATURES)
    set(RBLXBUILD_HIP11_COMPILE_FEATURES)
    set(RBLXBUILD_HIP14_COMPILE_FEATURES)
    set(RBLXBUILD_HIP17_COMPILE_FEATURES)
    set(RBLXBUILD_HIP20_COMPILE_FEATURES)
    set(RBLXBUILD_HIP23_COMPILE_FEATURES)
    set(RBLXBUILD_HIP26_COMPILE_FEATURES)


    include("${RBLXBUILD_ROOT}/Modules/Internal/FeatureTesting.rblxbuild")

    rblxbuild_record_hip_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (RBLXBUILD_HIP23_COMPILE_FEATURES AND RBLXBUILD_HIP26_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_HIP26_COMPILE_FEATURES ${RBLXBUILD_HIP23_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_HIP20_COMPILE_FEATURES AND RBLXBUILD_HIP23_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_HIP23_COMPILE_FEATURES ${RBLXBUILD_HIP20_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_HIP17_COMPILE_FEATURES AND RBLXBUILD_HIP20_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_HIP20_COMPILE_FEATURES ${RBLXBUILD_HIP17_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_HIP14_COMPILE_FEATURES AND RBLXBUILD_HIP17_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_HIP17_COMPILE_FEATURES ${RBLXBUILD_HIP14_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_HIP11_COMPILE_FEATURES AND RBLXBUILD_HIP14_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_HIP14_COMPILE_FEATURES ${RBLXBUILD_HIP11_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_HIP98_COMPILE_FEATURES AND RBLXBUILD_HIP11_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_HIP11_COMPILE_FEATURES ${RBLXBUILD_HIP98_COMPILE_FEATURES})
    endif()

    if(NOT RBLXBUILD_HIP_COMPILE_FEATURES)
      set(RBLXBUILD_HIP_COMPILE_FEATURES
        ${RBLXBUILD_HIP98_COMPILE_FEATURES}
        ${RBLXBUILD_HIP11_COMPILE_FEATURES}
        ${RBLXBUILD_HIP14_COMPILE_FEATURES}
        ${RBLXBUILD_HIP17_COMPILE_FEATURES}
        ${RBLXBUILD_HIP20_COMPILE_FEATURES}
        ${RBLXBUILD_HIP23_COMPILE_FEATURES}
        ${RBLXBUILD_HIP26_COMPILE_FEATURES}
      )
    endif()

    set(RBLXBUILD_HIP_COMPILE_FEATURES ${RBLXBUILD_HIP_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP98_COMPILE_FEATURES ${RBLXBUILD_HIP98_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP11_COMPILE_FEATURES ${RBLXBUILD_HIP11_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP14_COMPILE_FEATURES ${RBLXBUILD_HIP14_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP17_COMPILE_FEATURES ${RBLXBUILD_HIP17_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP20_COMPILE_FEATURES ${RBLXBUILD_HIP20_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP23_COMPILE_FEATURES ${RBLXBUILD_HIP23_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_HIP26_COMPILE_FEATURES ${RBLXBUILD_HIP26_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  elseif("x${lang}" STREQUAL "xSYCL" AND COMMAND rblxbuild_record_sycl_compile_features)
    message(CHECK_START "Detecting ${lang} compile features")

    set(RBLXBUILD_SYCL98_COMPILE_FEATURES)
    set(RBLXBUILD_SYCL11_COMPILE_FEATURES)
    set(RBLXBUILD_SYCL14_COMPILE_FEATURES)
    set(RBLXBUILD_SYCL17_COMPILE_FEATURES)
    set(RBLXBUILD_SYCL20_COMPILE_FEATURES)
    set(RBLXBUILD_SYCL23_COMPILE_FEATURES)
    set(RBLXBUILD_SYCL26_COMPILE_FEATURES)

    include("${RBLXBUILD_ROOT}/Modules/Internal/FeatureTesting.rblxbuild")

    rblxbuild_record_sycl_compile_features()

    if(NOT _result EQUAL 0)
      message(CHECK_FAIL "failed")
      return()
    endif()

    if (RBLXBUILD_SYCL23_COMPILE_FEATURES AND RBLXBUILD_SYCL26_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_SYCL26_COMPILE_FEATURES ${RBLXBUILD_SYCL23_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_SYCL20_COMPILE_FEATURES AND RBLXBUILD_SYCL23_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_SYCL23_COMPILE_FEATURES ${RBLXBUILD_SYCL20_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_SYCL17_COMPILE_FEATURES AND RBLXBUILD_SYCL20_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_SYCL20_COMPILE_FEATURES ${RBLXBUILD_SYCL17_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_SYCL14_COMPILE_FEATURES AND RBLXBUILD_SYCL17_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_SYCL17_COMPILE_FEATURES ${RBLXBUILD_SYCL14_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_SYCL11_COMPILE_FEATURES AND RBLXBUILD_SYCL14_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_SYCL14_COMPILE_FEATURES ${RBLXBUILD_SYCL11_COMPILE_FEATURES})
    endif()
    if (RBLXBUILD_SYCL98_COMPILE_FEATURES AND RBLXBUILD_SYCL11_COMPILE_FEATURES)
      list(REMOVE_ITEM RBLXBUILD_SYCL11_COMPILE_FEATURES ${RBLXBUILD_SYCL98_COMPILE_FEATURES})
    endif()

    if(NOT RBLXBUILD_SYCL_COMPILE_FEATURES)
      set(RBLXBUILD_SYCL_COMPILE_FEATURES
        ${RBLXBUILD_SYCL98_COMPILE_FEATURES}
        ${RBLXBUILD_SYCL11_COMPILE_FEATURES}
        ${RBLXBUILD_SYCL14_COMPILE_FEATURES}
        ${RBLXBUILD_SYCL17_COMPILE_FEATURES}
        ${RBLXBUILD_SYCL20_COMPILE_FEATURES}
        ${RBLXBUILD_SYCL23_COMPILE_FEATURES}
        ${RBLXBUILD_SYCL26_COMPILE_FEATURES}
      )
    endif()

    set(RBLXBUILD_SYCL_COMPILE_FEATURES ${RBLXBUILD_SYCL_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL98_COMPILE_FEATURES ${RBLXBUILD_SYCL98_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL11_COMPILE_FEATURES ${RBLXBUILD_SYCL11_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL14_COMPILE_FEATURES ${RBLXBUILD_SYCL14_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL17_COMPILE_FEATURES ${RBLXBUILD_SYCL17_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL20_COMPILE_FEATURES ${RBLXBUILD_SYCL20_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL23_COMPILE_FEATURES ${RBLXBUILD_SYCL23_COMPILE_FEATURES} PARENT_SCOPE)
    set(RBLXBUILD_SYCL26_COMPILE_FEATURES ${RBLXBUILD_SYCL26_COMPILE_FEATURES} PARENT_SCOPE)

    message(CHECK_PASS "done")

  endif()

endfunction()
