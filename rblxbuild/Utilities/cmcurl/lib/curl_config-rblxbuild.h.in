#rblxbuilddefine _FILE_OFFSET_BITS ${_FILE_OFFSET_BITS}

/* the signed version of size_t */
#ifndef SIZEOF_SSIZE_T
# if SIZEOF_LONG == SIZEOF_SIZE_T
   typedef long ssize_t;
# elif SIZEOF_LONG_LONG == SIZEOF_SIZE_T
   typedef long long ssize_t;
# elif SIZEOF___INT64 == SIZEOF_SIZE_T
   typedef __int64 ssize_t;
# else
   typedef int ssize_t;
# endif
#endif

/* Define to 1 if you have the mach_absolute_time function. */
#rblxbuilddefine HAVE_MACH_ABSOLUTE_TIME 1

/* to enable Windows IDN */
#rblxbuilddefine USE_WIN32_IDN 1

/* to enable Apple IDN */
#rblxbuilddefine USE_APPLE_IDN 1

/* to enable Apple OS-native certificate verification */
#rblxbuilddefine USE_APPLE_SECTRUST 1

/* to use Apple fast UDP (SYS_recvmsg_x, SYS_sendmsg_x) */
#rblxbuilddefine USE_APPLE_FAST_UDP

/* Define to 1 to query for HTTPSRR when using DoH */
#rblxbuilddefine USE_HTTPSRR 1

/* if ECH support is available */
#rblxbuilddefine USE_ECH 1

/* Define to 1 if you have the wolfSSL_CTX_GenerateEchConfig function. */
#rblxbuilddefine HAVE_WOLFSSL_CTX_GENERATEECHCONFIG 1

/* Define to 1 if you have the SSL_set1_ech_config_list function. */
#rblxbuilddefine HAVE_SSL_SET1_ECH_CONFIG_LIST 1

/* Define to 1 if OpenSSL has the DES_ecb_encrypt function. */
#rblxbuilddefine HAVE_DES_ECB_ENCRYPT 1
