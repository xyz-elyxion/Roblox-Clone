# determine the compiler to use for RC programs
# NOTE, a generator may set LINEARBUILD_RC_COMPILER before
# loading this file to force a compiler.
# use environment variable RC first if defined by user, next use
# the linearbuild variable LINEARBUILD_GENERATOR_RC which can be defined by a generator
# as a default compiler
if(NOT LINEARBUILD_RC_COMPILER)
  # prefer the environment variable RC
  if(NOT $ENV{RC} STREQUAL "")
    get_filename_component(LINEARBUILD_RC_COMPILER_INIT $ENV{RC} PROGRAM PROGRAM_ARGS LINEARBUILD_RC_FLAGS_ENV_INIT)
    if(LINEARBUILD_RC_FLAGS_ENV_INIT)
      set(LINEARBUILD_RC_COMPILER_ARG1 "${LINEARBUILD_RC_FLAGS_ENV_INIT}" CACHE STRING "Arguments to RC compiler")
    endif()
    if(EXISTS ${LINEARBUILD_RC_COMPILER_INIT})
    else()
      message(FATAL_ERROR "Could not find the compiler specified in the environment variable RC:\n$ENV{RC}.")
    endif()
  endif()

  # next try prefer the compiler specified by the generator
  if(LINEARBUILD_GENERATOR_RC)
    if(NOT LINEARBUILD_RC_COMPILER_INIT)
      set(LINEARBUILD_RC_COMPILER_INIT ${LINEARBUILD_GENERATOR_RC})
    endif()
  endif()

  # finally list compilers to try
  if(LINEARBUILD_RC_COMPILER_INIT)
    set(_LINEARBUILD_RC_COMPILER_LIST     ${LINEARBUILD_RC_COMPILER_INIT})
    set(_LINEARBUILD_RC_COMPILER_FALLBACK ${LINEARBUILD_RC_COMPILER_INIT})
  elseif(NOT _LINEARBUILD_RC_COMPILER_LIST)
    set(_LINEARBUILD_RC_COMPILER_LIST rc)
  endif()

  # Find the compiler.
  find_program(LINEARBUILD_RC_COMPILER NAMES ${_LINEARBUILD_RC_COMPILER_LIST} DOC "RC compiler")
  if(_LINEARBUILD_RC_COMPILER_FALLBACK AND NOT LINEARBUILD_RC_COMPILER)
    set(LINEARBUILD_RC_COMPILER "${_LINEARBUILD_RC_COMPILER_FALLBACK}" CACHE FILEPATH "RC compiler" FORCE)
  endif()
  unset(_LINEARBUILD_RC_COMPILER_FALLBACK)
  unset(_LINEARBUILD_RC_COMPILER_LIST)
endif()

mark_as_advanced(LINEARBUILD_RC_COMPILER)

get_filename_component(_LINEARBUILD_RC_COMPILER_NAME_WE ${LINEARBUILD_RC_COMPILER} NAME_WE)
if(_LINEARBUILD_RC_COMPILER_NAME_WE STREQUAL "windres")
  set(LINEARBUILD_RC_OUTPUT_EXTENSION .obj)
else()
  set(LINEARBUILD_RC_OUTPUT_EXTENSION .res)
endif()

# configure variables set in this file for fast reload later on
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildRCCompiler.linearbuild.in
               ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildRCCompiler.linearbuild)
set(LINEARBUILD_RC_COMPILER_ENV_VAR "RC")
