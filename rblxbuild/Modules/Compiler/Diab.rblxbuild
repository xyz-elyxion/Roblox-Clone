# This module is shared by multiple languages; use include blocker.
if(__COMPILER_Diab)
  return()
endif()
set(__COMPILER_Diab 1)

include(Compiler/RBLXBuildCommonCompilerMacros)

macro(__compiler_diab lang)
  set(RBLXBUILD_${lang}_VERBOSE_FLAG "-#")
  set(RBLXBUILD_${lang}_OUTPUT_EXTENSION ".o")

  string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -O -Xsize-opt")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -XO")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -XO -g3")

  set(__DIAB_AR "${RBLXBUILD_${lang}_COMPILER_AR}")
  set(RBLXBUILD_${lang}_CREATE_STATIC_LIBRARY "\"${__DIAB_AR}\"  -r <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_CREATE "\"${__DIAB_AR}\" -r <TARGET> <LINK_FLAGS> <OBJECTS>")

  set(_RBLXBUILD_${lang}_IPO_SUPPORTED_BY_RBLXBUILD YES)
  set(_RBLXBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_IPO -XO -Xwhole-program-optim)
endmacro()

set(RBLXBUILD_EXECUTABLE_SUFFIX "")
set(RBLXBUILD_LIBRARY_PATH_TERMINATOR "")
set(RBLXBUILD_LIBRARY_PATH_FLAG "")
