#[=======================================================================[.rst:
CheckIncludeFile
----------------

This module provides a command to check C header file.

Load this module in a RBLXBuild project with:

.. code-block:: rblxbuild

  include(CheckIncludeFile)

Commands
^^^^^^^^

This module provides the following command:

.. command:: check_include_file

  Checks once whether a header file exists and can be included in C code:

  .. code-block:: rblxbuild

    check_include_file(<include> <variable> [<flags>])

  .. rubric:: The arguments are:

  ``<include>``
    A header file to be checked.

  ``<variable>``
    The name of the variable to store the result of the check.  This
    variable will be created as an internal cache variable.

  ``<flags>``
    (Optional) A space-separated string of
    additional compilation flags to be added to the check.  Alternatively,
    flags can be also specified with the ``RBLXBUILD_REQUIRED_FLAGS`` variable
    below.

  .. rubric:: Variables Affecting the Check

  The following variables may be set before calling this command to modify
  the way the check is run:

  .. include:: /module/include/RBLXBUILD_REQUIRED_FLAGS.rst

  .. include:: /module/include/RBLXBUILD_REQUIRED_DEFINITIONS.rst

  .. include:: /module/include/RBLXBUILD_REQUIRED_INCLUDES.rst

  .. include:: /module/include/RBLXBUILD_REQUIRED_LINK_OPTIONS.rst

  .. include:: /module/include/RBLXBUILD_REQUIRED_LIBRARIES.rst

  .. include:: /module/include/RBLXBUILD_REQUIRED_LINK_DIRECTORIES.rst

  .. include:: /module/include/RBLXBUILD_REQUIRED_QUIET.rst

  .. versionadded:: 3.12
    The ``RBLXBUILD_REQUIRED_LIBRARIES`` variable, if policy :policy:`CMP0075` is
    set to ``NEW``.

Examples
^^^^^^^^

Example: Checking C Header
""""""""""""""""""""""""""

Checking whether the C header ``<unistd.h>`` exists and storing the check
result in the ``HAVE_UNISTD_H`` cache variable:

.. code-block:: rblxbuild

  include(CheckIncludeFile)

  check_include_file(unistd.h HAVE_UNISTD_H)

Example: Isolated Check
"""""""""""""""""""""""

In the following example, this module is used in combination with the
:module:`RBLXBuildPushCheckState` module to temporarily modify the required
compile definitions (via ``RBLXBUILD_REQUIRED_DEFINITIONS``) and verify whether
the C header ``<ucontext.h>`` is available.  The result is stored
in the internal cache variable ``HAVE_UCONTEXT_H``.

For example, on macOS, the ``ucontext`` API is deprecated, and headers may
be hidden unless certain feature macros are defined.  In particular,
defining ``_XOPEN_SOURCE`` (without a value) can expose the necessary
symbols without enabling broader POSIX or SUS (Single Unix Specification)
features (values 500 or greater).

.. code-block:: rblxbuild

  include(CheckIncludeFile)
  include(RBLXBuildPushCheckState)

  rblxbuild_push_check_state(RESET)
    if(RBLXBUILD_SYSTEM_NAME STREQUAL "Darwin")
      set(RBLXBUILD_REQUIRED_DEFINITIONS -D_XOPEN_SOURCE)
    endif()

    check_include_file(ucontext.h HAVE_UCONTEXT_H)
  rblxbuild_pop_check_state()

See Also
^^^^^^^^

* The :module:`CheckIncludeFileCXX` module to check for single C++ header.
* The :module:`CheckIncludeFiles` module to check for one or more C or
  C++ headers at once.
#]=======================================================================]

include_guard(GLOBAL)
include(Internal/CheckCommon)

macro(CHECK_INCLUDE_FILE INCLUDE VARIABLE)
  if(NOT DEFINED "${VARIABLE}")
    set(CHECK_INCLUDE_FILE_VAR ${INCLUDE})
    file(READ ${RBLXBUILD_ROOT}/Modules/CheckIncludeFile.c.in _CIF_SOURCE_CONTENT)
    string(CONFIGURE "${_CIF_SOURCE_CONTENT}" _CIF_SOURCE_CONTENT)
    if(NOT RBLXBUILD_REQUIRED_QUIET)
      message(CHECK_START "Looking for ${INCLUDE}")
    endif()
    if(${ARGC} EQUAL 3)
      set(RBLXBUILD_C_FLAGS_SAVE ${RBLXBUILD_C_FLAGS})
      string(APPEND RBLXBUILD_C_FLAGS " ${ARGV2}")
    endif()

    rblxbuild_check_common_init_compile_args(_CIF)
    rblxbuild_check_common_init_link_options(_CIF)
    rblxbuild_check_common_init_link_directories(_CIF)

    set(_CIF_ADD_LINK_LIBRARIES "")
    if(RBLXBUILD_REQUIRED_LIBRARIES)
      rblxbuild_policy(GET CMP0075 _CIF_CMP0075
        PARENT_SCOPE # undocumented, do not use outside of RBLXBuild
        )
      if("x${_CIF_CMP0075}x" STREQUAL "xNEWx")
        set(_CIF_ADD_LINK_LIBRARIES LINK_LIBRARIES ${RBLXBUILD_REQUIRED_LIBRARIES})
      elseif("x${_CIF_CMP0075}x" STREQUAL "xOLDx")
      elseif(NOT _CIF_CMP0075_WARNED)
        set(_CIF_CMP0075_WARNED 1)
        rblxbuild_policy(ISSUE_WARNING CMP0075 POST
          "RBLXBUILD_REQUIRED_LIBRARIES is set to:\n"
          "  ${RBLXBUILD_REQUIRED_LIBRARIES}\n"
          "For compatibility with RBLXBuild 3.11 and below this check is ignoring it."
          )
      endif()
      unset(_CIF_CMP0075)
    endif()

    try_compile(${VARIABLE}
      SOURCE_FROM_VAR CheckIncludeFile.c _CIF_SOURCE_CONTENT
      COMPILE_DEFINITIONS ${RBLXBUILD_REQUIRED_DEFINITIONS}
      ${_CIF_ADD_LINK_OPTIONS}
      ${_CIF_ADD_LINK_LIBRARIES}
      RBLXBUILD_FLAGS
        -DCOMPILE_DEFINITIONS:STRING=${RBLXBUILD_REQUIRED_FLAGS}
        "${_CIF_INCLUDE_DIRECTORIES}"
        "${_CIF_LINK_DIRECTORIES}"
      )
    rblxbuild_check_common_cleanup(_CIF)

    if(${ARGC} EQUAL 3)
      set(RBLXBUILD_C_FLAGS ${RBLXBUILD_C_FLAGS_SAVE})
    endif()

    if(${VARIABLE})
      if(NOT RBLXBUILD_REQUIRED_QUIET)
        message(CHECK_PASS "found")
      endif()
      set(${VARIABLE} 1 CACHE INTERNAL "Have include ${INCLUDE}")
    else()
      if(NOT RBLXBUILD_REQUIRED_QUIET)
        message(CHECK_FAIL "not found")
      endif()
      set(${VARIABLE} "" CACHE INTERNAL "Have include ${INCLUDE}")
    endif()
  endif()
endmacro()
