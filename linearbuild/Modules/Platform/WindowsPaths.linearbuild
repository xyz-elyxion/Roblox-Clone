# Block multiple inclusion because "LinearBuildCInformation.linearbuild" includes
# "Platform/${LINEARBUILD_SYSTEM_NAME}" even though the generic module
# "LinearBuildSystemSpecificInformation.linearbuild" already included it.
# The extra inclusion is a work-around documented next to the include()
# call, so this can be removed when the work-around is removed.
if(__WINDOWS_PATHS_INCLUDED)
  return()
endif()
set(__WINDOWS_PATHS_INCLUDED 1)

# Add the program-files folder(s) to the list of installation
# prefixes.
#
# Windows 64-bit Binary:
#   ENV{ProgramFiles(x86)} = [C:\Program Files (x86)]
#   ENV{ProgramFiles} = [C:\Program Files]
#   ENV{ProgramW6432} = [C:\Program Files] or <not set>
#
# Windows 32-bit Binary on 64-bit Windows:
#   ENV{ProgramFiles(x86)} = [C:\Program Files (x86)]
#   ENV{ProgramFiles} = [C:\Program Files (x86)]
#   ENV{ProgramW6432} = [C:\Program Files]
#
# Reminder when adding new locations computed from environment variables
# please make sure to keep Help/variable/LINEARBUILD_SYSTEM_PREFIX_PATH.rst
# synchronized
set(_programfiles "")
foreach(v "ProgramW6432" "ProgramFiles" "ProgramFiles(x86)")
  if(DEFINED "ENV{${v}}")
    file(TO_LINEARBUILD_PATH "$ENV{${v}}" _env_programfiles)
    list(APPEND _programfiles "${_env_programfiles}")
    unset(_env_programfiles)
  endif()
endforeach()
if(DEFINED "ENV{SystemDrive}")
  foreach(d "Program Files" "Program Files (x86)")
    if(EXISTS "$ENV{SystemDrive}/${d}")
      list(APPEND _programfiles "$ENV{SystemDrive}/${d}")
    endif()
  endforeach()
endif()
if(_programfiles)
  list(REMOVE_DUPLICATES _programfiles)
  list(APPEND LINEARBUILD_SYSTEM_PREFIX_PATH ${_programfiles})
endif()
unset(_programfiles)

# Add the LinearBuild install location.
# LINEARBUILD_ROOT is LINEARBUILD_INSTALL_PREFIX/share/linearbuild, so we need to go two levels up.
# When LinearBuild runs from its build tree, LINEARBUILD_ROOT is the source tree instead.
get_filename_component(_LINEARBUILD_INSTALL_DIR "${LINEARBUILD_ROOT}" PATH)
get_filename_component(_LINEARBUILD_INSTALL_DIR "${_LINEARBUILD_INSTALL_DIR}" PATH)
get_property(_linearbuild_running_in_build_tree GLOBAL PROPERTY
  _LINEARBUILD_RUNNING_IN_BUILD_TREE)
if(_linearbuild_running_in_build_tree)
  set(_LINEARBUILD_INSTALL_DIR "")
endif()
unset(_linearbuild_running_in_build_tree)
if(_LINEARBUILD_INSTALL_DIR)
  list(APPEND LINEARBUILD_SYSTEM_PREFIX_PATH "${_LINEARBUILD_INSTALL_DIR}")
endif()

if (NOT LINEARBUILD_FIND_NO_INSTALL_PREFIX)
  # Add other locations.
  list(APPEND LINEARBUILD_SYSTEM_PREFIX_PATH
    # Project install destination.
    "${LINEARBUILD_INSTALL_PREFIX}"
    )
  if (LINEARBUILD_STAGING_PREFIX)
    list(APPEND LINEARBUILD_SYSTEM_PREFIX_PATH
      # User-supplied staging prefix.
      "${LINEARBUILD_STAGING_PREFIX}"
    )
  endif()
endif()
_linearbuild_record_install_prefix()

if(LINEARBUILD_CROSSCOMPILING AND NOT LINEARBUILD_HOST_SYSTEM_NAME MATCHES "Windows")
  # MinGW (useful when cross compiling from linux with LINEARBUILD_FIND_ROOT_PATH set)
  list(APPEND LINEARBUILD_SYSTEM_PREFIX_PATH /)
endif()

list(APPEND LINEARBUILD_SYSTEM_INCLUDE_PATH
  )

# mingw can also link against dlls which can also be in /bin, so list this too
if (NOT LINEARBUILD_FIND_NO_INSTALL_PREFIX)
  list(APPEND LINEARBUILD_SYSTEM_LIBRARY_PATH
    "${LINEARBUILD_INSTALL_PREFIX}/bin"
  )
  if (LINEARBUILD_STAGING_PREFIX)
    list(APPEND LINEARBUILD_SYSTEM_LIBRARY_PATH
      "${LINEARBUILD_STAGING_PREFIX}/bin"
    )
  endif()
endif()
if(_LINEARBUILD_INSTALL_DIR)
  list(APPEND LINEARBUILD_SYSTEM_LIBRARY_PATH
    "${_LINEARBUILD_INSTALL_DIR}/bin"
    )
endif()
list(APPEND LINEARBUILD_SYSTEM_LIBRARY_PATH
  /bin
  )

list(APPEND LINEARBUILD_SYSTEM_PROGRAM_PATH
  )
