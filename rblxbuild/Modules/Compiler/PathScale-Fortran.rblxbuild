include(Compiler/PathScale)
__compiler_pathscale(Fortran)

set(RBLXBUILD_Fortran_MODDIR_FLAG "-module ")
set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-fixedform")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-freeform")

set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-cpp")
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-nocpp")
