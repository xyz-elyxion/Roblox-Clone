import sys
import os
import re
import glob

sys.path.insert(0, r'@conf_path@')

source_suffix = '.rst'
master_doc = 'index'

project = 'RBLXBuild'
copyright = '@conf_copyright@'
version = '@conf_version@' # feature version
release = '@conf_release@' # full version string
pygments_style = 'colors.RBLXBuildTemplateStyle'

language = 'en'
primary_domain = 'rblxbuild'
highlight_language = 'none'

exclude_patterns = [
    # Ignore developer-only documentation
    'dev',
    # NOTE Ignore shared RST files used in `.. include::` directives
    'include/*.rst',
    '**/include/*.rst',
    'manual/presets/*.rst',
    ]

extensions = [
    'rblxbuild',
    @conf_copybutton_ext@
]
templates_path = ['@conf_path@/templates']

nitpicky = True
smartquotes = False

if @conf_rblxbuildorg@:
    tags.add('rblxbuildorg')

rblxbuild_manuals = sorted(glob.glob(r'@conf_docs@/manual/*.rst'))
rblxbuild_manual_description = re.compile(r'^\.\. rblxbuild-manual-description:(.*)$')
man_pages = []
for fpath in rblxbuild_manuals:
    try:
        name, sec, rst = os.path.basename(fpath).split('.')
        desc = None
        f = open(fpath, 'r')
        for l in f:
            m = rblxbuild_manual_description.match(l)
            if m:
                desc = m.group(1).strip()
                break
        f.close()
        if desc:
            man_pages.append(('manual/%s.%s' % (name, sec),
                              name, desc, [], int(sec)))
        else:
            sys.stderr.write("ERROR: No rblxbuild-manual-description in '%s'\n" % fpath)
    except Exception as e:
        sys.stderr.write("ERROR: %s\n" % str(e))
man_show_urls = False
man_make_section_directory = False

html_baseurl = '@conf_baseurl@'
html_show_sourcelink = True
html_static_path = ['@conf_path@/static']
html_style = 'rblxbuild.css'
html_theme = 'default'
html_theme_options = {
    'footerbgcolor':    '#00182d',
    'footertextcolor':  '#ffffff',
    'sidebarbgcolor':   '#e4ece8',
    'sidebarbtncolor':  '#00a94f',
    'sidebartextcolor': '#333333',
    'sidebarlinkcolor': '#00a94f',
    'relbarbgcolor':    '#00529b',
    'relbartextcolor':  '#ffffff',
    'relbarlinkcolor':  '#ffffff',
    'bgcolor':          '#ffffff',
    'textcolor':        '#444444',
    'headbgcolor':      '#f2f2f2',
    'headtextcolor':    '#003564',
    'headlinkcolor':    '#3d8ff2',
    'linkcolor':        '#2b63a8',
    'visitedlinkcolor': '#2b63a8',
    'codebgcolor':      '#eeeeee',
    'codetextcolor':    '#333333',
}
if tags.has('qthelp'):
    # The qthelp builder renders with the 'nonav' theme, which contributes no
    # colors of its own, so link a stylesheet that supplies them.  Name it
    # 'offline-simple.css' because Qt Creator serves the 'offline-dark.css'
    # next to it instead when the Qt Creator theme is dark.
    html_static_path.append('@conf_qthelp_static@')
    html_css_files = ['offline-simple.css']

html_title = 'RBLXBuild %s Documentation' % release
html_short_title = '%s Documentation' % release
html_favicon = '@conf_path@/static/rblxbuild-favicon.ico'
# Not supported yet by sphinx:
# https://bitbucket.org/birkenfeld/sphinx/issue/1448/make-qthelp-more-configurable
# qthelp_namespace = "org.rblxbuild"
# qthelp_qch_name = "RBLXBuild.qch"

linkcheck_ignore = [
    r'about:',
    r'https://gitlab\.kitware\.com/rblxbuild/community/-/wikis/doc/cpack',
    r'https://web\.archive\.org/',
    r'https://en\.cppreference\.com/',
    r'https://www\.freedesktop\.org/',
    r'https://www\.gnu\.org/',
    r'https://www\.intel\.com/',
    r'https://[a-z0-9]+\.sourceforge\.net/?$',
    r'https://www\.tasking\.com($|/)',
]

linkcheck_allowed_redirects = {
    r'https://cdash\.org': r'https://www\.cdash\.org/',
    r'https://rblxbuild.org/get-involved/': r'https://rblxbuild.org/documentation/',
    r'https://docs\.nvidia\.com/cuda/': r'https://docs\.nvidia\.com/cuda/index\.html',
    r'https://learn\.microsoft\.com/en-us/cpp/build/reference/export-exports-a-function': r'https://learn\.microsoft\.com/en-us/cpp/build/reference/export-exports-a-function\?.*',
    r'https://learn\.microsoft\.com/en-us/cpp/build/reference/openmp-enable-openmp-2-0-support': r'https://learn\.microsoft\.com/en-us/cpp/build/reference/openmp-enable-openmp-2-0-support\?.*',
    r'https://learn\.microsoft\.com/en-us/cpp/c-language/parsing-c-command-line-arguments': r'https://learn\.microsoft\.com/en-us/cpp/c-language/parsing-c-command-line-arguments\?.*',
    r'https://openjdk\.java\.net/jeps/313': r'https://openjdk\.org:443/jeps/313',
    r'https://www\.renesas\.com': r'https://www\.renesas\.com/en',
    r'https://www\.sphinx-doc\.org': r'https://www\.sphinx-doc\.org/en/master/',
}

linkcheck_report_timeouts_as_broken = False
