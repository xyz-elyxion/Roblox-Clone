# This module is shared by multiple languages; use include blocker.
if(__LINUX_COMPILER_INTEL)
  return()
endif()
set(__LINUX_COMPILER_INTEL 1)

if(NOT XIAR)
  set(_intel_xiar_hints)
  foreach(lang C CXX Fortran)
    if(IS_ABSOLUTE "${RBLXBUILD_${lang}_COMPILER}")
      get_filename_component(_hint "${RBLXBUILD_${lang}_COMPILER}" PATH)
      list(APPEND _intel_xiar_hints ${_hint})
    endif()
  endforeach()
  find_program(XIAR NAMES xiar HINTS ${_intel_xiar_hints})
  mark_as_advanced(XIAR)
endif()

macro(__linux_compiler_intel lang)
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIC "-fPIC")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE "-fPIE")
  set(_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER NO)
  if (NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 13.0)
    set(_RBLXBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER YES)
    set(RBLXBUILD_${lang}_LINK_OPTIONS_PIE ${RBLXBUILD_${lang}_COMPILE_OPTIONS_PIE} "-pie")
    set(RBLXBUILD_${lang}_LINK_OPTIONS_NO_PIE "-no-pie")
  endif()
  set(RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS "-fPIC")
  set(RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-shared")

  # We pass this for historical reasons.  Projects may have
  # executables that use dlopen but do not set ENABLE_EXPORTS.
  set(RBLXBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS "-rdynamic")

  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  # FIXME(#26157): compute RBLXBUILD_<LANG>_COMPILER_LINKER* variables
  # in the meantime, enforce deactivation of push/pop state linker options
  # because xild front-end linker do not support these options even if the platform linker does...
  set(RBLXBUILD_${lang}_LINKER_PUSHPOP_STATE_SUPPORTED FALSE)

  set(_RBLXBUILD_${lang}_IPO_SUPPORTED_BY_RBLXBUILD YES)

  if(XIAR)
    # INTERPROCEDURAL_OPTIMIZATION
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_IPO -ipo)
    set(RBLXBUILD_${lang}_CREATE_STATIC_LIBRARY_IPO
      "${XIAR} cr <TARGET> <LINK_FLAGS> <OBJECTS> "
      "${XIAR} -s <TARGET> ")
    set(_RBLXBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
    set(_RBLXBUILD_${lang}_IPO_LEGACY_BEHAVIOR YES)
  else()
    set(_RBLXBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)
  endif()

  if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 12.0)
    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_VISIBILITY "-fvisibility=")
  endif()
endmacro()
