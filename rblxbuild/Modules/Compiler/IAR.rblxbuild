# This file is processed when the IAR C/C++ Compiler is used
#
# CPU <arch> supported in RBLXBuild: 8051, Arm, AVR, MSP430, RH850, RISC-V, RL78, RX, STM8 and V850
#
# The compiler user documentation is architecture-dependent
# and it can found with the product installation under <arch>/doc/{EW,BX}<arch>_DevelopmentGuide.ENU.pdf
#
#
include_guard()

macro(__compiler_iar_common lang)
  if ("x${lang}" MATCHES "^x(C|CXX)$")
    set(RBLXBUILD_${lang}_COMPILE_OBJECT             "<RBLXBUILD_${lang}_COMPILER> ${RBLXBUILD_IAR_${lang}_FLAG} --silent <SOURCE> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT>")
    set(RBLXBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_${lang}_COMPILER> ${RBLXBUILD_IAR_${lang}_FLAG} --silent <SOURCE> <DEFINES> <INCLUDES> <FLAGS> --preprocess=cnl <PREPROCESSED_SOURCE>")
    set(RBLXBUILD_${lang}_CREATE_ASSEMBLY_SOURCE     "<RBLXBUILD_${lang}_COMPILER> ${RBLXBUILD_IAR_${lang}_FLAG} --silent <SOURCE> <DEFINES> <INCLUDES> <FLAGS> -lAH <ASSEMBLY_SOURCE> -o <OBJECT>.dummy")

    set(RBLXBUILD_DEPFILE_FLAGS_${lang} "--dependencies=ns <DEP_FILE>")

    string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
    string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -r")
    string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -Oh -DNDEBUG")
    string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -Ohz -DNDEBUG")
    string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -Oh -r -DNDEBUG")

    set(RBLXBUILD_${lang}_LINK_MODE LINKER)

    set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "--warnings_are_errors")
  endif()

  set(RBLXBUILD_${lang}_OUTPUT_EXTENSION_REPLACE 1)
  set(RBLXBUILD_${lang}_RESPONSE_FILE_FLAG "-f ")
  set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "-f ")

  set(RBLXBUILD_${lang}_ARCHIVE_FINISH "")
endmacro()

macro(__compiler_iar_ilink lang)
  set(RBLXBUILD_EXECUTABLE_SUFFIX ".elf")
  set(RBLXBUILD_${lang}_OUTPUT_EXTENSION ".o")

  __compiler_iar_common(${lang})

  string(APPEND RBLXBUILD_EXE_LINKER_FLAGS_INIT " --silent")
  set(RBLXBUILD_${lang}_LINK_EXECUTABLE "<RBLXBUILD_LINKER> <OBJECTS> <LINK_FLAGS> <LINK_LIBRARIES> -o <TARGET>")

  set(RBLXBUILD_${lang}_CREATE_STATIC_LIBRARY "<RBLXBUILD_AR> <TARGET> --create <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_CREATE "<RBLXBUILD_AR> <TARGET> --create <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_APPEND "<RBLXBUILD_AR> <TARGET> --replace <LINK_FLAGS> <OBJECTS>")
endmacro()

macro(__compiler_iar_xlink lang)
  set(RBLXBUILD_EXECUTABLE_SUFFIX ".bin")

  __compiler_iar_common(${lang})

  string(APPEND RBLXBUILD_EXE_LINKER_FLAGS_INIT " -S")
  set(RBLXBUILD_${lang}_LINK_EXECUTABLE "<RBLXBUILD_LINKER> <OBJECTS> <LINK_FLAGS> <LINK_LIBRARIES> -o <TARGET>")

  set(RBLXBUILD_${lang}_CREATE_STATIC_LIBRARY "<RBLXBUILD_AR> <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_CREATE "<RBLXBUILD_AR> <TARGET> <LINK_FLAGS> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_APPEND "")

  set(RBLXBUILD_LIBRARY_PATH_FLAG "-I")
endmacro()

macro(__assembler_iar_deps flag min_version)
  if (RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL ${min_version})
    set(RBLXBUILD_DEPFILE_FLAGS_ASM "${flag} <DEP_FILE>")
  endif()
endmacro()
