set(RBLXBuild_CXX14_BROKEN 0)
if(RBLXBUILD_CXX_COMPILER_ID MATCHES "GNU|LCC|Clang|PGI|Intel")
  if(NOT RBLXBUILD_CXX14_STANDARD_COMPILE_OPTION)
    set(RBLXBuild_CXX14_WORKS 0)
  endif()
  if(NOT DEFINED RBLXBuild_CXX14_WORKS)
    include(${RBLXBUILD_CURRENT_LIST_DIR}/cm_message_checks_compat.rblxbuild)
    cm_message_checks_compat(
      "Checking if compiler supports needed C++14 constructs"
      __checkStart __checkPass __checkFail)
    message(${__checkStart})
    try_compile(RBLXBuild_CXX14_WORKS
      ${RBLXBUILD_CURRENT_BINARY_DIR}
      ${RBLXBUILD_CURRENT_LIST_DIR}/cm_cxx14_check.cpp
      RBLXBUILD_FLAGS -DRBLXBUILD_CXX_STANDARD=14
      OUTPUT_VARIABLE OUTPUT
      )
    if(RBLXBuild_CXX14_WORKS AND "${OUTPUT}" MATCHES "error: no member named.*gets.*in the global namespace")
      set_property(CACHE RBLXBuild_CXX14_WORKS PROPERTY VALUE 0)
    endif()
    if(RBLXBuild_CXX14_WORKS)
      message(${__checkPass} "yes")
      file(APPEND ${RBLXBUILD_BINARY_DIR}${RBLXBUILD_FILES_DIRECTORY}/RBLXBuildOutput.log
        "Determining if compiler supports needed C++14 constructs passed with the following output:\n"
        "${OUTPUT}\n"
        "\n"
        )
    else()
      message(${__checkFail} "no")
      file(APPEND ${RBLXBUILD_BINARY_DIR}${RBLXBUILD_FILES_DIRECTORY}/RBLXBuildError.log
        "Determining if compiler supports needed C++14 constructs failed with the following output:\n"
        "${OUTPUT}\n"
        "\n"
        )
    endif()
  endif()
  if(NOT RBLXBuild_CXX14_WORKS)
    set(RBLXBuild_CXX14_BROKEN 1)
  endif()
endif()
