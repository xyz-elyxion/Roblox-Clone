if(LINEARBUILD_OBJC_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_OBJC_COMPILER_WORKS TRUE)
  return()
endif()

include(LinearBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${LINEARBUILD_TRY_COMPILE_TARGET_TYPE})
if(_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older LinearBuild version.
# We now store this in LinearBuildCCompiler.linearbuild.
unset(LINEARBUILD_OBJC_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into LinearBuildOBJCCompiler.linearbuild
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerABI.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_ABI(OBJC ${LINEARBUILD_ROOT}/Modules/LinearBuildOBJCCompilerABI.m)
if(LINEARBUILD_OBJC_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(LINEARBUILD_OBJC_COMPILER_WORKS TRUE)
  message(STATUS "Check for working OBJC compiler: ${LINEARBUILD_OBJC_COMPILER} - skipped")
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that that selected Objective-C compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_OBJC_COMPILER_WORKS)
  PrintTestCompilerStatus("OBJC")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testObjCCompilerSource
    "#ifdef __cplusplus\n"
    "# error \"The LINEARBUILD_OBJC_COMPILER is set to a C++ compiler\"\n"
    "#endif\n"
    "#ifndef __OBJC__\n"
    "# error \"The LINEARBUILD_OBJC_COMPILER is not an Objective-C compiler\"\n"
    "#endif\n"
    "int main(int argc, char* argv[])\n"
    "{ (void)argv; return argc-1;}\n")
  # Clear result from normal variable.
  unset(LINEARBUILD_OBJC_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(LINEARBUILD_OBJC_COMPILER_WORKS
    SOURCE_FROM_VAR testObjCCompiler.m __TestCompiler_testObjCCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __LINEARBUILD_OBJC_COMPILER_OUTPUT)
  unset(__TestCompiler_testObjCCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT LINEARBUILD_OBJC_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__LINEARBUILD_OBJC_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The Objective-C compiler\n  \"${LINEARBUILD_OBJC_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "LinearBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerSupport.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_SUPPORT(OBJC)

# Re-configure to save learned information.
configure_file(
  ${LINEARBUILD_ROOT}/Modules/LinearBuildOBJCCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildOBJCCompiler.linearbuild
  @ONLY
  )
include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildOBJCCompiler.linearbuild)

if(LINEARBUILD_OBJC_SIZEOF_DATA_PTR)
  foreach(f ${LINEARBUILD_OBJC_ABI_FILES})
    include(${f})
  endforeach()
  unset(LINEARBUILD_OBJC_ABI_FILES)
endif()

set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__LINEARBUILD_OBJC_COMPILER_OUTPUT)
