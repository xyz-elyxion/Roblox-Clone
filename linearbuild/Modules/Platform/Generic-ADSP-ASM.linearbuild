include(Platform/Generic-ADSP-Common)

set(LINEARBUILD_ASM_SOURCE_FILE_EXTENSIONS asm)
set(LINEARBUILD_ASM_OUTPUT_EXTENSION ".doj" )
set(LINEARBUILD_ASM_COMPILE_OBJECT
    "<LINEARBUILD_ASM_COMPILER> <INCLUDES> <FLAGS> -proc ${ADSP_PROCESSOR} -si-revision ${ADSP_PROCESSOR_SILICIUM_REVISION} -o <OBJECT> <SOURCE>")
