set(RBLXBUILD_Fortran_SUBMODULE_SEP "-")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".mod")

set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
    "<RBLXBUILD_Fortran_COMPILER> -cpp <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")

set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-ffixed-form")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-ffree-form")

set(RBLXBUILD_Fortran_MODDIR_FLAG "-J")

set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-cpp")
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-nocpp")
set(RBLXBUILD_Fortran_POSTPROCESS_FLAG "-ffixed-line-length-72")

set(RBLXBUILD_Fortran_COMPILE_OPTIONS_TARGET "--target=")

if(RBLXBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 13.0)
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_WARNING_AS_ERROR "-Werror")
endif()

set(RBLXBUILD_Fortran_LINKER_WRAPPER_FLAG "-Wl,")
set(RBLXBUILD_Fortran_LINKER_WRAPPER_FLAG_SEP ",")

if("x${RBLXBUILD_Fortran_SIMULATE_ID}" STREQUAL "xMSVC")
  set(RBLXBUILD_Fortran_LINK_MODE LINKER)
else()
  set(RBLXBUILD_Fortran_VERBOSE_FLAG "-v")

  set(RBLXBUILD_Fortran_LINK_MODE DRIVER)

  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PIC "-fPIC")
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PIE "-fPIE")

  string(APPEND RBLXBUILD_Fortran_FLAGS_DEBUG_INIT " -O0 -g")
  string(APPEND RBLXBUILD_Fortran_FLAGS_RELWITHDEBINFO_INIT " -O2 -g")
  string(APPEND RBLXBUILD_Fortran_FLAGS_RELEASE_INIT " -O3")
endif()

set(RBLXBUILD_SHARED_LIBRARY_Fortran_FLAGS -fPIC)
set(RBLXBUILD_SHARED_LIBRARY_CREATE_Fortran_FLAGS "-shared")

# Determine LTO support
set(_RBLXBUILD_Fortran_IPO_SUPPORTED_BY_RBLXBUILD NO)
set(_RBLXBUILD_Fortran_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)
if(RBLXBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 18.0)
  set(_RBLXBUILD_Fortran_IPO_SUPPORTED_BY_RBLXBUILD YES)
  set(_RBLXBUILD_Fortran_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
  if(RBLXBUILD_Fortran_COMPILER_VERSION VERSION_LESS 23.0)
    set(RBLXBUILD_Fortran_COMPILE_OPTIONS_IPO "-flto")
  else()
    set(RBLXBUILD_Fortran_COMPILE_OPTIONS_IPO "-flto=thin")
  endif()
endif()
