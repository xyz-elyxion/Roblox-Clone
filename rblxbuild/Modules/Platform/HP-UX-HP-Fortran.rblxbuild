include(Platform/HP-UX-HP)
__hpux_compiler_hp(Fortran)

set(RBLXBUILD_Fortran_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
set(RBLXBUILD_Fortran_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
