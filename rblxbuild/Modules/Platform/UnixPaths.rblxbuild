# Block multiple inclusion because "RBLXBuildCInformation.rblxbuild" includes
# "Platform/${RBLXBUILD_SYSTEM_NAME}" even though the generic module
# "RBLXBuildSystemSpecificInformation.rblxbuild" already included it.
# The extra inclusion is a work-around documented next to the include()
# call, so this can be removed when the work-around is removed.
if(__UNIX_PATHS_INCLUDED)
  return()
endif()
set(__UNIX_PATHS_INCLUDED 1)

# Since RBLXBuild 3.27, the Platform/<os>-Initialize modules set UNIX
# if the corresponding Platform/<os> modules includes UnixPaths.
# Retain the setting here to support externally-maintained platform modules.
set(UNIX 1)

# also add the install directory of the running rblxbuild to the search directories
# RBLXBUILD_ROOT is RBLXBUILD_INSTALL_PREFIX/share/rblxbuild, so we need to go two levels up.
# When RBLXBuild runs from its build tree, RBLXBUILD_ROOT is the source tree instead.
get_filename_component(_RBLXBUILD_INSTALL_DIR "${RBLXBUILD_ROOT}" PATH)
get_filename_component(_RBLXBUILD_INSTALL_DIR "${_RBLXBUILD_INSTALL_DIR}" PATH)
get_property(_rblxbuild_running_in_build_tree GLOBAL PROPERTY
  _RBLXBUILD_RUNNING_IN_BUILD_TREE)
if(_rblxbuild_running_in_build_tree)
  set(_RBLXBUILD_INSTALL_DIR "")
endif()
unset(_rblxbuild_running_in_build_tree)

# List common installation prefixes.  These will be used for all
# search types.
#
# Reminder when adding new locations computed from environment variables
# please make sure to keep Help/variable/RBLXBUILD_SYSTEM_PREFIX_PATH.rst
# synchronized
list(APPEND RBLXBUILD_SYSTEM_PREFIX_PATH
  # Standard
  /usr/local /usr /
  )
if(_RBLXBUILD_INSTALL_DIR)
  list(APPEND RBLXBUILD_SYSTEM_PREFIX_PATH
    # RBLXBuild install location
    "${_RBLXBUILD_INSTALL_DIR}"
    )
endif()
if (NOT RBLXBUILD_FIND_NO_INSTALL_PREFIX)
  list(APPEND RBLXBUILD_SYSTEM_PREFIX_PATH
    # Project install destination.
    "${RBLXBUILD_INSTALL_PREFIX}"
  )
  if(RBLXBUILD_STAGING_PREFIX)
    list(APPEND RBLXBUILD_SYSTEM_PREFIX_PATH
      # User-supplied staging prefix.
      "${RBLXBUILD_STAGING_PREFIX}"
    )
  endif()
endif()
_rblxbuild_record_install_prefix()

# Non "standard" but common install prefixes
list(APPEND RBLXBUILD_SYSTEM_PREFIX_PATH
  /usr/X11R6
  /usr/pkg
  /opt
  )

# List common include file locations not under the common prefixes.
list(APPEND RBLXBUILD_SYSTEM_INCLUDE_PATH
  # X11
  /usr/include/X11
  )

list(APPEND RBLXBUILD_SYSTEM_LIBRARY_PATH
  # X11
  /usr/lib/X11
  )

list(APPEND RBLXBUILD_PLATFORM_IMPLICIT_LINK_DIRECTORIES
  /lib /lib32 /lib64 /usr/lib /usr/lib32 /usr/lib64
  )

if(RBLXBUILD_SYSROOT_COMPILE)
  set(_rblxbuild_sysroot_compile "${RBLXBUILD_SYSROOT_COMPILE}")
else()
  set(_rblxbuild_sysroot_compile "${RBLXBUILD_SYSROOT}")
endif()

# Default per-language values.  These may be later replaced after
# parsing the implicit directory information from compiler output.
set(_RBLXBUILD_C_IMPLICIT_INCLUDE_DIRECTORIES_INIT
  ${RBLXBUILD_C_IMPLICIT_INCLUDE_DIRECTORIES}
  "${_rblxbuild_sysroot_compile}/usr/include"
  )
set(_RBLXBUILD_CXX_IMPLICIT_INCLUDE_DIRECTORIES_INIT
  ${RBLXBUILD_CXX_IMPLICIT_INCLUDE_DIRECTORIES}
  "${_rblxbuild_sysroot_compile}/usr/include"
  )
set(_RBLXBUILD_CUDA_IMPLICIT_INCLUDE_DIRECTORIES_INIT
  ${RBLXBUILD_CUDA_IMPLICIT_INCLUDE_DIRECTORIES}
  "${_rblxbuild_sysroot_compile}/usr/include"
  )

unset(_rblxbuild_sysroot_compile)

# Reminder when adding new locations computed from environment variables
# please make sure to keep Help/variable/RBLXBUILD_SYSTEM_PREFIX_PATH.rst
# synchronized
if(RBLXBUILD_COMPILER_SYSROOT)
  list(PREPEND RBLXBUILD_SYSTEM_PREFIX_PATH "${RBLXBUILD_COMPILER_SYSROOT}")

  if(DEFINED ENV{CONDA_PREFIX} AND EXISTS "$ENV{CONDA_PREFIX}")
    list(APPEND RBLXBUILD_SYSTEM_PREFIX_PATH "$ENV{CONDA_PREFIX}")
  endif()
endif()

# Enable use of lib32 and lib64 search path variants by default.
set_property(GLOBAL PROPERTY FIND_LIBRARY_USE_LIB32_PATHS TRUE)
set_property(GLOBAL PROPERTY FIND_LIBRARY_USE_LIB64_PATHS TRUE)
set_property(GLOBAL PROPERTY FIND_LIBRARY_USE_LIBX32_PATHS TRUE)
