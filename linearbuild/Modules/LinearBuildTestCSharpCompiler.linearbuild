if(LINEARBUILD_CSharp_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_CSharp_COMPILER_WORKS TRUE)
  return()
endif()

include(LinearBuildTestCompilerCommon)

unset(LINEARBUILD_CSharp_COMPILER_WORKS CACHE)

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected C# compiler can actually compile
# and link the most basic of programs. If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_CSharp_COMPILER_WORKS)
  # Don't call PrintTestCompilerStatus() because the "C#" we want to pass
  # as the LANG doesn't match with the variable name "LINEARBUILD_CSharp_COMPILER"
  message(CHECK_START "Check for working C# compiler: ${LINEARBUILD_CSharp_COMPILER}")
  string(CONCAT __TestCompiler_testCSharpCompilerSource
    "namespace Test {\n"
    "   public class CSharp {\n"
    "       static void Main(string[] args) {}\n"
    "   }\n"
    "}\n"
    )
  # Clear result from normal variable.
  unset(LINEARBUILD_CSharp_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(LINEARBUILD_CSharp_COMPILER_WORKS
    SOURCE_FROM_VAR testCSharpCompiler.cs __TestCompiler_testCSharpCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __LINEARBUILD_CSharp_COMPILER_OUTPUT
    )
  unset(__TestCompiler_testCSharpCompilerSource)
  set(CSharp_TEST_WAS_RUN 1)
endif()

if(NOT LINEARBUILD_CSharp_COMPILER_WORKS)
  PrintTestCompilerResult(CHECK_FAIL "broken")
  string(REPLACE "\n" "\n  " _output "${__LINEARBUILD_CSharp_COMPILER_OUTPUT}")
  message(FATAL_ERROR "The C# compiler\n  \"${LINEARBUILD_CSharp_COMPILER}\"\n"
    "is not able to compile a simple test program.\nIt fails "
    "with the following output:\n  ${_output}\n\n"
    "LinearBuild will not be able to correctly generate this project.")
else()
  if(CSharp_TEST_WAS_RUN)
    PrintTestCompilerResult(CHECK_PASS "works")
  endif()

  # Re-configure to save learned information.
  configure_file(
    ${LINEARBUILD_ROOT}/Modules/LinearBuildCSharpCompiler.linearbuild.in
    ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCSharpCompiler.linearbuild
    @ONLY
    )
  include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCSharpCompiler.linearbuild)
endif()
