if(NOT DEFINED _LINEARBUILD_PROCESSING_LANGUAGE OR _LINEARBUILD_PROCESSING_LANGUAGE STREQUAL "")
  message(FATAL_ERROR "Internal error: _LINEARBUILD_PROCESSING_LANGUAGE is not set")
endif()

# Ubuntu 16.04:
# * /usr/bin/gcc-ar-5
# * /usr/bin/gcc-ranlib-5
string(REGEX MATCH "^([0-9]+)" __version_x
    "${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}")

string(REGEX MATCH "^([0-9]+\\.[0-9]+)" __version_x_y
    "${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}")

# Try to find tools in the same directory as GCC itself
get_filename_component(__gcc_hints "${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER}" DIRECTORY)

# http://manpages.ubuntu.com/manpages/wily/en/man1/gcc-ar.1.html
find_program(LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_AR
  NAMES
    "${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc-ar-${__version_x_y}"
    "${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc-ar-${__version_x}"
    "${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc-ar${_LINEARBUILD_COMPILER_SUFFIX}"
  HINTS ${__gcc_hints}
  NAMES_PER_DIR
  NO_LINEARBUILD_PATH
  NO_LINEARBUILD_ENVIRONMENT_PATH
  DOC "A wrapper around 'ar' adding the appropriate '--plugin' option for the GCC compiler"
)
mark_as_advanced(LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_AR)

# http://manpages.ubuntu.com/manpages/wily/en/man1/gcc-ranlib.1.html
find_program(LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_RANLIB
  NAMES
    "${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc-ranlib-${__version_x_y}"
    "${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc-ranlib-${__version_x}"
    "${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc-ranlib${_LINEARBUILD_COMPILER_SUFFIX}"
  HINTS ${__gcc_hints}
  NAMES_PER_DIR
  NO_LINEARBUILD_PATH
  NO_LINEARBUILD_ENVIRONMENT_PATH
  DOC "A wrapper around 'ranlib' adding the appropriate '--plugin' option for the GCC compiler"
)
mark_as_advanced(LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_RANLIB)
