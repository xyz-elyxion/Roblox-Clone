# This is a platform definition file for platforms without
# operating system, typically embedded platforms.
# It is used when LINEARBUILD_SYSTEM_NAME is set to "Generic"
#
# It is intentionally empty, since nothing is known
# about the platform. So everything has to be specified
# in the system/compiler files ${LINEARBUILD_SYSTEM_NAME}-<compiler_basename>.linearbuild
# and/or ${LINEARBUILD_SYSTEM_NAME}-<compiler_basename>-${LINEARBUILD_SYSTEM_PROCESSOR}.linearbuild

# (embedded) targets without operating system usually don't support shared libraries
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)

# To help the find_xxx() commands, set at least the following so LINEARBUILD_FIND_ROOT_PATH
# works at least for some simple cases:
set(LINEARBUILD_SYSTEM_INCLUDE_PATH /include )
set(LINEARBUILD_SYSTEM_LIBRARY_PATH /lib )
set(LINEARBUILD_SYSTEM_PROGRAM_PATH /bin )
