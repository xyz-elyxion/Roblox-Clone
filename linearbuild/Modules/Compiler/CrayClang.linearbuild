# This module is shared by multiple languages; use include blocker.
if(__COMPILER_CRAYCLANG)
  return()
endif()
set(__COMPILER_CRAYCLANG 1)

include(Compiler/Clang)

macro (__compiler_cray_clang lang)
  set(__crayclang_ver "${LINEARBUILD_${lang}_COMPILER_VERSION}")
  set("LINEARBUILD_${lang}_COMPILER_VERSION" "${LINEARBUILD_${lang}_COMPILER_VERSION_INTERNAL}")
  __compiler_clang(${lang})
  set("LINEARBUILD_${lang}_COMPILER_VERSION" "${__crayclang_ver}")
endmacro ()
