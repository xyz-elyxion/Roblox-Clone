include(Compiler/GNU)

macro(__compiler_qcc lang)
  __compiler_gnu(${lang})

  # http://www.qnx.com/developers/docs/6.4.0/neutrino/utilities/q/qcc.html#examples
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_TARGET "-V")

  set(RBLXBUILD_PREFIX_LIBRARY_ARCHITECTURE "ON")

  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_SYSROOT "-Wc,-isysroot,")
  set(RBLXBUILD_INCLUDE_SYSTEM_FLAG_${lang} "-isystem ")
  set(RBLXBUILD_DEPFILE_FLAGS_${lang} "-Wp,-MD,<DEP_FILE> -Wp,-MT,<DEP_TARGET> -Wp,-MF,<DEP_FILE>")

  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  if("${lang}" STREQUAL "CXX")
    set(RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "${RBLXBUILD_${lang}_COMPILER}")
    if(RBLXBUILD_${lang}_COMPILER_ARG1)
      separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${RBLXBUILD_${lang}_COMPILER_ARG1}")
      list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
      unset(_COMPILER_ARGS)
    endif()
    list(APPEND RBLXBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "-Wp,-dM" "-E" "-c" "${RBLXBUILD_ROOT}/Modules/RBLXBuildCXXCompilerABI.cpp")
  endif()
endmacro()
