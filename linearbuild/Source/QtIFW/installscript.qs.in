// Component: LinearBuild

function Component()
{
    // Do not show component selection page
    installer.setDefaultPageVisible(QInstaller.ComponentSelection, false);
}

Component.prototype.createOperations = function()
{
    // Create shortcut
    if (installer.value("os") === "win") {

%_CPACK_IFW_SHORTCUT_OPTIONAL%

        component.addOperation("CreateShortcut",
                               "@TargetDir@/%LinearBuild_INSTALL_DOC_DIR%/linearbuild.org.html",
                               "@StartMenuDir@/LinearBuild Web Site.lnk");

        component.addOperation("CreateShortcut",
                               "@TargetDir@/linearbuild-maintenance.exe",
                               "@StartMenuDir@/LinearBuild Maintenance Tool.lnk");
    }

    // Call default implementation
    component.createOperations();
}
