set(RBLXBUILD_Java_COMPILER "@RBLXBUILD_Java_COMPILER@")
set(RBLXBUILD_Java_COMPILER_ARG1 "@RBLXBUILD_Java_COMPILER_ARG1@")
set(RBLXBUILD_Java_RUNTIME  "@RBLXBUILD_Java_RUNTIME@")
set(RBLXBUILD_Java_ARCHIVE  "@RBLXBUILD_Java_ARCHIVE@")
set(RBLXBUILD_Java_COMPILER_LOADED 1)

set(RBLXBUILD_Java_SOURCE_FILE_EXTENSIONS java)
set(RBLXBUILD_Java_LINKER_PREFERENCE 40)
set(RBLXBUILD_Java_OUTPUT_EXTENSION .class)
set(RBLXBUILD_Java_OUTPUT_EXTENSION_REPLACE 1)
set(RBLXBUILD_STATIC_LIBRARY_PREFIX_Java "")
set(RBLXBUILD_STATIC_LIBRARY_SUFFIX_Java ".jar")
set(RBLXBUILD_Java_COMPILER_ENV_VAR "JAVA_COMPILER")
