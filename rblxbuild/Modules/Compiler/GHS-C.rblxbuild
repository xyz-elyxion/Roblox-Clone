include(Compiler/GHS)

set(RBLXBUILD_C_VERBOSE_FLAG "-v")
set(RBLXBUILD_C_OUTPUT_EXTENSION ".o")

string(APPEND RBLXBUILD_C_FLAGS_INIT " ")
string(APPEND RBLXBUILD_C_FLAGS_DEBUG_INIT " -Odebug -g")
string(APPEND RBLXBUILD_C_FLAGS_MINSIZEREL_INIT " -DNDEBUG -Ospace")
string(APPEND RBLXBUILD_C_FLAGS_RELEASE_INIT " -DNDEBUG -O")
string(APPEND RBLXBUILD_C_FLAGS_RELWITHDEBINFO_INIT " -DNDEBUG -O -g")
