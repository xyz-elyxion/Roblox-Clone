# This file sets the basic flags for the Windows Resource Compiler.
# It also loads the available platform file for the system-compiler
# if it exists.

# make sure we don't use LINEARBUILD_BASE_NAME from somewhere else
set(LINEARBUILD_BASE_NAME)
if(LINEARBUILD_RC_COMPILER MATCHES "windres[^/]*$")
 set(LINEARBUILD_BASE_NAME "windres")
else()
 get_filename_component(LINEARBUILD_BASE_NAME ${LINEARBUILD_RC_COMPILER} NAME_WE)
endif()
set(LINEARBUILD_SYSTEM_AND_RC_COMPILER_INFO_FILE
  ${LINEARBUILD_ROOT}/Modules/Platform/${LINEARBUILD_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME}.linearbuild)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME} OPTIONAL)

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.
if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

set(LINEARBUILD_RC_FLAGS_INIT "$ENV{RCFLAGS} ${LINEARBUILD_RC_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_RC_FLAGS "Flags for Windows Resource Compiler")

# These are the only types of flags that should be passed to the rc
# command, if COMPILE_FLAGS is used on a target this will be used
# to filter out any other flags
set(LINEARBUILD_RC_FLAG_REGEX "^[-/](D|I)")

# now define the following rule variables
# LINEARBUILD_RC_COMPILE_OBJECT
if(NOT LINEARBUILD_INCLUDE_FLAG_RC)
  set(LINEARBUILD_INCLUDE_FLAG_RC "-I ")
endif()
# compile a Resource file into an object file
if(NOT LINEARBUILD_RC_COMPILE_OBJECT)
  set(LINEARBUILD_RC_COMPILE_OBJECT
    "<LINEARBUILD_RC_COMPILER> <DEFINES> <INCLUDES> <FLAGS> /fo <OBJECT> <SOURCE>")
endif()

set(LINEARBUILD_RC_USE_LINKER_INFORMATION FALSE)

# set this variable so we can avoid loading this more than once.
set(LINEARBUILD_RC_INFORMATION_LOADED 1)
