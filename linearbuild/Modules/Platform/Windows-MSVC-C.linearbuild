include(Platform/Windows-MSVC)
if(NOT LINEARBUILD_C_COMPILER_VERSION VERSION_LESS 18.0)
  set(_FS_C " /FS")
endif()
__windows_compiler_msvc(C)

if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND LINEARBUILD_DEPFILE_FLAGS_C)
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_C_DEPENDS_USE_COMPILER TRUE)
endif()
