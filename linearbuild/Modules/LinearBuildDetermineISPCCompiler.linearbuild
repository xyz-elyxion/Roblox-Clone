# determine the compiler to use for ISPC programs

include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompiler.linearbuild)

if( NOT (("${LINEARBUILD_GENERATOR}" MATCHES "Make") OR ("${LINEARBUILD_GENERATOR}" MATCHES "Ninja")) )
  message(FATAL_ERROR "ISPC language not currently supported by \"${LINEARBUILD_GENERATOR}\" generator")
endif()

# Load system-specific compiler preferences for this language.
include(Platform/${LINEARBUILD_SYSTEM_NAME}-Determine-ISPC OPTIONAL)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-ISPC OPTIONAL)
if(NOT LINEARBUILD_ISPC_COMPILER_NAMES)
  set(LINEARBUILD_ISPC_COMPILER_NAMES ispc)
endif()


if(NOT LINEARBUILD_ISPC_COMPILER)

  set(LINEARBUILD_ISPC_COMPILER_INIT NOTFOUND)

  # prefer the environment variable CC
  if(NOT $ENV{ISPC} STREQUAL "")
    get_filename_component(LINEARBUILD_ISPC_COMPILER_INIT $ENV{ISPC} PROGRAM PROGRAM_ARGS LINEARBUILD_ISPC_FLAGS_ENV_INIT)
    if(LINEARBUILD_ISPC_FLAGS_ENV_INIT)
      set(LINEARBUILD_ISPC_COMPILER_ARG1 "${LINEARBUILD_ISPC_FLAGS_ENV_INIT}" CACHE STRING "First argument to ISPC compiler")
    endif()
    if(NOT EXISTS ${LINEARBUILD_ISPC_COMPILER_INIT})
      message(FATAL_ERROR "Could not find the compiler specified in the environment variable ISPC:\n$ENV{ISPC}.")
    endif()
  endif()

  # next try prefer the compiler specified by the generator
  if(LINEARBUILD_GENERATOR_ISPC)
    if(NOT LINEARBUILD_ISPC_COMPILER_INIT)
      set(LINEARBUILD_ISPC_COMPILER_INIT ${LINEARBUILD_GENERATOR_ISPC})
    endif()
  endif()

  # finally list compilers to try
  if(NOT LINEARBUILD_ISPC_COMPILER_INIT)
    set(LINEARBUILD_ISPC_COMPILER_LIST ${_LINEARBUILD_TOOLCHAIN_PREFIX}ispc ispc)
  endif()

  # Find the compiler.
  _linearbuild_find_compiler(ISPC)

else()
  _linearbuild_find_compiler_path(ISPC)
endif()
mark_as_advanced(LINEARBUILD_ISPC_COMPILER)

if(NOT LINEARBUILD_ISPC_COMPILER_ID_RUN)
set(LINEARBUILD_ISPC_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(LINEARBUILD_ISPC_COMPILER_ID)
  set(LINEARBUILD_ISPC_PLATFORM_ID)


  set(LINEARBUILD_ISPC_COMPILER_ID_TEST_FLAGS_FIRST
  # setup logic to make sure ISPC outputs a file
  "-o linearbuild_ispc_output"
  )

  include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerId.linearbuild)
  LINEARBUILD_DETERMINE_COMPILER_ID(ISPC ISPCFLAGS LinearBuildISPCCompilerId.ispc)

  _linearbuild_find_compiler_sysroot(ISPC)
endif()

if (NOT _LINEARBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_LINEARBUILD_TOOLCHAIN_LOCATION "${LINEARBUILD_ISPC_COMPILER}" PATH)
endif ()

set(_LINEARBUILD_PROCESSING_LANGUAGE "ISPC")
include(LinearBuildFindBinUtils)
include(Compiler/${LINEARBUILD_ISPC_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_LINEARBUILD_PROCESSING_LANGUAGE)

if(LINEARBUILD_ISPC_COMPILER_ID_VENDOR_MATCH)
  set(_SET_LINEARBUILD_ISPC_COMPILER_ID_VENDOR_MATCH
    "set(LINEARBUILD_ISPC_COMPILER_ID_VENDOR_MATCH [==[${LINEARBUILD_ISPC_COMPILER_ID_VENDOR_MATCH}]==])")
else()
  set(_SET_LINEARBUILD_ISPC_COMPILER_ID_VENDOR_MATCH "")
endif()


# configure variables set in this file for fast reload later on
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildISPCCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildISPCCompiler.linearbuild @ONLY)

set(LINEARBUILD_ISPC_COMPILER_ENV_VAR "ISPC")
