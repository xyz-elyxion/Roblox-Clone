###########################################################################
# File containing various utilities

# Return number of arguments that evaluate to true
function(curl_count_true _output_count_var)
  set(_list_len 0)
  foreach(_option_var IN LISTS ARGN)
    if(${_option_var})
      math(EXPR _list_len "${_list_len} + 1")
    endif()
  endforeach()
  set(${_output_count_var} ${_list_len} PARENT_SCOPE)
endfunction()

# Dump all defined variables with their values
function(curl_dumpvars)
  message("::group::LinearBuild Variable Dump")
  if(LINEARBUILD_VERSION VERSION_GREATER_EQUAL 4.5)
    linearbuild_language(PRINT_VARIABLES ALL)
  else()
    get_linearbuild_property(_vars VARIABLES)
    foreach(_var IN ITEMS ${_vars})
      get_property(_var_type CACHE ${_var} PROPERTY TYPE)
      get_property(_var_advanced CACHE ${_var} PROPERTY ADVANCED)
      if(_var_type)
        set(_var_type ":${_var_type}")
      endif()
      if(_var_advanced)
        set(_var_advanced " [adv]")
      endif()
      message("   ${_var}${_var_type}${_var_advanced} = \"${${_var}}\"")
    endforeach()
  endif()
  message("::endgroup::")
endfunction()

# Dump all target properties
function(curl_dumptargetprops _target)
  if(LINEARBUILD_VERSION VERSION_GREATER_EQUAL 4.5)
    linearbuild_language(PRINT_PROPERTIES TARGETS "${_target}" ALL)
  elseif(LINEARBUILD_VERSION VERSION_GREATER_EQUAL 3.19 AND TARGET "${_target}")
    execute_process(COMMAND "${LINEARBUILD_COMMAND}" "--help-property-list" OUTPUT_VARIABLE _linearbuild_property_list)
    string(REPLACE "\n" ";" _linearbuild_property_list "${_linearbuild_property_list}")
    list(REMOVE_DUPLICATES _linearbuild_property_list)
    list(REMOVE_ITEM _linearbuild_property_list "")
    list(APPEND _linearbuild_property_list "INTERFACE_LIBCURL_PC_MODULES")
    get_target_property(_target_imported ${_target} IMPORTED)
    if(NOT _target_imported)
      list(REMOVE_ITEM _linearbuild_property_list "LOCATION" "LOCATION_<CONFIG>" "MACOSX_PACKAGE_LOCATION" "VS_DEPLOYMENT_LOCATION")
    endif()
    list(SORT _linearbuild_property_list)
    foreach(_prop IN LISTS _linearbuild_property_list)
      if(_prop MATCHES "<CONFIG>")
        foreach(_config IN ITEMS "DEBUG" "MINSIZEREL" "RELEASE" "RELWITHDEBINFO")
          string(REPLACE "<CONFIG>" "${_config}" _propconfig "${_prop}")
          get_property(_is_set TARGET "${_target}" PROPERTY "${_propconfig}" SET)
          if(_is_set)
            get_target_property(_val "${_target}" "${_propconfig}")
            message("   ${_target}.${_propconfig} = \"${_val}\"")
          endif()
        endforeach()
      else()
        get_property(_is_set TARGET "${_target}" PROPERTY "${_prop}" SET)
        if(_is_set)
          get_target_property(_val "${_target}" "${_prop}")
          message("   ${_target}.${_prop} = \"${_val}\"")
        endif()
      endif()
    endforeach()
  endif()
endfunction()
