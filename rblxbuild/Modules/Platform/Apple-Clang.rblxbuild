# This module is shared by multiple languages; use include blocker.
include_guard()

macro(__apple_compiler_clang lang)
  set(RBLXBUILD_${lang}_VERBOSE_FLAG "-v -Wl,-v") # also tell linker to print verbose output
  set(RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-dynamiclib -Wl,-headerpad_max_install_names")
  set(RBLXBUILD_SHARED_MODULE_CREATE_${lang}_FLAGS "-bundle -Wl,-headerpad_max_install_names")
  set(RBLXBUILD_${lang}_SYSROOT_FLAG "-isysroot")
  set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mmacosx-version-min=")
  if(NOT RBLXBUILD_${lang}_COMPILER_VERSION VERSION_LESS 3.2)
    set(RBLXBUILD_${lang}_SYSTEM_FRAMEWORK_SEARCH_FLAG "-iframework ")
  endif()

  set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_FRAMEWORK "-framework <LIBRARY>")
  set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_FRAMEWORK_SUPPORTED TRUE)
  set(RBLXBUILD_${lang}_LINK_LIBRARY_FRAMEWORK_ATTRIBUTES LIBRARY_TYPE=STATIC,SHARED DEDUPLICATION=DEFAULT OVERRIDE=DEFAULT)

  # linker selection
  set(RBLXBUILD_${lang}_USING_LINKER_SYSTEM "-fuse-ld=ld")
  set(RBLXBUILD_${lang}_USING_LINKER_APPLE_CLASSIC "-fuse-ld=ld" "LINKER:-ld_classic")
  set(RBLXBUILD_${lang}_USING_LINKER_LLD "-fuse-ld=lld")
  set(RBLXBUILD_${lang}_USING_LINKER_MOLD "-fuse-ld=mold")
  set(RBLXBUILD_${lang}_USING_LINKER_SOLD "-fuse-ld=sold")

  if(NOT RBLXBUILD_${lang}_COMPILER_APPLE_SYSROOT)
    set(RBLXBUILD_${lang}_COMPILER_APPLE_SYSROOT_REQUIRED 1)
  endif()

  if(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/iPhoneOS")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-miphoneos-version-min=")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/iPhoneSimulator")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mios-simulator-version-min=")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/AppleTVOS")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mtvos-version-min=")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/AppleTVSimulator")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mtvos-simulator-version-min=")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/XROS")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "--target=<ARCH>-apple-xros<VERSION_MIN>")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/XRSimulator")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "--target=<ARCH>-apple-xros<VERSION_MIN>-simulator")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/WatchOS")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mwatchos-version-min=")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/WatchSimulator")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mwatchos-simulator-version-min=")
  elseif(_RBLXBUILD_OSX_SYSROOT_PATH MATCHES "/MacOSX" AND RBLXBUILD_SYSTEM_NAME STREQUAL "iOS")
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "--target=<ARCH>-apple-ios<VERSION_MIN>-macabi")
  else()
    set(RBLXBUILD_${lang}_OSX_DEPLOYMENT_TARGET_FLAG "-mmacosx-version-min=")
  endif()
endmacro()
