# support for the nasm assembler

set(LINEARBUILD_ASM_NASM_SOURCE_FILE_EXTENSIONS nasm asm)

if(NOT LINEARBUILD_ASM_NASM_OBJECT_FORMAT)
  if(WIN32)
    if(LINEARBUILD_C_SIZEOF_DATA_PTR EQUAL 8 OR LINEARBUILD_CXX_SIZEOF_DATA_PTR EQUAL 8)
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT win64)
    elseif(LINEARBUILD_C_SIZEOF_DATA_PTR EQUAL 4 OR LINEARBUILD_CXX_SIZEOF_DATA_PTR EQUAL 4)
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT win32)
    elseif(LINEARBUILD_SYSTEM_PROCESSOR STREQUAL "x86_64")
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT win64)
    else()
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT win32)
    endif()
  elseif(APPLE)
    if(LINEARBUILD_C_SIZEOF_DATA_PTR EQUAL 8 OR LINEARBUILD_CXX_SIZEOF_DATA_PTR EQUAL 8)
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT macho64)
    elseif(LINEARBUILD_C_SIZEOF_DATA_PTR EQUAL 4 OR LINEARBUILD_CXX_SIZEOF_DATA_PTR EQUAL 4)
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT macho32)
    elseif(LINEARBUILD_SYSTEM_PROCESSOR STREQUAL "x86_64")
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT macho64)
    else()
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT macho)
    endif()
  else()
    if(LINEARBUILD_C_SIZEOF_DATA_PTR EQUAL 8 OR LINEARBUILD_CXX_SIZEOF_DATA_PTR EQUAL 8)
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT elf64)
    elseif(LINEARBUILD_C_SIZEOF_DATA_PTR EQUAL 4 OR LINEARBUILD_CXX_SIZEOF_DATA_PTR EQUAL 4)
      if(";${LINEARBUILD_C_COMPILER_ARCHITECTURE_ID};${LINEARBUILD_CXX_COMPILER_ARCHITECTURE_ID};" MATCHES ";x86_64;")
        set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT elfx32)
      else()
        set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT elf32)
      endif()
    elseif(LINEARBUILD_SYSTEM_PROCESSOR STREQUAL "x86_64")
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT elf64)
    else()
      set(LINEARBUILD_ASM_NASM_OBJECT_FORMAT elf)
    endif()
  endif()
endif()

if(NOT LINEARBUILD_ASM_NASM_COMPILE_OBJECT)
  set(LINEARBUILD_ASM_NASM_COMPILE_OBJECT "<LINEARBUILD_ASM_NASM_COMPILER> <DEFINES> <INCLUDES> -f ${LINEARBUILD_ASM_NASM_OBJECT_FORMAT} <FLAGS> -o <OBJECT> <SOURCE>")
endif()

if(NOT LINEARBUILD_ASM_NASM_LINK_EXECUTABLE)
  set(LINEARBUILD_ASM_NASM_LINK_EXECUTABLE
    "<LINEARBUILD_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(LINEARBUILD_ASM_NASM_COMPILER_ID STREQUAL "NASM")
  set(LINEARBUILD_DEPFILE_FLAGS_ASM_NASM "-MD <DEP_FILE> -MT <DEP_TARGET>")

  if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
      AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake")
    # dependencies are computed by the compiler itself
    set(LINEARBUILD_ASM_NASM_DEPFILE_FORMAT gcc)
    set(LINEARBUILD_ASM_NASM_DEPENDS_USE_COMPILER TRUE)
  endif()
endif()

# Load the generic ASMInformation file:
set(ASM_DIALECT "_NASM")
include(LinearBuildASMInformation)
set(ASM_DIALECT)
