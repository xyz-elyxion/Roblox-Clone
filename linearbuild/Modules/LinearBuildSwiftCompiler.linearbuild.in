set(LINEARBUILD_Swift_COMPILER "@LINEARBUILD_Swift_COMPILER@")
set(LINEARBUILD_Swift_COMPILER_ID "@LINEARBUILD_Swift_COMPILER_ID@")
set(LINEARBUILD_Swift_COMPILER_VERSION "@LINEARBUILD_Swift_COMPILER_VERSION@")

set(LINEARBUILD_Swift_COMPILER_LOADED 1)
set(LINEARBUILD_Swift_COMPILER_WORKS "@LINEARBUILD_Swift_COMPILER_WORKS@")

set(LINEARBUILD_Swift_COMPILER_ENV_VAR "SWIFTC")

set(LINEARBUILD_Swift_COMPILER_ID_RUN 1)
set(LINEARBUILD_Swift_SOURCE_FILE_EXTENSIONS swift)

set(LINEARBUILD_Swift_COMPILER_USE_OLD_DRIVER "@LINEARBUILD_Swift_COMPILER_USE_OLD_DRIVER@")

set(LINEARBUILD_Swift_IMPLICIT_INCLUDE_DIRECTORIES "@LINEARBUILD_Swift_IMPLICIT_INCLUDE_DIRECTORIES@")

set(LINEARBUILD_Swift_MODULE_TRIPLE "@LINEARBUILD_Swift_MODULE_TRIPLE@")
set(LINEARBUILD_Swift_SIZEOF_DATA_PTR "@LINEARBUILD_Swift_SIZEOF_DATA_PTR@")

if(NOT LINEARBUILD_SIZEOF_VOID_P AND LINEARBUILD_Swift_SIZEOF_DATA_PTR)
  set(LINEARBUILD_SIZEOF_VOID_P "${LINEARBUILD_Swift_SIZEOF_DATA_PTR}")
endif()
