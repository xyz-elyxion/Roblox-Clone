include(Compiler/IntelLLVM)
__compiler_intel_llvm(ASM)

string(APPEND RBLXBUILD_ASM_FLAGS_MINSIZEREL_INIT " -DNDEBUG")
string(APPEND RBLXBUILD_ASM_FLAGS_RELEASE_INIT " -DNDEBUG")
string(APPEND RBLXBUILD_ASM_FLAGS_RELWITHDEBINFO_INIT " -DNDEBUG")

if(UNIX)
  set(RBLXBUILD_ASM_SOURCE_FILE_EXTENSIONS s;S)
else()
  set(RBLXBUILD_ASM_SOURCE_FILE_EXTENSIONS asm)
endif()
