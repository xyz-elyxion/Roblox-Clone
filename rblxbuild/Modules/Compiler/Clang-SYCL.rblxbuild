include(Compiler/Clang)
__compiler_clang(SYCL)
__compiler_clang_cxx_standards(SYCL)

if(NOT RBLXBUILD_SYCL_COMPILER_ID STREQUAL "AdaptiveCpp")
  set(_RBLXBUILD_SYCL_REQUIRED_FLAG "-fsycl")
  foreach(std IN ITEMS 98 11 14)
    unset(RBLXBUILD_SYCL${std}_STANDARD_COMPILE_OPTION)
    unset(RBLXBUILD_SYCL${std}_EXTENSION_COMPILE_OPTION)
  endforeach()
  if(RBLXBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 24)
    set(RBLXBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_ON "-fgpu-rdc")
    set(RBLXBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_OFF "-fno-gpu-rdc")
  endif()
  set(RBLXBUILD_SYCL_COMPILER_HAS_DEVICE_LINK_PHASE FALSE)
endif()

set(RBLXBUILD_SYCL_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN
  "-fvisibility-inlines-hidden")

set(RBLXBUILD_SYCL_COMPILER_PREDEFINES_COMMAND "${RBLXBUILD_SYCL_COMPILER}")
if(RBLXBUILD_SYCL_COMPILER_ARG1)
  separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${RBLXBUILD_SYCL_COMPILER_ARG1}")
  list(APPEND RBLXBUILD_SYCL_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
  unset(_COMPILER_ARGS)
endif()
if(RBLXBUILD_SYCL_COMPILER_TARGET)
  if(RBLXBUILD_SYCL_COMPILER_VERSION VERSION_LESS 3.4.0)
    list(APPEND RBLXBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
      "-target" "${RBLXBUILD_SYCL_COMPILER_TARGET}")
  else()
    list(APPEND RBLXBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
      "--target=${RBLXBUILD_SYCL_COMPILER_TARGET}")
  endif()
endif()
list(APPEND RBLXBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
  ${_RBLXBUILD_SYCL_REQUIRED_FLAG} "-x" "c++" "-w" "-dM" "-E"
  "${RBLXBUILD_ROOT}/Modules/RBLXBuildSYCLCompilerABI.sycl")
