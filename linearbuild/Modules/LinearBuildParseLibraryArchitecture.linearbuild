# Function parse implicit linker options.
# This is used internally by LinearBuild and should not be included by user
# code.

function(linearbuild_parse_library_architecture lang implicit_dirs implicit_objs output_var)
  unset(library_arch)
  # Detect library architecture directory name.
  if(LINEARBUILD_LIBRARY_ARCHITECTURE_REGEX)
    foreach(dir IN LISTS implicit_dirs)
      if("${dir}" MATCHES "/lib/${LINEARBUILD_LIBRARY_ARCHITECTURE_REGEX}$")
        get_filename_component(arch "${dir}" NAME)
        set(library_arch "${arch}")
        break()
      endif()
    endforeach()

    foreach(obj IN LISTS implicit_objs)
      get_filename_component(dir "${obj}" DIRECTORY)
      if("${dir}" MATCHES "(/usr)?/lib/${LINEARBUILD_LIBRARY_ARCHITECTURE_REGEX}$")
        get_filename_component(arch "${dir}" NAME)
        set(library_arch "${arch}")
        break()
      endif()
    endforeach()
  endif()

  if(LINEARBUILD_CXX_COMPILER_ID STREQUAL QCC)
    foreach(dir ${implicit_dirs})
      if (dir MATCHES "/lib$")
        get_filename_component(assumedArchDir "${dir}" DIRECTORY)
        get_filename_component(archParentDir "${assumedArchDir}" DIRECTORY)
        if (archParentDir STREQUAL LINEARBUILD_SYSROOT)
          get_filename_component(archDirName "${assumedArchDir}" NAME)
          set(library_arch "${archDirName}")
          break()
        endif()
      endif()
    endforeach()
  endif()

  # Return results.
  if(library_arch)
    set(${output_var} "${library_arch}" PARENT_SCOPE)
  endif()
endfunction()
