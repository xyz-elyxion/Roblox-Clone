if(LINEARBUILD_GENERATOR MATCHES "^Xcode")
  message(FATAL_ERROR
    "The SYCL language is not supported by the \"${LINEARBUILD_GENERATOR}\" "
    "generator.")
endif()

include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompiler.linearbuild)

# Record the selection used to identify the host toolchain and runtime.
if(DEFINED LINEARBUILD_SYCL_DEVICE_TARGETS)
  set(_LINEARBUILD_SYCL_DEVICE_TARGETS "${LINEARBUILD_SYCL_DEVICE_TARGETS}")
endif()

# Load system-specific compiler preferences for this language.
include(Platform/${LINEARBUILD_SYSTEM_NAME}-Determine-SYCL OPTIONAL)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-SYCL OPTIONAL)
if(NOT LINEARBUILD_SYCL_COMPILER_NAMES)
  set(LINEARBUILD_SYCL_COMPILER_NAMES dpclang++ dpclang-cl icpx icx icx-cl dpcpp acpp syclcc clang++ clang-cl)
endif()

if(NOT "${LINEARBUILD_GENERATOR}" MATCHES "Green Hills MULTI")
  if(NOT LINEARBUILD_SYCL_COMPILER)
    set(LINEARBUILD_SYCL_COMPILER_INIT NOTFOUND)

    if(NOT $ENV{SYCLCXX} STREQUAL "")
      get_filename_component(LINEARBUILD_SYCL_COMPILER_INIT $ENV{SYCLCXX} PROGRAM PROGRAM_ARGS LINEARBUILD_SYCL_FLAGS_ENV_INIT)
      if(LINEARBUILD_SYCL_FLAGS_ENV_INIT)
        set(LINEARBUILD_SYCL_COMPILER_ARG1 "${LINEARBUILD_SYCL_FLAGS_ENV_INIT}" CACHE STRING "Arguments to SYCL compiler")
      endif()
      if(NOT EXISTS ${LINEARBUILD_SYCL_COMPILER_INIT})
        message(FATAL_ERROR "Could not find the compiler specified in the environment variable SYCLCXX:\n$ENV{SYCLCXX}.\n${LINEARBUILD_SYCL_COMPILER_INIT}")
      endif()
    endif()

    if(LINEARBUILD_GENERATOR_SYCL AND NOT LINEARBUILD_SYCL_COMPILER_INIT)
      set(LINEARBUILD_SYCL_COMPILER_INIT ${LINEARBUILD_GENERATOR_SYCL})
    endif()

    if(NOT LINEARBUILD_SYCL_COMPILER_INIT)
      set(LINEARBUILD_SYCL_COMPILER_LIST dpclang++ dpclang-cl icpx icx icx-cl dpcpp acpp syclcc clang++ clang-cl)
    endif()

    _linearbuild_find_compiler(SYCL)
  else()
    _linearbuild_find_compiler_path(SYCL)
  endif()
  mark_as_advanced(LINEARBUILD_SYCL_COMPILER)

  get_filename_component(_LINEARBUILD_SYCL_COMPILER_NAME
    "${LINEARBUILD_SYCL_COMPILER}" NAME_WE)
  if(_LINEARBUILD_SYCL_COMPILER_NAME MATCHES "^(acpp|syclcc|syclcc-clang)$")
    set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST "-x c++")
    set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS "-c -x c++" "-x c++")
  else()
    set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST "-fsycl -x c++")
    set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS
      "-c -fsycl -x c++"
      "-fsycl -x c++"
      "-c -x c++"
      "-x c++")
  endif()
  unset(_LINEARBUILD_SYCL_COMPILER_NAME)
endif()

if(LINEARBUILD_SYCL_COMPILER_TARGET)
  get_filename_component(_LINEARBUILD_SYCL_COMPILER_NAME
    "${LINEARBUILD_SYCL_COMPILER}" NAME_WE)
  if(_LINEARBUILD_SYCL_COMPILER_NAME MATCHES "^(acpp|syclcc|syclcc-clang)$")
    set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST
      "-c --target=${LINEARBUILD_SYCL_COMPILER_TARGET} -x c++")
  else()
    set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST
      "-c --target=${LINEARBUILD_SYCL_COMPILER_TARGET} -fsycl -x c++")
  endif()
  unset(_LINEARBUILD_SYCL_COMPILER_NAME)
endif()

get_filename_component(_LINEARBUILD_SYCL_COMPILER_NAME
  "${LINEARBUILD_SYCL_COMPILER}" NAME_WE)
if(_LINEARBUILD_SYCL_COMPILER_NAME MATCHES "^(acpp|syclcc|syclcc-clang)$")
  if(NOT DEFINED _LINEARBUILD_SYCL_DEVICE_TARGETS)
    if(DEFINED ENV{ACPP_TARGETS})
      set(_LINEARBUILD_SYCL_DEVICE_TARGETS "$ENV{ACPP_TARGETS}")
    elseif(DEFINED ENV{HIPSYCL_TARGETS})
      set(_LINEARBUILD_SYCL_DEVICE_TARGETS "$ENV{HIPSYCL_TARGETS}")
    else()
      execute_process(COMMAND "${LINEARBUILD_SYCL_COMPILER}" --help
        OUTPUT_VARIABLE _LINEARBUILD_SYCL_DRIVER_HELP
        ERROR_QUIET)
      if(_LINEARBUILD_SYCL_DRIVER_HELP MATCHES
          "--acpp-targets=[^\n]*\n[^\n]*\n[^\n]*\n  \\[current value: ([^]\n]+)\\]")
        if(NOT LINEARBUILD_MATCH_1 STREQUAL "NOT SET")
          set(_LINEARBUILD_SYCL_DEVICE_TARGETS "${LINEARBUILD_MATCH_1}")
        endif()
      endif()
      unset(_LINEARBUILD_SYCL_DRIVER_HELP)
    endif()
  endif()
  # AdaptiveCpp supplies the backend's source language itself.  A forwarded
  # -x c++ would override its -x cuda/-x hip during multipass compilation.
  string(TOLOWER "${_LINEARBUILD_SYCL_DEVICE_TARGETS}" _LINEARBUILD_SYCL_TARGET_FLOWS)
  if(_LINEARBUILD_SYCL_TARGET_FLOWS MATCHES
      "(^|;)[ \t]*(cuda|hip)(\\.(integrated|explicit)-multipass)?[ \t]*(:|;|$)" OR
      (NOT "${LINEARBUILD_SYCL_DEVICE_TARGETS}" STREQUAL "" AND
       NOT LINEARBUILD_SYCL_DEVICE_TARGETS))
    string(REPLACE "-x c++" "" LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST
      "${LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST}")
    string(REPLACE "-x c++" "" LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS
      "${LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS}")
  endif()
  unset(_LINEARBUILD_SYCL_TARGET_FLOWS)
  set(_LINEARBUILD_SYCL_DEVICE_TARGET_OPTION "--acpp-targets=")
  set(_LINEARBUILD_SYCL_DEVICE_TARGET_VALUE "${_LINEARBUILD_SYCL_DEVICE_TARGETS}")
elseif(_LINEARBUILD_SYCL_COMPILER_NAME MATCHES "^(clang\\+\\+|clang|clang-cl)(-[0-9]+)?$")
  set(_LINEARBUILD_SYCL_DEVICE_TARGET_OPTION "--offload-targets=")
  string(REPLACE ";" "," _LINEARBUILD_SYCL_DEVICE_TARGET_VALUE
    "${_LINEARBUILD_SYCL_DEVICE_TARGETS}")
else()
  set(_LINEARBUILD_SYCL_DEVICE_TARGET_OPTION "-fsycl-targets=")
  string(REPLACE ";" "," _LINEARBUILD_SYCL_DEVICE_TARGET_VALUE
    "${_LINEARBUILD_SYCL_DEVICE_TARGETS}")
endif()
if(_LINEARBUILD_SYCL_DEVICE_TARGETS)
  set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST
    "\"${_LINEARBUILD_SYCL_DEVICE_TARGET_OPTION}${_LINEARBUILD_SYCL_DEVICE_TARGET_VALUE}\" ${LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST}")
  string(REPLACE ";" "\\;" _LINEARBUILD_SYCL_DEVICE_TARGET_VALUE
    "${_LINEARBUILD_SYCL_DEVICE_TARGET_VALUE}")
  foreach(_flag IN LISTS LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS)
    # Subsequent attempts must not silently fall back to default targets.
    string(APPEND _LINEARBUILD_SYCL_ID_TARGET_FLAGS
      "\"${_LINEARBUILD_SYCL_DEVICE_TARGET_OPTION}${_LINEARBUILD_SYCL_DEVICE_TARGET_VALUE}\" ${_flag};")
  endforeach()
  set(LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS "${_LINEARBUILD_SYCL_ID_TARGET_FLAGS}")
endif()
unset(_LINEARBUILD_SYCL_COMPILER_NAME)
unset(_LINEARBUILD_SYCL_DEVICE_TARGET_OPTION)
unset(_LINEARBUILD_SYCL_DEVICE_TARGET_VALUE)
unset(_LINEARBUILD_SYCL_ID_TARGET_FLAGS)
unset(_flag)

if(NOT LINEARBUILD_SYCL_COMPILER_ID_RUN)
  set(LINEARBUILD_SYCL_COMPILER_ID_RUN 1)

  set(LINEARBUILD_SYCL_COMPILER_ID)
  set(LINEARBUILD_SYCL_PLATFORM_ID)
  file(READ ${LINEARBUILD_ROOT}/Modules/LinearBuildPlatformId.h.in
    LINEARBUILD_SYCL_COMPILER_ID_PLATFORM_CONTENT)

  list(APPEND LINEARBUILD_SYCL_COMPILER_ID_VENDORS IAR)
  set(LINEARBUILD_SYCL_COMPILER_ID_VENDOR_FLAGS_IAR )
  set(LINEARBUILD_SYCL_COMPILER_ID_VENDOR_REGEX_IAR "IAR .+ Compiler")

  set(LINEARBUILD_SYCL_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdSYCL/(\\./)?(CompilerIdSYCL.(framework|xctest|build/[^ \t\r\n]+)/)?CompilerIdSYCL[ \t\n\\\"]")
  set(LINEARBUILD_SYCL_COMPILER_ID_TOOL_MATCH_INDEX 2)

  include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerId.linearbuild)
  get_filename_component(_LINEARBUILD_SYCL_COMPILER_NAME "${LINEARBUILD_SYCL_COMPILER}" NAME_WE)
  if(_LINEARBUILD_SYCL_COMPILER_NAME MATCHES "-cl$")
    string(APPEND LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST " -clang:-v")
  else()
    string(APPEND LINEARBUILD_SYCL_COMPILER_ID_TEST_FLAGS_FIRST " -v")
  endif()
  unset(_LINEARBUILD_SYCL_COMPILER_NAME)
  LINEARBUILD_DETERMINE_COMPILER_ID(SYCL SYCLFLAGS LinearBuildSYCLCompilerId.sycl)

  include(LinearBuildParseImplicitLinkInfo)
  linearbuild_parse_implicit_link_info2("${LINEARBUILD_SYCL_COMPILER_PRODUCED_OUTPUT}" _LINEARBUILD_SYCL_LINK_LOG ""
    LANGUAGE SYCL
    COMPUTE_IMPLICIT_LIBS LINEARBUILD_SYCL_HOST_IMPLICIT_LINK_LIBRARIES
    COMPUTE_IMPLICIT_DIRS LINEARBUILD_SYCL_HOST_IMPLICIT_LINK_DIRECTORIES
    COMPUTE_IMPLICIT_FWKS LINEARBUILD_SYCL_HOST_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES)
  message(CONFIGURE_LOG "Parsed SYCL compiler-id link information:\n${_LINEARBUILD_SYCL_LINK_LOG}\n")
  set(LINEARBUILD_SYCL_IMPLICIT_LINK_LIBRARIES "${LINEARBUILD_SYCL_HOST_IMPLICIT_LINK_LIBRARIES}")
  set(LINEARBUILD_SYCL_IMPLICIT_LINK_DIRECTORIES "${LINEARBUILD_SYCL_HOST_IMPLICIT_LINK_DIRECTORIES}")
  set(LINEARBUILD_SYCL_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES "${LINEARBUILD_SYCL_HOST_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES}")
  include(Internal/LinearBuildSYCLFilterImplicitLibs)
  linearbuild_sycl_filter_implicit_libs(LINEARBUILD_SYCL_IMPLICIT_LINK_LIBRARIES)

  _linearbuild_find_compiler_sysroot(SYCL)
else()
  if(NOT DEFINED LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT)
    if(LINEARBUILD_SYCL_COMPILER_ID STREQUAL "Clang" OR
       "x${LINEARBUILD_SYCL_COMPILER_ID}" STREQUAL "xDPClang" OR
       "x${LINEARBUILD_SYCL_COMPILER_ID}" STREQUAL "xIntelLLVM")
      if("x${LINEARBUILD_SYCL_SIMULATE_ID}" STREQUAL "xMSVC")
        set(LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT "MSVC")
      else()
        set(LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT "GNU")
      endif()
    elseif(LINEARBUILD_SYCL_COMPILER_ID STREQUAL "AdaptiveCpp")
      set(LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT "GNU")
    else()
      set(LINEARBUILD_SYCL_COMPILER_FRONTEND_VARIANT "")
    endif()
  endif()
endif()

if(NOT _LINEARBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_LINEARBUILD_TOOLCHAIN_LOCATION "${LINEARBUILD_SYCL_COMPILER}" PATH)
endif()

if(NOT _LINEARBUILD_TOOLCHAIN_PREFIX)
  if(LINEARBUILD_SYCL_COMPILER_ID MATCHES "GNU|Clang|IntelLLVM|QCC|LCC")
    get_filename_component(COMPILER_BASENAME "${LINEARBUILD_SYCL_COMPILER}" NAME)
    if(COMPILER_BASENAME MATCHES "^(.+-)?(dpclang\\+\\+|dpclang-cl|dpclang|clang\\+\\+|dpcpp|icpx|[gc]\\+\\+|clang-cl)(-?[0-9]+(\\.[0-9]+)*)?(-[^.]+)?(\\.exe)?$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
      set(_LINEARBUILD_TOOLCHAIN_SUFFIX ${LINEARBUILD_MATCH_3})
      set(_LINEARBUILD_COMPILER_SUFFIX ${LINEARBUILD_MATCH_5})
    elseif(LINEARBUILD_SYCL_COMPILER_TARGET AND LINEARBUILD_SYCL_COMPILER_ID MATCHES "Clang|IntelLLVM")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_SYCL_COMPILER_TARGET}-)
    endif()

    if("${_LINEARBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
    endif()
  endif()
endif()

set(_LINEARBUILD_PROCESSING_LANGUAGE "SYCL")
include(LinearBuildFindBinUtils)
include(Compiler/${LINEARBUILD_SYCL_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_LINEARBUILD_PROCESSING_LANGUAGE)

if(LINEARBUILD_SYCL_COMPILER_SYSROOT)
  string(CONCAT _SET_LINEARBUILD_SYCL_COMPILER_SYSROOT
    "set(LINEARBUILD_SYCL_COMPILER_SYSROOT \"${LINEARBUILD_SYCL_COMPILER_SYSROOT}\")\n"
    "set(LINEARBUILD_COMPILER_SYSROOT \"${LINEARBUILD_SYCL_COMPILER_SYSROOT}\")")
else()
  set(_SET_LINEARBUILD_SYCL_COMPILER_SYSROOT "")
endif()

if(MSVC_SYCL_ARCHITECTURE_ID)
  set(SET_MSVC_SYCL_ARCHITECTURE_ID
    "set(MSVC_SYCL_ARCHITECTURE_ID ${MSVC_SYCL_ARCHITECTURE_ID})")
endif()

# configure all variables set in this file
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildSYCLCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildSYCLCompiler.linearbuild
  @ONLY
  )

set(LINEARBUILD_SYCL_COMPILER_ENV_VAR "SYCLCXX")
