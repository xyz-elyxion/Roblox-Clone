# file LICENSE.rst or https://linearbuild.org/licensing for details.


if(UNIX)
  set(LINEARBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .o)
else()
  set(LINEARBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .obj)
endif()

set(LINEARBUILD_INCLUDE_FLAG_ASM${ASM_DIALECT} "-I")       # -I
set(LINEARBUILD_BASE_NAME)
get_filename_component(LINEARBUILD_BASE_NAME "${LINEARBUILD_ASM${ASM_DIALECT}_COMPILER}" NAME_WE)

if("${LINEARBUILD_BASE_NAME}" STREQUAL "as")
  set(LINEARBUILD_BASE_NAME gas)
endif()

# Load compiler-specific information.
set(_INCLUDED_FILE "")
if(LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID)
  include(Compiler/${LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT} OPTIONAL  RESULT_VARIABLE _INCLUDED_FILE)
endif()
if(NOT _INCLUDED_FILE)
  if("ASM${ASM_DIALECT}" STREQUAL "ASM" AND LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID)
    message(STATUS "Warning: Did not find file Compiler/${LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT}")
  endif()
  include(Platform/${LINEARBUILD_BASE_NAME} OPTIONAL)
endif()

if(LINEARBUILD_SYSTEM_PROCESSOR)
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT}-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL  RESULT_VARIABLE _INCLUDED_FILE)
  if(NOT _INCLUDED_FILE)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME}-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
endif()

include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT} OPTIONAL  RESULT_VARIABLE _INCLUDED_FILE)
if(NOT _INCLUDED_FILE)
  include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_BASE_NAME} OPTIONAL)
endif()

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(LINEARBUILD_USER_MAKE_RULES_OVERRIDE_ASM)
  # Save the full path of the file so try_compile can use it.
  include(${LINEARBUILD_USER_MAKE_RULES_OVERRIDE_ASM} RESULT_VARIABLE _override)
  set(LINEARBUILD_USER_MAKE_RULES_OVERRIDE_ASM "${_override}")
endif()

# Set default assembler file extensions:
if(NOT LINEARBUILD_ASM${ASM_DIALECT}_SOURCE_FILE_EXTENSIONS)
  set(LINEARBUILD_ASM${ASM_DIALECT}_SOURCE_FILE_EXTENSIONS s;S;asm)
endif()


# Support for LINEARBUILD_ASM${ASM_DIALECT}_FLAGS_INIT and friends:
set(LINEARBUILD_ASM${ASM_DIALECT}_FLAGS_INIT "$ENV{ASM${ASM_DIALECT}FLAGS} ${LINEARBUILD_ASM${ASM_DIALECT}_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_ASM${ASM_DIALECT}_FLAGS "Flags used by the ASM${ASM_DIALECT} compiler")

if(NOT LINEARBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT)
  set(LINEARBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT "<LINEARBUILD_ASM${ASM_DIALECT}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT LINEARBUILD_ASM${ASM_DIALECT}_CREATE_STATIC_LIBRARY)
  set(LINEARBUILD_ASM${ASM_DIALECT}_CREATE_STATIC_LIBRARY
      "<LINEARBUILD_AR> cr <TARGET> <LINK_FLAGS> <OBJECTS> "
      "<LINEARBUILD_RANLIB> <TARGET>")
endif()

if(NOT LINEARBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE)
  set(LINEARBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE
    "<LINEARBUILD_ASM${ASM_DIALECT}_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(NOT LINEARBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG)
  set(LINEARBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_ASM${ASM_DIALECT}_FLAG})
endif()

if(NOT LINEARBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG_SEP)
  set(LINEARBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG_SEP ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_ASM${ASM_DIALECT}_FLAG_SEP})
endif()

if(NOT LINEARBUILD_EXECUTABLE_RPATH_LINK_ASM${ASM_DIALECT}_FLAG)
  set(LINEARBUILD_EXECUTABLE_RPATH_LINK_ASM${ASM_DIALECT}_FLAG ${LINEARBUILD_SHARED_LIBRARY_RPATH_LINK_ASM${ASM_DIALECT}_FLAG})
endif()

set(LINEARBUILD_ASM${ASM_DIALECT}_USE_LINKER_INFORMATION TRUE)

set(LINEARBUILD_ASM${ASM_DIALECT}_INFORMATION_LOADED 1)
