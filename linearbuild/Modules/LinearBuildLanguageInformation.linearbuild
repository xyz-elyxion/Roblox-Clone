# This file contains common code blocks used by all the language information
# files

# load any compiler-wrapper specific information
macro(__linearbuild_include_compiler_wrapper lang)
  set(_INCLUDED_WRAPPER_FILE 0)
  if (LINEARBUILD_${lang}_COMPILER_ID)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_${lang}_COMPILER_WRAPPER}-${LINEARBUILD_${lang}_COMPILER_ID}-${lang} OPTIONAL RESULT_VARIABLE _INCLUDED_WRAPPER_FILE)
  endif()
  if (NOT _INCLUDED_WRAPPER_FILE)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_${lang}_COMPILER_WRAPPER}-${lang} OPTIONAL RESULT_VARIABLE _INCLUDED_WRAPPER_FILE)
  endif ()

  # No platform - wrapper - lang information so maybe there's just wrapper - lang information
  if(NOT _INCLUDED_WRAPPER_FILE)
    if (LINEARBUILD_${lang}_COMPILER_ID)
      include(Compiler/${LINEARBUILD_${lang}_COMPILER_WRAPPER}-${LINEARBUILD_${lang}_COMPILER_ID}-${lang} OPTIONAL RESULT_VARIABLE _INCLUDED_WRAPPER_FILE)
    endif()
    if (NOT _INCLUDED_WRAPPER_FILE)
      include(Compiler/${LINEARBUILD_${lang}_COMPILER_WRAPPER}-${lang} OPTIONAL RESULT_VARIABLE _INCLUDED_WRAPPER_FILE)
    endif ()
  endif ()
endmacro ()
