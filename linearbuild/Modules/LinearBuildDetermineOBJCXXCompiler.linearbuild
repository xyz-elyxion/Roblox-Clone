# determine the compiler to use for Objective-C++ programs
# NOTE, a generator may set LINEARBUILD_OBJCXX_COMPILER before
# loading this file to force a compiler.
# use environment variable OBJCXX first if defined by user, next use
# the linearbuild variable LINEARBUILD_GENERATOR_OBJCXX which can be defined by a generator
# as a default compiler
# If the internal linearbuild variable _LINEARBUILD_TOOLCHAIN_PREFIX is set, this is used
# as prefix for the tools (e.g. arm-elf-g++, arm-elf-ar etc.)
#
# Sets the following variables:
#   LINEARBUILD_OBJCXX_COMPILER
#   LINEARBUILD_AR
#   LINEARBUILD_RANLIB
#
# If not already set before, it also sets
#   _LINEARBUILD_TOOLCHAIN_PREFIX

include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompiler.linearbuild)

# Load system-specific compiler preferences for this language.
include(Platform/${LINEARBUILD_SYSTEM_NAME}-Determine-OBJCXX OPTIONAL)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-OBJCXX OPTIONAL)
if(NOT LINEARBUILD_OBJCXX_COMPILER_NAMES)
  set(LINEARBUILD_OBJCXX_COMPILER_NAMES clang++)
endif()

if("${LINEARBUILD_GENERATOR}" MATCHES "Xcode")
  set(LINEARBUILD_OBJCXX_COMPILER_XCODE_TYPE sourcecode.cpp.objcpp)
else()
  if(NOT LINEARBUILD_OBJCXX_COMPILER)
    set(LINEARBUILD_OBJCXX_COMPILER_INIT NOTFOUND)

    # prefer the environment variable OBJCXX or CXX
    foreach(var OBJCXX CXX)
      if($ENV{${var}} MATCHES ".+")
        get_filename_component(LINEARBUILD_OBJCXX_COMPILER_INIT $ENV{${var}} PROGRAM PROGRAM_ARGS LINEARBUILD_OBJCXX_FLAGS_ENV_INIT)
        if(LINEARBUILD_OBJCXX_FLAGS_ENV_INIT)
          set(LINEARBUILD_OBJCXX_COMPILER_ARG1 "${LINEARBUILD_OBJCXX_FLAGS_ENV_INIT}" CACHE STRING "Arguments to Objective-C++ compiler")
        endif()
        if(NOT EXISTS ${LINEARBUILD_OBJCXX_COMPILER_INIT})
          message(FATAL_ERROR "Could not find the compiler specified in the environment variable ${var}:\n  $ENV{${var}}")
        endif()
        break()
      endif()
    endforeach()

    # next prefer the generator specified compiler
    if(LINEARBUILD_GENERATOR_OBJCXX)
      if(NOT LINEARBUILD_OBJCXX_COMPILER_INIT)
        set(LINEARBUILD_OBJCXX_COMPILER_INIT ${LINEARBUILD_GENERATOR_OBJCXX})
      endif()
    endif()

    # finally list compilers to try
    if(NOT LINEARBUILD_OBJCXX_COMPILER_INIT)
      set(LINEARBUILD_OBJCXX_COMPILER_LIST ${_LINEARBUILD_TOOLCHAIN_PREFIX}c++ ${_LINEARBUILD_TOOLCHAIN_PREFIX}g++ clang++)
    endif()

    _linearbuild_find_compiler(OBJCXX)

  else()
    # we only get here if LINEARBUILD_OBJCXX_COMPILER was specified using -D or a pre-made LinearBuildCache.txt
    # (e.g. via ctest) or set in LINEARBUILD_TOOLCHAIN_FILE
    # if LINEARBUILD_OBJCXX_COMPILER is a list, use the first item as
    # LINEARBUILD_OBJCXX_COMPILER and the rest as LINEARBUILD_OBJCXX_COMPILER_ARG1
    set(LINEARBUILD_OBJCXX_COMPILER_ARG1 "${LINEARBUILD_OBJCXX_COMPILER}")
    list(POP_FRONT LINEARBUILD_OBJCXX_COMPILER_ARG1 LINEARBUILD_OBJCXX_COMPILER)
    list(JOIN LINEARBUILD_OBJCXX_COMPILER_ARG1 " " LINEARBUILD_OBJCXX_COMPILER_ARG1)

    # if a compiler was specified by the user but without path,
    # now try to find it with the full path
    # if it is found, force it into the cache,
    # if not, don't overwrite the setting (which was given by the user) with "NOTFOUND"
    # if the C compiler already had a path, reuse it for searching the CXX compiler
    get_filename_component(_LINEARBUILD_USER_OBJCXX_COMPILER_PATH "${LINEARBUILD_OBJCXX_COMPILER}" PATH)
    if(NOT _LINEARBUILD_USER_OBJCXX_COMPILER_PATH)
      find_program(LINEARBUILD_OBJCXX_COMPILER_WITH_PATH NO_CACHE NAMES ${LINEARBUILD_OBJCXX_COMPILER})
      if(LINEARBUILD_OBJCXX_COMPILER_WITH_PATH)
        set(LINEARBUILD_OBJCXX_COMPILER ${LINEARBUILD_OBJCXX_COMPILER_WITH_PATH} CACHE STRING "Objective-C++ compiler" FORCE)
      endif()
    endif()

  endif()
  mark_as_advanced(LINEARBUILD_OBJCXX_COMPILER)

  # Each entry in this list is a set of extra flags to try
  # adding to the compile line to see if it helps produce
  # a valid identification file.
  set(LINEARBUILD_OBJCXX_COMPILER_ID_TEST_FLAGS_FIRST)
  set(LINEARBUILD_OBJCXX_COMPILER_ID_TEST_FLAGS
    # Try compiling to an object file only.
    "-c"

    # ARMClang need target options
    "--target=arm-arm-none-eabi -mcpu=cortex-m3"
    )
endif()

# Build a small source file to identify the compiler.
if(NOT LINEARBUILD_OBJCXX_COMPILER_ID_RUN)
  set(LINEARBUILD_OBJCXX_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(LINEARBUILD_OBJCXX_COMPILER_ID)
  file(READ ${LINEARBUILD_ROOT}/Modules/LinearBuildPlatformId.h.in
    LINEARBUILD_OBJCXX_COMPILER_ID_PLATFORM_CONTENT)

  # Match the link line from xcodebuild output of the form
  #  Ld ...
  #      ...
  #      /path/to/cc ...CompilerIdOBJCXX/...
  # to extract the compiler front-end for the language.
  set(LINEARBUILD_OBJCXX_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdOBJCXX/(\\./)?(CompilerIdOBJCXX.(framework|xctest|build/[^ \t\r\n]+)/)?CompilerIdOBJCXX[ \t\n\\\"]")
  set(LINEARBUILD_OBJCXX_COMPILER_ID_TOOL_MATCH_INDEX 2)

  include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerId.linearbuild)
  LINEARBUILD_DETERMINE_COMPILER_ID(OBJCXX OBJCXXFLAGS LinearBuildOBJCXXCompilerId.mm)

  # Set old compiler and platform id variables.
  if(LINEARBUILD_OBJCXX_COMPILER_ID MATCHES "GNU")
    set(LINEARBUILD_COMPILER_IS_GNUOBJCXX 1)
  endif()
  if(LINEARBUILD_OBJCXX_COMPILER_ID MATCHES "Clang")
    set(LINEARBUILD_COMPILER_IS_CLANGOBJCXX 1)
  endif()
endif()

if (NOT _LINEARBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_LINEARBUILD_TOOLCHAIN_LOCATION "${LINEARBUILD_OBJCXX_COMPILER}" PATH)
endif ()

# if we have a g++ cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-g++, arm-elf-g++ or i586-mingw32msvc-g++ , optionally
# with a 3-component version number at the end (e.g. arm-eabi-gcc-4.5.2).
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gcc.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"


if (NOT _LINEARBUILD_TOOLCHAIN_PREFIX)

  if("${LINEARBUILD_OBJCXX_COMPILER_ID}" MATCHES "GNU|Clang|QCC")
    get_filename_component(COMPILER_BASENAME "${LINEARBUILD_OBJCXX_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+-)(clan)?[gc]\\+\\+(-[0-9]+(\\.[0-9]+)*)?(-[^.]+)?(\\.exe)?$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
      set(_LINEARBUILD_COMPILER_SUFFIX ${LINEARBUILD_MATCH_5})
    elseif("${LINEARBUILD_OBJCXX_COMPILER_ID}" MATCHES "Clang")
      if(LINEARBUILD_OBJCXX_COMPILER_TARGET)
        set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_OBJCXX_COMPILER_TARGET}-)
      endif()
    elseif(COMPILER_BASENAME MATCHES "QCC(\\.exe)?$")
      if(LINEARBUILD_OBJCXX_COMPILER_TARGET MATCHES "gcc_nto([a-z0-9]+_[0-9]+|[^_le]+)(le)")
        set(_LINEARBUILD_TOOLCHAIN_PREFIX nto${LINEARBUILD_MATCH_1}-)
      endif()
    endif ()

    # if "llvm-" is part of the prefix, remove it, since llvm doesn't have its own binutils
    # but uses the regular ar, objcopy, etc. (instead of llvm-objcopy etc.)
    if ("${_LINEARBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
    endif ()
  endif()

endif ()

set(_LINEARBUILD_PROCESSING_LANGUAGE "OBJCXX")
include(LinearBuildFindBinUtils)
include(Compiler/${LINEARBUILD_OBJCXX_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_LINEARBUILD_PROCESSING_LANGUAGE)

if(LINEARBUILD_OBJCXX_XCODE_ARCHS)
  set(SET_LINEARBUILD_XCODE_ARCHS
    "set(LINEARBUILD_XCODE_ARCHS \"${LINEARBUILD_OBJCXX_XCODE_ARCHS}\")")
endif()

# configure all variables set in this file
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildOBJCXXCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildOBJCXXCompiler.linearbuild
  @ONLY
  )

set(LINEARBUILD_OBJCXX_COMPILER_ENV_VAR "OBJCXX")
