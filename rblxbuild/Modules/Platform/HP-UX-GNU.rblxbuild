# This module is shared by multiple languages; use include blocker.
if(__HPUX_COMPILER_GNU)
  return()
endif()
set(__HPUX_COMPILER_GNU 1)

macro(__hpux_compiler_gnu lang)
  string(APPEND RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS " -Wl,-E,-b,+nodefaultrpath")
  set(RBLXBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS "-Wl,-E")
  set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG "-Wl,+b")
  set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG_SEP ":")
  set(RBLXBUILD_SHARED_LIBRARY_SONAME_${lang}_FLAG "-Wl,+h")

  set(RBLXBUILD_EXECUTABLE_CREATE_${lang}_FLAGS "-Wl,+s,+nodefaultrpath")
  rblxbuild_policy(GET CMP0210 _CMP0210)
  if (NOT _CMP0210 STREQUAL "NEW")
    set(RBLXBUILD_${lang}_LINK_FLAGS "${RBLXBUILD_EXECUTABLE_CREATE_${lang}_FLAGS}")
  endif()
  unset(_CMP0210)

  unset(RBLXBUILD_${lang}_COMPILE_OPTIONS_VISIBILITY)
endmacro()
