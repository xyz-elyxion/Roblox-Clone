# This file sets the basic flags for the C# language in LinearBuild.
# It also loads the available platform file for the system-compiler
# if it exists.

set(LINEARBUILD_BASE_NAME)
get_filename_component(LINEARBUILD_BASE_NAME "${LINEARBUILD_CSharp_COMPILER}" NAME_WE)

set(LINEARBUILD_BUILD_TYPE_INIT Debug)

set(LINEARBUILD_CSharp_FLAGS_INIT "/define:TRACE")
set(LINEARBUILD_CSharp_FLAGS_DEBUG_INIT "/debug:full /optimize- /warn:3 /errorreport:prompt /define:DEBUG")
set(LINEARBUILD_CSharp_FLAGS_RELEASE_INIT "/debug:none /optimize  /warn:1  /errorreport:queue")
set(LINEARBUILD_CSharp_FLAGS_RELWITHDEBINFO_INIT "/debug:full /optimize-")
set(LINEARBUILD_CSharp_FLAGS_MINSIZEREL_INIT "/debug:none /optimize")
set(LINEARBUILD_CSharp_LINKER_SUPPORTS_PDB ON)

set(LINEARBUILD_CSharp_STANDARD_LIBRARIES_INIT "System")

if(LINEARBUILD_SIZEOF_VOID_P EQUAL 4)
  set(LINEARBUILD_CSharp_FLAGS_INIT "/platform:x86 ${LINEARBUILD_CSharp_FLAGS_INIT}")
else()
  set(LINEARBUILD_CSharp_FLAGS_INIT "/platform:x64 ${LINEARBUILD_CSharp_FLAGS_INIT}")
endif()

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

# for most systems a module is the same as a shared library
# so unless the variable LINEARBUILD_MODULE_EXISTS is set just
# copy the values from the LIBRARY variables
if(NOT LINEARBUILD_MODULE_EXISTS)
  set(LINEARBUILD_SHARED_MODULE_CSharp_FLAGS ${LINEARBUILD_SHARED_LIBRARY_CSharp_FLAGS})
  set(LINEARBUILD_SHARED_MODULE_CREATE_CSharp_FLAGS ${LINEARBUILD_SHARED_LIBRARY_CREATE_CSharp_FLAGS})
endif()

# add the flags to the cache based
# on the initial values computed in the platform/*.linearbuild files
# use _INIT variables so that this only happens the first time
# and you can set these flags in the linearbuild cache
set(LINEARBUILD_CSharp_FLAGS_INIT "$ENV{CSFLAGS} ${LINEARBUILD_CSharp_FLAGS_INIT}")

linearbuild_initialize_per_config_variable(LINEARBUILD_CSharp_FLAGS "Flags used by the C# compiler")

if(LINEARBUILD_CSharp_STANDARD_LIBRARIES_INIT)
  set(LINEARBUILD_CSharp_STANDARD_LIBRARIES "${LINEARBUILD_CSharp_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all C# applications.")
  mark_as_advanced(LINEARBUILD_CSharp_STANDARD_LIBRARIES)
endif()

# set missing flags (if they are not defined). This is needed in the
# unlikely case that you have only C# and no C/C++ targets in your
# project.
linearbuild_initialize_per_config_variable(LINEARBUILD_EXE_LINKER_FLAGS    "Flags used by the linker")
linearbuild_initialize_per_config_variable(LINEARBUILD_SHARED_LINKER_FLAGS "Flags used by the linker during the creation of shared libraries")

set(LINEARBUILD_CSharp_CREATE_SHARED_LIBRARY "CSharp_NO_CREATE_SHARED_LIBRARY")
set(LINEARBUILD_CSharp_CREATE_SHARED_MODULE "CSharp_NO_CREATE_SHARED_MODULE")
set(LINEARBUILD_CSharp_LINK_EXECUTABLE "CSharp_NO_LINK_EXECUTABLE")

set(LINEARBUILD_CSharp_USE_RESPONSE_FILE_FOR_OBJECTS 1)

set(LINEARBUILD_CSharp_USE_LINKER_INFORMATION FALSE)

set(LINEARBUILD_CSharp_INFORMATION_LOADED 1)
