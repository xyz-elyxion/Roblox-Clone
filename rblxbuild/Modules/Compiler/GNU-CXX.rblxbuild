include(Compiler/GNU)
__compiler_gnu(CXX)
__compiler_gnu_cxx_standards(CXX)


if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
    AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND RBLXBUILD_DEPFILE_FLAGS_CXX)
  # dependencies are computed by the compiler itself
  set(RBLXBUILD_CXX_DEPFILE_FORMAT gcc)
  set(RBLXBUILD_CXX_DEPENDS_USE_COMPILER TRUE)
endif()

set(RBLXBUILD_CXX_COMPILE_OPTIONS_EXPLICIT_LANGUAGE -x c++)

if (WIN32)
  if(NOT RBLXBUILD_CXX_COMPILER_VERSION VERSION_LESS 4.6)
    set(RBLXBUILD_CXX_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fno-keep-inline-dllexport")
  endif()
else()
  if(NOT RBLXBUILD_CXX_COMPILER_VERSION VERSION_LESS 4.0)
    set(RBLXBUILD_CXX_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")
  endif()
endif()

__compiler_check_default_language_standard(CXX 3.4 98 6.0 14 11.1 17)

if(RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 14.0)
  string(CONCAT RBLXBUILD_CXX_SCANDEP_SOURCE
    "<RBLXBUILD_CXX_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E -x c++ <SOURCE>"
    " -MT <DYNDEP_FILE> -MD -MF <DEP_FILE>"
    " -fmodules-ts -fdeps-file=<DYNDEP_FILE> -fdeps-target=<OBJECT> -fdeps-format=p1689r5"
    " -o <PREPROCESSED_SOURCE>")
  set(RBLXBUILD_CXX_MODULE_MAP_FORMAT "gcc")
  string(CONCAT RBLXBUILD_CXX_MODULE_MAP_FLAG
    # Turn on modules.
    "-fmodules-ts"
    # Read the module mapper file.
    " -fmodule-mapper=<MODULE_MAP_FILE>"
    # Make sure dependency tracking is enabled (missing from `try_*`).
    " -MD"
    # Suppress `CXX_MODULES +=` from generated depfile snippets.
    " -fdeps-format=p1689r5"
    # Force C++ as a language.
    " -x c++")
  set(RBLXBUILD_CXX_MODULE_BMI_ONLY_FLAG "-fmodule-only")
endif()
