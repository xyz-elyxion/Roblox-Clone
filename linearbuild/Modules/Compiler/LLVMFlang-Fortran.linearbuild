set(LINEARBUILD_Fortran_SUBMODULE_SEP "-")
set(LINEARBUILD_Fortran_SUBMODULE_EXT ".mod")

set(LINEARBUILD_Fortran_PREPROCESS_SOURCE
    "<LINEARBUILD_Fortran_COMPILER> -cpp <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")

set(LINEARBUILD_Fortran_FORMAT_FIXED_FLAG "-ffixed-form")
set(LINEARBUILD_Fortran_FORMAT_FREE_FLAG "-ffree-form")

set(LINEARBUILD_Fortran_MODDIR_FLAG "-J")

set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-cpp")
set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-nocpp")
set(LINEARBUILD_Fortran_POSTPROCESS_FLAG "-ffixed-line-length-72")

set(LINEARBUILD_Fortran_COMPILE_OPTIONS_TARGET "--target=")

if(LINEARBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 13.0)
  set(LINEARBUILD_Fortran_COMPILE_OPTIONS_WARNING_AS_ERROR "-Werror")
endif()

set(LINEARBUILD_Fortran_LINKER_WRAPPER_FLAG "-Wl,")
set(LINEARBUILD_Fortran_LINKER_WRAPPER_FLAG_SEP ",")

if("x${LINEARBUILD_Fortran_SIMULATE_ID}" STREQUAL "xMSVC")
  set(LINEARBUILD_Fortran_LINK_MODE LINKER)
else()
  set(LINEARBUILD_Fortran_VERBOSE_FLAG "-v")

  set(LINEARBUILD_Fortran_LINK_MODE DRIVER)

  set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PIC "-fPIC")
  set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PIE "-fPIE")

  string(APPEND LINEARBUILD_Fortran_FLAGS_DEBUG_INIT " -O0 -g")
  string(APPEND LINEARBUILD_Fortran_FLAGS_RELWITHDEBINFO_INIT " -O2 -g")
  string(APPEND LINEARBUILD_Fortran_FLAGS_RELEASE_INIT " -O3")
endif()

set(LINEARBUILD_SHARED_LIBRARY_Fortran_FLAGS -fPIC)
set(LINEARBUILD_SHARED_LIBRARY_CREATE_Fortran_FLAGS "-shared")

# Determine LTO support
set(_LINEARBUILD_Fortran_IPO_SUPPORTED_BY_LINEARBUILD NO)
set(_LINEARBUILD_Fortran_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)
if(LINEARBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL 18.0)
  set(_LINEARBUILD_Fortran_IPO_SUPPORTED_BY_LINEARBUILD YES)
  set(_LINEARBUILD_Fortran_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
  if(LINEARBUILD_Fortran_COMPILER_VERSION VERSION_LESS 23.0)
    set(LINEARBUILD_Fortran_COMPILE_OPTIONS_IPO "-flto")
  else()
    set(LINEARBUILD_Fortran_COMPILE_OPTIONS_IPO "-flto=thin")
  endif()
endif()
