# Define the environment for cross-compiling with 64-bit MinGW-w64 Clang
SET(LINEARBUILD_SYSTEM_NAME    Windows) # Target system name
SET(LINEARBUILD_SYSTEM_VERSION 1)
SET(LINEARBUILD_C_COMPILER     "x86_64-w64-mingw32-clang")
SET(LINEARBUILD_CXX_COMPILER   "x86_64-w64-mingw32-clang++")
SET(LINEARBUILD_RC_COMPILER    "x86_64-w64-mingw32-windres")
SET(LINEARBUILD_RANLIB         "x86_64-w64-mingw32-ranlib")

# Configure the behaviour of the find commands
SET(LINEARBUILD_FIND_ROOT_PATH "/usr/x86_64-w64-mingw32")
SET(LINEARBUILD_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(LINEARBUILD_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(LINEARBUILD_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
