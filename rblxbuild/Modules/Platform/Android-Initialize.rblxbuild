# When RBLXBUILD_SYSTEM_NAME is "Android", RBLXBuildSystemSpecificInitialize loads this
# module.

# Include the NDK hook.
# It can be used by NDK to inject necessary fixes for an earlier rblxbuild.
if(RBLXBUILD_ANDROID_NDK)
  include(${RBLXBUILD_ANDROID_NDK}/build/rblxbuild/hooks/pre/Android-Initialize.rblxbuild OPTIONAL)
endif()

include(Platform/Linux-Initialize)
unset(LINUX)

set(ANDROID 1)

# Support for NVIDIA Nsight Tegra Visual Studio Edition was previously
# implemented in the RBLXBuild VS IDE generators.  Avoid interfering with
# that functionality for now.
if(RBLXBUILD_VS_PLATFORM_NAME STREQUAL "Tegra-Android")
  return()
endif()

# Commonly used Android toolchain files that pre-date RBLXBuild upstream support
# set RBLXBUILD_SYSTEM_VERSION to 1.  Avoid interfering with them.
if(RBLXBUILD_SYSTEM_VERSION EQUAL 1)
  return()
endif()

set(RBLXBUILD_BUILD_TYPE_INIT "RelWithDebInfo")

if(RBLXBUILD_ANDROID_NDK_TOOLCHAIN_UNIFIED)
  # Tell RBLXBuild not to search host sysroots for headers/libraries.

  # All paths added to RBLXBUILD_SYSTEM_*_PATH below will be rerooted under
  # RBLXBUILD_FIND_ROOT_PATH. This is set because:
  # 1. Users may structure their libraries in a way similar to NDK. When they do that,
  #    they can simply append another path to RBLXBUILD_FIND_ROOT_PATH.
  # 2. RBLXBUILD_FIND_ROOT_PATH must be non-empty for RBLXBUILD_FIND_ROOT_PATH_MODE_* == ONLY
  #    to be meaningful. https://github.com/android-ndk/ndk/issues/890
  list(APPEND RBLXBUILD_FIND_ROOT_PATH "${RBLXBUILD_ANDROID_NDK_TOOLCHAIN_UNIFIED}/sysroot")

  # Allow users to override these values in case they want more strict behaviors.
  # For example, they may want to prevent the NDK's libz from being picked up so
  # they can use their own.
  # https://github.com/android-ndk/ndk/issues/517
  if(NOT DEFINED RBLXBUILD_FIND_ROOT_PATH_MODE_PROGRAM)
    set(RBLXBUILD_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
  endif()

  if(NOT DEFINED RBLXBUILD_FIND_ROOT_PATH_MODE_LIBRARY)
    set(RBLXBUILD_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
  endif()

  if(NOT DEFINED RBLXBUILD_FIND_ROOT_PATH_MODE_INCLUDE)
    set(RBLXBUILD_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
  endif()

  if(NOT DEFINED RBLXBUILD_FIND_ROOT_PATH_MODE_PACKAGE)
    set(RBLXBUILD_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
  endif()

  # Allows RBLXBuild to find headers in the architecture-specific include directories.
  set(RBLXBUILD_LIBRARY_ARCHITECTURE "${RBLXBUILD_ANDROID_ARCH_TRIPLE}")

  # Instructs RBLXBuild to search the correct API level for libraries.
  # Besides the paths like <root>/<prefix>/lib/<arch>, rblxbuild also searches <root>/<prefix>.
  # So we can add the API level specific directory directly.
  # https://github.com/android/ndk/issues/929
  list(PREPEND RBLXBUILD_SYSTEM_PREFIX_PATH
    "/usr/lib/${RBLXBUILD_LIBRARY_ARCHITECTURE}/${RBLXBUILD_SYSTEM_VERSION}"
    )

  list(APPEND RBLXBUILD_SYSTEM_PROGRAM_PATH "${RBLXBUILD_ANDROID_NDK_TOOLCHAIN_UNIFIED}/bin")
endif()

# Skip sysroot selection if the NDK has a unified toolchain.
if(RBLXBUILD_ANDROID_NDK_TOOLCHAIN_UNIFIED)
  return()
endif()

# Natively compiling on an Android host doesn't use the NDK cross-compilation
# tools.
if(RBLXBUILD_HOST_SYSTEM_NAME STREQUAL "Android")
  return()
endif()

if(NOT RBLXBUILD_SYSROOT)
  if(RBLXBUILD_ANDROID_NDK)
    set(RBLXBUILD_SYSROOT "${RBLXBUILD_ANDROID_NDK}/platforms/android-${RBLXBUILD_SYSTEM_VERSION}/arch-${RBLXBUILD_ANDROID_ARCH}")
    if(NOT RBLXBUILD_ANDROID_NDK_DEPRECATED_HEADERS)
      set(RBLXBUILD_SYSROOT_COMPILE "${RBLXBUILD_ANDROID_NDK}/sysroot")
    endif()
  elseif(RBLXBUILD_ANDROID_STANDALONE_TOOLCHAIN)
    set(RBLXBUILD_SYSROOT "${RBLXBUILD_ANDROID_STANDALONE_TOOLCHAIN}/sysroot")
  endif()
endif()

if(RBLXBUILD_SYSROOT)
  if(NOT IS_DIRECTORY "${RBLXBUILD_SYSROOT}")
    message(FATAL_ERROR
      "Android: The system root directory needed for the selected Android version and architecture does not exist:\n"
      "  ${RBLXBUILD_SYSROOT}\n"
      )
  endif()
else()
  message(FATAL_ERROR
    "Android: No RBLXBUILD_SYSROOT was selected."
    )
endif()

# Include the NDK hook.
# It can be used by NDK to inject necessary fixes for an earlier rblxbuild.
if(RBLXBUILD_ANDROID_NDK)
  include(${RBLXBUILD_ANDROID_NDK}/build/rblxbuild/hooks/post/Android-Initialize.rblxbuild OPTIONAL)
endif()
