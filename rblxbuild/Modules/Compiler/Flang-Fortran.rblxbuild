include(Compiler/Clang)
__compiler_clang(Fortran)

# No -isystem for Fortran because it will not find .mod files.
unset(RBLXBUILD_INCLUDE_SYSTEM_FLAG_Fortran)

set(RBLXBUILD_Fortran_SUBMODULE_SEP "-")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".mod")

set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
    "<RBLXBUILD_Fortran_COMPILER> -cpp <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")

set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-ffixed-form")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-ffree-form")

set(RBLXBUILD_Fortran_MODDIR_FLAG "-J")

set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-cpp")
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-nocpp")
