include(Compiler/LCC)
__compiler_lcc(Fortran)

set(RBLXBUILD_Fortran_SUBMODULE_SEP "@")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".smod")

set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
  "<RBLXBUILD_Fortran_COMPILER> -cpp <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> -o <PREPROCESSED_SOURCE>")

set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-ffixed-form")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-ffree-form")

# LCC < 1.24.00 has a broken Fortran preprocessor
if(RBLXBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL "1.24.00")
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-cpp")
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-nocpp")
endif()

set(RBLXBUILD_Fortran_POSTPROCESS_FLAG "-fpreprocessed")

# No -DNDEBUG for Fortran.
string(APPEND RBLXBUILD_Fortran_FLAGS_MINSIZEREL_INIT " -Os")
string(APPEND RBLXBUILD_Fortran_FLAGS_RELEASE_INIT " -O3")

# No -isystem for Fortran because it will not find .mod files.
unset(RBLXBUILD_INCLUDE_SYSTEM_FLAG_Fortran)

# Fortran-specific feature flags.
set(RBLXBUILD_Fortran_MODDIR_FLAG -J)
