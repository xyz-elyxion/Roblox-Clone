include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompiler.linearbuild)
include(${LINEARBUILD_ROOT}/Modules/LinearBuildParseImplicitLinkInfo.linearbuild)

if( NOT ( ("${LINEARBUILD_GENERATOR}" MATCHES "Make") OR
          ("${LINEARBUILD_GENERATOR}" MATCHES "Ninja") OR
          ("${LINEARBUILD_GENERATOR}" MATCHES "FASTBuild") OR
          ("${LINEARBUILD_GENERATOR}" MATCHES "Visual Studio (1|[9][0-9])") ) )
  message(FATAL_ERROR "CUDA language not currently supported by \"${LINEARBUILD_GENERATOR}\" generator")
endif()

if(LINEARBUILD_GENERATOR MATCHES "Visual Studio")
  if(DEFINED ENV{CUDAHOSTCXX} OR DEFINED LINEARBUILD_CUDA_HOST_COMPILER)
    message(WARNING "Visual Studio does not support specifying CUDAHOSTCXX or LINEARBUILD_CUDA_HOST_COMPILER. Using the C++ compiler provided by Visual Studio.")
  endif()
else()
  if(NOT LINEARBUILD_CUDA_COMPILER)
    set(LINEARBUILD_CUDA_COMPILER_INIT NOTFOUND)

    # prefer the environment variable CUDACXX
    if(NOT $ENV{CUDACXX} STREQUAL "")
      get_filename_component(LINEARBUILD_CUDA_COMPILER_INIT $ENV{CUDACXX} PROGRAM PROGRAM_ARGS LINEARBUILD_CUDA_FLAGS_ENV_INIT)
      if(LINEARBUILD_CUDA_FLAGS_ENV_INIT)
        set(LINEARBUILD_CUDA_COMPILER_ARG1 "${LINEARBUILD_CUDA_FLAGS_ENV_INIT}" CACHE STRING "Arguments to CUDA compiler")
      endif()
      if(NOT EXISTS ${LINEARBUILD_CUDA_COMPILER_INIT})
        message(FATAL_ERROR "Could not find the compiler specified in the environment variable CUDACXX:\n$ENV{CUDACXX}.\n${LINEARBUILD_CUDA_COMPILER_INIT}")
      endif()
    endif()

    # finally list compilers to try
    if(NOT LINEARBUILD_CUDA_COMPILER_INIT)
      set(LINEARBUILD_CUDA_COMPILER_LIST nvcc)
    endif()

    set(_LINEARBUILD_CUDA_COMPILER_PATHS "$ENV{CUDA_PATH}/bin")
    _linearbuild_find_compiler(CUDA)
    unset(_LINEARBUILD_CUDA_COMPILER_PATHS)
  else()
    _linearbuild_find_compiler_path(CUDA)
  endif()

  mark_as_advanced(LINEARBUILD_CUDA_COMPILER)

  #Allow the user to specify a host compiler except for Visual Studio
  if(NOT $ENV{CUDAHOSTCXX} STREQUAL "")
    get_filename_component(LINEARBUILD_CUDA_HOST_COMPILER $ENV{CUDAHOSTCXX} PROGRAM)
    if(NOT EXISTS ${LINEARBUILD_CUDA_HOST_COMPILER})
      message(FATAL_ERROR "Could not find the compiler specified in the environment variable CUDAHOSTCXX:\n$ENV{CUDAHOSTCXX}.\n${LINEARBUILD_CUDA_HOST_COMPILER}")
    endif()
  elseif(LINEARBUILD_CUDA_HOST_COMPILER)
    # We get here if LINEARBUILD_CUDA_HOST_COMPILER was specified by the user or toolchain file.
    if(IS_ABSOLUTE "${LINEARBUILD_CUDA_HOST_COMPILER}")
      # Convert to forward slashes.
      linearbuild_path(CONVERT "${LINEARBUILD_CUDA_HOST_COMPILER}" TO_LINEARBUILD_PATH_LIST LINEARBUILD_CUDA_HOST_COMPILER NORMALIZE)
    else()
      # Convert to absolute path so changes in `PATH` do not impact CUDA compilation.
      find_program(_LINEARBUILD_CUDA_HOST_COMPILER_PATH NO_CACHE NAMES "${LINEARBUILD_CUDA_HOST_COMPILER}")
      if(_LINEARBUILD_CUDA_HOST_COMPILER_PATH)
        set(LINEARBUILD_CUDA_HOST_COMPILER "${_LINEARBUILD_CUDA_HOST_COMPILER_PATH}")
      endif()
      unset(_LINEARBUILD_CUDA_HOST_COMPILER_PATH)
    endif()
    if(NOT EXISTS "${LINEARBUILD_CUDA_HOST_COMPILER}")
      message(FATAL_ERROR "Could not find the compiler specified in the variable LINEARBUILD_CUDA_HOST_COMPILER:\n  ${LINEARBUILD_CUDA_HOST_COMPILER}")
    endif()
    # If the value was cached, update the cache entry with our modifications.
    get_property(_LINEARBUILD_CUDA_HOST_COMPILER_CACHED CACHE LINEARBUILD_CUDA_HOST_COMPILER PROPERTY TYPE)
    if(_LINEARBUILD_CUDA_HOST_COMPILER_CACHED)
      set_property(CACHE LINEARBUILD_CUDA_HOST_COMPILER PROPERTY VALUE "${LINEARBUILD_CUDA_HOST_COMPILER}")
      mark_as_advanced(LINEARBUILD_CUDA_HOST_COMPILER)
    endif()
    unset(_LINEARBUILD_CUDA_HOST_COMPILER_CACHED)
  endif()
endif()

if(NOT "$ENV{CUDAARCHS}" STREQUAL "")
  set(LINEARBUILD_CUDA_ARCHITECTURES "$ENV{CUDAARCHS}" CACHE STRING "CUDA architectures")
endif()

# Build a small source file to identify the compiler.
if(NOT LINEARBUILD_CUDA_COMPILER_ID_RUN)
  set(LINEARBUILD_CUDA_COMPILER_ID_RUN 1)

  include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerId.linearbuild)

  if(LINEARBUILD_GENERATOR MATCHES "Visual Studio")
    # We will not know LINEARBUILD_CUDA_COMPILER until the main compiler id step
    # below extracts it, but we do know that the compiler id will be NVIDIA.
    set(LINEARBUILD_CUDA_COMPILER_ID "NVIDIA")
  else()
    # We determine the vendor to help with find the toolkit and use the right flags for detection right away.
    # The main compiler identification is still needed below to extract other information.
    list(APPEND LINEARBUILD_CUDA_COMPILER_ID_VENDORS NVIDIA Clang)
    set(LINEARBUILD_CUDA_COMPILER_ID_VENDOR_REGEX_NVIDIA "nvcc: [^\n]+ Cuda compiler driver")
    set(LINEARBUILD_CUDA_COMPILER_ID_VENDOR_REGEX_Clang "(clang version)")
    LINEARBUILD_DETERMINE_COMPILER_ID_VENDOR(CUDA "--version")

    # Find the CUDA toolkit to get:
    # - LINEARBUILD_CUDA_COMPILER_TOOLKIT_VERSION
    # - LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT
    # - LINEARBUILD_CUDA_COMPILER_LIBRARY_ROOT
    # We save them in LinearBuildCUDACompiler.linearbuild so FindCUDAToolkit can
    # avoid searching on future runs and the toolkit is the same.
    # Match arguments with linearbuild_cuda_architectures_all call.
    include(Internal/LinearBuildCUDAFindToolkit)
    linearbuild_cuda_find_toolkit(CUDA LINEARBUILD_CUDA_COMPILER_)

    set(LINEARBUILD_CUDA_DEVICE_LINKER "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}/bin/nvlink${LINEARBUILD_EXECUTABLE_SUFFIX}")
    set(LINEARBUILD_CUDA_FATBINARY "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}/bin/fatbinary${LINEARBUILD_EXECUTABLE_SUFFIX}")
  endif()

  set(LINEARBUILD_CUDA_COMPILER_ID_FLAGS_ALWAYS "-v")

  if(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "NVIDIA")
    set(nvcc_test_flags "--keep --keep-dir tmp")
    if(LINEARBUILD_CUDA_HOST_COMPILER)
      string(APPEND nvcc_test_flags " -ccbin=\"${LINEARBUILD_CUDA_HOST_COMPILER}\"")
    endif()
    # If we have extracted the vendor as NVIDIA we should require detection to
    # work. If we don't, users will get confusing errors later about failure
    # to detect a default value for LINEARBUILD_CUDA_ARCHITECTURES
    set(LINEARBUILD_CUDA_COMPILER_ID_REQUIRE_SUCCESS ON)
  elseif(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "Clang")
    set(clang_test_flags "--cuda-path=\"${LINEARBUILD_CUDA_COMPILER_LIBRARY_ROOT}\"")
    if(LINEARBUILD_CROSSCOMPILING)
      # Need to pass the host target and include directories if we're crosscompiling.
      string(APPEND clang_test_flags " --sysroot=\"${LINEARBUILD_SYSROOT}\" --target=${LINEARBUILD_CUDA_COMPILER_TARGET}")
    endif()
  endif()

  # If the user set LINEARBUILD_CUDA_ARCHITECTURES, validate its value.
  include(Internal/LinearBuildCUDAArchitecturesValidate)
  linearbuild_cuda_architectures_validate(CUDA)

  if(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "Clang")
    # Clang does not automatically select an architecture supported by the SDK.
    # Prefer NVCC's default for each SDK version, and fall back to older archs.
    set(archs "")
    if(NOT LINEARBUILD_CUDA_COMPILER_TOOLKIT_VERSION VERSION_LESS 13.0)
      list(APPEND archs 75)
    endif()
    if(NOT LINEARBUILD_CUDA_COMPILER_TOOLKIT_VERSION VERSION_LESS 11.0)
      list(APPEND archs 52)
    endif()
    list(APPEND archs 30 20)
    foreach(arch IN LISTS archs)
      list(APPEND LINEARBUILD_CUDA_COMPILER_ID_TEST_FLAGS_FIRST "${clang_test_flags} --cuda-gpu-arch=sm_${arch}")
    endforeach()
  elseif(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "NVIDIA")
    list(APPEND LINEARBUILD_CUDA_COMPILER_ID_TEST_FLAGS_FIRST "${nvcc_test_flags}")
  endif()

  # We perform compiler identification for a second time to extract implicit linking info and host compiler for NVCC.
  # We need to unset the compiler ID otherwise LINEARBUILD_DETERMINE_COMPILER_ID() doesn't work.
  set(LINEARBUILD_CUDA_COMPILER_ID)
  set(LINEARBUILD_CUDA_PLATFORM_ID)
  file(READ ${LINEARBUILD_ROOT}/Modules/LinearBuildPlatformId.h.in
    LINEARBUILD_CUDA_COMPILER_ID_PLATFORM_CONTENT)

  LINEARBUILD_DETERMINE_COMPILER_ID(CUDA CUDAFLAGS LinearBuildCUDACompilerId.cu)

  if(LINEARBUILD_GENERATOR MATCHES "Visual Studio")
    # Now that we have the path to nvcc, we can compute the toolkit root.
    get_filename_component(LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT "${LINEARBUILD_CUDA_COMPILER}" DIRECTORY)
    get_filename_component(LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}" DIRECTORY)
    set(LINEARBUILD_CUDA_COMPILER_LIBRARY_ROOT "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}")

    # The compiler comes with the toolkit, so the versions are the same.
    set(LINEARBUILD_CUDA_COMPILER_TOOLKIT_VERSION ${LINEARBUILD_CUDA_COMPILER_VERSION})
  endif()

  include(Internal/LinearBuildCUDAArchitecturesAll)
  # From LINEARBUILD_CUDA_COMPILER_TOOLKIT_VERSION and LINEARBUILD_CUDA_COMPILER_{ID,VERSION}, get:
  # - LINEARBUILD_CUDA_ARCHITECTURES_ALL
  # - LINEARBUILD_CUDA_ARCHITECTURES_ALL_MAJOR
  # Match arguments with linearbuild_cuda_find_toolkit call.
  linearbuild_cuda_architectures_all(CUDA LINEARBUILD_CUDA_COMPILER_)

  _linearbuild_find_compiler_sysroot(CUDA)
endif()

set(_LINEARBUILD_PROCESSING_LANGUAGE "CUDA")
include(LinearBuildFindBinUtils)
include(Compiler/${LINEARBUILD_CUDA_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_LINEARBUILD_PROCESSING_LANGUAGE)

if(MSVC_CUDA_ARCHITECTURE_ID)
  set(SET_MSVC_CUDA_ARCHITECTURE_ID
    "set(MSVC_CUDA_ARCHITECTURE_ID ${MSVC_CUDA_ARCHITECTURE_ID})")
endif()

if(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "Clang")
  string(REGEX MATCHALL "-target-cpu sm_([0-9]+)" _clang_target_cpus "${LINEARBUILD_CUDA_COMPILER_PRODUCED_OUTPUT}")

  foreach(_clang_target_cpu ${_clang_target_cpus})
    if(_clang_target_cpu MATCHES "-target-cpu sm_([0-9]+)")
      list(APPEND LINEARBUILD_CUDA_ARCHITECTURES_DEFAULT "${LINEARBUILD_MATCH_1}")
    endif()
  endforeach()

  # Find target directory when crosscompiling.
  if(LINEARBUILD_CROSSCOMPILING)
    if(LINEARBUILD_CUDA_COMPILER_TARGET MATCHES "^([^-]+)(-|$)")
      set(_CUDA_TARGET_PROCESSOR "${LINEARBUILD_MATCH_1}")
    elseif(LINEARBUILD_SYSTEM_PROCESSOR)
      set(_CUDA_TARGET_PROCESSOR "${LINEARBUILD_SYSTEM_PROCESSOR}")
    else()
      message(FATAL_ERROR "Cross-compiling CUDA with Clang requires LINEARBUILD_CUDA_COMPILER_TARGET and/or LINEARBUILD_SYSTEM_PROCESSOR to be set.")
    endif()
    # Keep in sync with equivalent table in FindCUDAToolkit!
    if(_CUDA_TARGET_PROCESSOR STREQUAL "armv7-a")
      # Support for NVPACK
      set(_CUDA_TARGET_NAMES "armv7-linux-androideabi")
    elseif(_CUDA_TARGET_PROCESSOR MATCHES "arm")
      set(_CUDA_TARGET_NAMES "armv7-linux-gnueabihf")
    elseif(_CUDA_TARGET_PROCESSOR MATCHES "aarch64")
      if(ANDROID_ARCH_NAME STREQUAL "arm64")
        set(_CUDA_TARGET_NAMES "aarch64-linux-androideabi")
      elseif (LINEARBUILD_SYSTEM_NAME STREQUAL "QNX")
        set(_CUDA_TARGET_NAMES "aarch64-qnx")
      else()
        set(_CUDA_TARGET_NAMES "aarch64-linux" "sbsa-linux")
      endif()
    elseif(_CUDA_TARGET_PROCESSOR STREQUAL "x86_64")
      set(_CUDA_TARGET_NAMES "x86_64-linux")
    endif()

    foreach(_CUDA_TARGET_NAME IN LISTS _CUDA_TARGET_NAMES)
      if(EXISTS "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}/targets/${_CUDA_TARGET_NAME}")
        set(_CUDA_TARGET_DIR "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}/targets/${_CUDA_TARGET_NAME}")
        break()
      endif()
    endforeach()
    unset(_CUDA_TARGET_NAME)
    unset(_CUDA_TARGET_NAMES)
    unset(_CUDA_TARGET_PROCESSOR)
  endif()

  # If not already set we can simply use the toolkit root or it's a scattered installation.
  if(NOT _CUDA_TARGET_DIR)
    set(_CUDA_TARGET_DIR "${LINEARBUILD_CUDA_COMPILER_TOOLKIT_ROOT}")
  endif()

  # We can't use find_library() yet at this point, so try a few guesses.
  if(EXISTS "${_CUDA_TARGET_DIR}/lib64")
    set(_CUDA_LIBRARY_DIR "${_CUDA_TARGET_DIR}/lib64")
  elseif(EXISTS "${_CUDA_TARGET_DIR}/lib/x64")
    set(_CUDA_LIBRARY_DIR "${_CUDA_TARGET_DIR}/lib/x64")
  elseif(EXISTS "${_CUDA_TARGET_DIR}/lib/arm64")
    set(_CUDA_LIBRARY_DIR "${_CUDA_TARGET_DIR}/lib/arm64")
  elseif(EXISTS "${_CUDA_TARGET_DIR}/lib")
    set(_CUDA_LIBRARY_DIR "${_CUDA_TARGET_DIR}/lib")
  else()
    message(FATAL_ERROR "Unable to find _CUDA_LIBRARY_DIR based on _CUDA_TARGET_DIR=${_CUDA_TARGET_DIR}")
  endif()

  # _CUDA_TARGET_DIR always points to the directory containing the include directory.
  # On a scattered installation /usr, on a non-scattered something like /usr/local/cuda or /usr/local/cuda-10.2/targets/aarch64-linux.
  if(EXISTS "${_CUDA_TARGET_DIR}/include/cuda_runtime.h")
    set(_CUDA_INCLUDE_DIRS "${_CUDA_TARGET_DIR}/include")
  else()
    message(FATAL_ERROR "Unable to find cuda_runtime.h in \"${_CUDA_TARGET_DIR}/include\" for _CUDA_INCLUDE_DIRS.")
  endif()

  # CUDA 13 has multiple includes that are implicitly added by nvcc that we need to replicate for
  # clang-cuda
  if(EXISTS "${_CUDA_TARGET_DIR}/include/cccl")
    list(APPEND _CUDA_INCLUDE_DIRS "${_CUDA_TARGET_DIR}/include/cccl")
  endif()

  # Clang does not add any CUDA SDK libraries or directories when invoking the host linker.
  # Add the CUDA toolkit library directory ourselves so that linking works.
  # The CUDA runtime libraries are handled elsewhere by LINEARBUILD_CUDA_RUNTIME_LIBRARY.
  set(LINEARBUILD_CUDA_TOOLKIT_INCLUDE_DIRECTORIES "${_CUDA_INCLUDE_DIRS}")
  set(LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES "${_CUDA_LIBRARY_DIR}")
  set(LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_LIBRARIES "")
  set(LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES "")

  # Don't leak variables unnecessarily to user code.
  unset(_CUDA_INCLUDE_DIRS)
  unset(_CUDA_LIBRARY_DIR)
  unset(_CUDA_TARGET_DIR)
elseif(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "NVIDIA")
  include(Internal/LinearBuildNVCCParseImplicitInfo)
  # Parse LINEARBUILD_CUDA_COMPILER_PRODUCED_OUTPUT to get:
  # - LINEARBUILD_CUDA_ARCHITECTURES_DEFAULT
  # - LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES
  # - LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES
  # - LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_LIBRARIES
  # - LINEARBUILD_CUDA_HOST_LINK_LAUNCHER
  # - LINEARBUILD_CUDA_RUNTIME_LIBRARY_DEFAULT
  # - LINEARBUILD_CUDA_TOOLKIT_INCLUDE_DIRECTORIES
  # Match arguments with linearbuild_nvcc_filter_implicit_info call in LinearBuildTestCUDACompiler.
  linearbuild_nvcc_parse_implicit_info(CUDA LINEARBUILD_CUDA_)

  set(_SET_LINEARBUILD_CUDA_RUNTIME_LIBRARY_DEFAULT
    "set(LINEARBUILD_CUDA_RUNTIME_LIBRARY_DEFAULT \"${LINEARBUILD_CUDA_RUNTIME_LIBRARY_DEFAULT}\")")
endif()

include(Internal/LinearBuildCUDAFilterImplicitLibs)
# Filter out implicit link libraries that should not be passed unconditionally.
linearbuild_cuda_filter_implicit_libs(LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_LIBRARIES)

if(LINEARBUILD_CUDA_COMPILER_SYSROOT)
  string(CONCAT _SET_LINEARBUILD_CUDA_COMPILER_SYSROOT
    "set(LINEARBUILD_CUDA_COMPILER_SYSROOT \"${LINEARBUILD_CUDA_COMPILER_SYSROOT}\")\n"
    "set(LINEARBUILD_COMPILER_SYSROOT \"${LINEARBUILD_CUDA_COMPILER_SYSROOT}\")")
else()
  set(_SET_LINEARBUILD_CUDA_COMPILER_SYSROOT "")
endif()

# If the user did not set LINEARBUILD_CUDA_ARCHITECTURES, use the compiler's default.
if("${LINEARBUILD_CUDA_ARCHITECTURES}" STREQUAL "")
  linearbuild_policy(GET CMP0104 _CUDA_CMP0104)
  if(LINEARBUILD_CUDA_COMPILER_ID AND (NOT LINEARBUILD_CUDA_COMPILER_ID STREQUAL "NVIDIA" OR _CUDA_CMP0104 STREQUAL "NEW"))
    set(LINEARBUILD_CUDA_ARCHITECTURES "${LINEARBUILD_CUDA_ARCHITECTURES_DEFAULT}" CACHE STRING "CUDA architectures")
    if(NOT LINEARBUILD_CUDA_ARCHITECTURES)
      message(FATAL_ERROR "Failed to detect a default CUDA architecture.\n\nCompiler output:\n${LINEARBUILD_CUDA_COMPILER_PRODUCED_OUTPUT}")
    endif()
  endif()
endif()
unset(LINEARBUILD_CUDA_ARCHITECTURES_DEFAULT)

# configure all variables set in this file
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildCUDACompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCUDACompiler.linearbuild
  @ONLY
)

set(LINEARBUILD_CUDA_COMPILER_ENV_VAR "CUDACXX")
set(LINEARBUILD_CUDA_HOST_COMPILER_ENV_VAR "CUDAHOSTCXX")
