# This module is used by the Makefile generator to determine the following variables:
# LINEARBUILD_SYSTEM_NAME - on unix this is uname -s, for windows it is Windows
# LINEARBUILD_SYSTEM_VERSION - on unix this is uname -r, for windows it is empty
# LINEARBUILD_SYSTEM - ${LINEARBUILD_SYSTEM}-${LINEARBUILD_SYSTEM_VERSION}, for windows: ${LINEARBUILD_SYSTEM}

# find out on which system linearbuild runs
if(LINEARBUILD_HOST_UNIX)
  find_program(LINEARBUILD_UNAME NAMES uname PATHS /bin /usr/bin /usr/local/bin NO_LINEARBUILD_FIND_ROOT_PATH)
  if(LINEARBUILD_UNAME)
    if(LINEARBUILD_HOST_SYSTEM_NAME STREQUAL "AIX")
      execute_process(COMMAND ${LINEARBUILD_UNAME} -v
        OUTPUT_VARIABLE _LINEARBUILD_HOST_SYSTEM_MAJOR_VERSION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _uname_result)
      execute_process(COMMAND ${LINEARBUILD_UNAME} -r
        OUTPUT_VARIABLE _LINEARBUILD_HOST_SYSTEM_MINOR_VERSION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _uname_result2)
      if(_uname_result EQUAL 0 AND _uname_result2 EQUAL 0)
        set(LINEARBUILD_HOST_SYSTEM_VERSION "${_LINEARBUILD_HOST_SYSTEM_MAJOR_VERSION}.${_LINEARBUILD_HOST_SYSTEM_MINOR_VERSION}")
      endif()
      unset(_LINEARBUILD_HOST_SYSTEM_MAJOR_VERSION)
      unset(_LINEARBUILD_HOST_SYSTEM_MINOR_VERSION)
    elseif(LINEARBUILD_HOST_SYSTEM_NAME STREQUAL "Android")
      execute_process(COMMAND getprop ro.build.version.sdk
        OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_VERSION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _uname_result)

      if(NOT DEFINED LINEARBUILD_SYSTEM_VERSION)
        set(_ANDROID_API_LEVEL_H $ENV{PREFIX}/include/android/api-level.h)
        set(_ANDROID_API_REGEX "#define __ANDROID_API__ ([0-9]+)")
        file(READ ${_ANDROID_API_LEVEL_H} _ANDROID_API_LEVEL_H_CONTENT)
        string(REGEX MATCH ${_ANDROID_API_REGEX} _ANDROID_API_LINE "${_ANDROID_API_LEVEL_H_CONTENT}")
        string(REGEX REPLACE ${_ANDROID_API_REGEX} "\\1" _ANDROID_API "${_ANDROID_API_LINE}")
        if(_ANDROID_API)
          set(LINEARBUILD_SYSTEM_VERSION "${_ANDROID_API}")
        endif()

        unset(_ANDROID_API_LEVEL_H)
        unset(_ANDROID_API_LEVEL_H_CONTENT)
        unset(_ANDROID_API_REGEX)
        unset(_ANDROID_API_LINE)
        unset(_ANDROID_API)
      endif()
    else()
      execute_process(COMMAND ${LINEARBUILD_UNAME} -r
        OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_VERSION
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _uname_result)
    endif()
    if(LINEARBUILD_HOST_SYSTEM_NAME MATCHES "Linux|CYGWIN.*|MSYS.*|^GNU$|Android")
      execute_process(COMMAND ${LINEARBUILD_UNAME} -m
        OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_PROCESSOR
        RESULT_VARIABLE val
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    elseif(LINEARBUILD_HOST_SYSTEM_NAME MATCHES "Darwin")
      # If we are running on Apple Silicon, honor LINEARBUILD_APPLE_SILICON_PROCESSOR.
      if(DEFINED LINEARBUILD_APPLE_SILICON_PROCESSOR)
        set(_LINEARBUILD_APPLE_SILICON_PROCESSOR "${LINEARBUILD_APPLE_SILICON_PROCESSOR}")
      elseif(DEFINED ENV{LINEARBUILD_APPLE_SILICON_PROCESSOR})
        set(_LINEARBUILD_APPLE_SILICON_PROCESSOR "$ENV{LINEARBUILD_APPLE_SILICON_PROCESSOR}")
      else()
        set(_LINEARBUILD_APPLE_SILICON_PROCESSOR "")
      endif()
      if(_LINEARBUILD_APPLE_SILICON_PROCESSOR)
        if(";${_LINEARBUILD_APPLE_SILICON_PROCESSOR};" MATCHES "^;(arm64|x86_64);$")
          execute_process(COMMAND sysctl -q hw.optional.arm64
            OUTPUT_VARIABLE _sysctl_stdout
            ERROR_VARIABLE _sysctl_stderr
            RESULT_VARIABLE _sysctl_result
            )
          if(NOT _sysctl_result EQUAL 0 OR NOT _sysctl_stdout MATCHES "hw.optional.arm64: 1")
            set(_LINEARBUILD_APPLE_SILICON_PROCESSOR "")
          endif()
          unset(_sysctl_result)
          unset(_sysctl_stderr)
          unset(_sysctl_stdout)
        endif()
      endif()
      if(_LINEARBUILD_APPLE_SILICON_PROCESSOR)
        set(LINEARBUILD_HOST_SYSTEM_PROCESSOR "${_LINEARBUILD_APPLE_SILICON_PROCESSOR}")
      else()
        execute_process(COMMAND ${LINEARBUILD_UNAME} -m
          OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_PROCESSOR
          RESULT_VARIABLE val
          OUTPUT_STRIP_TRAILING_WHITESPACE
          ERROR_QUIET)
      endif()
      unset(_LINEARBUILD_APPLE_SILICON_PROCESSOR)
      if(LINEARBUILD_HOST_SYSTEM_PROCESSOR STREQUAL "Power Macintosh")
        # OS X ppc 'uname -m' may report 'Power Macintosh' instead of 'powerpc'
        set(LINEARBUILD_HOST_SYSTEM_PROCESSOR "powerpc")
      endif()
    elseif(LINEARBUILD_HOST_SYSTEM_NAME MATCHES "OpenBSD")
      execute_process(COMMAND arch -s
        OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_PROCESSOR
        RESULT_VARIABLE val
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    else()
      execute_process(COMMAND ${LINEARBUILD_UNAME} -p
        OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_PROCESSOR
        RESULT_VARIABLE val
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
      if("${val}" GREATER 0)
        execute_process(COMMAND ${LINEARBUILD_UNAME} -m
          OUTPUT_VARIABLE LINEARBUILD_HOST_SYSTEM_PROCESSOR
          RESULT_VARIABLE val
          OUTPUT_STRIP_TRAILING_WHITESPACE
          ERROR_QUIET)
      endif()
    endif()
    # check the return of the last uname -m or -p
    if("${val}" GREATER 0)
        set(LINEARBUILD_HOST_SYSTEM_PROCESSOR "unknown")
    endif()
    set(LINEARBUILD_UNAME ${LINEARBUILD_UNAME} CACHE INTERNAL "uname command")
    # processor may have double quote in the name, and that needs to be removed
    string(REPLACE "\"" "" LINEARBUILD_HOST_SYSTEM_PROCESSOR "${LINEARBUILD_HOST_SYSTEM_PROCESSOR}")
    string(REPLACE "/" "_" LINEARBUILD_HOST_SYSTEM_PROCESSOR "${LINEARBUILD_HOST_SYSTEM_PROCESSOR}")
  endif()
else()
  if(LINEARBUILD_HOST_WIN32)
    if (DEFINED ENV{PROCESSOR_ARCHITEW6432})
      set (LINEARBUILD_HOST_SYSTEM_PROCESSOR "$ENV{PROCESSOR_ARCHITEW6432}")
    else()
      set (LINEARBUILD_HOST_SYSTEM_PROCESSOR "$ENV{PROCESSOR_ARCHITECTURE}")
    endif()
  endif()
endif()

# if a toolchain file is used, the user wants to cross compile.
# in this case read the toolchain file and keep the LINEARBUILD_HOST_SYSTEM_*
# variables around so they can be used in LinearBuildLists.txt.
# In all other cases, the host and target platform are the same.
if(LINEARBUILD_TOOLCHAIN_FILE)
  # Retain input value to detect changes requiring re-configuration.
  set(_LINEARBUILD_INPUT_TOOLCHAIN_FILE "${LINEARBUILD_TOOLCHAIN_FILE}")
  if(IS_ABSOLUTE "${LINEARBUILD_TOOLCHAIN_FILE}" AND EXISTS "${LINEARBUILD_TOOLCHAIN_FILE}")
    # Normalize the absolute path.
    set(LINEARBUILD_TOOLCHAIN_FILE "${LINEARBUILD_TOOLCHAIN_FILE}" CACHE FILEPATH "The LinearBuild toolchain file" FORCE)
    set(LINEARBUILD_TOOLCHAIN_FILE "$CACHE{LINEARBUILD_TOOLCHAIN_FILE}")
    include("${LINEARBUILD_TOOLCHAIN_FILE}" OPTIONAL RESULT_VARIABLE _INCLUDED_TOOLCHAIN_FILE)
  else()
    # at first try to load it as path relative to the directory from which linearbuild has been run
    include("${LINEARBUILD_BINARY_DIR}/${LINEARBUILD_TOOLCHAIN_FILE}" OPTIONAL RESULT_VARIABLE _INCLUDED_TOOLCHAIN_FILE)
    if(NOT _INCLUDED_TOOLCHAIN_FILE)
      # if the file isn't found there, check the default locations
      include("${LINEARBUILD_TOOLCHAIN_FILE}" OPTIONAL RESULT_VARIABLE _INCLUDED_TOOLCHAIN_FILE)
    endif()
    if(_INCLUDED_TOOLCHAIN_FILE)
      set(LINEARBUILD_TOOLCHAIN_FILE "${_INCLUDED_TOOLCHAIN_FILE}" CACHE FILEPATH "The LinearBuild toolchain file" FORCE)
    endif()
  endif()
  if(NOT _INCLUDED_TOOLCHAIN_FILE)
    message(FATAL_ERROR "Could not find toolchain file:\n \"${LINEARBUILD_TOOLCHAIN_FILE}\"")
  endif()
endif()

if(LINEARBUILD_SYSTEM_NAME)
  # LINEARBUILD_SYSTEM_NAME was set by a toolchain file or on the command line.
  # Assume it set LINEARBUILD_SYSTEM_VERSION and LINEARBUILD_SYSTEM_PROCESSOR too.
  if(NOT DEFINED LINEARBUILD_CROSSCOMPILING)
    set(LINEARBUILD_CROSSCOMPILING TRUE)
  endif()
elseif(LINEARBUILD_VS_WINCE_VERSION)
  set(LINEARBUILD_SYSTEM_NAME      "WindowsCE")
  set(LINEARBUILD_SYSTEM_VERSION   "${LINEARBUILD_VS_WINCE_VERSION}")
  set(LINEARBUILD_SYSTEM_PROCESSOR "${MSVC_C_ARCHITECTURE_ID}")
  set(LINEARBUILD_CROSSCOMPILING TRUE)
else()
  # Build for the host platform and architecture by default.
  set(LINEARBUILD_SYSTEM_NAME      "${LINEARBUILD_HOST_SYSTEM_NAME}")
  if(NOT DEFINED LINEARBUILD_SYSTEM_VERSION)
    set(LINEARBUILD_SYSTEM_VERSION "${LINEARBUILD_HOST_SYSTEM_VERSION}")
  endif()
  set(LINEARBUILD_SYSTEM_PROCESSOR "${LINEARBUILD_HOST_SYSTEM_PROCESSOR}")
  if(LINEARBUILD_CROSSCOMPILING)
    message(AUTHOR_WARNING
      "LINEARBUILD_CROSSCOMPILING has been set by the project, toolchain file, or user.  "
      "LinearBuild is resetting it to false because LINEARBUILD_SYSTEM_NAME was not set.  "
      "To indicate cross compilation, only LINEARBUILD_SYSTEM_NAME needs to be set."
      )
  endif()
  set(LINEARBUILD_CROSSCOMPILING FALSE)
endif()

include(Platform/${LINEARBUILD_SYSTEM_NAME}-Determine OPTIONAL)

set(LINEARBUILD_SYSTEM ${LINEARBUILD_SYSTEM_NAME})
if(LINEARBUILD_SYSTEM_VERSION)
  string(APPEND LINEARBUILD_SYSTEM -${LINEARBUILD_SYSTEM_VERSION})
endif()
set(LINEARBUILD_HOST_SYSTEM ${LINEARBUILD_HOST_SYSTEM_NAME})
if(LINEARBUILD_HOST_SYSTEM_VERSION)
  string(APPEND LINEARBUILD_HOST_SYSTEM -${LINEARBUILD_HOST_SYSTEM_VERSION})
endif()

# this file is also executed from cpack, then we don't need to generate these files
# in this case there is no LINEARBUILD_BINARY_DIR
if(LINEARBUILD_BINARY_DIR)
  # write entry to the log file
  if(LINEARBUILD_CROSSCOMPILING)
    message(CONFIGURE_LOG
      "The target system is: ${LINEARBUILD_SYSTEM_NAME} - ${LINEARBUILD_SYSTEM_VERSION} - ${LINEARBUILD_SYSTEM_PROCESSOR}\n"
      "The host system is: ${LINEARBUILD_HOST_SYSTEM_NAME} - ${LINEARBUILD_HOST_SYSTEM_VERSION} - ${LINEARBUILD_HOST_SYSTEM_PROCESSOR}\n"
      )
  else()
    message(CONFIGURE_LOG
      "The system is: ${LINEARBUILD_SYSTEM_NAME} - ${LINEARBUILD_SYSTEM_VERSION} - ${LINEARBUILD_SYSTEM_PROCESSOR}\n"
      )
  endif()

  # if a toolchain file is used, it needs to be included in the configured file,
  # so settings done there are also available if they don't go in the cache and in try_compile()
  set(INCLUDE_LINEARBUILD_TOOLCHAIN_FILE_IF_REQUIRED)
  if(DEFINED LINEARBUILD_TOOLCHAIN_FILE)
    string(CONCAT INCLUDE_LINEARBUILD_TOOLCHAIN_FILE_IF_REQUIRED
      "set(_LINEARBUILD_INPUT_TOOLCHAIN_FILE [==[${_LINEARBUILD_INPUT_TOOLCHAIN_FILE}]==])\n"
    )
    if(_INCLUDED_TOOLCHAIN_FILE)
      string(APPEND INCLUDE_LINEARBUILD_TOOLCHAIN_FILE_IF_REQUIRED
        "set(_LINEARBUILD_SYSTEM_TOOLCHAIN_FILE \"${LINEARBUILD_TOOLCHAIN_FILE}\")\n"
        "include(\"\${_LINEARBUILD_SYSTEM_TOOLCHAIN_FILE}\")"
      )
    endif()
  endif()

  # configure variables set in this file for fast reload, the template file is defined at the top of this file
  configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildSystem.linearbuild.in
                ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildSystem.linearbuild
                @ONLY)

endif()
