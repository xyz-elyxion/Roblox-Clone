include(Platform/Linux-LCC)
__linux_compiler_lcc(Fortran)
if (LINEARBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL "1.26.03")
  set(LINEARBUILD_SHARED_LIBRARY_LINK_Fortran_FLAGS "-lgfortran")
elseif (LINEARBUILD_Fortran_COMPILER_VERSION VERSION_GREATER_EQUAL "1.24.01")
  set(LINEARBUILD_SHARED_LIBRARY_LINK_Fortran_FLAGS "-llfortran")
else()
  unset(LINEARBUILD_Fortran_CREATE_PREPROCESSED_SOURCE)
endif()
