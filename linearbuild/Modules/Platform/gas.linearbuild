if(UNIX)
  set(LINEARBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .o)
else()
  set(LINEARBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .obj)
endif()

set(LINEARBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT "<LINEARBUILD_ASM${ASM_DIALECT}_COMPILER> <INCLUDES> <FLAGS> -o <OBJECT> <SOURCE>")

set(LINEARBUILD_ASM${ASM_DIALECT}_CREATE_STATIC_LIBRARY
      "<LINEARBUILD_AR> cr <TARGET> <LINK_FLAGS> <OBJECTS> "
      "<LINEARBUILD_RANLIB> <TARGET> ")

set(LINEARBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE
    "<LINEARBUILD_LINKER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

# to be done
set(LINEARBUILD_ASM${ASM_DIALECT}_CREATE_SHARED_LIBRARY)
set(LINEARBUILD_ASM${ASM_DIALECT}_CREATE_SHARED_MODULE)
