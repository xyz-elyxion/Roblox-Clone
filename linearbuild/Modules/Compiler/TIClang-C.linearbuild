include(Compiler/Clang-C)
include(Compiler/TIClang)
__compiler_ticlang(C)

if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND LINEARBUILD_DEPFILE_FLAGS_C)
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_C_DEPFILE_FORMAT gcc)
  set(LINEARBUILD_C_DEPENDS_USE_COMPILER TRUE)
endif()

set(LINEARBUILD_C90_STANDARD_COMPILE_OPTION "-std=c90")
set(LINEARBUILD_C90_EXTENSION_COMPILE_OPTION "-std=gnu90")
set(LINEARBUILD_C90_STANDARD__HAS_FULL_SUPPORT ON)

set(LINEARBUILD_C99_STANDARD_COMPILE_OPTION "-std=c99")
set(LINEARBUILD_C99_EXTENSION_COMPILE_OPTION "-std=gnu99")
set(LINEARBUILD_C99_STANDARD__HAS_FULL_SUPPORT ON)

set(LINEARBUILD_C11_STANDARD_COMPILE_OPTION "-std=c11")
set(LINEARBUILD_C11_EXTENSION_COMPILE_OPTION "-std=gnu11")
set(LINEARBUILD_C11_STANDARD__HAS_FULL_SUPPORT ON)

if(LINEARBUILD_C_COMPILER_VERSION VERSION_GREATER_EQUAL 1.3)
  set(LINEARBUILD_C17_STANDARD_COMPILE_OPTION "-std=c17")
  set(LINEARBUILD_C17_EXTENSION_COMPILE_OPTION "-std=gnu17")
  set(LINEARBUILD_C17_STANDARD__HAS_FULL_SUPPORT ON)
  set(LINEARBUILD_C_STANDARD_LATEST 17)
else()
  set(LINEARBUILD_C_STANDARD_LATEST 11)
endif()


# Including the "${LINEARBUILD_ROOT}/Modules/Compiler/Clang-C.linearbuild" script above may set several other compile option
# variables which do not necessarily apply here. So, we unset those variables accordingly.

if(LINEARBUILD_C_COMPILER_VERSION VERSION_LESS 1.3)
  unset(LINEARBUILD_C17_STANDARD_COMPILE_OPTION)
  unset(LINEARBUILD_C17_EXTENSION_COMPILE_OPTION)
endif()

unset(LINEARBUILD_C23_STANDARD_COMPILE_OPTION)
unset(LINEARBUILD_C23_EXTENSION_COMPILE_OPTION)
