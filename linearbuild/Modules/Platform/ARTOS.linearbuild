# Support for ARTOS RTOS (locamation.com)
set(LINEARBUILD_LINK_LIBRARY_SUFFIX "")
set(LINEARBUILD_STATIC_LIBRARY_PREFIX "")
set(LINEARBUILD_STATIC_LIBRARY_SUFFIX ".a")
set(LINEARBUILD_SHARED_LIBRARY_PREFIX "")
set(LINEARBUILD_SHARED_LIBRARY_SUFFIX ".a")
set(LINEARBUILD_EXECUTABLE_SUFFIX ".x")
set(LINEARBUILD_DL_LIBS "")

set(LINEARBUILD_FIND_LIBRARY_PREFIXES "lib" "")
set(LINEARBUILD_FIND_LIBRARY_SUFFIXES ".a")

# ARTOS does not support shared libs
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)

set(LINEARBUILD_C_LINK_SHARED_LIBRARY )
set(LINEARBUILD_C_LINK_MODULE_LIBRARY )
