# this file has flags that are shared across languages and sets
# cache values that can be initialized in the platform-compiler.linearbuild file
# it may be included by more than one language.

string(APPEND LINEARBUILD_EXE_LINKER_FLAGS_INIT " $ENV{LDFLAGS}")
string(APPEND LINEARBUILD_SHARED_LINKER_FLAGS_INIT " $ENV{LDFLAGS}")
string(APPEND LINEARBUILD_MODULE_LINKER_FLAGS_INIT " $ENV{LDFLAGS}")

linearbuild_initialize_per_config_variable(LINEARBUILD_EXE_LINKER_FLAGS    "Flags used by the linker")
linearbuild_initialize_per_config_variable(LINEARBUILD_SHARED_LINKER_FLAGS "Flags used by the linker during the creation of shared libraries")
linearbuild_initialize_per_config_variable(LINEARBUILD_MODULE_LINKER_FLAGS "Flags used by the linker during the creation of modules")
linearbuild_initialize_per_config_variable(LINEARBUILD_STATIC_LINKER_FLAGS "Flags used by the archiver during the creation of static libraries")

# Alias the build tool variable for backward compatibility.
set(LINEARBUILD_BUILD_TOOL ${LINEARBUILD_MAKE_PROGRAM})

mark_as_advanced(
LINEARBUILD_VERBOSE_MAKEFILE
)

# The Platform/* modules set a bunch of platform-specific flags expressed
# for the C toolchain.  Other languages call this to copy them as defaults.
macro(_linearbuild_common_language_platform_flags lang)
  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS)
    set(LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS ${LINEARBUILD_SHARED_LIBRARY_CREATE_C_FLAGS})
  endif()

  if(NOT DEFINED LINEARBUILD_${lang}_COMPILE_OPTIONS_PIC)
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIC ${LINEARBUILD_C_COMPILE_OPTIONS_PIC})
  endif()

  if(NOT DEFINED LINEARBUILD_${lang}_COMPILE_OPTIONS_PIE)
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIE ${LINEARBUILD_C_COMPILE_OPTIONS_PIE})
  endif()
  if(NOT DEFINED LINEARBUILD_${lang}_LINK_OPTIONS_PIE)
    set(LINEARBUILD_${lang}_LINK_OPTIONS_PIE ${LINEARBUILD_C_LINK_OPTIONS_PIE})
  endif()
  if(NOT DEFINED LINEARBUILD_${lang}_LINK_OPTIONS_NO_PIE)
    set(LINEARBUILD_${lang}_LINK_OPTIONS_NO_PIE ${LINEARBUILD_C_LINK_OPTIONS_NO_PIE})
  endif()

  if(NOT DEFINED LINEARBUILD_${lang}_COMPILE_OPTIONS_DLL)
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_DLL ${LINEARBUILD_C_COMPILE_OPTIONS_DLL})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_${lang}_FLAGS)
    set(LINEARBUILD_SHARED_LIBRARY_${lang}_FLAGS ${LINEARBUILD_SHARED_LIBRARY_C_FLAGS})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS)
    set(LINEARBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS ${LINEARBUILD_SHARED_LIBRARY_LINK_C_FLAGS})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG)
    set(LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG_SEP)
    set(LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG_SEP ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG_SEP})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_RPATH_LINK_${lang}_FLAG)
    set(LINEARBUILD_SHARED_LIBRARY_RPATH_LINK_${lang}_FLAG ${LINEARBUILD_SHARED_LIBRARY_RPATH_LINK_C_FLAG})
  endif()

  if(NOT DEFINED LINEARBUILD_EXE_EXPORTS_${lang}_FLAG)
    set(LINEARBUILD_EXE_EXPORTS_${lang}_FLAG ${LINEARBUILD_EXE_EXPORTS_C_FLAG})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_SONAME_${lang}_FLAG)
    set(LINEARBUILD_SHARED_LIBRARY_SONAME_${lang}_FLAG ${LINEARBUILD_SHARED_LIBRARY_SONAME_C_FLAG})
  endif()

  if(NOT DEFINED LINEARBUILD_EXECUTABLE_RUNTIME_${lang}_FLAG)
    set(LINEARBUILD_EXECUTABLE_RUNTIME_${lang}_FLAG ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG})
  endif()

  if(NOT DEFINED LINEARBUILD_EXECUTABLE_RUNTIME_${lang}_FLAG_SEP)
    set(LINEARBUILD_EXECUTABLE_RUNTIME_${lang}_FLAG_SEP ${LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG_SEP})
  endif()

  if(NOT DEFINED LINEARBUILD_EXECUTABLE_RPATH_LINK_${lang}_FLAG)
    set(LINEARBUILD_EXECUTABLE_RPATH_LINK_${lang}_FLAG ${LINEARBUILD_SHARED_LIBRARY_RPATH_LINK_${lang}_FLAG})
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_LIBRARY_LINK_${lang}_WITH_RUNTIME_PATH)
    set(LINEARBUILD_SHARED_LIBRARY_LINK_${lang}_WITH_RUNTIME_PATH ${LINEARBUILD_SHARED_LIBRARY_LINK_C_WITH_RUNTIME_PATH})
  endif()

  if(NOT DEFINED LINEARBUILD_INCLUDE_FLAG_${lang})
    set(LINEARBUILD_INCLUDE_FLAG_${lang} ${LINEARBUILD_INCLUDE_FLAG_C})
  endif()

  # for most systems a module is the same as a shared library
  # so unless the variable LINEARBUILD_MODULE_EXISTS is set just
  # copy the values from the LIBRARY variables
  if(NOT LINEARBUILD_MODULE_EXISTS)
    set(LINEARBUILD_SHARED_MODULE_${lang}_FLAGS "${LINEARBUILD_SHARED_LIBRARY_${lang}_FLAGS}")
    set(LINEARBUILD_SHARED_MODULE_CREATE_${lang}_FLAGS "${LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS}")
  endif()

  if(NOT DEFINED LINEARBUILD_SHARED_MODULE_CREATE_${lang}_FLAGS)
    set(LINEARBUILD_SHARED_MODULE_CREATE_${lang}_FLAGS "${LINEARBUILD_SHARED_LIBRARY_CREATE_C_FLAGS}")
  endif()
  if(NOT DEFINED LINEARBUILD_SHARED_MODULE_${lang}_FLAGS)
    set(LINEARBUILD_SHARED_MODULE_${lang}_FLAGS "${LINEARBUILD_SHARED_LIBRARY_C_FLAGS}")
  endif()

  foreach(type IN ITEMS SHARED_LIBRARY SHARED_MODULE EXE)
    if(NOT DEFINED LINEARBUILD_${type}_LINK_STATIC_${lang}_FLAGS)
      set(LINEARBUILD_${type}_LINK_STATIC_${lang}_FLAGS
        ${LINEARBUILD_${type}_LINK_STATIC_C_FLAGS})
    endif()
    if(NOT DEFINED LINEARBUILD_${type}_LINK_DYNAMIC_${lang}_FLAGS)
      set(LINEARBUILD_${type}_LINK_DYNAMIC_${lang}_FLAGS
        ${LINEARBUILD_${type}_LINK_DYNAMIC_C_FLAGS})
    endif()
  endforeach()
endmacro()
