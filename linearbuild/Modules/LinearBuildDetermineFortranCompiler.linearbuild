# determine the compiler to use for Fortran programs
# NOTE, a generator may set LINEARBUILD_Fortran_COMPILER before
# loading this file to force a compiler.
# use environment variable FC first if defined by user, next use
# the linearbuild variable LINEARBUILD_GENERATOR_FC which can be defined by a generator
# as a default compiler

include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompiler.linearbuild)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-Determine-Fortran OPTIONAL)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-Fortran OPTIONAL)
if(NOT LINEARBUILD_Fortran_COMPILER_NAMES)
  set(LINEARBUILD_Fortran_COMPILER_NAMES f95)
endif()

if(${LINEARBUILD_GENERATOR} MATCHES "Visual Studio")
elseif("${LINEARBUILD_GENERATOR}" MATCHES "Xcode")
  set(LINEARBUILD_Fortran_COMPILER_XCODE_TYPE sourcecode.fortran.f90)
  _linearbuild_find_compiler_path(Fortran)
else()
  if(NOT LINEARBUILD_Fortran_COMPILER)
    # prefer the environment variable FC
    if(NOT $ENV{FC} STREQUAL "")
      get_filename_component(LINEARBUILD_Fortran_COMPILER_INIT $ENV{FC} PROGRAM PROGRAM_ARGS LINEARBUILD_Fortran_FLAGS_ENV_INIT)
      if(LINEARBUILD_Fortran_FLAGS_ENV_INIT)
        set(LINEARBUILD_Fortran_COMPILER_ARG1 "${LINEARBUILD_Fortran_FLAGS_ENV_INIT}" CACHE STRING "Arguments to Fortran compiler")
      endif()
      if(EXISTS ${LINEARBUILD_Fortran_COMPILER_INIT})
      else()
        message(FATAL_ERROR "Could not find the compiler specified in the environment variable FC:\n$ENV{FC}.")
      endif()
    endif()

    # next try prefer the compiler specified by the generator
    if(LINEARBUILD_GENERATOR_FC)
      if(NOT LINEARBUILD_Fortran_COMPILER_INIT)
        set(LINEARBUILD_Fortran_COMPILER_INIT ${LINEARBUILD_GENERATOR_FC})
      endif()
    endif()

    # finally list compilers to try
    if(NOT LINEARBUILD_Fortran_COMPILER_INIT)
      # Known compilers:
      #  ftn: Cray fortran compiler wrapper
      #  gfortran: putative GNU Fortran 95+ compiler (in progress)
      #  frt: Fujitsu Fortran compiler
      #  pathf90/pathf95/pathf2003: PathScale Fortran compiler
      #  pgfortran: Portland Group Fortran compilers
      #  nvfortran: NVHPC Fotran compiler
      #  flang: Flang Fortran compiler
      #  xlf: IBM (AIX) Fortran compiler
      #  lf95: Lahey-Fujitsu F95 compiler
      #  fl32: Microsoft Fortran 77 "PowerStation" compiler
      #  af77: Apogee F77 compiler for Intergraph hardware running CLIX
      #  epcf90: "Edinburgh Portable Compiler" F90
      #  fort: Compaq (now HP) Fortran 90/95 compiler for Tru64 and Linux/Alpha
      #  ifx: Intel Fortran LLVM-based compiler
      #  ifort: Intel Classic Fortran compiler
      #  nagfor: NAG Fortran compiler
      #  lfortran: LFortran Fortran Compiler
      #
      #  GNU is last to be searched,
      #  so if you paid for a compiler it is picked by default.
      set(LINEARBUILD_Fortran_COMPILER_LIST
        ftn
        ifx ifort nvfortran pgfortran lf95 xlf fort
        flang lfortran frt nagfor
        gfortran
        )

      # Vendor-specific compiler names.
      set(_Fortran_COMPILER_NAMES_LCC       lfortran gfortran)
      set(_Fortran_COMPILER_NAMES_GNU       gfortran)
      set(_Fortran_COMPILER_NAMES_Intel     ifort ifc efc ifx)
      set(_Fortran_COMPILER_NAMES_Absoft    af95 af90 af77)
      set(_Fortran_COMPILER_NAMES_PGI       pgf95 pgfortran pgf90 pgf77)
      set(_Fortran_COMPILER_NAMES_Flang     flang)
      set(_Fortran_COMPILER_NAMES_LLVMFlang flang)
      set(_Fortran_COMPILER_NAMES_PathScale pathf2003 pathf95 pathf90)
      set(_Fortran_COMPILER_NAMES_XL        xlf)
      set(_Fortran_COMPILER_NAMES_VisualAge xlf95 xlf90 xlf)
      set(_Fortran_COMPILER_NAMES_NAG       nagfor)
      set(_Fortran_COMPILER_NAMES_NVHPC     nvfortran)
    endif()

    _linearbuild_find_compiler(Fortran)

  else()
    _linearbuild_find_compiler_path(Fortran)
  endif()
  mark_as_advanced(LINEARBUILD_Fortran_COMPILER)

  # Each entry in this list is a set of extra flags to try
  # adding to the compile line to see if it helps produce
  # a valid identification executable.
  set(LINEARBUILD_Fortran_COMPILER_ID_TEST_FLAGS_FIRST
    # Get verbose output to help distinguish compilers.
    "-v"

    # Try compiling to an object file only, with verbose output.
    "-v -c"
    )
  set(LINEARBUILD_Fortran_COMPILER_ID_TEST_FLAGS
    # Try compiling to an object file only.
    "-c"

    # Intel on windows does not preprocess by default.
    "-fpp"

    # LFortran does not preprocess by default.
    "--cpp-infer"
    )
endif()

if(LINEARBUILD_Fortran_COMPILER_TARGET)
  set(LINEARBUILD_Fortran_COMPILER_ID_TEST_FLAGS_FIRST "-v -c --target=${LINEARBUILD_Fortran_COMPILER_TARGET}")
endif()

# Build a small source file to identify the compiler.
if(NOT LINEARBUILD_Fortran_COMPILER_ID_RUN)
  set(LINEARBUILD_Fortran_COMPILER_ID_RUN 1)

  # Table of per-vendor compiler output regular expressions.
  list(APPEND LINEARBUILD_Fortran_COMPILER_ID_MATCH_VENDORS CCur)
  set(LINEARBUILD_Fortran_COMPILER_ID_MATCH_VENDOR_REGEX_CCur "Concurrent Fortran [0-9]+ Compiler")

  # Table of per-vendor compiler id flags with expected output.
  list(APPEND LINEARBUILD_Fortran_COMPILER_ID_VENDORS Compaq)
  set(LINEARBUILD_Fortran_COMPILER_ID_VENDOR_FLAGS_Compaq "-what")
  set(LINEARBUILD_Fortran_COMPILER_ID_VENDOR_REGEX_Compaq "Compaq Visual Fortran")
  list(APPEND LINEARBUILD_Fortran_COMPILER_ID_VENDORS NAG) # Numerical Algorithms Group
  set(LINEARBUILD_Fortran_COMPILER_ID_VENDOR_FLAGS_NAG "-V")
  set(LINEARBUILD_Fortran_COMPILER_ID_VENDOR_REGEX_NAG "NAG Fortran Compiler")
  list(APPEND LINEARBUILD_Fortran_COMPILER_ID_VENDORS IBMFlang)
  set(LINEARBUILD_Fortran_COMPILER_ID_VENDOR_FLAGS_IBMFlang "--version")
  set(LINEARBUILD_Fortran_COMPILER_ID_VENDOR_REGEX_IBMFlang "IBM Open XL Fortran")

  # Match the link line from xcodebuild output of the form
  #  Ld ...
  #      ...
  #      /path/to/cc ...CompilerIdFortran/...
  # to extract the compiler front-end for the language.
  set(LINEARBUILD_Fortran_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdFortran/(\\./)?(CompilerIdFortran.xctest/)?CompilerIdFortran[ \t\n\\\"]")
  set(LINEARBUILD_Fortran_COMPILER_ID_TOOL_MATCH_INDEX 2)

  set(_version_info "")
  foreach(m IN ITEMS MAJOR MINOR PATCH TWEAK)
    set(_COMP "_${m}")
    string(APPEND _version_info "
#if defined(COMPILER_VERSION${_COMP})")
    foreach(d RANGE 1 8)
      string(APPEND _version_info "
# undef DEC
# undef HEX
# define DEC(n) DEC_${d}(n)
# define HEX(n) HEX_${d}(n)
# if COMPILER_VERSION${_COMP} == 0
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[0]'
# elif COMPILER_VERSION${_COMP} == 1
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[1]'
# elif COMPILER_VERSION${_COMP} == 2
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[2]'
# elif COMPILER_VERSION${_COMP} == 3
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[3]'
# elif COMPILER_VERSION${_COMP} == 4
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[4]'
# elif COMPILER_VERSION${_COMP} == 5
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[5]'
# elif COMPILER_VERSION${_COMP} == 6
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[6]'
# elif COMPILER_VERSION${_COMP} == 7
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[7]'
# elif COMPILER_VERSION${_COMP} == 8
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[8]'
# elif COMPILER_VERSION${_COMP} == 9
        PRINT *, 'INFO:compiler_version${_COMP}_digit_${d}[9]'
# endif
")
    endforeach()
    string(APPEND _version_info "
#endif")
  endforeach()
  set(LINEARBUILD_Fortran_COMPILER_ID_VERSION_INFO "${_version_info}")
  unset(_version_info)
  unset(_COMP)

  # Try to identify the compiler.
  set(LINEARBUILD_Fortran_COMPILER_ID)
  include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerId.linearbuild)
  LINEARBUILD_DETERMINE_COMPILER_ID(Fortran FFLAGS LinearBuildFortranCompilerId.F)

  _linearbuild_find_compiler_sysroot(Fortran)

  # Fall back to old is-GNU test.
  if(NOT LINEARBUILD_Fortran_COMPILER_ID)
    execute_process(COMMAND ${LINEARBUILD_Fortran_COMPILER} ${LINEARBUILD_Fortran_COMPILER_ID_FLAGS_LIST} -E "${LINEARBUILD_ROOT}/Modules/LinearBuildTestGNU.c"
      OUTPUT_VARIABLE LINEARBUILD_COMPILER_OUTPUT RESULT_VARIABLE LINEARBUILD_COMPILER_RETURN)
    if(NOT LINEARBUILD_COMPILER_RETURN)
      if(LINEARBUILD_COMPILER_OUTPUT MATCHES "THIS_IS_GNU")
        set(LINEARBUILD_Fortran_COMPILER_ID "GNU")
        message(CONFIGURE_LOG
          "Determining if the Fortran compiler is GNU succeeded with "
          "the following output:\n${LINEARBUILD_COMPILER_OUTPUT}\n\n")
      else()
        message(CONFIGURE_LOG
          "Determining if the Fortran compiler is GNU failed with "
          "the following output:\n${LINEARBUILD_COMPILER_OUTPUT}\n\n")
      endif()
      if(NOT LINEARBUILD_Fortran_PLATFORM_ID)
        if(LINEARBUILD_COMPILER_OUTPUT MATCHES "THIS_IS_MINGW")
          set(LINEARBUILD_Fortran_PLATFORM_ID "MinGW")
        endif()
        if(LINEARBUILD_COMPILER_OUTPUT MATCHES "THIS_IS_CYGWIN")
          set(LINEARBUILD_Fortran_PLATFORM_ID "Cygwin")
        endif()
      endif()
    endif()
  endif()

  # Fall back for GNU MINGW, which is not always detected correctly
  # (__MINGW32__ is defined for the C language, but perhaps not for Fortran!)
  if(LINEARBUILD_Fortran_COMPILER_ID MATCHES "GNU" AND NOT LINEARBUILD_Fortran_PLATFORM_ID)
    execute_process(COMMAND ${LINEARBUILD_Fortran_COMPILER} ${LINEARBUILD_Fortran_COMPILER_ID_FLAGS_LIST} -E "${LINEARBUILD_ROOT}/Modules/LinearBuildTestGNU.c"
      OUTPUT_VARIABLE LINEARBUILD_COMPILER_OUTPUT RESULT_VARIABLE LINEARBUILD_COMPILER_RETURN)
    if(NOT LINEARBUILD_COMPILER_RETURN)
      if(LINEARBUILD_COMPILER_OUTPUT MATCHES "THIS_IS_MINGW")
        set(LINEARBUILD_Fortran_PLATFORM_ID "MinGW")
      endif()
      if(LINEARBUILD_COMPILER_OUTPUT MATCHES "THIS_IS_CYGWIN")
        set(LINEARBUILD_Fortran_PLATFORM_ID "Cygwin")
      endif()
    endif()
  endif()

  # Set old compiler and platform id variables.
  if(LINEARBUILD_Fortran_COMPILER_ID MATCHES "GNU")
    set(LINEARBUILD_COMPILER_IS_GNUG77 1)
  endif()
endif()

if("${LINEARBUILD_Fortran_COMPILER_ID};${LINEARBUILD_Fortran_SIMULATE_ID}" STREQUAL "LLVMFlang;MSVC")
  # With LLVMFlang targeting the MSVC ABI we link using lld-link.
  # Detect the implicit link information from the compiler driver
  # so we can explicitly pass it to the linker.
  include(${LINEARBUILD_ROOT}/Modules/LinearBuildParseImplicitLinkInfo.linearbuild)
  set(_LLVMFlang_COMMAND "${LINEARBUILD_Fortran_COMPILER}" "-###" ${LINEARBUILD_CURRENT_LIST_DIR}/LinearBuildFortranCompilerABI.F)
  if(LINEARBUILD_Fortran_COMPILER_TARGET)
    list(APPEND _LLVMFlang_COMMAND --target=${LINEARBUILD_Fortran_COMPILER_TARGET})
  endif()
  execute_process(COMMAND ${_LLVMFlang_COMMAND}
    OUTPUT_VARIABLE _LLVMFlang_OUTPUT
    ERROR_VARIABLE _LLVMFlang_OUTPUT
    RESULT_VARIABLE _LLVMFlang_RESULT)
  string(JOIN "\" \"" _LLVMFlang_COMMAND ${_LLVMFlang_COMMAND})
  message(CONFIGURE_LOG
    "Running the Fortran compiler: \"${_LLVMFlang_COMMAND}\"\n"
    "${_LLVMFlang_OUTPUT}"
    )
  if(_LLVMFlang_RESULT EQUAL 0)
    linearbuild_parse_implicit_link_info("${_LLVMFlang_OUTPUT}"
                                   LINEARBUILD_Fortran_IMPLICIT_LINK_LIBRARIES
                                   LINEARBUILD_Fortran_IMPLICIT_LINK_DIRECTORIES
                                   LINEARBUILD_Fortran_IMPLICIT_LINK_FRAMEWORK_DIRECTORIES
                                   log
                                   "${LINEARBUILD_Fortran_IMPLICIT_OBJECT_REGEX}"
                                   LANGUAGE Fortran)
    message(CONFIGURE_LOG
      "Parsed Fortran implicit link information:\n"
      "${log}\n"
      )
    set(_LINEARBUILD_Fortran_IMPLICIT_LINK_INFORMATION_DETERMINED_EARLY 1)
    if("x${LINEARBUILD_Fortran_COMPILER_ARCHITECTURE_ID}" STREQUAL "xARM64" AND LINEARBUILD_Fortran_COMPILER_VERSION VERSION_LESS 18.0)
      # LLVMFlang < 18.0 does not add `-defaultlib:` fields to object
      # files to specify link dependencies on its runtime libraries.
      # For now, we add them ourselves.
      list(APPEND LINEARBUILD_Fortran_IMPLICIT_LINK_LIBRARIES "clang_rt.builtins-aarch64.lib")
    endif()
  endif()
  unset(_LLVMFlang_COMMAND)
  unset(_LLVMFlang_OUTPUT)
  unset(_LLVMFlang_RESULT)
endif()

if (NOT _LINEARBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_LINEARBUILD_TOOLCHAIN_LOCATION "${LINEARBUILD_Fortran_COMPILER}" PATH)
endif ()

# if we have a fortran cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-gfortran, arm-elf-gfortran or i586-mingw32msvc-gfortran , optionally
# with a 3-component version number at the end (e.g. arm-eabi-gcc-4.5.2).
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gcc.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"
if (NOT _LINEARBUILD_TOOLCHAIN_PREFIX)

  if(LINEARBUILD_Fortran_COMPILER_ID MATCHES "GNU")
    get_filename_component(COMPILER_BASENAME "${LINEARBUILD_Fortran_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+-)g?fortran(-[0-9]+\\.[0-9]+\\.[0-9]+)?(\\.exe)?$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
    endif ()

    # if "llvm-" is part of the prefix, remove it, since llvm doesn't have its own binutils
    # but uses the regular ar, objcopy, etc. (instead of llvm-objcopy etc.)
    if ("${_LINEARBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
    endif ()
  endif()

endif ()

set(_LINEARBUILD_PROCESSING_LANGUAGE "Fortran")
include(LinearBuildFindBinUtils)
include(Compiler/${LINEARBUILD_Fortran_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_LINEARBUILD_PROCESSING_LANGUAGE)

if(LINEARBUILD_Fortran_XL_CPP)
  set(_SET_LINEARBUILD_Fortran_XL_CPP
    "set(LINEARBUILD_Fortran_XL_CPP \"${LINEARBUILD_Fortran_XL_CPP}\")")
endif()

if(LINEARBUILD_Fortran_COMPILER_SYSROOT)
  string(CONCAT _SET_LINEARBUILD_Fortran_COMPILER_SYSROOT
    "set(LINEARBUILD_Fortran_COMPILER_SYSROOT \"${LINEARBUILD_Fortran_COMPILER_SYSROOT}\")\n"
    "set(LINEARBUILD_COMPILER_SYSROOT \"${LINEARBUILD_Fortran_COMPILER_SYSROOT}\")")
else()
  set(_SET_LINEARBUILD_Fortran_COMPILER_SYSROOT "")
endif()

if(MSVC_Fortran_ARCHITECTURE_ID)
  set(SET_MSVC_Fortran_ARCHITECTURE_ID
    "set(MSVC_Fortran_ARCHITECTURE_ID ${MSVC_Fortran_ARCHITECTURE_ID})")
endif()
if(LINEARBUILD_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(LINEARBUILD_Fortran_VENDOR_SOURCE_FILE_EXTENSIONS ";cuf;CUF")
endif()
# configure variables set in this file for fast reload later on
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildFortranCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildFortranCompiler.linearbuild
  @ONLY
  )
set(LINEARBUILD_Fortran_COMPILER_ENV_VAR "FC")
