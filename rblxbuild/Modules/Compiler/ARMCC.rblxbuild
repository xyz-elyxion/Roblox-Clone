if(_ARMCC_RBLXBUILD_LOADED)
  return()
endif()
set(_ARMCC_RBLXBUILD_LOADED TRUE)

# See ARM Compiler documentation at:
# http://infocenter.arm.com/help/topic/com.arm.doc.set.swdev/index.html

get_filename_component(_RBLXBUILD_C_TOOLCHAIN_LOCATION "${RBLXBUILD_C_COMPILER}" PATH)
get_filename_component(_RBLXBUILD_CXX_TOOLCHAIN_LOCATION "${RBLXBUILD_CXX_COMPILER}" PATH)

set(RBLXBUILD_EXECUTABLE_SUFFIX ".elf")

find_program(RBLXBUILD_ARMCC_LINKER armlink HINTS "${_RBLXBUILD_C_TOOLCHAIN_LOCATION}" "${_RBLXBUILD_CXX_TOOLCHAIN_LOCATION}" )
find_program(RBLXBUILD_ARMCC_AR     armar   HINTS "${_RBLXBUILD_C_TOOLCHAIN_LOCATION}" "${_RBLXBUILD_CXX_TOOLCHAIN_LOCATION}" )

set(RBLXBUILD_LINKER "${RBLXBUILD_ARMCC_LINKER}" CACHE FILEPATH "The ARMCC linker" FORCE)
mark_as_advanced(RBLXBUILD_ARMCC_LINKER)
set(RBLXBUILD_AR "${RBLXBUILD_ARMCC_AR}" CACHE FILEPATH "The ARMCC archiver" FORCE)
mark_as_advanced(RBLXBUILD_ARMCC_AR)

macro(__compiler_armcc lang)
  string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -Ospace -DNDEBUG")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -Otime -DNDEBUG")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -g")

  set(RBLXBUILD_${lang}_OUTPUT_EXTENSION ".o")
  set(RBLXBUILD_${lang}_OUTPUT_EXTENSION_REPLACE 1)
  set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "--via=")

  set(RBLXBUILD_${lang}_LINK_MODE LINKER)

  set(RBLXBUILD_${lang}_LINK_EXECUTABLE      "<RBLXBUILD_LINKER> <LINK_FLAGS> <LINK_LIBRARIES> <OBJECTS> -o <TARGET> --list <TARGET_BASE>.map")
  set(RBLXBUILD_${lang}_CREATE_STATIC_LIBRARY  "<RBLXBUILD_AR> --create -cr <TARGET> <LINK_FLAGS> <OBJECTS>")

  set(RBLXBUILD_DEPFILE_FLAGS_${lang} "--depend=<DEP_FILE> --depend_single_line --no_depend_system_headers")

  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Xlinker" " ")
endmacro()
