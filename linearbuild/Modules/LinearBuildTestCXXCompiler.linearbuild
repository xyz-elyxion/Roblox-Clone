if(LINEARBUILD_CXX_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_CXX_COMPILER_WORKS TRUE)
  return()
endif()

include(LinearBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${LINEARBUILD_TRY_COMPILE_TARGET_TYPE})
if(_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older LinearBuild version.
# We now store this in LinearBuildCXXCompiler.linearbuild.
unset(LINEARBUILD_CXX_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into LinearBuildCXXCompiler.linearbuild
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerABI.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_ABI(CXX ${LINEARBUILD_ROOT}/Modules/LinearBuildCXXCompilerABI.cpp)
if(LINEARBUILD_CXX_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(LINEARBUILD_CXX_COMPILER_WORKS TRUE)
  message(STATUS "Check for working CXX compiler: ${LINEARBUILD_CXX_COMPILER} - skipped")
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected C++ compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_CXX_COMPILER_WORKS)
  PrintTestCompilerStatus("CXX")
  # FIXME: Use a block() to isolate the variables we set/unset here.
  if(DEFINED LINEARBUILD_CXX_SCAN_FOR_MODULES)
    set(__LINEARBUILD_SAVED_CXX_SCAN_FOR_MODULES "${LINEARBUILD_CXX_SCAN_FOR_MODULES}")
  else()
    unset(__LINEARBUILD_SAVED_CXX_SCAN_FOR_MODULES)
  endif()
  set(LINEARBUILD_CXX_SCAN_FOR_MODULES OFF)
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testCXXCompilerSource
    "#ifndef __cplusplus\n"
    "# error \"The LINEARBUILD_CXX_COMPILER is set to a C compiler\"\n"
    "#endif\n"
    "int main(){return 0;}\n")
  # Clear result from normal variable.
  unset(LINEARBUILD_CXX_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(LINEARBUILD_CXX_COMPILER_WORKS
    SOURCE_FROM_VAR testCXXCompiler.cxx __TestCompiler_testCXXCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __LINEARBUILD_CXX_COMPILER_OUTPUT)
  if(DEFINED __LINEARBUILD_SAVED_CXX_SCAN_FOR_MODULES)
    set(LINEARBUILD_CXX_SCAN_FOR_MODULES "${__LINEARBUILD_SAVED_CXX_SCAN_FOR_MODULES}")
    unset(__LINEARBUILD_SAVED_CXX_SCAN_FOR_MODULES)
  else()
    unset(LINEARBUILD_CXX_SCAN_FOR_MODULES)
  endif()
  unset(__TestCompiler_testCXXCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT LINEARBUILD_CXX_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__LINEARBUILD_CXX_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The C++ compiler\n  \"${LINEARBUILD_CXX_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "LinearBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerSupport.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_SUPPORT(CXX)

# Re-configure to save learned information.
configure_file(
  ${LINEARBUILD_ROOT}/Modules/LinearBuildCXXCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCXXCompiler.linearbuild
  @ONLY
  )
include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCXXCompiler.linearbuild)

if(LINEARBUILD_CXX_SIZEOF_DATA_PTR)
  foreach(f ${LINEARBUILD_CXX_ABI_FILES})
    include(${f})
  endforeach()
  unset(LINEARBUILD_CXX_ABI_FILES)
endif()

set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__LINEARBUILD_CXX_COMPILER_OUTPUT)
