# determine the compiler to use for ASM programs

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompiler.rblxbuild)

rblxbuild_policy(GET CMP0194 _RBLXBUILD_ASM_CMP0194)

if(NOT RBLXBUILD_ASM${ASM_DIALECT}_COMPILER)
  # prefer the environment variable ASM
  if(NOT $ENV{ASM${ASM_DIALECT}} STREQUAL "")
    get_filename_component(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_INIT $ENV{ASM${ASM_DIALECT}} PROGRAM PROGRAM_ARGS RBLXBUILD_ASM${ASM_DIALECT}_FLAGS_ENV_INIT)
    if(RBLXBUILD_ASM${ASM_DIALECT}_FLAGS_ENV_INIT)
      set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARG1 "${RBLXBUILD_ASM${ASM_DIALECT}_FLAGS_ENV_INIT}" CACHE STRING "Arguments to ASM${ASM_DIALECT} compiler")
    endif()
    if(NOT EXISTS ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_INIT})
      message(FATAL_ERROR "Could not find the compiler specified in the environment variable ASM${ASM_DIALECT}:\n$ENV{ASM${ASM_DIALECT}}.")
    endif()
  endif()

  # finally list compilers to try
  if("ASM${ASM_DIALECT}" STREQUAL "ASM") # the generic assembler support
    if(NOT RBLXBUILD_ASM_COMPILER_INIT)
      if(_RBLXBUILD_ASM_CMP0194 STREQUAL "NEW")
        set(_RBLXBUILD_ASM_REGEX_MSVC "^(MSVC)$")
        set(_RBLXBUILD_ASM_REGEX_CL "(^|/)[Cc][Ll](\\.|$)")
        set(_RBLXBUILD_ASM_MAYBE_CL "")
      else()
        set(_RBLXBUILD_ASM_REGEX_MSVC "CMP0194_OLD_MSVC_NOT_EXCLUDED")
        set(_RBLXBUILD_ASM_REGEX_CL "CMP0194_OLD_MSVC_NOT_EXCLUDED")
        set(_RBLXBUILD_ASM_MAYBE_CL "cl")
      endif()
      if(RBLXBUILD_C_COMPILER_LOADED AND NOT RBLXBUILD_C_COMPILER_ID MATCHES "${_RBLXBUILD_ASM_REGEX_MSVC}")
        set(RBLXBUILD_ASM_COMPILER_LIST ${RBLXBUILD_C_COMPILER})
      elseif(NOT RBLXBUILD_C_COMPILER_LOADED AND RBLXBUILD_C_COMPILER AND NOT RBLXBUILD_C_COMPILER MATCHES "${_RBLXBUILD_ASM_REGEX_CL}")
        set(RBLXBUILD_ASM_COMPILER_LIST ${RBLXBUILD_C_COMPILER})
      elseif(RBLXBUILD_CXX_COMPILER_LOADED AND NOT RBLXBUILD_CXX_COMPILER_ID MATCHES "${_RBLXBUILD_ASM_REGEX_MSVC}")
        set(RBLXBUILD_ASM_COMPILER_LIST ${RBLXBUILD_CXX_COMPILER})
      elseif(NOT RBLXBUILD_CXX_COMPILER_LOADED AND RBLXBUILD_CXX_COMPILER AND NOT RBLXBUILD_CXX_COMPILER MATCHES "${_RBLXBUILD_ASM_REGEX_CL}")
        set(RBLXBUILD_ASM_COMPILER_LIST ${RBLXBUILD_CXX_COMPILER})
      else()
        # List all default C and CXX compilers
        set(RBLXBUILD_ASM_COMPILER_LIST
             ${_RBLXBUILD_TOOLCHAIN_PREFIX}cc  ${_RBLXBUILD_TOOLCHAIN_PREFIX}gcc bcc64x xlc
             ${_RBLXBUILD_ASM_MAYBE_CL}
          CC ${_RBLXBUILD_TOOLCHAIN_PREFIX}c++ ${_RBLXBUILD_TOOLCHAIN_PREFIX}g++ bcc64x xlC)
        unset(_RBLXBUILD_ASM_MAYBE_CL)
        unset(_RBLXBUILD_ASM_REGEX_CL)
        unset(_RBLXBUILD_ASM_REGEX_MSVC)
      endif()
    endif()
  else() # some specific assembler "dialect"
    if(NOT RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_INIT  AND NOT RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LIST)
      message(FATAL_ERROR "RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_INIT or RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LIST must be preset !")
    endif()
  endif()

  # Find the compiler.
  _rblxbuild_find_compiler(ASM${ASM_DIALECT})

else()
  _rblxbuild_find_compiler_path(ASM${ASM_DIALECT})
endif()
mark_as_advanced(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER)

if (NOT _RBLXBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_RBLXBUILD_TOOLCHAIN_LOCATION "${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER}" PATH)
endif ()


if(NOT RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID)

  # Table of per-vendor compiler id flags with expected output.
  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS GNU )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_GNU "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_GNU "(GNU assembler)|(GCC)|(Free Software Foundation)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS AppleClang )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_AppleClang "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_AppleClang "(Apple (clang|LLVM) version)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS Clang )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_Clang "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_Clang "(clang version)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS ARMClang )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_ARMClang "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_ARMClang "armclang")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS OrangeC )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_OrangeC "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_OrangeC "occ \\(OrangeC\\) Version")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS HP )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_HP "-V")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_HP "HP C")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS Intel )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_Intel "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_Intel "(ICC)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS IntelLLVM )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_IntelLLVM "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_IntelLLVM "(Intel[^\n]+oneAPI)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS SunPro )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_SunPro "-V")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_SunPro "Sun C")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS XL )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_XL "-qversion")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_XL "XL C")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS MSVC )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_MSVC "-?")
  if(_RBLXBUILD_ASM_CMP0194 STREQUAL "NEW")
    set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_MSVC "Microsoft.*Macro Assembler")
  else()
    set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_MSVC "Microsoft")
  endif()

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS TI )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_TI "-h")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_TI "Texas Instruments")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS TIClang )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_TIClang "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_TIClang "(TI (.*) Clang Compiler)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS IAR)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_IAR )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_IAR "IAR Assembler")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS Diab)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_Diab "-V" )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_Diab "Wind River Systems")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS ARMCC)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_ARMCC )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_ARMCC "(ARM Compiler)|(ARM Assembler)|(Arm Compiler)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS NASM)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_NASM "-v")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_NASM "(NASM version)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS YASM)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_YASM "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_YASM "(yasm)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS ADSP)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_ADSP "-version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_ADSP "Analog Devices")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS QCC)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_QCC "-V")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_QCC "gcc_nto")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS Tasking)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_Tasking "--version")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_Tasking "TASKING")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS Renesas)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_Renesas "-v")
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_Renesas "(RX Family C/C\\+\\+ Compiler)|(RL78 Family Compiler)|(RH850 Family Compiler)")

  list(APPEND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDORS PellesC)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_FLAGS_PellesC )
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_REGEX_PellesC "Pelles Macro Assembler")

  include(RBLXBuildDetermineCompilerId)
  set(userflags)
  RBLXBUILD_DETERMINE_COMPILER_ID_VENDOR(ASM${ASM_DIALECT} "${userflags}")
  set(_variant "")
  if("x${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}" STREQUAL "xIAR")
    # primary necessary to detect architecture, so the right archiver and linker can be picked
    # eg. "IAR Assembler V8.10.1.12857/W32 for ARM" or "IAR Assembler V4.11.1.4666 for Renesas RX"
    # Earlier versions did not provide `--version`, so grep the full output to extract Assembler ID string
    string(REGEX MATCH "IAR Assembler[^\r\n]*" _compileid "${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_OUTPUT}")
    if("${_compileid}" MATCHES "V([0-9]+\\.[0-9]+\\.[0-9]+)")
      set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_VERSION ${RBLXBUILD_MATCH_1})
    endif()
    if("${_compileid}" MATCHES "for.*(MSP430|8051|ARM|AVR|RH850|RISC-?V|RL78|RX|STM8|V850)")
      set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARCHITECTURE_ID ${RBLXBUILD_MATCH_1})
    endif()
  elseif("x${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}" STREQUAL "xClang")
    # Test whether an MSVC-like command-line option works.
    execute_process(COMMAND ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER} -?
      OUTPUT_VARIABLE _clang_output
      ERROR_VARIABLE _clang_output
      RESULT_VARIABLE _clang_result)
      if(_clang_result EQUAL 0)
        set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_FRONTEND_VARIANT "MSVC")
        set(RBLXBUILD_ASM${ASM_DIALECT}_SIMULATE_ID MSVC)
      else()
        set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_FRONTEND_VARIANT "GNU")
      endif()
      set(_variant " with ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_FRONTEND_VARIANT}-like command-line")
  elseif("x${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}" STREQUAL "xRenesas")
    string(REGEX MATCH "[A-Za-z0-9]+ Family (C/C\\+\\+ )*Compiler [V|E][0-9|.]+" _compiler_id "${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_OUTPUT}")
    string(REGEX MATCH "R[A-Za-z0-9]+" RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARCHITECTURE_ID "${_compiler_id}")
    string(REGEX MATCH "V[0-9|.]+" RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_VERSION "${_compiler_id}")
  endif()

  _rblxbuild_find_compiler_sysroot(ASM${ASM_DIALECT})

  unset(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_OUTPUT)
  unset(_all_compileid_matches)
  unset(_compileid)
  unset(_clang_result)
  unset(_clang_output)
endif()

if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID)
  if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_VERSION)
    set(_version " ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_VERSION}")
  else()
    set(_version "")
  endif()
  if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARCHITECTURE_ID AND "x${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}" STREQUAL "xIAR")
    set(_archid " ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARCHITECTURE_ID}")
  elseif(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARCHITECTURE_ID AND "x${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}" STREQUAL "xRenesas")
    set(_archid " ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ARCHITECTURE_ID} Family Assembler")
  else()
    set(_archid "")
  endif()
  message(STATUS "The ASM${ASM_DIALECT} compiler identification is ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}${_archid}${_version}${_variant}")
  unset(_archid)
  unset(_version)
  unset(_variant)
else()
  message(STATUS "The ASM${ASM_DIALECT} compiler identification is unknown")
endif()

if("ASM${ASM_DIALECT}" STREQUAL "ASM" AND RBLXBUILD_ASM_COMPILER_ID STREQUAL "MSVC" AND _RBLXBUILD_ASM_CMP0194 STREQUAL "")
  rblxbuild_policy(ISSUE_WARNING CMP0194)
endif()

# If we have a gas/as cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-gas, arm-elf-gas or i586-mingw32msvc-gas , optionally
# with a 3-component version number at the end
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gas.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"
if (NOT _RBLXBUILD_TOOLCHAIN_PREFIX)
  get_filename_component(COMPILER_BASENAME "${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER}" NAME)
  if (COMPILER_BASENAME MATCHES "^(.+-)g?as(-[0-9]+\\.[0-9]+\\.[0-9]+)?(\\.exe)?$")
    set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
  endif ()
endif ()

# Now try the C compiler regexp:
if (NOT _RBLXBUILD_TOOLCHAIN_PREFIX)
  if (COMPILER_BASENAME MATCHES "^(.+-)g?cc(-[0-9]+\\.[0-9]+\\.[0-9]+)?(\\.exe)?$")
    set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
  endif ()
endif ()

# Finally try the CXX compiler regexp:
if (NOT _RBLXBUILD_TOOLCHAIN_PREFIX)
  if (COMPILER_BASENAME MATCHES "^(.+-)[gc]\\+\\+(-[0-9]+\\.[0-9]+\\.[0-9]+)?(\\.exe)?$")
    set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
  endif ()
endif ()


set(_RBLXBUILD_PROCESSING_LANGUAGE "ASM${ASM_DIALECT}")
include(RBLXBuildFindBinUtils)
include(Compiler/${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_RBLXBUILD_PROCESSING_LANGUAGE)

set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ENV_VAR "ASM${ASM_DIALECT}")

if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER)
  message(STATUS "Found assembler: ${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER}")
else()
  message(STATUS "Didn't find assembler")
endif()

if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_SYSROOT)
  string(CONCAT _SET_RBLXBUILD_ASM_COMPILER_SYSROOT
    "set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_SYSROOT \"${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_SYSROOT}\")\n"
    "set(RBLXBUILD_COMPILER_SYSROOT \"${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_SYSROOT}\")")
else()
  set(_SET_RBLXBUILD_ASM_COMPILER_SYSROOT "")
endif()

if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_MATCH)
  set(_SET_RBLXBUILD_ASM_COMPILER_ID_VENDOR_MATCH
    "set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_MATCH [==[${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_MATCH}]==])")
else()
  set(_SET_RBLXBUILD_ASM_COMPILER_ID_VENDOR_MATCH "")
endif()

# configure variables set in this file for fast reload later on
block()
  foreach(_var IN ITEMS
      # Keep in sync with Internal/RBLXBuildInspectASMLinker.
      COMPILER
      COMPILER_ID
      COMPILER_ARG1
      COMPILER_ENV_VAR
      COMPILER_AR
      COMPILER_RANLIB
      COMPILER_VERSION
      COMPILER_ARCHITECTURE_ID
      COMPILER_FRONTEND_VARIANT
      SIMULATE_ID
      )
    set(_RBLXBUILD_ASM_${_var} "${RBLXBUILD_ASM${ASM_DIALECT}_${_var}}")
  endforeach()
  configure_file(${RBLXBUILD_ROOT}/Modules/RBLXBuildASMCompiler.rblxbuild.in
    ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildASM${ASM_DIALECT}Compiler.rblxbuild @ONLY)
endblock()
