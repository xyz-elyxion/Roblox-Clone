include(Compiler/GNU)
__compiler_gnu(OBJCXX)
__compiler_gnu_cxx_standards(OBJCXX)

if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
    AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND RBLXBUILD_DEPFILE_FLAGS_OBJCXX)
  # dependencies are computed by the compiler itself
  set(RBLXBUILD_OBJCXX_DEPFILE_FORMAT gcc)
  set(RBLXBUILD_OBJCXX_DEPENDS_USE_COMPILER TRUE)
endif()


if(NOT RBLXBUILD_OBJCXX_COMPILER_VERSION VERSION_LESS 4.2)
  set(RBLXBUILD_OBJCXX_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")
endif()
