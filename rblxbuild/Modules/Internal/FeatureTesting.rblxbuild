macro(_has_compiler_features lang level compile_flags feature_list)
  # presume all known features are supported
  get_property(known_features GLOBAL PROPERTY RBLXBUILD_${lang}${level}_KNOWN_FEATURES)
  list(APPEND ${feature_list} ${known_features})
endmacro()

macro(_has_compiler_features_c std)
  list(APPEND RBLXBUILD_C${std}_COMPILE_FEATURES c_std_${std})
  _has_compiler_features(C ${std} "${RBLXBUILD_C${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_C${std}_COMPILE_FEATURES)
endmacro()
macro(_has_compiler_features_cxx std)
  list(APPEND RBLXBUILD_CXX${std}_COMPILE_FEATURES cxx_std_${std})
  _has_compiler_features(CXX ${std} "${RBLXBUILD_CXX${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_CXX${std}_COMPILE_FEATURES)
endmacro()
macro(_has_compiler_features_sycl std)
  list(APPEND RBLXBUILD_SYCL${std}_COMPILE_FEATURES sycl_cxx_std_${std})
  _has_compiler_features(SYCL ${std} "${RBLXBUILD_SYCL${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_SYCL${std}_COMPILE_FEATURES)
  if(${std} GREATER_EQUAL 17)
    # SYCL starts at C++17, which includes all granular C++98/11/14 features.
    foreach(previous_std IN ITEMS 98 11 14)
      get_property(previous_features GLOBAL PROPERTY
        RBLXBUILD_CXX${previous_std}_KNOWN_FEATURES)
      list(APPEND RBLXBUILD_SYCL${std}_COMPILE_FEATURES ${previous_features})
    endforeach()
    unset(previous_features)
    unset(previous_std)
  endif()
endmacro()
macro(_has_compiler_features_cuda std)
  list(APPEND RBLXBUILD_CUDA${std}_COMPILE_FEATURES cuda_std_${std})
  _has_compiler_features(CUDA ${std} "${RBLXBUILD_CUDA${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_CUDA${std}_COMPILE_FEATURES)
endmacro()
macro(_has_compiler_features_hip std)
  list(APPEND RBLXBUILD_HIP${std}_COMPILE_FEATURES hip_std_${std})
  _has_compiler_features(HIP ${std} "${RBLXBUILD_HIP${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_HIP${std}_COMPILE_FEATURES)
endmacro()
