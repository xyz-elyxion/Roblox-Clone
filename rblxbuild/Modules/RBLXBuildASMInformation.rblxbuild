# file LICENSE.rst or https://rblxbuild.org/licensing for details.


if(UNIX)
  set(RBLXBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .obj)
endif()

set(RBLXBUILD_INCLUDE_FLAG_ASM${ASM_DIALECT} "-I")       # -I
set(RBLXBUILD_BASE_NAME)
get_filename_component(RBLXBUILD_BASE_NAME "${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER}" NAME_WE)

if("${RBLXBUILD_BASE_NAME}" STREQUAL "as")
  set(RBLXBUILD_BASE_NAME gas)
endif()

# Load compiler-specific information.
set(_INCLUDED_FILE "")
if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID)
  include(Compiler/${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT} OPTIONAL  RESULT_VARIABLE _INCLUDED_FILE)
endif()
if(NOT _INCLUDED_FILE)
  if("ASM${ASM_DIALECT}" STREQUAL "ASM" AND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID)
    message(STATUS "Warning: Did not find file Compiler/${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT}")
  endif()
  include(Platform/${RBLXBUILD_BASE_NAME} OPTIONAL)
endif()

if(RBLXBUILD_SYSTEM_PROCESSOR)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT}-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL  RESULT_VARIABLE _INCLUDED_FILE)
  if(NOT _INCLUDED_FILE)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME}-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
endif()

include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID}-ASM${ASM_DIALECT} OPTIONAL  RESULT_VARIABLE _INCLUDED_FILE)
if(NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME} OPTIONAL)
endif()

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_ASM)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE_ASM} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_ASM "${_override}")
endif()

# Set default assembler file extensions:
if(NOT RBLXBUILD_ASM${ASM_DIALECT}_SOURCE_FILE_EXTENSIONS)
  set(RBLXBUILD_ASM${ASM_DIALECT}_SOURCE_FILE_EXTENSIONS s;S;asm)
endif()


# Support for RBLXBUILD_ASM${ASM_DIALECT}_FLAGS_INIT and friends:
set(RBLXBUILD_ASM${ASM_DIALECT}_FLAGS_INIT "$ENV{ASM${ASM_DIALECT}FLAGS} ${RBLXBUILD_ASM${ASM_DIALECT}_FLAGS_INIT}")

rblxbuild_initialize_per_config_variable(RBLXBUILD_ASM${ASM_DIALECT}_FLAGS "Flags used by the ASM${ASM_DIALECT} compiler")

if(NOT RBLXBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT)
  set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT "<RBLXBUILD_ASM${ASM_DIALECT}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT RBLXBUILD_ASM${ASM_DIALECT}_CREATE_STATIC_LIBRARY)
  set(RBLXBUILD_ASM${ASM_DIALECT}_CREATE_STATIC_LIBRARY
      "<RBLXBUILD_AR> cr <TARGET> <LINK_FLAGS> <OBJECTS> "
      "<RBLXBUILD_RANLIB> <TARGET>")
endif()

if(NOT RBLXBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE)
  set(RBLXBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE
    "<RBLXBUILD_ASM${ASM_DIALECT}_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(NOT RBLXBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG)
  set(RBLXBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG ${RBLXBUILD_SHARED_LIBRARY_RUNTIME_ASM${ASM_DIALECT}_FLAG})
endif()

if(NOT RBLXBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG_SEP)
  set(RBLXBUILD_EXECUTABLE_RUNTIME_ASM${ASM_DIALECT}_FLAG_SEP ${RBLXBUILD_SHARED_LIBRARY_RUNTIME_ASM${ASM_DIALECT}_FLAG_SEP})
endif()

if(NOT RBLXBUILD_EXECUTABLE_RPATH_LINK_ASM${ASM_DIALECT}_FLAG)
  set(RBLXBUILD_EXECUTABLE_RPATH_LINK_ASM${ASM_DIALECT}_FLAG ${RBLXBUILD_SHARED_LIBRARY_RPATH_LINK_ASM${ASM_DIALECT}_FLAG})
endif()

set(RBLXBUILD_ASM${ASM_DIALECT}_USE_LINKER_INFORMATION TRUE)

set(RBLXBUILD_ASM${ASM_DIALECT}_INFORMATION_LOADED 1)
