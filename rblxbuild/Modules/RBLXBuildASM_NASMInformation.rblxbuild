# support for the nasm assembler

set(RBLXBUILD_ASM_NASM_SOURCE_FILE_EXTENSIONS nasm asm)

if(NOT RBLXBUILD_ASM_NASM_OBJECT_FORMAT)
  if(WIN32)
    if(RBLXBUILD_C_SIZEOF_DATA_PTR EQUAL 8 OR RBLXBUILD_CXX_SIZEOF_DATA_PTR EQUAL 8)
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT win64)
    elseif(RBLXBUILD_C_SIZEOF_DATA_PTR EQUAL 4 OR RBLXBUILD_CXX_SIZEOF_DATA_PTR EQUAL 4)
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT win32)
    elseif(RBLXBUILD_SYSTEM_PROCESSOR STREQUAL "x86_64")
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT win64)
    else()
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT win32)
    endif()
  elseif(APPLE)
    if(RBLXBUILD_C_SIZEOF_DATA_PTR EQUAL 8 OR RBLXBUILD_CXX_SIZEOF_DATA_PTR EQUAL 8)
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT macho64)
    elseif(RBLXBUILD_C_SIZEOF_DATA_PTR EQUAL 4 OR RBLXBUILD_CXX_SIZEOF_DATA_PTR EQUAL 4)
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT macho32)
    elseif(RBLXBUILD_SYSTEM_PROCESSOR STREQUAL "x86_64")
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT macho64)
    else()
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT macho)
    endif()
  else()
    if(RBLXBUILD_C_SIZEOF_DATA_PTR EQUAL 8 OR RBLXBUILD_CXX_SIZEOF_DATA_PTR EQUAL 8)
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT elf64)
    elseif(RBLXBUILD_C_SIZEOF_DATA_PTR EQUAL 4 OR RBLXBUILD_CXX_SIZEOF_DATA_PTR EQUAL 4)
      if(";${RBLXBUILD_C_COMPILER_ARCHITECTURE_ID};${RBLXBUILD_CXX_COMPILER_ARCHITECTURE_ID};" MATCHES ";x86_64;")
        set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT elfx32)
      else()
        set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT elf32)
      endif()
    elseif(RBLXBUILD_SYSTEM_PROCESSOR STREQUAL "x86_64")
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT elf64)
    else()
      set(RBLXBUILD_ASM_NASM_OBJECT_FORMAT elf)
    endif()
  endif()
endif()

if(NOT RBLXBUILD_ASM_NASM_COMPILE_OBJECT)
  set(RBLXBUILD_ASM_NASM_COMPILE_OBJECT "<RBLXBUILD_ASM_NASM_COMPILER> <DEFINES> <INCLUDES> -f ${RBLXBUILD_ASM_NASM_OBJECT_FORMAT} <FLAGS> -o <OBJECT> <SOURCE>")
endif()

if(NOT RBLXBUILD_ASM_NASM_LINK_EXECUTABLE)
  set(RBLXBUILD_ASM_NASM_LINK_EXECUTABLE
    "<RBLXBUILD_LINKER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(RBLXBUILD_ASM_NASM_COMPILER_ID STREQUAL "NASM")
  set(RBLXBUILD_DEPFILE_FLAGS_ASM_NASM "-MD <DEP_FILE> -MT <DEP_TARGET>")

  if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
      AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake")
    # dependencies are computed by the compiler itself
    set(RBLXBUILD_ASM_NASM_DEPFILE_FORMAT gcc)
    set(RBLXBUILD_ASM_NASM_DEPENDS_USE_COMPILER TRUE)
  endif()
endif()

# Load the generic ASMInformation file:
set(ASM_DIALECT "_NASM")
include(RBLXBuildASMInformation)
set(ASM_DIALECT)
