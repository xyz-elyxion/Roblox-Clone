# This file sets the basic flags for the linker used by the Objective-C++ compiler in LinearBuild.
# It also loads the available platform file for the system-linker
# if it exists.
# It also loads a system - linker - processor (or target hardware)
# specific file, which is mainly useful for crosscompiling and embedded systems.

include(Internal/LinearBuildCommonLinkerInformation)

set(_INCLUDED_FILE 0)

# Load linker-specific information.
if(LINEARBUILD_OBJCXX_COMPILER_LINKER_ID)
  include(Linker/${LINEARBUILD_OBJCXX_COMPILER_LINKER_ID}-C OPTIONAL)
endif()

# load a hardware specific file, mostly useful for embedded compilers
if(LINEARBUILD_SYSTEM_PROCESSOR AND LINEARBUILD_OBJCXX_COMPILER_LINKER_ID)
    include(Platform/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_OBJCXX_COMPILER_LINKER_ID}-OBJCXX-${LINEARBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()


# load the system- and linker specific files
if(LINEARBUILD_OBJCXX_COMPILER_LINKER_ID)
  include(Platform/Linker/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-${LINEARBUILD_OBJCXX_COMPILER_LINKER_ID}-C
    OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()

# We specify the platform linker information in the system file.
if (NOT _INCLUDED_FILE)
  include(Platform/Linker/${LINEARBUILD_EFFECTIVE_SYSTEM_NAME}-OBJCXX OPTIONAL)
endif ()

_linearbuild_common_linker_platform_flags(OBJCXX)

set(LINEARBUILD_OBJCXX_LINKER_INFORMATION_LOADED 1)
