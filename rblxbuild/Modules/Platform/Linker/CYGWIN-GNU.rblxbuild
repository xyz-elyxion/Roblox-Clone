# This module is shared by multiple languages; use include blocker.
include_guard()

include(Platform/Linker/GNU)

macro(__cygwin_linker_gnu lang)
  set(RBLXBUILD_${lang}_PLATFORM_LINKER_ID GNU)
  if(RBLXBUILD_${lang}_COMPILER_LINKER)
    __rblxbuild_set_whole_archive_feature("${RBLXBUILD_${lang}_COMPILER_LINKER}"
                                      "${RBLXBUILD_${lang}_COMPILER_LINKER_ARCHITECTURE_FLAGS}"
                                      "${lang}")
  endif()
endmacro()
