include(Compiler/Clang-CXX)
include(Compiler/ARMClang)
__compiler_armclang(CXX)

if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
    AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND RBLXBUILD_DEPFILE_FLAGS_CXX)
  # dependencies are computed by the compiler itself
  set(RBLXBUILD_CXX_DEPFILE_FORMAT gcc)
  set(RBLXBUILD_CXX_DEPENDS_USE_COMPILER TRUE)
endif()
