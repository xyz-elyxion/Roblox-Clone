# support for AT&T syntax assemblers, e.g. GNU as

set(ASM_DIALECT "-ATT")
# *.S files are supposed to be preprocessed, so they should not be passed to
# assembler but should be processed by gcc
set(LINEARBUILD_ASM${ASM_DIALECT}_SOURCE_FILE_EXTENSIONS s;asm)

set(LINEARBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT "<LINEARBUILD_ASM${ASM_DIALECT}_COMPILER> <INCLUDES> <FLAGS> -o <OBJECT> <SOURCE>")

include(LinearBuildASMInformation)
set(ASM_DIALECT)
