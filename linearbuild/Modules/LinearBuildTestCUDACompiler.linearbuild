if(LINEARBUILD_CUDA_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_CUDA_COMPILER_WORKS TRUE)
  return()
endif()

include(LinearBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${LINEARBUILD_TRY_COMPILE_TARGET_TYPE})
if(_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older LinearBuild version.
# We now store this in LinearBuildCUDACompiler.linearbuild.
unset(LINEARBUILD_CUDA_COMPILER_WORKS CACHE)

# If the compiler was not identified, required compiler-specific variables
# such as _LINEARBUILD_CUDA_WHOLE_FLAG will not be set.  Issue a clear diagnostic
# rather than the cryptic "required internal LinearBuild variable not set" message
# that the generator would otherwise emit.
if(NOT LINEARBUILD_CUDA_COMPILER_ID)
  PrintTestCompilerStatus("CUDA")
  PrintTestCompilerResult(CHECK_FAIL "broken")
  message(FATAL_ERROR "The CUDA compiler\n  \"${LINEARBUILD_CUDA_COMPILER}\"\n"
    "is not able to compile a simple test program.\nThe compiler could not "
    "be identified as a supported CUDA compiler.\n\n"
    "LinearBuild will not be able to correctly generate this project.")
endif()

# Try to identify the ABI and configure it into LinearBuildCUDACompiler.linearbuild
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerABI.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_ABI(CUDA ${LINEARBUILD_ROOT}/Modules/LinearBuildCUDACompilerABI.cu)
if(LINEARBUILD_CUDA_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(LINEARBUILD_CUDA_COMPILER_WORKS TRUE)
  message(STATUS "Check for working CUDA compiler: ${LINEARBUILD_CUDA_COMPILER} - skipped")

  include(Internal/LinearBuildCUDAArchitecturesNative)
  # Run the test binary to get:
  # - LINEARBUILD_CUDA_ARCHITECTURES_NATIVE
  linearbuild_cuda_architectures_native(CUDA)
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected cuda compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_CUDA_COMPILER_WORKS)
  PrintTestCompilerStatus("CUDA")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testCudaCompilerSource
    "#ifndef __CUDACC__\n"
    "# error \"The LINEARBUILD_CUDA_COMPILER is set to an invalid CUDA compiler\"\n"
    "#endif\n"
    "int main(){return 0;}\n")

  # Clear result from normal variable.
  unset(LINEARBUILD_CUDA_COMPILER_WORKS)

  # Puts test result in cache variable.
  try_compile(LINEARBUILD_CUDA_COMPILER_WORKS
    SOURCE_FROM_VAR main.cu __TestCompiler_testCudaCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __LINEARBUILD_CUDA_COMPILER_OUTPUT)
  unset(__TestCompiler_testCudaCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT LINEARBUILD_CUDA_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__LINEARBUILD_CUDA_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The CUDA compiler\n  \"${LINEARBUILD_CUDA_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "LinearBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerSupport.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_SUPPORT(CUDA)

if("x${LINEARBUILD_CUDA_SIMULATE_ID}" STREQUAL "xMSVC")
  set(LINEARBUILD_CUDA_IMPLICIT_LINK_LIBRARIES "${LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_LIBRARIES}")
  set(LINEARBUILD_CUDA_IMPLICIT_LINK_DIRECTORIES "${LINEARBUILD_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES}")
endif()

include(Internal/LinearBuildCUDAFilterImplicitLibs)
# Filter out implicit link libraries that should not be passed unconditionally.
linearbuild_cuda_filter_implicit_libs(LINEARBUILD_CUDA_IMPLICIT_LINK_LIBRARIES)

if(LINEARBUILD_CUDA_COMPILER_ID STREQUAL "NVIDIA")
  include(Internal/LinearBuildNVCCFilterImplicitInfo)
  # Match arguments with linearbuild_nvcc_parse_implicit_info call in LinearBuildDetermineCUDACompiler.
  linearbuild_nvcc_filter_implicit_info(CUDA LINEARBUILD_CUDA_)
endif()

# Re-configure to save learned information.
configure_file(
  ${LINEARBUILD_ROOT}/Modules/LinearBuildCUDACompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCUDACompiler.linearbuild
  @ONLY
  )
include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCUDACompiler.linearbuild)

set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__LINEARBUILD_CUDA_COMPILER_OUTPUT)
