# This file sets the basic flags for the C language in RBLXBuild.
# It also loads the available platform file for the system-compiler
# if it exists.
# It also loads a system - compiler - processor (or target hardware)
# specific file, which is mainly useful for crosscompiling and embedded systems.

include(RBLXBuildLanguageInformation)

# some compilers use different extensions (e.g. sdcc uses .rel)
# so set the extension here first so it can be overridden by the compiler specific file
if(UNIX)
  set(RBLXBUILD_C_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_C_OUTPUT_EXTENSION .obj)
endif()

set(_INCLUDED_FILE 0)

# Load compiler-specific information.
if(RBLXBUILD_C_COMPILER_ID)
  include(Compiler/${RBLXBUILD_C_COMPILER_ID}-C OPTIONAL)
endif()

set(RBLXBUILD_BASE_NAME)
get_filename_component(RBLXBUILD_BASE_NAME "${RBLXBUILD_C_COMPILER}" NAME_WE)
if(RBLXBUILD_C_COMPILER_ID STREQUAL "GNU")
  set(RBLXBUILD_BASE_NAME gcc)
endif()


# load a hardware specific file, mostly useful for embedded compilers
if(RBLXBUILD_SYSTEM_PROCESSOR)
  if(RBLXBUILD_C_COMPILER_ID)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_C_COMPILER_ID}-C-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
  endif()
  if (NOT _INCLUDED_FILE)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME}-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif ()
endif()


# load the system- and compiler specific files
if(RBLXBUILD_C_COMPILER_ID)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_C_COMPILER_ID}-C
    OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()
if (NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME}
    OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif ()

# load any compiler-wrapper specific information
if (RBLXBUILD_C_COMPILER_WRAPPER)
  __rblxbuild_include_compiler_wrapper(C)
endif ()

# We specify the compiler information in the system file for some
# platforms, but this language may not have been enabled when the file
# was first included.  Include it again to get the language info.
# Remove this when all compiler info is removed from system files.
if (NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_SYSTEM_NAME} OPTIONAL)
endif ()

if(RBLXBUILD_C_SIZEOF_DATA_PTR)
  foreach(f IN LISTS RBLXBUILD_C_ABI_FILES)
    include(${f})
  endforeach()
  unset(RBLXBUILD_C_ABI_FILES)
endif()

# This should be included before the _INIT variables are
# used to initialize the cache.  Since the rule variables
# have if blocks on them, users can still define them here.
# But, it should still be after the platform file so changes can
# be made to those values.

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_C)
  # Save the full path of the file so try_compile can use it.
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE_C} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_C "${_override}")
endif()

set(RBLXBUILD_C_FLAGS_INIT "$ENV{CFLAGS} ${RBLXBUILD_C_FLAGS_INIT}")

rblxbuild_initialize_per_config_variable(RBLXBUILD_C_FLAGS "Flags used by the C compiler")

if(RBLXBUILD_C_STANDARD_LIBRARIES_INIT)
  set(RBLXBUILD_C_STANDARD_LIBRARIES "${RBLXBUILD_C_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all C applications.")
  mark_as_advanced(RBLXBUILD_C_STANDARD_LIBRARIES)
endif()

if(NOT RBLXBUILD_C_COMPILER_LAUNCHER AND DEFINED ENV{RBLXBUILD_C_COMPILER_LAUNCHER})
  set(RBLXBUILD_C_COMPILER_LAUNCHER "$ENV{RBLXBUILD_C_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for C.")
endif()

if(NOT RBLXBUILD_C_LINKER_LAUNCHER AND DEFINED ENV{RBLXBUILD_C_LINKER_LAUNCHER})
  set(RBLXBUILD_C_LINKER_LAUNCHER "$ENV{RBLXBUILD_C_LINKER_LAUNCHER}"
    CACHE STRING "Linker launcher for C.")
endif()

include(RBLXBuildCommonLanguageInclude)
_rblxbuild_common_language_platform_flags(C)

# now define the following rule variables

# RBLXBUILD_C_CREATE_SHARED_LIBRARY
# RBLXBUILD_C_CREATE_SHARED_MODULE
# RBLXBUILD_C_COMPILE_OBJECT
# RBLXBUILD_C_LINK_EXECUTABLE

# variables supplied by the generator at use time
# <TARGET>
# <TARGET_BASE> the target without the suffix
# <OBJECTS>
# <OBJECT>
# <LINK_LIBRARIES>
# <FLAGS>
# <LINK_FLAGS>

# C compiler information
# <RBLXBUILD_C_COMPILER>

# Static library tools
# <RBLXBUILD_AR>
# <RBLXBUILD_RANLIB>


# create a C shared library
if(NOT RBLXBUILD_C_CREATE_SHARED_LIBRARY)
  set(RBLXBUILD_C_CREATE_SHARED_LIBRARY
      "<RBLXBUILD_C_COMPILER> <RBLXBUILD_SHARED_LIBRARY_C_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
endif()

# create a C shared module just copy the shared library rule
if(NOT RBLXBUILD_C_CREATE_SHARED_MODULE)
  set(RBLXBUILD_C_CREATE_SHARED_MODULE ${RBLXBUILD_C_CREATE_SHARED_LIBRARY})
endif()

# Create a static archive incrementally for large object file counts.
# If RBLXBUILD_C_CREATE_STATIC_LIBRARY is set it will override these.
if(NOT DEFINED RBLXBUILD_C_ARCHIVE_CREATE)
  set(RBLXBUILD_C_ARCHIVE_CREATE "<RBLXBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_C_ARCHIVE_APPEND)
  set(RBLXBUILD_C_ARCHIVE_APPEND "<RBLXBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_C_ARCHIVE_FINISH)
  set(RBLXBUILD_C_ARCHIVE_FINISH "<RBLXBUILD_RANLIB> <TARGET>")
endif()

# compile a C file into an object file
if(NOT RBLXBUILD_C_COMPILE_OBJECT)
  set(RBLXBUILD_C_COMPILE_OBJECT
    "<RBLXBUILD_C_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT RBLXBUILD_C_LINK_EXECUTABLE)
  set(RBLXBUILD_C_LINK_EXECUTABLE
    "<RBLXBUILD_C_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

set(RBLXBUILD_C_USE_LINKER_INFORMATION TRUE)

set(RBLXBUILD_C_INFORMATION_LOADED 1)
