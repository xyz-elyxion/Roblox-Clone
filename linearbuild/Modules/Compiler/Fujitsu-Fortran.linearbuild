include(Compiler/Fujitsu)
__compiler_fujitsu(Fortran)

set(LINEARBUILD_Fortran_SUBMODULE_SEP ".")
set(LINEARBUILD_Fortran_SUBMODULE_EXT ".smod")

set(LINEARBUILD_Fortran_PREPROCESS_SOURCE
  "<LINEARBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -Cpp -P <SOURCE> -o <PREPROCESSED_SOURCE>")
set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-Cpp")

set(LINEARBUILD_Fortran_FORMAT_FIXED_FLAG "-Fixed")
set(LINEARBUILD_Fortran_FORMAT_FREE_FLAG "-Free")

string(APPEND LINEARBUILD_Fortran_FLAGS_DEBUG_INIT "")

set(LINEARBUILD_Fortran_MODDIR_FLAG "-M ")
