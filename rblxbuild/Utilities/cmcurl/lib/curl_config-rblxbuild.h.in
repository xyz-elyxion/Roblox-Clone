/* disables MIME support */
#rblxbuilddefine CURL_DISABLE_MIME 1

/* disables local binding support */
#rblxbuilddefine CURL_DISABLE_BINDLOCAL 1

/* disables MQTT */
#rblxbuilddefine CURL_DISABLE_MQTT 1

/* disables netrc parser */
#rblxbuilddefine CURL_DISABLE_NETRC 1

/* enables NTLM support */
