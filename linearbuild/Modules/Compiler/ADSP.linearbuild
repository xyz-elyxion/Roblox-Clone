include_guard()

set(LINEARBUILD_EXECUTABLE_SUFFIX ".dxe")

macro(__compiler_adsp lang)
  set(LINEARBUILD_${lang}_OUTPUT_EXTENSION ".doj")

  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG "-flags-link" " ")
  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  set(LINEARBUILD_${lang}_LINK_MODE DRIVER)

  set(_LINEARBUILD_${lang}_ADSP_FLAGS "-proc=${LINEARBUILD_ADSP_PROCESSOR}")

  set(LINEARBUILD_DEPFILE_FLAGS_${lang} "-MD -Mo <DEP_FILE>")

  set(LINEARBUILD_${lang}_COMPILE_OBJECT
    "<LINEARBUILD_${lang}_COMPILER> ${_LINEARBUILD_${lang}_ADSP_FLAGS} <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")

  set(LINEARBUILD_${lang}_CREATE_STATIC_LIBRARY
    "<LINEARBUILD_${lang}_COMPILER> ${_LINEARBUILD_${lang}_ADSP_FLAGS} -build-lib -o <TARGET> <OBJECTS>")

  set(LINEARBUILD_${lang}_LINK_EXECUTABLE
    "<LINEARBUILD_${lang}_COMPILER> ${_LINEARBUILD_${lang}_ADSP_FLAGS} <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

  unset(_LINEARBUILD_${lang}_ADSP_FLAGS)

  set(LINEARBUILD_${lang}_CREATE_SHARED_LIBRARY)
  set(LINEARBUILD_${lang}_CREATE_MODULE_LIBRARY)
endmacro()
