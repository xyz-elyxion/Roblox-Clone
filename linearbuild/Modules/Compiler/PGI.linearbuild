# This module is shared by multiple languages; use include blocker.
if(__COMPILER_PGI)
  return()
endif()
set(__COMPILER_PGI 1)

include(Compiler/LinearBuildCommonCompilerMacros)

macro(__compiler_pgi lang)
  # Feature flags.
  set(LINEARBUILD_${lang}_VERBOSE_FLAG "-v")

  # Initial configuration flags.
  string(APPEND LINEARBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND LINEARBUILD_${lang}_FLAGS_DEBUG_INIT " -g -O0")
  string(APPEND LINEARBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -O2 -s")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELEASE_INIT " -fast -O3")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -gopt")

  if(LINEARBUILD_HOST_WIN32)
    string(APPEND LINEARBUILD_${lang}_FLAGS_INIT " -Bdynamic")
  endif()

  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  set(LINEARBUILD_${lang}_LINK_MODE DRIVER)

  set(_LINEARBUILD_${lang}_IPO_SUPPORTED_BY_LINEARBUILD YES)
  if(NOT LINEARBUILD_SYSTEM_PROCESSOR STREQUAL ppc64le AND (NOT LINEARBUILD_HOST_WIN32 OR LINEARBUILD_${lang}_COMPILER_VERSION VERSION_LESS 16.3) AND LINEARBUILD_${lang}_COMPILER_VERSION VERSION_LESS 23.3)
    set(_LINEARBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_IPO "-Mipa=fast,inline")
  else()
    set(_LINEARBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)
  endif()

  # Preprocessing and assembly rules.
  set(LINEARBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<LINEARBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
  set(LINEARBUILD_${lang}_CREATE_ASSEMBLY_SOURCE "<LINEARBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
endmacro()
