set(LINEARBUILD_OBJCXX_COMPILER_ID_RUN 1)
set(LINEARBUILD_OBJCXX_SOURCE_FILE_EXTENSIONS M;m;mm)
set(LINEARBUILD_OBJCXX_IGNORE_EXTENSIONS inl;h;hpp;HPP;H;o;O)

if (LINEARBUILD_OBJC_COMPILER_ID_RUN)
  foreach(extension IN LISTS LINEARBUILD_OBJC_SOURCE_FILE_EXTENSIONS)
    list(REMOVE_ITEM LINEARBUILD_OBJCXX_SOURCE_FILE_EXTENSIONS ${extension})
  endforeach()
endif()

foreach (lang IN ITEMS C CXX OBJC)
  foreach(extension IN LISTS LINEARBUILD_OBJCXX_SOURCE_FILE_EXTENSIONS)
    if (LINEARBUILD_${lang}_COMPILER_ID_RUN)
      list(REMOVE_ITEM LINEARBUILD_${lang}_SOURCE_FILE_EXTENSIONS ${extension})
    endif()
  endforeach()
endforeach()

