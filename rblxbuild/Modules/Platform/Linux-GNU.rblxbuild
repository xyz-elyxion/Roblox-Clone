# This module is shared by multiple languages; use include blocker.
if(__LINUX_COMPILER_GNU)
  return()
endif()
set(__LINUX_COMPILER_GNU 1)

macro(__linux_compiler_gnu lang)
  # We pass this for historical reasons.  Projects may have
  # executables that use dlopen but do not set ENABLE_EXPORTS.
  set(RBLXBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS "-rdynamic")

  set(RBLXBUILD_${lang}_VERBOSE_LINK_FLAG "-Wl,-v")

  # linker selection
  set(RBLXBUILD_${lang}_USING_LINKER_SYSTEM "")
  set(RBLXBUILD_${lang}_USING_LINKER_LLD "-fuse-ld=lld")
  set(RBLXBUILD_${lang}_USING_LINKER_BFD "-fuse-ld=bfd")
  set(RBLXBUILD_${lang}_USING_LINKER_GOLD "-fuse-ld=gold")
  if(NOT RBLXBUILD_${lang}_COMPILER_ID STREQUAL "GNU"
      OR RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL "12.1")
    set(RBLXBUILD_${lang}_USING_LINKER_MOLD "-fuse-ld=mold")
  endif()
  if(RBLXBUILD_${lang}_COMPILER_ID STREQUAL "Clang")
    set(RBLXBUILD_${lang}_USING_LINKER_WILD "--ld-path=wild")
  elseif(RBLXBUILD_${lang}_COMPILER_ID STREQUAL "GNU"
      AND RBLXBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL "16.0")
    set(RBLXBUILD_${lang}_USING_LINKER_WILD "-fuse-ld=wild")
  endif()
endmacro()
