include(Compiler/NVIDIA)
__compiler_nvidia_cxx_standards(CUDA)
__compiler_nvidia_cuda_flags(CUDA)

set(RBLXBUILD_CUDA_COMPILER_HAS_DEVICE_LINK_PHASE True)

set(_RBLXBUILD_CUDA_WHOLE_FLAG "-c")
set(_RBLXBUILD_CUDA_RDC_FLAG "-rdc=true")
set(_RBLXBUILD_CUDA_PTX_FLAG "-ptx")
set(_RBLXBUILD_CUDA_CUBIN_FLAG "-cubin")
set(_RBLXBUILD_CUDA_FATBIN_FLAG "-fatbin")
if(RBLXBUILD_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL "11.7.0")
  set(_RBLXBUILD_CUDA_OPTIX_FLAG "-optix-ir")
endif()

if(RBLXBUILD_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 11.2)
  set(RBLXBUILD_CUDA_DEVICE_LINK_OPTIONS_IPO " -dlto")
endif()

set(RBLXBUILD_CUDA_DEVICE_COMPILER_WRAPPER_FLAG "-Xcompiler=")
set(RBLXBUILD_CUDA_DEVICE_COMPILER_WRAPPER_FLAG_SEP ",")
set(RBLXBUILD_CUDA_DEVICE_LINKER_WRAPPER_FLAG "-Xlinker=")
set(RBLXBUILD_CUDA_DEVICE_LINKER_WRAPPER_FLAG_SEP ",")

set(RBLXBUILD_CUDA_DEVICE_LINK_MODE DRIVER)
