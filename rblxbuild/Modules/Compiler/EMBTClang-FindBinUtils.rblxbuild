# Runs immediately after RBLXBuildFindBinUtils during compiler determination.
# RBLXBuildFindBinUtils does not match EMBTClang in its Clang/IntelLLVM/LLVMFlang
# regex, so it falls through to the generic branch and finds whatever "ar"
# happens to be on PATH (often a stray ar.exe from MSYS, MinGW, etc.).
# Override RBLXBUILD_AR/RBLXBUILD_RANLIB with the llvm-ar/llvm-ranlib that ship
# alongside bcc64x in the Embarcadero installation.

if(NOT DEFINED _RBLXBUILD_PROCESSING_LANGUAGE OR _RBLXBUILD_PROCESSING_LANGUAGE STREQUAL "")
  message(FATAL_ERROR "Internal error: _RBLXBUILD_PROCESSING_LANGUAGE is not set")
endif()

# The compiler path is fully resolved by this point in the determination
# phase, so get_filename_component yields a real directory.
get_filename_component(__embt_hint
  "${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER}" REALPATH)
get_filename_component(__embt_hint "${__embt_hint}" DIRECTORY)

find_program(__embt_ar NAMES llvm-ar
  HINTS "${__embt_hint}"
  NO_RBLXBUILD_PATH NO_RBLXBUILD_ENVIRONMENT_PATH NO_DEFAULT_PATH)
if(__embt_ar)
  set(RBLXBUILD_AR "${__embt_ar}" CACHE FILEPATH "Archiver" FORCE)
  set(RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_AR "${__embt_ar}"
      CACHE FILEPATH "LLVM archiver" FORCE)
  mark_as_advanced(RBLXBUILD_AR
    RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_AR)
endif()
unset(__embt_ar CACHE)

find_program(__embt_ranlib NAMES llvm-ranlib
  HINTS "${__embt_hint}"
  NO_RBLXBUILD_PATH NO_RBLXBUILD_ENVIRONMENT_PATH NO_DEFAULT_PATH)
if(__embt_ranlib)
  set(RBLXBUILD_RANLIB "${__embt_ranlib}" CACHE FILEPATH "Archive index tool" FORCE)
  set(RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_RANLIB "${__embt_ranlib}"
      CACHE FILEPATH "Generate index for LLVM archive" FORCE)
  mark_as_advanced(RBLXBUILD_RANLIB
    RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_RANLIB)
endif()
unset(__embt_ranlib CACHE)

# Pin the linker and the remaining LLVM binutils that ship beside bcc64x, for the
# same reason as RBLXBUILD_AR above: RBLXBuildFindBinUtils leaves them unset (or, for a
# bare name, resolvable from a stray PATH entry).  Linking itself goes through
# the bcc64x driver, so RBLXBUILD_LINKER is informational (CheckLinkerFlag and the
# like consume it).
foreach(__embt_tool "LINKER=ld.lld" "NM=llvm-nm" "OBJDUMP=llvm-objdump"
                    "STRIP=llvm-strip" "DLLTOOL=llvm-dlltool")
  string(REPLACE "=" ";" __embt_tool "${__embt_tool}")
  list(GET __embt_tool 0 __embt_var)
  list(GET __embt_tool 1 __embt_prog)
  find_program(__embt_found NAMES ${__embt_prog}
    HINTS "${__embt_hint}"
    NO_RBLXBUILD_PATH NO_RBLXBUILD_ENVIRONMENT_PATH NO_DEFAULT_PATH)
  if(__embt_found)
    set(RBLXBUILD_${__embt_var} "${__embt_found}" CACHE FILEPATH "${__embt_prog}" FORCE)
    mark_as_advanced(RBLXBUILD_${__embt_var})
  endif()
  unset(__embt_found CACHE)
endforeach()
unset(__embt_var)
unset(__embt_prog)
unset(__embt_tool)

unset(__embt_hint)
