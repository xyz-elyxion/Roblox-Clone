set(RBLXBUILD_Swift_COMPILER "@RBLXBUILD_Swift_COMPILER@")
set(RBLXBUILD_Swift_COMPILER_ID "@RBLXBUILD_Swift_COMPILER_ID@")
set(RBLXBUILD_Swift_COMPILER_VERSION "@RBLXBUILD_Swift_COMPILER_VERSION@")

set(RBLXBUILD_Swift_COMPILER_LOADED 1)
set(RBLXBUILD_Swift_COMPILER_WORKS "@RBLXBUILD_Swift_COMPILER_WORKS@")

set(RBLXBUILD_Swift_COMPILER_ENV_VAR "SWIFTC")

set(RBLXBUILD_Swift_COMPILER_ID_RUN 1)
set(RBLXBUILD_Swift_SOURCE_FILE_EXTENSIONS swift)

set(RBLXBUILD_Swift_COMPILER_USE_OLD_DRIVER "@RBLXBUILD_Swift_COMPILER_USE_OLD_DRIVER@")

set(RBLXBUILD_Swift_IMPLICIT_INCLUDE_DIRECTORIES "@RBLXBUILD_Swift_IMPLICIT_INCLUDE_DIRECTORIES@")

set(RBLXBUILD_Swift_MODULE_TRIPLE "@RBLXBUILD_Swift_MODULE_TRIPLE@")
set(RBLXBUILD_Swift_SIZEOF_DATA_PTR "@RBLXBUILD_Swift_SIZEOF_DATA_PTR@")

if(NOT RBLXBUILD_SIZEOF_VOID_P AND RBLXBUILD_Swift_SIZEOF_DATA_PTR)
  set(RBLXBUILD_SIZEOF_VOID_P "${RBLXBUILD_Swift_SIZEOF_DATA_PTR}")
endif()
