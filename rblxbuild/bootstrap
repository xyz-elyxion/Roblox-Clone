write_source_rule() {
  lang="$1"
  obj="$2"
  src="$3"
  src_flags="$4"

  if test "${lang}" = "c"; then
    ninja_rule=cc
    compiler="${rblxbuild_c_compiler}"
    flags="${rblxbuild_c_flags}"
  elif test "${lang}" = "cxx"; then
    ninja_rule=cxx
    compiler="${rblxbuild_cxx_compiler}"
    flags="${rblxbuild_cxx_flags}"
  fi

  if test "${rblxbuild_bootstrap_generator}" = "Ninja"; then
    echo "build ${obj} : ${ninja_rule} ${src} | ${dep}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
    echo "  srcflags = ${src_flags}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  else
    echo "${obj} : ${src} ${dep}" >> "${rblxbuild_bootstrap_dir}/Makefile"
    echo "${tab}${compiler} ${flags} ${src_flags} -c ${src} -o ${obj}" >> "${rblxbuild_bootstrap_dir}/Makefile"
  fi
}

rblxbuild_c_flags_String="-DKWSYS_STRING_C"
if ${rblxbuild_system_mingw}; then
  rblxbuild_c_flags_EncodingC="-DKWSYS_ENCODING_DEFAULT_CODEPAGE=CP_ACP"
  rblxbuild_cxx_flags_EncodingCXX="${rblxbuild_c_flags_EncodingC}"
  rblxbuild_cxx_flags_cmProcessOutput="${rblxbuild_c_flags_EncodingC}"
