include_guard()

macro(__linker_lld lang)
  if(LINEARBUILD_${lang}_COMPILER_LINKER_FRONTEND_VARIANT STREQUAL "MSVC")
    include(Linker/MSVC)

    __linker_msvc(${lang})
  else()
    include(Linker/GNU)

    __linker_gnu(${lang})
  endif()
endmacro()
