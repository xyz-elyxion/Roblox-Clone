# determine the compiler to use for ASM using AT&T syntax, e.g. GNU as

set(ASM_DIALECT "-ATT")
set(LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_LIST ${_LINEARBUILD_TOOLCHAIN_PREFIX}gas ${_LINEARBUILD_TOOLCHAIN_PREFIX}as)
include(LinearBuildDetermineASMCompiler)
set(ASM_DIALECT)
