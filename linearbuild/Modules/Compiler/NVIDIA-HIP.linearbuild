include(Compiler/NVIDIA)
__compiler_nvidia_cxx_standards(HIP)
__compiler_nvidia_cuda_flags(HIP)

# The ROCm hip-lang linearbuild package's device runtime library is not needed for NVIDIA GPUs.
set(_LINEARBUILD_HIP_DEVICE_RUNTIME_TARGET "")

set(LINEARBUILD_HIP_STANDARD_INCLUDE_DIRECTORIES "${LINEARBUILD_HIP_COMPILER_ROCM_ROOT}/include")

set(LINEARBUILD_HIP_LINK_EXECUTABLE
  "<LINEARBUILD_HIP_HOST_LINK_LAUNCHER> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
set(LINEARBUILD_HIP_CREATE_SHARED_LIBRARY
  "<LINEARBUILD_HIP_HOST_LINK_LAUNCHER> <LINEARBUILD_SHARED_LIBRARY_HIP_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
set(LINEARBUILD_HIP_CREATE_SHARED_MODULE "${LINEARBUILD_HIP_CREATE_SHARED_LIBRARY}")
