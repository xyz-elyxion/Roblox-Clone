set(LINEARBUILD_Fortran_COMPILER_AR "@LINEARBUILD_Fortran_COMPILER_AR@")
set(LINEARBUILD_RANLIB "@LINEARBUILD_RANLIB@")
set(LINEARBUILD_LINKER "@LINEARBUILD_LINKER@")
set(LINEARBUILD_Fortran_COMPILER_LINKER "@LINEARBUILD_Fortran_COMPILER_LINKER@")
set(LINEARBUILD_Fortran_COMPILER_LINKER_ARCHITECTURE_FLAGS "@LINEARBUILD_Fortran_COMPILER_LINKER_ARCHITECTURE_FLAGS@")
set(LINEARBUILD_Fortran_COMPILER_LINKER_ID "@LINEARBUILD_Fortran_COMPILER_LINKER_ID@")
set(LINEARBUILD_Fortran_COMPILER_LINKER_VERSION "@LINEARBUILD_Fortran_COMPILER_LINKER_VERSION@")
