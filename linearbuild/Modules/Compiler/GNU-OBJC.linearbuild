include(Compiler/GNU)
__compiler_gnu(OBJC)
__compiler_gnu_c_standards(OBJC)


if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND LINEARBUILD_DEPFILE_FLAGS_OBJC)
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_OBJC_DEPFILE_FORMAT gcc)
  set(LINEARBUILD_OBJC_DEPENDS_USE_COMPILER TRUE)
endif()
