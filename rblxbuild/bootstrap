  uv_c_flags="${uv_c_flags} `rblxbuild_escape_shell "-I${rblxbuild_source_dir}/Utilities/cmlibuv/include"`"
  if ${rblxbuild_system_mingw}; then
    uv_c_flags="${uv_c_flags} `rblxbuild_escape_shell "-I${rblxbuild_source_dir}/Utilities/cmlibuv/src/win"`"
  else
    uv_c_flags="${uv_c_flags} `rblxbuild_escape_shell "-I${rblxbuild_source_dir}/Utilities/cmlibuv/src/unix"`"
  fi
  uv_c_flags="${uv_c_flags} `rblxbuild_escape_shell "-I${rblxbuild_source_dir}/Utilities/cmlibuv/src"`"
