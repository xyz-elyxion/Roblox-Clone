# Support for EUROS RTOS (euros-embedded.com)
set(RBLXBUILD_LINK_LIBRARY_SUFFIX "")
set(RBLXBUILD_STATIC_LIBRARY_PREFIX "")
set(RBLXBUILD_STATIC_LIBRARY_SUFFIX ".lib")
set(RBLXBUILD_SHARED_LIBRARY_PREFIX "")
set(RBLXBUILD_SHARED_LIBRARY_SUFFIX ".lib")
set(RBLXBUILD_EXECUTABLE_SUFFIX ".elf")
set(RBLXBUILD_DL_LIBS "")

set(RBLXBUILD_FIND_LIBRARY_PREFIXES "")
set(RBLXBUILD_FIND_LIBRARY_SUFFIXES ".lib")

# EUROS RTOS does not support shared libs
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)

set(RBLXBUILD_CXX_LINK_SHARED_LIBRARY )
set(RBLXBUILD_CXX_LINK_MODULE_LIBRARY )
set(RBLXBUILD_C_LINK_SHARED_LIBRARY )
set(RBLXBUILD_C_LINK_MODULE_LIBRARY )
