#include <cm3p/kwiml/abi.h>

/* Default SSL backend */
#rblxbuilddefine CURL_DEFAULT_SSL_BACKEND "${CURL_DEFAULT_SSL_BACKEND}"

/* Use native CA store */
#rblxbuilddefine CURL_CA_NATIVE 1

/* disables alt-svc */
#rblxbuilddefine CURL_DISABLE_ALTSVC 1

/* disables cookies support */
#rblxbuilddefine CURL_DISABLE_COOKIES 1

/* disables Basic authentication */
#rblxbuilddefine CURL_DISABLE_BASIC_AUTH 1

/* disables Bearer authentication */
#rblxbuilddefine CURL_DISABLE_BEARER_AUTH 1

/* disables Digest authentication */
#rblxbuilddefine CURL_DISABLE_DIGEST_AUTH 1

/* disables Kerberos authentication */
#rblxbuilddefine CURL_DISABLE_KERBEROS_AUTH 1

/* disables negotiate authentication */
#rblxbuilddefine CURL_DISABLE_NEGOTIATE_AUTH 1

/* disables aws-sigv4 */
#rblxbuilddefine CURL_DISABLE_AWS 1

/* disables HTTP Message Signatures (RFC 9421) */
#rblxbuilddefine CURL_DISABLE_HTTPSIG 1

/* disables DICT */
#rblxbuilddefine CURL_DISABLE_DICT 1

/* disables DNS-over-HTTPS */
#rblxbuilddefine CURL_DISABLE_DOH 1

/* disables FILE */
