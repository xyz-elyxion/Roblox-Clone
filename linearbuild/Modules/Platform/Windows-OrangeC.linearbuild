set(LINEARBUILD_LINK_LIBRARY_SUFFIX "")
set(LINEARBUILD_STATIC_LIBRARY_SUFFIX ".l")
set(LINEARBUILD_IMPORT_LIBRARY_SUFFIX ".l")
set(LINEARBUILD_FIND_LIBRARY_PREFIXES "")
set(LINEARBUILD_FIND_LIBRARY_SUFFIXES ".l")

macro(__windows_compiler_orangec lang)
  set(LINEARBUILD_${lang}_CREATE_WIN32_EXE "-Wg")
  set(LINEARBUILD_${lang}_CREATE_CONSOLE_EXE "-Wc")

  if(LINEARBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL "7.0")
    if(NOT LINEARBUILD_RC_COMPILER_INIT)
      set(LINEARBUILD_RC_COMPILER_INIT orc)
    endif()
    enable_language(RC)
  endif()
endmacro()
