include(Compiler/Clang)
__compiler_clang(SYCL)
__compiler_clang_cxx_standards(SYCL)

if(NOT LINEARBUILD_SYCL_COMPILER_ID STREQUAL "AdaptiveCpp")
  set(_LINEARBUILD_SYCL_REQUIRED_FLAG "-fsycl")
  foreach(std IN ITEMS 98 11 14)
    unset(LINEARBUILD_SYCL${std}_STANDARD_COMPILE_OPTION)
    unset(LINEARBUILD_SYCL${std}_EXTENSION_COMPILE_OPTION)
  endforeach()
  if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_GREATER_EQUAL 24)
    set(LINEARBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_ON "-fgpu-rdc")
    set(LINEARBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_OFF "-fno-gpu-rdc")
  endif()
  set(LINEARBUILD_SYCL_COMPILER_HAS_DEVICE_LINK_PHASE FALSE)
endif()

set(LINEARBUILD_SYCL_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN
  "-fvisibility-inlines-hidden")

set(LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND "${LINEARBUILD_SYCL_COMPILER}")
if(LINEARBUILD_SYCL_COMPILER_ARG1)
  separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${LINEARBUILD_SYCL_COMPILER_ARG1}")
  list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
  unset(_COMPILER_ARGS)
endif()
if(LINEARBUILD_SYCL_COMPILER_TARGET)
  if(LINEARBUILD_SYCL_COMPILER_VERSION VERSION_LESS 3.4.0)
    list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
      "-target" "${LINEARBUILD_SYCL_COMPILER_TARGET}")
  else()
    list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
      "--target=${LINEARBUILD_SYCL_COMPILER_TARGET}")
  endif()
endif()
list(APPEND LINEARBUILD_SYCL_COMPILER_PREDEFINES_COMMAND
  ${_LINEARBUILD_SYCL_REQUIRED_FLAG} "-x" "c++" "-w" "-dM" "-E"
  "${LINEARBUILD_ROOT}/Modules/LinearBuildSYCLCompilerABI.sycl")
