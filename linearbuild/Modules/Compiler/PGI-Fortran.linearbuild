include(Compiler/PGI)
__compiler_pgi(Fortran)

set(LINEARBUILD_Fortran_SUBMODULE_SEP "-")
set(LINEARBUILD_Fortran_SUBMODULE_EXT ".mod")

set(LINEARBUILD_Fortran_PREPROCESS_SOURCE
  "<LINEARBUILD_Fortran_COMPILER> -Mpreprocess <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-Mpreprocess")

set(LINEARBUILD_Fortran_FORMAT_FIXED_FLAG "-Mnofreeform")
set(LINEARBUILD_Fortran_FORMAT_FREE_FLAG "-Mfreeform")

string(APPEND LINEARBUILD_Fortran_FLAGS_DEBUG_INIT " -Mbounds")

set(LINEARBUILD_Fortran_MODDIR_FLAG "-module ")
