if(LINEARBUILD_HIP_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_HIP_COMPILER_WORKS TRUE)
  return()
endif()

set(__LINEARBUILD_HIP_FLAGS "${LINEARBUILD_HIP_FLAGS}")

if(LINEARBUILD_HIP_COMPILER_ID STREQUAL "Clang" AND NOT LINEARBUILD_HIP_PLATFORM STREQUAL "spirv")
  string(APPEND LINEARBUILD_HIP_FLAGS " --cuda-host-only")
endif()

include(LinearBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${LINEARBUILD_TRY_COMPILE_TARGET_TYPE})
if(_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older LinearBuild version.
# We now store this in LinearBuildHIPCompiler.linearbuild.
unset(LINEARBUILD_HIP_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into LinearBuildHIPCompiler.linearbuild
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerABI.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_ABI(HIP ${LINEARBUILD_ROOT}/Modules/LinearBuildHIPCompilerABI.hip)
if(LINEARBUILD_HIP_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(LINEARBUILD_HIP_COMPILER_WORKS TRUE)
  message(STATUS "Check for working HIP compiler: ${LINEARBUILD_HIP_COMPILER} - skipped")

  if(LINEARBUILD_HIP_COMPILER_ID STREQUAL "NVIDIA")
    include(Internal/LinearBuildCUDAArchitecturesNative)
    # Run the test binary to get:
    # - LINEARBUILD_HIP_ARCHITECTURES_NATIVE
    linearbuild_cuda_architectures_native(HIP)
  endif()
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected C++ compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_HIP_COMPILER_WORKS)
  PrintTestCompilerStatus("HIP")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testHIPCompilerSource
    "#if !defined(__HIP__) && !defined(__NVCC__)\n"
    "# error \"The LINEARBUILD_HIP_COMPILER is set to a C/CXX compiler\"\n"
    "#endif\n"
    "int main(){return 0;}\n")
  # Clear result from normal variable.
  unset(LINEARBUILD_HIP_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(LINEARBUILD_HIP_COMPILER_WORKS
    SOURCE_FROM_VAR testHIPCompiler.hip __TestCompiler_testHIPCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __LINEARBUILD_HIP_COMPILER_OUTPUT)
  unset(__TestCompiler_testHIPCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT LINEARBUILD_HIP_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__LINEARBUILD_HIP_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The HIP compiler\n  \"${LINEARBUILD_HIP_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "LinearBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

set(LINEARBUILD_HIP_FLAGS "${__LINEARBUILD_HIP_FLAGS}")
unset(__LINEARBUILD_HIP_FLAGS)


# Try to identify the compiler features
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerSupport.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_SUPPORT(HIP)

if(LINEARBUILD_HIP_COMPILER_ID STREQUAL "NVIDIA")
  include(Internal/LinearBuildNVCCFilterImplicitInfo)
  # Match arguments with linearbuild_nvcc_parse_implicit_info call in LinearBuildDetermineHIPCompiler.
  linearbuild_nvcc_filter_implicit_info(HIP LINEARBUILD_HIP_CUDA_)

  include(Internal/LinearBuildCUDAFilterImplicitLibs)
  # Filter out implicit link libraries that should not be passed unconditionally.
  linearbuild_cuda_filter_implicit_libs(LINEARBUILD_HIP_IMPLICIT_LINK_LIBRARIES)
endif()

# Re-configure to save learned information.
configure_file(
  ${LINEARBUILD_ROOT}/Modules/LinearBuildHIPCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildHIPCompiler.linearbuild
  @ONLY
  )
include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildHIPCompiler.linearbuild)

if(LINEARBUILD_HIP_SIZEOF_DATA_PTR)
  foreach(f ${LINEARBUILD_HIP_ABI_FILES})
    include(${f})
  endforeach()
  unset(LINEARBUILD_HIP_ABI_FILES)
endif()

set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__LINEARBUILD_HIP_COMPILER_OUTPUT)
