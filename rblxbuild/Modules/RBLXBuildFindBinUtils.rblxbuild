# search for additional tools required for C/C++ (and other languages ?)
#
# If the internal rblxbuild variable _RBLXBUILD_TOOLCHAIN_PREFIX is set, this is used
# as prefix for the tools (e.g. arm-elf-gcc etc.)
# If the rblxbuild variable _RBLXBUILD_TOOLCHAIN_LOCATION is set, the compiler is
# searched only there. The other tools are at first searched there, then
# also in the default locations.
#
# Sets the following variables:
#   RBLXBUILD_AR
#   RBLXBUILD_RANLIB
#   RBLXBUILD_LINKER
#   RBLXBUILD_MT
#   RBLXBUILD_OBJDUMP
#   RBLXBUILD_STRIP
#   RBLXBUILD_INSTALL_NAME_TOOL

# on UNIX, cygwin and mingw

# Resolve full path of RBLXBUILD_TOOL from user-defined name and SEARCH_PATH.
function(__resolve_tool_path RBLXBUILD_TOOL SEARCH_PATH DOCSTRING)

  if(${RBLXBUILD_TOOL})
    # We only get here if RBLXBUILD_TOOL was
    # specified using -D or a pre-made RBLXBuildCache.txt (e.g. via ctest)
    # or set in RBLXBUILD_TOOLCHAIN_FILE.

    get_filename_component(_RBLXBUILD_USER_TOOL_PATH "${${RBLXBUILD_TOOL}}" DIRECTORY)
    # Is RBLXBUILD_TOOL a user-defined name instead of a full path?
    if(NOT _RBLXBUILD_USER_TOOL_PATH)

      # Find RBLXBUILD_TOOL in the SEARCH_PATH directory by user-defined name.
      find_program(_RBLXBUILD_TOOL_WITH_PATH NO_CACHE NAMES ${${RBLXBUILD_TOOL}} HINTS ${SEARCH_PATH} NO_RBLXBUILD_PATH NO_RBLXBUILD_ENVIRONMENT_PATH)
      if(_RBLXBUILD_TOOL_WITH_PATH)

        # Overwrite RBLXBUILD_TOOL with full path found in SEARCH_PATH.
        set(${RBLXBUILD_TOOL} ${_RBLXBUILD_TOOL_WITH_PATH} PARENT_SCOPE)

        get_property(_RBLXBUILD_TOOL_CACHED CACHE ${RBLXBUILD_TOOL} PROPERTY TYPE)
        # If RBLXBUILD_TOOL is present in the RBLXBuild Cache, then overwrit it as well.
        if(_RBLXBUILD_TOOL_CACHED)
          set(${RBLXBUILD_TOOL} "${_RBLXBUILD_TOOL_WITH_PATH}" CACHE STRING ${DOCSTRING} FORCE)
        endif()

      endif()

    endif()

  endif()

endfunction()

__resolve_tool_path(RBLXBUILD_LINKER "${_RBLXBUILD_TOOLCHAIN_LOCATION}" "Default Linker")
__resolve_tool_path(RBLXBUILD_MT     "${_RBLXBUILD_TOOLCHAIN_LOCATION}" "Default Manifest Tool")

macro(__resolve_linker_path __linker_type __name __search_path __doc)
  if(NOT RBLXBUILD_LINKER_${__linker_type})
    set( RBLXBUILD_LINKER_${__linker_type} "${__name}")
  endif()
  __resolve_tool_path(RBLXBUILD_LINKER_${__linker_type} "${__search_path}" "${__doc}")
endmacro()

set(_RBLXBUILD_TOOL_VARS "")

# if it's the MS C/CXX compiler, search for link
if(("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_SIMULATE_ID}" STREQUAL "xMSVC" AND
   ("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_FRONTEND_VARIANT}" STREQUAL "xMSVC"
     OR NOT "x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Clang|DPClang)$"))
   OR "x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xMSVC"
   OR (RBLXBUILD_HOST_WIN32 AND "x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xPGI")
   OR (RBLXBUILD_HOST_WIN32 AND "x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xNVIDIA")
   OR (RBLXBUILD_HOST_WIN32 AND "x${_RBLXBUILD_PROCESSING_LANGUAGE}" STREQUAL "xISPC")
   OR (RBLXBUILD_GENERATOR MATCHES "Visual Studio"
       AND NOT RBLXBUILD_VS_PLATFORM_NAME STREQUAL "Tegra-Android"))

  # Start with the canonical names.
  set(_RBLXBUILD_LINKER_NAMES "link")
  set(_RBLXBUILD_AR_NAMES "lib")
  set(_RBLXBUILD_MT_NAMES "mt")

  # Prepend toolchain-specific names.
  if("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Clang|DPClang|LLVMFlang)$")
    set(_RBLXBUILD_NM_NAMES "llvm-nm" "nm")
    list(PREPEND _RBLXBUILD_AR_NAMES "llvm-lib")
    if("${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}" VERSION_GREATER_EQUAL 14.0.2 OR
       (RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID STREQUAL "DPClang" AND
        RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION_INTERNAL VERSION_GREATER_EQUAL 14.0.2))
      list(PREPEND _RBLXBUILD_MT_NAMES "llvm-mt")
    endif()
    list(PREPEND _RBLXBUILD_LINKER_NAMES "lld-link")
    list(APPEND _RBLXBUILD_TOOL_VARS NM)
  elseif("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xIntel")
    list(PREPEND _RBLXBUILD_AR_NAMES "xilib")
    list(PREPEND _RBLXBUILD_LINKER_NAMES "xilink")
  endif()

  list(APPEND _RBLXBUILD_TOOL_VARS LINKER MT AR)

  # look-up for possible usable linker
  __resolve_linker_path(LINK "link" "${_RBLXBUILD_TOOLCHAIN_LOCATION}" "link Linker")
  __resolve_linker_path(LLD "lld-link" "${_RBLXBUILD_TOOLCHAIN_LOCATION}" "lld-link Linker")

elseif("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Open)?Watcom$")
  set(_RBLXBUILD_LINKER_NAMES "wlink")
  set(_RBLXBUILD_AR_NAMES "wlib")
  list(APPEND _RBLXBUILD_TOOL_VARS LINKER AR)

elseif("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xPellesC")
  set(_RBLXBUILD_LINKER_NAMES "polink")
  set(_RBLXBUILD_AR_NAMES "polib")
  list(APPEND _RBLXBUILD_TOOL_VARS LINKER AR)

elseif("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^xIAR$")
  # Detect the `<lang>` compiler name
  get_filename_component(__iar_selected_compiler "${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER}" NAME)
  # Strip out the `icc`,`iasm`,`a` prefixes and other `_suffixes leaving only the `<target>`
  string(TOLOWER "${__iar_selected_compiler}" __iar_arch_id)
  string(REGEX REPLACE "^x(icc|iasm|a)|(_.*)$" "" __iar_arch_id "x${__iar_arch_id}")
  # IAR Archive Tool
  set(_RBLXBUILD_AR_NAMES
    "iarchive" "iarchive.exe"
    "xar" "xar.exe"
  )
  # IAR Linker
  set(_RBLXBUILD_LINKER_NAMES
    "ilink${__iar_arch_id}" "ilink${__iar_arch_id}.exe"
    "xlink${__iar_arch_id}" "xlink${__iar_arch_id}.exe"
    "xlink" "xlink.exe"
  )
  # IAR ELF Dumper
  set(_RBLXBUILD_IAR_ELFDUMP_NAMES
    "ielfdump${__iar_arch_id}" "ielfdump${__iar_arch_id}.exe"
  )
  # IAR ELF Tool
  set(_RBLXBUILD_IAR_ELFTOOL_NAMES
    "ielftool" "ielftool.exe"
  )
  # IAR ELF Exe to Object Tool
  set(_RBLXBUILD_IAR_EXE2OBJ_NAMES
    "iexe2obj" "iexe2obj.exe"
  )
  # IAR Object File Manipulator
  set(_RBLXBUILD_IAR_OBJMANIP_NAMES
    "iobjmanip" "iobjmanip.exe"
  )
  # IAR Absolute Symbol Exporter
  set(_RBLXBUILD_IAR_SYMEXPORT_NAMES
    "isymexport" "isymexport.exe"
  )
  # IAR C-STAT Command Line Interface
  set(_RBLXBUILD_IAR_CSTAT_NAMES
    "icstat" "icstat.exe"
  )
  # IAR C-STAT Checks Manifest Handler
  set(_RBLXBUILD_IAR_CHECKS_NAMES
    "ichecks" "ichecks.exe"
  )
  # IAR C-STAT Report Generator
  set(_RBLXBUILD_IAR_REPORT_NAMES
    "ireport" "ireport.exe"
  )
  list(APPEND _RBLXBUILD_TOOL_VARS
    AR LINKER IAR_ELFDUMP IAR_ELFTOOL IAR_EXE2OBJ IAR_OBJMANIP IAR_SYMEXPORT
    IAR_CSTAT IAR_CHECKS IAR_REPORT
  )
  unset(__iar_selected_compiler)
  unset(__iar_arch_id)

# in all other cases search for ar, ranlib, etc.
else()
  if(RBLXBUILD_C_COMPILER_EXTERNAL_TOOLCHAIN)
    set(_RBLXBUILD_TOOLCHAIN_LOCATION ${_RBLXBUILD_TOOLCHAIN_LOCATION} ${RBLXBUILD_C_COMPILER_EXTERNAL_TOOLCHAIN}/bin)
  endif()
  if(RBLXBUILD_CXX_COMPILER_EXTERNAL_TOOLCHAIN)
    set(_RBLXBUILD_TOOLCHAIN_LOCATION ${_RBLXBUILD_TOOLCHAIN_LOCATION} ${RBLXBUILD_CXX_COMPILER_EXTERNAL_TOOLCHAIN}/bin)
  endif()

  # Start with the canonical names.
  set(_RBLXBUILD_AR_NAMES "ar")
  set(_RBLXBUILD_RANLIB_NAMES "ranlib")
  set(_RBLXBUILD_STRIP_NAMES "strip")
  set(_RBLXBUILD_LINKER_NAMES "ld")
  set(_RBLXBUILD_NM_NAMES "nm")
  set(_RBLXBUILD_OBJDUMP_NAMES "objdump")
  set(_RBLXBUILD_OBJCOPY_NAMES "objcopy")
  set(_RBLXBUILD_READELF_NAMES "readelf")
  set(_RBLXBUILD_DLLTOOL_NAMES "dlltool")
  set(_RBLXBUILD_ADDR2LINE_NAMES "addr2line")
  set(_RBLXBUILD_TAPI_NAMES "tapi")

  # Prepend toolchain-specific names.
  if("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Clang|DPClang|IntelLLVM|LLVMFlang)$")
    if("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_SIMULATE_ID}" STREQUAL "xMSVC")
      list(PREPEND _RBLXBUILD_LINKER_NAMES "lld-link")
    elseif(NOT APPLE)
      list(PREPEND _RBLXBUILD_LINKER_NAMES "ld.lld")
    endif()
    # llvm-ar does not generate a symbol table that the Apple ld64 linker accepts.
    if(NOT APPLE)
      list(PREPEND _RBLXBUILD_AR_NAMES "llvm-ar")
    endif()
    list(PREPEND _RBLXBUILD_RANLIB_NAMES "llvm-ranlib")
    # llvm-strip versions prior to 11 require additional flags we do not yet add.
    if("${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}" VERSION_GREATER_EQUAL 11)
      # llvm-strip does not seem to support chained fixup format on macOS correctly.
      if(NOT APPLE)
        list(PREPEND _RBLXBUILD_STRIP_NAMES "llvm-strip")
      endif()
    endif()
    list(PREPEND _RBLXBUILD_NM_NAMES "llvm-nm")
    if("${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}" VERSION_GREATER_EQUAL 9)
      # llvm-objcopy and llvm-objdump on versions prior to 9 did not support everything we need.
      list(PREPEND _RBLXBUILD_OBJCOPY_NAMES "llvm-objcopy")
      list(PREPEND _RBLXBUILD_OBJDUMP_NAMES "llvm-objdump")
    endif()
    list(PREPEND _RBLXBUILD_READELF_NAMES "llvm-readelf")
    list(PREPEND _RBLXBUILD_DLLTOOL_NAMES "llvm-dlltool")
    list(PREPEND _RBLXBUILD_ADDR2LINE_NAMES "llvm-addr2line")
  elseif("${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL ARMClang)
    list(PREPEND _RBLXBUILD_AR_NAMES "armar")
    list(PREPEND _RBLXBUILD_LINKER_NAMES "armlink")
  endif()

  if(EMSCRIPTEN)
    list(PREPEND _RBLXBUILD_AR_NAMES "emar")
    list(PREPEND _RBLXBUILD_RANLIB_NAMES "emranlib")
  endif()

  list(APPEND _RBLXBUILD_TOOL_VARS AR RANLIB STRIP LINKER NM OBJDUMP OBJCOPY READELF DLLTOOL ADDR2LINE TAPI)
endif()

foreach(_RBLXBUILD_TOOL IN LISTS _RBLXBUILD_TOOL_VARS)
  # Build the final list of prefixed/suffixed names.
  set(_RBLXBUILD_${_RBLXBUILD_TOOL}_FIND_NAMES "")
  foreach(_RBLXBUILD_TOOL_NAME IN LISTS _RBLXBUILD_${_RBLXBUILD_TOOL}_NAMES)
    list(APPEND _RBLXBUILD_${_RBLXBUILD_TOOL}_FIND_NAMES
      ${_RBLXBUILD_TOOLCHAIN_PREFIX}${_RBLXBUILD_TOOL_NAME}${_RBLXBUILD_TOOLCHAIN_SUFFIX}
      ${_RBLXBUILD_TOOLCHAIN_PREFIX}${_RBLXBUILD_TOOL_NAME}
      ${_RBLXBUILD_TOOL_NAME}${_RBLXBUILD_TOOLCHAIN_SUFFIX}
      ${_RBLXBUILD_TOOL_NAME}
      )
  endforeach()
  list(REMOVE_DUPLICATES _RBLXBUILD_${_RBLXBUILD_TOOL}_FIND_NAMES)

  find_program(RBLXBUILD_${_RBLXBUILD_TOOL} NAMES ${_RBLXBUILD_${_RBLXBUILD_TOOL}_FIND_NAMES} HINTS ${_RBLXBUILD_TOOLCHAIN_LOCATION} NO_RBLXBUILD_PATH NO_RBLXBUILD_ENVIRONMENT_PATH)
  unset(_RBLXBUILD_${_RBLXBUILD_TOOL}_FIND_NAMES)
endforeach()

if(NOT RBLXBUILD_RANLIB)
    set(RBLXBUILD_RANLIB : CACHE INTERNAL "noop for ranlib")
endif()

if(APPLE AND "TAPI" IN_LIST _RBLXBUILD_TOOL_VARS AND NOT RBLXBUILD_TAPI)
  # try to pick-up from Apple toolchain
  execute_process(COMMAND xcrun --find tapi
    OUTPUT_VARIABLE _xcrun_out
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE _xcrun_failed)
  if(NOT _xcrun_failed AND EXISTS "${_xcrun_out}")
    set_property(CACHE RBLXBUILD_TAPI PROPERTY VALUE "${_xcrun_out}")
  endif()
  unset(_xcrun_out)
  unset(_xcrun_failed)
endif()


if(RBLXBUILD_PLATFORM_HAS_INSTALLNAME)
  find_program(RBLXBUILD_INSTALL_NAME_TOOL NAMES ${_RBLXBUILD_TOOLCHAIN_PREFIX}install_name_tool llvm-install-name-tool HINTS ${_RBLXBUILD_TOOLCHAIN_LOCATION} NO_RBLXBUILD_PATH NO_RBLXBUILD_ENVIRONMENT_PATH)
  if(NOT RBLXBUILD_INSTALL_NAME_TOOL)
    message(FATAL_ERROR "Could not find install_name_tool, please check your installation.")
  endif()

  list(APPEND _RBLXBUILD_TOOL_VARS INSTALL_NAME_TOOL)
endif()

# Mark any tool cache entries as advanced.
foreach(_RBLXBUILD_TOOL IN LISTS _RBLXBUILD_TOOL_VARS)
  get_property(_RBLXBUILD_TOOL_CACHED CACHE RBLXBUILD_${_RBLXBUILD_TOOL} PROPERTY TYPE)
  if(_RBLXBUILD_TOOL_CACHED)
    mark_as_advanced(RBLXBUILD_${_RBLXBUILD_TOOL})
  endif()
  unset(_RBLXBUILD_${_RBLXBUILD_TOOL}_NAMES)
endforeach()
unset(_RBLXBUILD_TOOL_VARS)
unset(_RBLXBUILD_TOOL_CACHED)
unset(_RBLXBUILD_TOOL_NAME)
unset(_RBLXBUILD_TOOL)

if("x${RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^xIAR$")
  # Set for backwards compatibility
  set(RBLXBUILD_IAR_ARCHIVE "${RBLXBUILD_AR}" CACHE FILEPATH "The IAR archiver")
  set(RBLXBUILD_IAR_LINKER "${RBLXBUILD_LINKER}" CACHE FILEPATH "The IAR ILINK linker")
  mark_as_advanced(RBLXBUILD_IAR_LINKER RBLXBUILD_IAR_AR)
endif()
