/* disables GOPHER */
#rblxbuilddefine CURL_DISABLE_GOPHER 1

/* disables headers-api support */
#rblxbuilddefine CURL_DISABLE_HEADERS_API 1

/* disables HSTS support */
#rblxbuilddefine CURL_DISABLE_HSTS 1

/* disables HTTP */
#rblxbuilddefine CURL_DISABLE_HTTP 1

/* disabled all HTTP authentication methods */
#rblxbuilddefine CURL_DISABLE_HTTP_AUTH 1

/* disables IMAP */
#rblxbuilddefine CURL_DISABLE_IMAP 1

/* disables LDAP */
#rblxbuilddefine CURL_DISABLE_LDAP 1

/* disables LDAPS */
#rblxbuilddefine CURL_DISABLE_LDAPS 1

/* disables --libcurl option from the curl tool */
