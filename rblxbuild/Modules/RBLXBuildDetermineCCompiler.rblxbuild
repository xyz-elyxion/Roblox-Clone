# determine the compiler to use for C programs
# NOTE, a generator may set RBLXBUILD_C_COMPILER before
# loading this file to force a compiler.
# use environment variable CC first if defined by user, next use
# the rblxbuild variable RBLXBUILD_GENERATOR_CC which can be defined by a generator
# as a default compiler
# If the internal rblxbuild variable _RBLXBUILD_TOOLCHAIN_PREFIX is set, this is used
# as prefix for the tools (e.g. arm-elf-gcc, arm-elf-ar etc.). This works
# currently with the GNU crosscompilers.
#
# Sets the following variables:
#   RBLXBUILD_C_COMPILER
#   RBLXBUILD_AR
#   RBLXBUILD_RANLIB
#
# If not already set before, it also sets
#   _RBLXBUILD_TOOLCHAIN_PREFIX

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompiler.rblxbuild)

# Load system-specific compiler preferences for this language.
include(Platform/${RBLXBUILD_SYSTEM_NAME}-Determine-C OPTIONAL)
include(Platform/${RBLXBUILD_SYSTEM_NAME}-C OPTIONAL)
if(NOT RBLXBUILD_C_COMPILER_NAMES)
  set(RBLXBUILD_C_COMPILER_NAMES cc)
endif()

if(${RBLXBUILD_GENERATOR} MATCHES "Visual Studio")
elseif("${RBLXBUILD_GENERATOR}" MATCHES "Green Hills MULTI")
elseif("${RBLXBUILD_GENERATOR}" MATCHES "Xcode")
  set(RBLXBUILD_C_COMPILER_XCODE_TYPE sourcecode.c.c)
  _rblxbuild_find_compiler_path(C)
else()
  if(NOT RBLXBUILD_C_COMPILER)
    set(RBLXBUILD_C_COMPILER_INIT NOTFOUND)

    # prefer the environment variable CC
    if(NOT $ENV{CC} STREQUAL "")
      get_filename_component(RBLXBUILD_C_COMPILER_INIT $ENV{CC} PROGRAM PROGRAM_ARGS RBLXBUILD_C_FLAGS_ENV_INIT)
      if(RBLXBUILD_C_FLAGS_ENV_INIT)
        set(RBLXBUILD_C_COMPILER_ARG1 "${RBLXBUILD_C_FLAGS_ENV_INIT}" CACHE STRING "Arguments to C compiler")
      endif()
      if(NOT EXISTS ${RBLXBUILD_C_COMPILER_INIT})
        message(FATAL_ERROR "Could not find the compiler specified in the environment variable CC:\n$ENV{CC}.")
      endif()
    endif()

    # next try prefer the compiler specified by the generator
    if(RBLXBUILD_GENERATOR_CC)
      if(NOT RBLXBUILD_C_COMPILER_INIT)
        set(RBLXBUILD_C_COMPILER_INIT ${RBLXBUILD_GENERATOR_CC})
      endif()
    endif()

    # finally list compilers to try
    if(NOT RBLXBUILD_C_COMPILER_INIT)
      set(RBLXBUILD_C_COMPILER_LIST ${_RBLXBUILD_TOOLCHAIN_PREFIX}cc ${_RBLXBUILD_TOOLCHAIN_PREFIX}gcc cl bcc64x bcc xlc icx clang dpclang)
    endif()

    _rblxbuild_find_compiler(C)

  else()
    _rblxbuild_find_compiler_path(C)
  endif()
  mark_as_advanced(RBLXBUILD_C_COMPILER)

  # Each entry in this list is a set of extra flags to try
  # adding to the compile line to see if it helps produce
  # a valid identification file.
  set(RBLXBUILD_C_COMPILER_ID_TEST_FLAGS_FIRST)
  set(RBLXBUILD_C_COMPILER_ID_TEST_FLAGS
    # Try compiling to an object file only.
    "-c"

    # Try enabling ANSI mode on HP.
    "-Aa"

    # Try compiling K&R-compatible code (needed by Bruce C Compiler).
    "-D__CLASSIC_C__"

    # ARMClang need target options
    "--target=arm-arm-none-eabi -mcpu=cortex-m3"

    # MSVC needs at least one include directory for __has_include to function,
    # but custom toolchains may run MSVC with no INCLUDE env var and no -I flags.
    # Also avoid linking so this works with no LIB env var.
    "-c -I__does_not_exist__"
    )
endif()
if(RBLXBUILD_C_COMPILER_TARGET)
  set(RBLXBUILD_C_COMPILER_ID_TEST_FLAGS_FIRST "-c --target=${RBLXBUILD_C_COMPILER_TARGET}")
endif()
# Build a small source file to identify the compiler.
if(NOT RBLXBUILD_C_COMPILER_ID_RUN)
  set(RBLXBUILD_C_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(RBLXBUILD_C_COMPILER_ID)
  set(RBLXBUILD_C_PLATFORM_ID)
  file(READ ${RBLXBUILD_ROOT}/Modules/RBLXBuildPlatformId.h.in
    RBLXBUILD_C_COMPILER_ID_PLATFORM_CONTENT)

  # The IAR compiler produces weird output.
  # See https://gitlab.kitware.com/rblxbuild/rblxbuild/-/issues/10176#note_153591
  list(APPEND RBLXBUILD_C_COMPILER_ID_VENDORS IAR)
  set(RBLXBUILD_C_COMPILER_ID_VENDOR_FLAGS_IAR )
  set(RBLXBUILD_C_COMPILER_ID_VENDOR_REGEX_IAR "IAR .+ Compiler")

  # Match the link line from xcodebuild output of the form
  #  Ld ...
  #      ...
  #      /path/to/cc ...CompilerIdC/...
  # to extract the compiler front-end for the language.
  set(RBLXBUILD_C_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdC/(\\./)?(CompilerIdC.(framework|xctest|build/[^ \t\r\n]+)/)?CompilerIdC[ \t\n\\\"]")
  set(RBLXBUILD_C_COMPILER_ID_TOOL_MATCH_INDEX 2)

  include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerId.rblxbuild)
  RBLXBUILD_DETERMINE_COMPILER_ID(C CFLAGS RBLXBuildCCompilerId.c)

  _rblxbuild_find_compiler_sysroot(C)

  # Set old compiler and platform id variables.
  if(RBLXBUILD_C_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_COMPILER_IS_GNUCC 1)
  endif()
else()
  if(NOT DEFINED RBLXBUILD_C_COMPILER_FRONTEND_VARIANT)
    # Some toolchain files set our internal RBLXBUILD_C_COMPILER_ID_RUN
    # variable but are not aware of RBLXBUILD_C_COMPILER_FRONTEND_VARIANT.
    # They pre-date our support for the GNU-like variant targeting the
    # MSVC ABI so we do not consider that here.
    if(RBLXBUILD_C_COMPILER_ID STREQUAL "Clang"
      OR "x${RBLXBUILD_C_COMPILER_ID}" STREQUAL "xDPClang"
      OR "x${RBLXBUILD_C_COMPILER_ID}" STREQUAL "xIntelLLVM")
      if("x${RBLXBUILD_C_SIMULATE_ID}" STREQUAL "xMSVC")
        set(RBLXBUILD_C_COMPILER_FRONTEND_VARIANT "MSVC")
      else()
        set(RBLXBUILD_C_COMPILER_FRONTEND_VARIANT "GNU")
      endif()
    else()
      set(RBLXBUILD_C_COMPILER_FRONTEND_VARIANT "")
    endif()
  endif()
endif()

if (NOT _RBLXBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_RBLXBUILD_TOOLCHAIN_LOCATION "${RBLXBUILD_C_COMPILER}" PATH)
endif ()

# If we have a gcc cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-gcc, arm-elf-gcc or i586-mingw32msvc-gcc, optionally
# with a 3-component version number at the end (e.g. arm-eabi-gcc-4.5.2).
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gcc.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"
if (NOT _RBLXBUILD_TOOLCHAIN_PREFIX)

  if(RBLXBUILD_C_COMPILER_ID MATCHES "GNU|Clang|QCC|LCC")
    get_filename_component(COMPILER_BASENAME "${RBLXBUILD_C_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+-)?(dpclang|clang|g?cc)(-cl)?(-?[0-9]+(\\.[0-9]+)*)?(-[^.]+)?(\\.exe)?$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
      set(_RBLXBUILD_TOOLCHAIN_SUFFIX ${RBLXBUILD_MATCH_4})
      set(_RBLXBUILD_COMPILER_SUFFIX ${RBLXBUILD_MATCH_6})
    elseif(RBLXBUILD_C_COMPILER_ID MATCHES "TIClang")
       if (COMPILER_BASENAME MATCHES "^(.+)?clang(\\.exe)?$")
         set(_RBLXBUILD_TOOLCHAIN_PREFIX "${RBLXBUILD_MATCH_1}")
         set(_RBLXBUILD_TOOLCHAIN_SUFFIX "${RBLXBUILD_MATCH_2}")
       endif()
    elseif(RBLXBUILD_C_COMPILER_ID MATCHES "Clang")
      if(RBLXBUILD_C_COMPILER_TARGET)
        set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_C_COMPILER_TARGET}-)
      endif()
    elseif(COMPILER_BASENAME MATCHES "qcc(\\.exe)?$")
      if(RBLXBUILD_C_COMPILER_TARGET MATCHES "gcc_nto([a-z0-9]+_[0-9]+|[^_le]+)(le)?")
        set(_RBLXBUILD_TOOLCHAIN_PREFIX nto${RBLXBUILD_MATCH_1}-)
      endif()
    endif ()

    # if "llvm-" is part of the prefix, remove it, since llvm doesn't have its own binutils
    # but uses the regular ar, objcopy, etc. (instead of llvm-objcopy etc.)
    if ("${_RBLXBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
    endif ()
  elseif(RBLXBUILD_C_COMPILER_ID MATCHES "TI")
    # TI compilers are named e.g. cl6x, cl470 or armcl.exe
    get_filename_component(COMPILER_BASENAME "${RBLXBUILD_C_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+)?cl([^.]+)?(\\.exe)?$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX "${RBLXBUILD_MATCH_1}")
      set(_RBLXBUILD_TOOLCHAIN_SUFFIX "${RBLXBUILD_MATCH_2}")
    endif ()
  endif()

endif ()

set(_RBLXBUILD_PROCESSING_LANGUAGE "C")
include(RBLXBuildFindBinUtils)
include(Compiler/${RBLXBUILD_C_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_RBLXBUILD_PROCESSING_LANGUAGE)

if(RBLXBUILD_C_COMPILER_SYSROOT)
  string(CONCAT _SET_RBLXBUILD_C_COMPILER_SYSROOT
    "set(RBLXBUILD_C_COMPILER_SYSROOT \"${RBLXBUILD_C_COMPILER_SYSROOT}\")\n"
    "set(RBLXBUILD_COMPILER_SYSROOT \"${RBLXBUILD_C_COMPILER_SYSROOT}\")")
else()
  set(_SET_RBLXBUILD_C_COMPILER_SYSROOT "")
endif()

if(MSVC_C_ARCHITECTURE_ID)
  set(SET_MSVC_C_ARCHITECTURE_ID
    "set(MSVC_C_ARCHITECTURE_ID ${MSVC_C_ARCHITECTURE_ID})")
endif()

if(RBLXBUILD_C_MSVC_I18N_DIR)
  set(SET_RBLXBUILD_C_MSVC_I18N_DIR
    "set(RBLXBUILD_C_MSVC_I18N_DIR ${RBLXBUILD_C_MSVC_I18N_DIR})")
endif()

if(RBLXBUILD_C_XCODE_ARCHS)
  set(SET_RBLXBUILD_XCODE_ARCHS
    "set(RBLXBUILD_XCODE_ARCHS \"${RBLXBUILD_C_XCODE_ARCHS}\")")
endif()

# configure variables set in this file for fast reload later on
configure_file(${RBLXBUILD_ROOT}/Modules/RBLXBuildCCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildCCompiler.rblxbuild
  @ONLY
  )
set(RBLXBUILD_C_COMPILER_ENV_VAR "CC")
