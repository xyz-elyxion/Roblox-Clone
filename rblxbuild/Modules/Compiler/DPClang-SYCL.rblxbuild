include(Compiler/DPClang)
__compiler_dpclang(SYCL)

include(Compiler/IntelLLVM-SYCL-DeviceLink)

if(RBLXBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
  set(RBLXBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_ON "-clang:-fgpu-rdc")
  set(RBLXBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_OFF "-clang:-fno-gpu-rdc")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS "-fsycl;-clang:-fsycl-link")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS_WHOLE_ARCHIVE "-clang:-Wl,--whole-archive")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS_NO_WHOLE_ARCHIVE "-clang:-Wl,--no-whole-archive")
endif()
