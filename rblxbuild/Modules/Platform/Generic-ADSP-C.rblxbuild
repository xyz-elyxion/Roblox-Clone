
include(Platform/Generic-ADSP-Common)


set(RBLXBUILD_C_OUTPUT_EXTENSION ".doj")

string(APPEND RBLXBUILD_C_FLAGS_DEBUG_INIT " -g")
string(APPEND RBLXBUILD_C_FLAGS_MINSIZEREL_INIT " ")
string(APPEND RBLXBUILD_C_FLAGS_RELEASE_INIT " ")
string(APPEND RBLXBUILD_C_FLAGS_RELWITHDEBINFO_INIT " ")

set(RBLXBUILD_C_LINKER_WRAPPER_FLAG "-flags-link" " ")
set(RBLXBUILD_C_LINKER_WRAPPER_FLAG_SEP ",")

set(RBLXBUILD_C_CREATE_STATIC_LIBRARY
    "<RBLXBUILD_C_COMPILER> -build-lib -proc ${ADSP_PROCESSOR} -si-revision ${ADSP_PROCESSOR_SILICIUM_REVISION} -o <TARGET> <OBJECTS>")

set(RBLXBUILD_C_LINK_EXECUTABLE
    "<RBLXBUILD_C_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(RBLXBUILD_C_CREATE_SHARED_LIBRARY)
set(RBLXBUILD_C_CREATE_MODULE_LIBRARY)
