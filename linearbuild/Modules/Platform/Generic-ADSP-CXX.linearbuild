include(Platform/Generic-ADSP-Common)

set(LINEARBUILD_CXX_OUTPUT_EXTENSION ".doj")

string(APPEND LINEARBUILD_CXX_FLAGS_DEBUG_INIT " -g")
string(APPEND LINEARBUILD_CXX_FLAGS_MINSIZEREL_INIT " ")
string(APPEND LINEARBUILD_CXX_FLAGS_RELEASE_INIT " ")
string(APPEND LINEARBUILD_CXX_FLAGS_RELWITHDEBINFO_INIT " ")

set(LINEARBUILD_CXX_LINKER_WRAPPER_FLAG "-flags-link" " ")
set(LINEARBUILD_CXX_LINKER_WRAPPER_FLAG_SEP ",")

set(LINEARBUILD_CXX_CREATE_STATIC_LIBRARY
     "<LINEARBUILD_CXX_COMPILER> -build-lib -proc ${ADSP_PROCESSOR} -si-revision ${ADSP_PROCESSOR_SILICIUM_REVISION} -o <TARGET> <OBJECTS>")

set(LINEARBUILD_CXX_LINK_EXECUTABLE
     "<LINEARBUILD_CXX_COMPILER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(LINEARBUILD_CXX_CREATE_SHARED_LIBRARY)
set(LINEARBUILD_CXX_CREATE_MODULE_LIBRARY)
