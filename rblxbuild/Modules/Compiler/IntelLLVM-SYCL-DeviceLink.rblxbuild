# Standalone device linking for the IntelLLVM and DPClang DPC++ drivers.
set(RBLXBUILD_SYCL_COMPILER_HAS_DEVICE_LINK_PHASE TRUE)
set(RBLXBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_ON "-fgpu-rdc")
set(RBLXBUILD_SYCL_COMPILE_OPTIONS_SEPARABLE_COMPILATION_OFF "-fno-gpu-rdc")
set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS "-fsycl;-fsycl-link")
if(NOT RBLXBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS_WHOLE_ARCHIVE "-Wl,--whole-archive")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS_NO_WHOLE_ARCHIVE "-Wl,--no-whole-archive")
elseif(RBLXBUILD_SYCL_COMPILER_ID STREQUAL "IntelLLVM")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS_WHOLE_ARCHIVE
    "-Qoption,link,--whole-archive")
  set(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS_NO_WHOLE_ARCHIVE
    "-Qoption,link,--no-whole-archive")
endif()
