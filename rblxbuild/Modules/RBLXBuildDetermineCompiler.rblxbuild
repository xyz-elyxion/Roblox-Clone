macro(_rblxbuild_find_compiler lang)
  # Use already-enabled languages for reference.
  if(DEFINED _RBLXBUILD_CHECK_ENABLED_LANGUAGES)
    set(_languages "${_RBLXBUILD_CHECK_ENABLED_LANGUAGES}")
  else()
    get_property(_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
  endif()
  list(REMOVE_ITEM _languages "${lang}")

  if(RBLXBUILD_${lang}_COMPILER_INIT)
    # Search only for the specified compiler.
    set(RBLXBUILD_${lang}_COMPILER_LIST "${RBLXBUILD_${lang}_COMPILER_INIT}")
  else()
    # Re-order the compiler list with preferred vendors first.
    set(_${lang}_COMPILER_LIST "${RBLXBUILD_${lang}_COMPILER_LIST}")
    set(RBLXBUILD_${lang}_COMPILER_LIST "")
    # Prefer vendors of compilers from reference languages.
    foreach(l IN LISTS _languages)
      list(APPEND RBLXBUILD_${lang}_COMPILER_LIST
        ${_${lang}_COMPILER_NAMES_${RBLXBUILD_${l}_COMPILER_ID}})
    endforeach()
    # Prefer vendors based on the platform.
    list(APPEND RBLXBUILD_${lang}_COMPILER_LIST ${RBLXBUILD_${lang}_COMPILER_NAMES})
    # Append the rest of the list and remove duplicates.
    list(APPEND RBLXBUILD_${lang}_COMPILER_LIST ${_${lang}_COMPILER_LIST})
    unset(_${lang}_COMPILER_LIST)
    list(REMOVE_DUPLICATES RBLXBUILD_${lang}_COMPILER_LIST)
    if(RBLXBUILD_${lang}_COMPILER_EXCLUDE)
      list(REMOVE_ITEM RBLXBUILD_${lang}_COMPILER_LIST
        ${RBLXBUILD_${lang}_COMPILER_EXCLUDE})
    endif()
  endif()

  # Look for directories containing compilers of reference languages.
  set(_${lang}_COMPILER_HINTS "${RBLXBUILD_${lang}_COMPILER_HINTS}")
  foreach(l IN LISTS _languages)
    if(RBLXBUILD_${l}_COMPILER AND IS_ABSOLUTE "${RBLXBUILD_${l}_COMPILER}")
      get_filename_component(_hint "${RBLXBUILD_${l}_COMPILER}" PATH)
      if(IS_DIRECTORY "${_hint}")
        list(APPEND _${lang}_COMPILER_HINTS "${_hint}")
      endif()
      unset(_hint)
    endif()
  endforeach()

  # Find the compiler.
  if(_${lang}_COMPILER_HINTS)
    # Prefer directories containing compilers of reference languages.
    list(REMOVE_DUPLICATES _${lang}_COMPILER_HINTS)
    find_program(RBLXBUILD_${lang}_COMPILER
      NAMES ${RBLXBUILD_${lang}_COMPILER_LIST}
      PATHS ${_${lang}_COMPILER_HINTS}
      NO_DEFAULT_PATH
      DOC "${lang} compiler")
  endif()
  if(RBLXBUILD_HOST_WIN32 AND RBLXBUILD_GENERATOR MATCHES "Ninja|MSYS Makefiles|MinGW Makefiles|FASTBuild")
    # On Windows command-line builds, some generators imply a preferred compiler tool.
    # These generators do not, so use the compiler that occurs first in PATH.
    find_program(RBLXBUILD_${lang}_COMPILER
      NAMES ${RBLXBUILD_${lang}_COMPILER_LIST}
      NAMES_PER_DIR
      DOC "${lang} compiler"
      NO_PACKAGE_ROOT_PATH
      NO_RBLXBUILD_PATH
      NO_RBLXBUILD_ENVIRONMENT_PATH
      NO_RBLXBUILD_SYSTEM_PATH
      )
  endif()
  find_program(RBLXBUILD_${lang}_COMPILER NAMES ${RBLXBUILD_${lang}_COMPILER_LIST} DOC "${lang} compiler")
  if(_RBLXBUILD_${lang}_COMPILER_PATHS)
    # As a last fall-back, search in language-specific paths
    find_program(RBLXBUILD_${lang}_COMPILER
      NAMES ${RBLXBUILD_${lang}_COMPILER_LIST}
      NAMES_PER_DIR
      PATHS ${_RBLXBUILD_${lang}_COMPILER_PATHS}
      DOC "${lang} compiler"
      NO_DEFAULT_PATH
      )
  endif()
  if(RBLXBUILD_${lang}_COMPILER_INIT AND NOT RBLXBUILD_${lang}_COMPILER)
    set_property(CACHE RBLXBUILD_${lang}_COMPILER PROPERTY VALUE "${RBLXBUILD_${lang}_COMPILER_INIT}")
  endif()
  unset(_${lang}_COMPILER_HINTS)
  unset(_languages)
endmacro()

macro(_rblxbuild_find_compiler_path lang)
  if(RBLXBUILD_${lang}_COMPILER)
    # we only get here if RBLXBUILD_${lang}_COMPILER was specified using -D or a pre-made RBLXBuildCache.txt
    # (e.g. via ctest) or set in RBLXBUILD_TOOLCHAIN_FILE
    # if RBLXBUILD_${lang}_COMPILER is a list, use the first item as
    # RBLXBUILD_${lang}_COMPILER and the rest as RBLXBUILD_${lang}_COMPILER_ARG1
    # Otherwise, preserve any existing RBLXBUILD_${lang}_COMPILER_ARG1 that might
    # have been saved by RBLXBuildDetermine${lang}Compiler in a previous run.

    # Necessary for Windows paths to avoid improper escaping of backslashes
    rblxbuild_path(CONVERT "${RBLXBUILD_${lang}_COMPILER}" TO_RBLXBUILD_PATH_LIST RBLXBUILD_${lang}_COMPILER NORMALIZE)

    list(LENGTH RBLXBUILD_${lang}_COMPILER _RBLXBUILD_${lang}_COMPILER_LENGTH)
    if(_RBLXBUILD_${lang}_COMPILER_LENGTH GREATER 1)
      set(RBLXBUILD_${lang}_COMPILER_ARG1 "${RBLXBUILD_${lang}_COMPILER}")
      list(POP_FRONT RBLXBUILD_${lang}_COMPILER_ARG1 RBLXBUILD_${lang}_COMPILER)
      list(JOIN RBLXBUILD_${lang}_COMPILER_ARG1 " " RBLXBUILD_${lang}_COMPILER_ARG1)
    endif()
    unset(_RBLXBUILD_${lang}_COMPILER_LENGTH)

    # find the compiler in the PATH if necessary
    # if compiler (and arguments) comes from cache then synchronize cache with updated RBLXBUILD_<LANG>_COMPILER
    get_filename_component(_RBLXBUILD_USER_${lang}_COMPILER_PATH "${RBLXBUILD_${lang}_COMPILER}" PATH)
    if(NOT _RBLXBUILD_USER_${lang}_COMPILER_PATH)
      find_program(RBLXBUILD_${lang}_COMPILER_WITH_PATH NO_CACHE NAMES ${RBLXBUILD_${lang}_COMPILER})
      if(RBLXBUILD_${lang}_COMPILER_WITH_PATH)
        set(RBLXBUILD_${lang}_COMPILER ${RBLXBUILD_${lang}_COMPILER_WITH_PATH})
        get_property(_RBLXBUILD_${lang}_COMPILER_CACHED CACHE RBLXBUILD_${lang}_COMPILER PROPERTY TYPE)
        if(_RBLXBUILD_${lang}_COMPILER_CACHED)
          set(RBLXBUILD_${lang}_COMPILER "${RBLXBUILD_${lang}_COMPILER}" CACHE STRING "${lang} compiler" FORCE)
        endif()
        unset(_RBLXBUILD_${lang}_COMPILER_CACHED)
      endif()
    elseif (EXISTS ${RBLXBUILD_${lang}_COMPILER})
      get_property(_RBLXBUILD_${lang}_COMPILER_CACHED CACHE RBLXBUILD_${lang}_COMPILER PROPERTY TYPE)
      if(_RBLXBUILD_${lang}_COMPILER_CACHED)
        set(RBLXBUILD_${lang}_COMPILER "${RBLXBUILD_${lang}_COMPILER}" CACHE STRING "${lang} compiler" FORCE)
      endif()
      unset(_RBLXBUILD_${lang}_COMPILER_CACHED)
    endif()
  endif()
endmacro()

function(_rblxbuild_find_compiler_sysroot lang)
  if(RBLXBUILD_${lang}_COMPILER_ID STREQUAL "GNU" OR RBLXBUILD_${lang}_COMPILER_ID STREQUAL "LCC")
    execute_process(COMMAND "${RBLXBUILD_${lang}_COMPILER}" -print-sysroot
      OUTPUT_STRIP_TRAILING_WHITESPACE
      OUTPUT_VARIABLE _rblxbuild_sysroot_run_out
      ERROR_VARIABLE _rblxbuild_sysroot_run_err
      RESULT_VARIABLE _rblxbuild_sysroot_run_res
    )

    if(_rblxbuild_sysroot_run_res EQUAL 0
        AND _rblxbuild_sysroot_run_out
        AND NOT _rblxbuild_sysroot_run_err
        AND NOT _rblxbuild_sysroot_run_out STREQUAL "/"
        AND IS_DIRECTORY "${_rblxbuild_sysroot_run_out}/usr")
      file(TO_RBLXBUILD_PATH "${_rblxbuild_sysroot_run_out}/usr" _rblxbuild_sysroot_run_out_usr)
      set(RBLXBUILD_${lang}_COMPILER_SYSROOT "${_rblxbuild_sysroot_run_out_usr}" PARENT_SCOPE)
    else()
      set(RBLXBUILD_${lang}_COMPILER_SYSROOT "" PARENT_SCOPE)
    endif()
  endif()
endfunction()
