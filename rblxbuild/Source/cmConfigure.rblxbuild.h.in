#define RBLXBUILD_DATA_DIR "/@RBLXBUILD_DATA_DIR@"
#define RBLXBUILD_DOC_DIR "/@RBLXBUILD_DOC_DIR@"

#define CM_FALLTHROUGH cmsys_FALLTHROUGH

