# This module is shared by multiple languages; use include blocker.
include_guard()

set(RBLXBUILD_BUILD_TYPE_INIT Debug)

string(APPEND RBLXBUILD_EXE_LINKER_FLAGS_INIT " system linux opt noextension")
string(APPEND RBLXBUILD_MODULE_LINKER_FLAGS_INIT " system linux")
string(APPEND RBLXBUILD_SHARED_LINKER_FLAGS_INIT " system linux")

rblxbuild_policy(GET CMP0136 __LINUX_WATCOM_CMP0136)
if(__LINUX_WATCOM_CMP0136 STREQUAL "NEW")
  set(RBLXBUILD_WATCOM_RUNTIME_LIBRARY_DEFAULT "SingleThreaded")
else()
  set(RBLXBUILD_WATCOM_RUNTIME_LIBRARY_DEFAULT "")
endif()
unset(__LINUX_WATCOM_CMP0136)

# single/multi-threaded                 /-bm
# default is setup for single-threaded libraries
string(APPEND RBLXBUILD_C_FLAGS_INIT " -bt=linux")
string(APPEND RBLXBUILD_CXX_FLAGS_INIT " -bt=linux -xs")

macro(__linux_open_watcom lang)
  if(RBLXBUILD_CROSSCOMPILING)
    if(NOT RBLXBUILD_${lang}_STANDARD_INCLUDE_DIRECTORIES)
      set(RBLXBUILD_${lang}_STANDARD_INCLUDE_DIRECTORIES $ENV{WATCOM}/lh)
    endif()
  endif()
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_SingleThreaded         "")
  set(RBLXBUILD_${lang}_COMPILE_OPTIONS_WATCOM_RUNTIME_LIBRARY_MultiThreaded          -bm)
endmacro()
