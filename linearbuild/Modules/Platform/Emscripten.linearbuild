# Emscripten provides a combined toolchain file and platform module
# that predates LinearBuild upstream support.  As a toolchain file it sets
# LINEARBUILD_SYSTEM_VERSION to 1 and points LINEARBUILD_MODULE_PATH to itself.
# Include it here to preserve its role as a platform module.
if(LINEARBUILD_SYSTEM_VERSION EQUAL 1 AND LINEARBUILD_MODULE_PATH)
  find_file(_EMSCRIPTEN_PLATFORM_MODULE NAMES "Platform/Emscripten.linearbuild"
    NO_CACHE NO_DEFAULT_PATH NO_LINEARBUILD_FIND_ROOT_PATH PATHS ${LINEARBUILD_MODULE_PATH})
  if(_EMSCRIPTEN_PLATFORM_MODULE)
    include("${_EMSCRIPTEN_PLATFORM_MODULE}")
    unset(_EMSCRIPTEN_PLATFORM_MODULE)
    return()
  endif()
  unset(_EMSCRIPTEN_PLATFORM_MODULE)
endif()

set(LINEARBUILD_SHARED_LIBRARY_LINK_C_WITH_RUNTIME_PATH ON)

set(LINEARBUILD_SHARED_LIBRARY_SUFFIX ".wasm")
set(LINEARBUILD_EXECUTABLE_SUFFIX ".js")

set(LINEARBUILD_DL_LIBS "")
