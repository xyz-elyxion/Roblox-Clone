if(RBLXBUILD_OBJC_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(RBLXBUILD_OBJC_COMPILER_WORKS TRUE)
  return()
endif()

include(RBLXBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${RBLXBUILD_TRY_COMPILE_TARGET_TYPE})
if(_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older RBLXBuild version.
# We now store this in RBLXBuildCCompiler.rblxbuild.
unset(RBLXBUILD_OBJC_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into RBLXBuildOBJCCompiler.rblxbuild
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerABI.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_ABI(OBJC ${RBLXBUILD_ROOT}/Modules/RBLXBuildOBJCCompilerABI.m)
if(RBLXBUILD_OBJC_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(RBLXBUILD_OBJC_COMPILER_WORKS TRUE)
  message(STATUS "Check for working OBJC compiler: ${RBLXBUILD_OBJC_COMPILER} - skipped")
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that that selected Objective-C compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and rblxbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT RBLXBUILD_OBJC_COMPILER_WORKS)
  PrintTestCompilerStatus("OBJC")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testObjCCompilerSource
    "#ifdef __cplusplus\n"
    "# error \"The RBLXBUILD_OBJC_COMPILER is set to a C++ compiler\"\n"
    "#endif\n"
    "#ifndef __OBJC__\n"
    "# error \"The RBLXBUILD_OBJC_COMPILER is not an Objective-C compiler\"\n"
    "#endif\n"
    "int main(int argc, char* argv[])\n"
    "{ (void)argv; return argc-1;}\n")
  # Clear result from normal variable.
  unset(RBLXBUILD_OBJC_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(RBLXBUILD_OBJC_COMPILER_WORKS
    SOURCE_FROM_VAR testObjCCompiler.m __TestCompiler_testObjCCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __RBLXBUILD_OBJC_COMPILER_OUTPUT)
  unset(__TestCompiler_testObjCCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT RBLXBUILD_OBJC_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__RBLXBUILD_OBJC_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The Objective-C compiler\n  \"${RBLXBUILD_OBJC_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "RBLXBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerSupport.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_SUPPORT(OBJC)

# Re-configure to save learned information.
configure_file(
  ${RBLXBUILD_ROOT}/Modules/RBLXBuildOBJCCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildOBJCCompiler.rblxbuild
  @ONLY
  )
include(${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildOBJCCompiler.rblxbuild)

if(RBLXBUILD_OBJC_SIZEOF_DATA_PTR)
  foreach(f ${RBLXBUILD_OBJC_ABI_FILES})
    include(${f})
  endforeach()
  unset(RBLXBUILD_OBJC_ABI_FILES)
endif()

set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__RBLXBUILD_OBJC_COMPILER_OUTPUT)
