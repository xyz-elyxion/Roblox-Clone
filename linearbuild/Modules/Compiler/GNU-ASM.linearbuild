# This file is loaded when gcc/g++ is used for assembler files (the "ASM" linearbuild language)
include(Compiler/GNU)

set(LINEARBUILD_ASM_SOURCE_FILE_EXTENSIONS s;S;asm)

__compiler_gnu(ASM)

if(LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_MATCH STREQUAL "GNU assembler")
  set(LINEARBUILD_DEPFILE_FLAGS_ASM${ASM_DIALECT} "--MD <DEP_FILE>")
  set(LINEARBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE
    "<LINEARBUILD_LINKER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
  set(LINEARBUILD_ASM_DEFINE_FLAG "--defsym ")
endif()
