if(RBLXBUILD_ISPC_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(RBLXBUILD_ISPC_COMPILER_WORKS TRUE)
  return()
endif()

include(RBLXBuildTestCompilerCommon)

# Make sure we try to compile as a STATIC_LIBRARY
set(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${RBLXBUILD_TRY_COMPILE_TARGET_TYPE})
set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# # Try to identify the ABI and configure it into RBLXBuildISPCCompiler.rblxbuild
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerABI.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_ABI(ISPC ${RBLXBUILD_ROOT}/Modules/RBLXBuildISPCCompilerABI.ispc)
if(RBLXBUILD_ISPC_ABI_COMPILED)
#   # The compiler worked so skip dedicated test below.
  set(RBLXBUILD_ISPC_COMPILER_WORKS TRUE)
  message(STATUS "Check for working ISPC compiler: ${RBLXBUILD_ISPC_COMPILER} - skipped")
endif()

# Re-configure to save learned information.
configure_file(
  ${RBLXBUILD_ROOT}/Modules/RBLXBuildISPCCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildISPCCompiler.rblxbuild
  @ONLY
  )
include(${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildISPCCompiler.rblxbuild)

if(RBLXBUILD_ISPC_SIZEOF_DATA_PTR)
  foreach(f ${RBLXBUILD_ISPC_ABI_FILES})
    include(${f})
  endforeach()
  unset(RBLXBUILD_ISPC_ABI_FILES)
endif()

set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
