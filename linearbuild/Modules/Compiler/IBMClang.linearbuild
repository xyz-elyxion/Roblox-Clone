# This module is shared by multiple languages; use include blocker.
if(__COMPILER_IBMClang)
  return()
endif()
set(__COMPILER_IBMClang 1)

# Macro to set ibm-clang unique config. This should be called after common
# clang config is included and include only what isn't common.
macro(__compiler_ibmclang lang)
  # Feature flags.
  set(LINEARBUILD_${lang}_VERBOSE_FLAG "-v")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIC "-fPIC")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIE "-fPIC")
  set(LINEARBUILD_${lang}_RESPONSE_FILE_FLAG "@")
  set(LINEARBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "@")

  if(LINEARBUILD_${lang}_COMPILER_TARGET AND "${lang}" STREQUAL "CXX")
    list(APPEND LINEARBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "--target=${LINEARBUILD_${lang}_COMPILER_TARGET}")
  endif()

  # Thin LTO is not yet supported on AIX.
  if(NOT (LINEARBUILD_SYSTEM_NAME STREQUAL "AIX"))
    set(_LINEARBUILD_LTO_THIN TRUE)
  endif()

  if("${lang}" STREQUAL "CXX")
    list(APPEND LINEARBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "-w" "-dM" "-E" "${LINEARBUILD_ROOT}/Modules/LinearBuildCXXCompilerABI.cpp")
  endif()
endmacro()
