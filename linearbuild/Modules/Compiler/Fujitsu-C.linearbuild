include(Compiler/Fujitsu)
__compiler_fujitsu(C)

if(LINEARBUILD_C_COMPILER_VERSION VERSION_GREATER_EQUAL 4)
  set(LINEARBUILD_C90_STANDARD_COMPILE_OPTION  -std=c89)
  set(LINEARBUILD_C90_EXTENSION_COMPILE_OPTION -std=gnu89)
  set(LINEARBUILD_C90_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_C99_STANDARD_COMPILE_OPTION  -std=c99)
  set(LINEARBUILD_C99_EXTENSION_COMPILE_OPTION -std=gnu99)
  set(LINEARBUILD_C99_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_C11_STANDARD_COMPILE_OPTION  -std=c11)
  set(LINEARBUILD_C11_EXTENSION_COMPILE_OPTION -std=gnu11)
  set(LINEARBUILD_C11_STANDARD__HAS_FULL_SUPPORT ON)

  set(LINEARBUILD_C_STANDARD_LATEST 11)
endif()

__compiler_check_default_language_standard(C 4 11)
