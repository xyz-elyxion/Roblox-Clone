/* expat_config.h.rblxbuild.  Based upon generated expat_config.h.in.  */

#ifndef EXPAT_CONFIG_H
#  define EXPAT_CONFIG_H 1

/* 1234 = LIL_ENDIAN, 4321 = BIGENDIAN */
#rblxbuilddefine BYTEORDER @BYTEORDER@

/* Define to 1 if you have the `arc4random' function. */
#rblxbuilddefine HAVE_ARC4RANDOM

/* Define to 1 if you have the `arc4random_buf' function. */
#rblxbuilddefine HAVE_ARC4RANDOM_BUF

/* Define to 1 if you have the <dlfcn.h> header file. */
#rblxbuilddefine HAVE_DLFCN_H

/* Define to 1 if you have the <fcntl.h> header file. */
#rblxbuilddefine HAVE_FCNTL_H

/* Define to 1 if you have the `getpagesize' function. */
#rblxbuilddefine HAVE_GETPAGESIZE

/* Define to 1 if you have the `getrandom' function. */
#rblxbuilddefine HAVE_GETRANDOM

/* Define to 1 if you have the `getentropy' function. */
#rblxbuilddefine HAVE_GETENTROPY

/* Define to 1 if you have the <inttypes.h> header file. */
#rblxbuilddefine HAVE_INTTYPES_H

/* Define to 1 if you have the <memory.h> header file. */
#rblxbuilddefine HAVE_MEMORY_H

/* Define to 1 if you have a working `mmap' system call. */
#rblxbuilddefine HAVE_MMAP

/* Define to 1 if you have the <stdint.h> header file. */
#rblxbuilddefine HAVE_STDINT_H

/* Define to 1 if you have the <stdlib.h> header file. */
#rblxbuilddefine HAVE_STDLIB_H

/* Define to 1 if you have the <strings.h> header file. */
#rblxbuilddefine HAVE_STRINGS_H

/* Define to 1 if you have the <string.h> header file. */
#rblxbuilddefine HAVE_STRING_H

/* Define to 1 if you have `syscall' and `SYS_getrandom'. */
#rblxbuilddefine HAVE_SYSCALL_GETRANDOM

/* Define to 1 if you have the <sys/stat.h> header file. */
#rblxbuilddefine HAVE_SYS_STAT_H

/* Define to 1 if you have the <sys/types.h> header file. */
#rblxbuilddefine HAVE_SYS_TYPES_H

/* Define to 1 if you have the <unistd.h> header file. */
#rblxbuilddefine HAVE_UNISTD_H

/* Define to 1 if you have the ANSI C header files. */
#  ifndef STDC_HEADERS
#rblxbuilddefine STDC_HEADERS
#  endif

/* whether byteorder is bigendian */
#rblxbuilddefine WORDS_BIGENDIAN

/* Define to specify how much context to retain around the current parse
   point, 0 to disable. */
#  define XML_CONTEXT_BYTES 1024

#  if ! defined(_WIN32)
/* Define to include code reading entropy from `/dev/urandom'. */
#rblxbuilddefine XML_DEV_URANDOM
#  endif

/* Define to make parameter entity parsing functionality available. */
/* #undef XML_DTD */

/* Define as 1/0 to enable/disable support for general entities. */
#  define XML_GE 0

/* Define to make XML Namespaces functionality available. */
/* #undef XML_NS */

/* Define to __FUNCTION__ or "" if `__func__' does not conform to ANSI C. */
#  ifdef _MSC_VER
#    define __func__ __FUNCTION__
#  endif

#endif // ndef EXPAT_CONFIG_H
