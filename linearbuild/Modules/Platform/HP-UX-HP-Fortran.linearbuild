include(Platform/HP-UX-HP)
__hpux_compiler_hp(Fortran)

set(LINEARBUILD_Fortran_CREATE_PREPROCESSED_SOURCE "<LINEARBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
set(LINEARBUILD_Fortran_CREATE_ASSEMBLY_SOURCE "<LINEARBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
