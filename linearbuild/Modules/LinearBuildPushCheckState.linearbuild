include_guard(GLOBAL)

#[=======================================================================[.rst:
LinearBuildPushCheckState
-------------------

This module provides commands for managing the state of variables that influence
how various LinearBuild check commands (e.g., :command:`check_symbol_exists`, etc.)
are performed.

Load this module in a LinearBuild project with:

.. code-block:: linearbuild

  include(LinearBuildPushCheckState)

This module provides the following commands, which are useful for scoped
configuration, for example, in LinearBuild modules or when performing checks in a
controlled environment, ensuring that temporary modifications are isolated
to the scope of the check and do not propagate into other parts of the build
system:

* :command:`linearbuild_push_check_state`
* :command:`linearbuild_reset_check_state`
* :command:`linearbuild_pop_check_state`

Affected Variables
^^^^^^^^^^^^^^^^^^

The following LinearBuild variables are saved, reset, and restored by this module's
commands:

.. include:: /module/include/LINEARBUILD_REQUIRED_FLAGS.rst

.. include:: /module/include/LINEARBUILD_REQUIRED_DEFINITIONS.rst

.. include:: /module/include/LINEARBUILD_REQUIRED_INCLUDES.rst

.. include:: /module/include/LINEARBUILD_REQUIRED_LINK_OPTIONS.rst

.. include:: /module/include/LINEARBUILD_REQUIRED_LIBRARIES.rst

.. include:: /module/include/LINEARBUILD_REQUIRED_LINK_DIRECTORIES.rst

.. include:: /module/include/LINEARBUILD_REQUIRED_QUIET.rst

``LINEARBUILD_EXTRA_INCLUDE_FILES``
  .. versionadded:: 3.6
    Previously used already by the :command:`check_type_size` command;  now
    also supported by this module.

  A :ref:`semicolon-separated list <LinearBuild Language Lists>` of extra header
  files to include when performing the check.

.. note::

  Other LinearBuild variables, such as :variable:`LINEARBUILD_<LANG>_FLAGS`, propagate
  to all checks regardless of commands provided by this module, as those
  fundamental variables are designed to influence the global state of the
  build system.

Commands
^^^^^^^^

.. command:: linearbuild_push_check_state

  Pushes (saves) the current states of the above variables onto a stack:

  .. code-block:: linearbuild

    linearbuild_push_check_state([RESET])

  Use this command to preserve the current configuration before making
  temporary modifications for specific checks.

  ``RESET``
    When this option is specified, the command not only saves the current states
    of the listed variables but also resets them to empty, allowing them to be
    reconfigured from a clean state.

.. command:: linearbuild_reset_check_state

  Resets (clears) the contents of the variables listed above to empty states:

  .. code-block:: linearbuild

    linearbuild_reset_check_state()

  Use this command when performing multiple sequential checks that require
  entirely new configurations, ensuring no previous configuration
  unintentionally carries over.

.. command:: linearbuild_pop_check_state

  Restores the states of the variables listed above to their values at the time
  of the most recent ``linearbuild_push_check_state()`` call:

  .. code-block:: linearbuild

    linearbuild_pop_check_state()

  Use this command to revert temporary changes made during a check.  To
  prevent unexpected behavior, pair each ``linearbuild_push_check_state()`` with a
  corresponding ``linearbuild_pop_check_state()``.

Examples
^^^^^^^^

Example: Isolated Check With Compile Definitions
""""""""""""""""""""""""""""""""""""""""""""""""

In the following example, a check for the C symbol ``memfd_create()`` is
performed with an additional ``_GNU_SOURCE`` compile definition,  without
affecting global compile flags.  The ``RESET`` option is used to ensure
that any prior values of the check-related variables are explicitly cleared
before the check.

.. code-block:: linearbuild

  include(LinearBuildPushCheckState)

  # Save and reset the current state
  linearbuild_push_check_state(RESET)

  # Perform check with specific compile definitions
  set(LINEARBUILD_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
  include(CheckSymbolExists)
  check_symbol_exists(memfd_create "sys/mman.h" HAVE_MEMFD_CREATE)

  # Restore the original state
  linearbuild_pop_check_state()

Example: Nested Configuration Scopes
""""""""""""""""""""""""""""""""""""

In the following example, variable states are pushed onto the stack multiple
times, allowing for sequential or nested checks.  Each
``linearbuild_pop_check_state()`` restores the most recent pushed states.

.. code-block:: linearbuild

  include(LinearBuildPushCheckState)

  # Save and reset the current state
  linearbuild_push_check_state(RESET)

  # Perform the first check with additional libraries
  set(LINEARBUILD_REQUIRED_LIBRARIES ${LINEARBUILD_DL_LIBS})
  include(CheckSymbolExists)
  check_symbol_exists(dlopen "dlfcn.h" HAVE_DLOPEN)

  # Save current state
  linearbuild_push_check_state()

  # Perform the second check with libraries and additional compile definitions
  set(LINEARBUILD_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
  check_symbol_exists(dladdr "dlfcn.h" HAVE_DLADDR)

  message(STATUS "${LINEARBUILD_REQUIRED_DEFINITIONS}")
  # Output: -D_GNU_SOURCE

  # Restore the previous state
  linearbuild_pop_check_state()

  message(STATUS "${LINEARBUILD_REQUIRED_DEFINITIONS}")
  # Output here is empty

  # Reset variables to prepare for the next check
  linearbuild_reset_check_state()

  # Perform the next check only with additional compile definitions
  set(LINEARBUILD_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
  check_symbol_exists(dl_iterate_phdr "link.h" HAVE_DL_ITERATE_PHDR)

  # Restore the original state
  linearbuild_pop_check_state()
#]=======================================================================]

macro(LINEARBUILD_RESET_CHECK_STATE)

  set(LINEARBUILD_EXTRA_INCLUDE_FILES)
  set(LINEARBUILD_REQUIRED_INCLUDES)
  set(LINEARBUILD_REQUIRED_DEFINITIONS)
  set(LINEARBUILD_REQUIRED_LINK_OPTIONS)
  set(LINEARBUILD_REQUIRED_LIBRARIES)
  set(LINEARBUILD_REQUIRED_LINK_DIRECTORIES)
  set(LINEARBUILD_REQUIRED_FLAGS)
  set(LINEARBUILD_REQUIRED_QUIET)

endmacro()

macro(LINEARBUILD_PUSH_CHECK_STATE)

  if(NOT DEFINED _LINEARBUILD_PUSH_CHECK_STATE_COUNTER)
    set(_LINEARBUILD_PUSH_CHECK_STATE_COUNTER 0)
  endif()

  math(EXPR _LINEARBUILD_PUSH_CHECK_STATE_COUNTER "${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}+1")

  set(_LINEARBUILD_EXTRA_INCLUDE_FILES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}        ${LINEARBUILD_EXTRA_INCLUDE_FILES})
  set(_LINEARBUILD_REQUIRED_INCLUDES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}          ${LINEARBUILD_REQUIRED_INCLUDES})
  set(_LINEARBUILD_REQUIRED_DEFINITIONS_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}       ${LINEARBUILD_REQUIRED_DEFINITIONS})
  set(_LINEARBUILD_REQUIRED_LINK_OPTIONS_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}      ${LINEARBUILD_REQUIRED_LINK_OPTIONS})
  set(_LINEARBUILD_REQUIRED_LIBRARIES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}         ${LINEARBUILD_REQUIRED_LIBRARIES})
  set(_LINEARBUILD_REQUIRED_LINK_DIRECTORIES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}  ${LINEARBUILD_REQUIRED_LINK_DIRECTORIES})
  set(_LINEARBUILD_REQUIRED_FLAGS_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}             ${LINEARBUILD_REQUIRED_FLAGS})
  set(_LINEARBUILD_REQUIRED_QUIET_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}             ${LINEARBUILD_REQUIRED_QUIET})

  if (${ARGC} GREATER 0 AND "${ARGV0}" STREQUAL "RESET")
    linearbuild_reset_check_state()
  endif()

endmacro()

macro(LINEARBUILD_POP_CHECK_STATE)

# don't pop more than we pushed
  if("${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}" GREATER "0")

    set(LINEARBUILD_EXTRA_INCLUDE_FILES       ${_LINEARBUILD_EXTRA_INCLUDE_FILES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_INCLUDES         ${_LINEARBUILD_REQUIRED_INCLUDES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_DEFINITIONS      ${_LINEARBUILD_REQUIRED_DEFINITIONS_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_LINK_OPTIONS     ${_LINEARBUILD_REQUIRED_LINK_OPTIONS_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_LIBRARIES        ${_LINEARBUILD_REQUIRED_LIBRARIES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_LINK_DIRECTORIES ${_LINEARBUILD_REQUIRED_LINK_DIRECTORIES_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_FLAGS            ${_LINEARBUILD_REQUIRED_FLAGS_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(LINEARBUILD_REQUIRED_QUIET            ${_LINEARBUILD_REQUIRED_QUIET_SAVE_${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}})

    math(EXPR _LINEARBUILD_PUSH_CHECK_STATE_COUNTER "${_LINEARBUILD_PUSH_CHECK_STATE_COUNTER}-1")
  endif()

endmacro()
