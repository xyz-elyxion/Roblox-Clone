# This module is shared by multiple languages; use include blocker.
if(__WINDOWS_INTEL)
  return()
endif()
set(__WINDOWS_INTEL 1)


if (LINEARBUILD_GENERATOR MATCHES "^Ninja")
  # retrieve ninja version to enable dependencies configuration
  # against Ninja capabilities
  execute_process(COMMAND "${LINEARBUILD_MAKE_PROGRAM}" --version
    RESULT_VARIABLE _LINEARBUILD_NINJA_RESULT
    OUTPUT_VARIABLE _LINEARBUILD_NINJA_VERSION
    ERROR_VARIABLE _LINEARBUILD_NINJA_VERSION)
  if (_LINEARBUILD_NINJA_RESULT EQUAL 0 AND _LINEARBUILD_NINJA_VERSION MATCHES "[0-9]+(\\.[0-9]+)*")
    set (_LINEARBUILD_NINJA_VERSION "${LINEARBUILD_MATCH_0}")
  endif()
  unset(_LINEARBUILD_NINJA_RESULT)
endif()

include(Platform/Windows-MSVC)
macro(__windows_compiler_intel lang)
  __windows_compiler_msvc(${lang})
endmacro()
