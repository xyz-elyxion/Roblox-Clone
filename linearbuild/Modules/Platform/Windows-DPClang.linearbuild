include_guard()

macro(__windows_compiler_dpclang lang)
  set(_dpclang_${lang}_version "${LINEARBUILD_${lang}_COMPILER_VERSION}")
  set(LINEARBUILD_${lang}_COMPILER_VERSION "${LINEARBUILD_${lang}_COMPILER_VERSION_INTERNAL}")
  include(Platform/Windows-Clang-${lang})
  set(LINEARBUILD_${lang}_COMPILER_VERSION "${_dpclang_${lang}_version}")
  unset(_dpclang_${lang}_version)
endmacro()
