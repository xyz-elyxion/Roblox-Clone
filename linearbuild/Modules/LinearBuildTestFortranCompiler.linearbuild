if(LINEARBUILD_Fortran_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_Fortran_COMPILER_WORKS TRUE)
  return()
endif()

include(LinearBuildTestCompilerCommon)

# Remove any cached result from an older LinearBuild version.
# We now store this in LinearBuildFortranCompiler.linearbuild.
unset(LINEARBUILD_Fortran_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into LinearBuildFortranCompiler.linearbuild
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerABI.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_ABI(Fortran ${LINEARBUILD_ROOT}/Modules/LinearBuildFortranCompilerABI.F90)
if(LINEARBUILD_Fortran_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(LINEARBUILD_Fortran_COMPILER_WORKS TRUE)
  if (NOT DEFINED LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90)
    set(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90 1)
  endif ()
  message(STATUS "Check for working Fortran compiler: ${LINEARBUILD_Fortran_COMPILER} - skipped")
else()
  linearbuild_determine_compiler_abi(Fortran ${LINEARBUILD_ROOT}/Modules/LinearBuildFortranCompilerABI.F)
  if(LINEARBUILD_Fortran_ABI_COMPILED)
    set(LINEARBUILD_Fortran_COMPILER_WORKS TRUE)
    message(STATUS "Check for working Fortran 77 compiler: ${LINEARBUILD_Fortran_COMPILER} - skipped")
  endif()
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected Fortran compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_Fortran_COMPILER_WORKS)
  PrintTestCompilerStatus("Fortran")
  set(__TestCompiler_testFortranCompilerSource "
        PROGRAM TESTFortran
        PRINT *, 'Hello'
        END
  ")
  # Clear result from normal variable.
  unset(LINEARBUILD_Fortran_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(LINEARBUILD_Fortran_COMPILER_WORKS
    SOURCE_FROM_VAR testFortranCompiler.f __TestCompiler_testFortranCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE OUTPUT)
  unset(__TestCompiler_testFortranCompilerSource)
  if(NOT LINEARBUILD_Fortran_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${OUTPUT}")
    message(FATAL_ERROR "The Fortran compiler\n  \"${LINEARBUILD_Fortran_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "LinearBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Test for Fortran 90 support by using an f90-specific construct.
if(NOT DEFINED LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90)
  message(CHECK_START "Checking whether ${LINEARBUILD_Fortran_COMPILER} supports Fortran 90")
  set(__TestCompiler_testFortranCompilerF90Source "
    PROGRAM TESTFortran90
    integer stop ; stop = 1 ; do while ( stop .eq. 0 ) ; end do
    END PROGRAM TESTFortran90
")
  try_compile(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90
    SOURCE_FROM_VAR testFortranCompilerF90.f90 __TestCompiler_testFortranCompilerF90Source
    OUTPUT_VARIABLE OUTPUT)
  unset(__TestCompiler_testFortranCompilerF90Source)
  if(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90)
    message(CHECK_PASS "yes")
    set(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90 1)
  else()
    message(CHECK_FAIL "no")
    set(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90 0)
  endif()
  unset(LINEARBUILD_Fortran_COMPILER_SUPPORTS_F90 CACHE)
endif()

# Re-configure to save learned information.
configure_file(
  ${LINEARBUILD_ROOT}/Modules/LinearBuildFortranCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildFortranCompiler.linearbuild
  @ONLY
  )
include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildFortranCompiler.linearbuild)

if(LINEARBUILD_Fortran_SIZEOF_DATA_PTR)
  foreach(f ${LINEARBUILD_Fortran_ABI_FILES})
    include(${f})
  endforeach()
  unset(LINEARBUILD_Fortran_ABI_FILES)
endif()
