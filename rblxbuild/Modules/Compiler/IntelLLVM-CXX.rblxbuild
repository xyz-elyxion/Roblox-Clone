include(Compiler/IntelLLVM)
__compiler_intel_llvm(CXX)

if("x${RBLXBUILD_CXX_COMPILER_FRONTEND_VARIANT}" STREQUAL "xMSVC")
  set(RBLXBUILD_CXX_COMPILE_OPTIONS_EXPLICIT_LANGUAGE -TP)
  set(RBLXBUILD_CXX_CLANG_TIDY_DRIVER_MODE "cl")
  set(RBLXBUILD_CXX_INCLUDE_WHAT_YOU_USE_DRIVER_MODE "cl")
  if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
      AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake"
      AND RBLXBUILD_DEPFILE_FLAGS_CXX)
    set(RBLXBUILD_CXX_DEPENDS_USE_COMPILER TRUE)
  endif()
else()
  set(RBLXBUILD_CXX_COMPILE_OPTIONS_EXPLICIT_LANGUAGE -x c++)
  if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
      AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake"
      AND RBLXBUILD_DEPFILE_FLAGS_CXX)
    # dependencies are computed by the compiler itself
    set(RBLXBUILD_CXX_DEPFILE_FORMAT gcc)
    set(RBLXBUILD_CXX_DEPENDS_USE_COMPILER TRUE)
  endif()

  set(RBLXBUILD_CXX_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")

  string(APPEND RBLXBUILD_CXX_FLAGS_MINSIZEREL_INIT " -DNDEBUG")
  string(APPEND RBLXBUILD_CXX_FLAGS_RELEASE_INIT " -DNDEBUG")
  string(APPEND RBLXBUILD_CXX_FLAGS_RELWITHDEBINFO_INIT " -DNDEBUG")
endif()

set(RBLXBUILD_CXX98_STANDARD__HAS_FULL_SUPPORT ON)
set(RBLXBUILD_CXX11_STANDARD__HAS_FULL_SUPPORT ON)
set(RBLXBUILD_CXX14_STANDARD__HAS_FULL_SUPPORT ON)

if(NOT "x${RBLXBUILD_CXX_SIMULATE_ID}" STREQUAL "xMSVC")
  set(RBLXBUILD_CXX98_STANDARD_COMPILE_OPTION  "-std=c++98")
  set(RBLXBUILD_CXX98_EXTENSION_COMPILE_OPTION "-std=gnu++98")

  set(RBLXBUILD_CXX11_STANDARD_COMPILE_OPTION  "-std=c++11")
  set(RBLXBUILD_CXX11_EXTENSION_COMPILE_OPTION "-std=gnu++11")

  set(RBLXBUILD_CXX14_STANDARD_COMPILE_OPTION  "-std=c++14")
  set(RBLXBUILD_CXX14_EXTENSION_COMPILE_OPTION "-std=gnu++14")

  set(RBLXBUILD_CXX17_STANDARD_COMPILE_OPTION  "-std=c++17")
  set(RBLXBUILD_CXX17_EXTENSION_COMPILE_OPTION "-std=gnu++17")

  set(RBLXBUILD_CXX20_STANDARD_COMPILE_OPTION  "-std=c++20")
  set(RBLXBUILD_CXX20_EXTENSION_COMPILE_OPTION "-std=gnu++20")

  set(RBLXBUILD_CXX_STANDARD_LATEST 20)

  if (RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(RBLXBUILD_CXX23_STANDARD_COMPILE_OPTION "-std=c++23")
    set(RBLXBUILD_CXX23_EXTENSION_COMPILE_OPTION "-std=gnu++23")
    set(RBLXBUILD_CXX_STANDARD_LATEST 23)
  elseif(RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 2021.2.0)
    set(RBLXBUILD_CXX23_STANDARD_COMPILE_OPTION  "-std=c++2b")
    set(RBLXBUILD_CXX23_EXTENSION_COMPILE_OPTION "-std=gnu++2b")
    set(RBLXBUILD_CXX_STANDARD_LATEST 23)
  endif()

  if (RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(RBLXBUILD_CXX26_STANDARD_COMPILE_OPTION "-std=c++26")
    set(RBLXBUILD_CXX26_EXTENSION_COMPILE_OPTION "-std=gnu++26")
    set(RBLXBUILD_CXX_STANDARD_LATEST 26)
  endif()
else()
  set(RBLXBUILD_CXX98_STANDARD_COMPILE_OPTION  "")
  set(RBLXBUILD_CXX98_EXTENSION_COMPILE_OPTION "")

  set(RBLXBUILD_CXX11_STANDARD_COMPILE_OPTION  "")
  set(RBLXBUILD_CXX11_EXTENSION_COMPILE_OPTION "")

  set(RBLXBUILD_CXX14_STANDARD_COMPILE_OPTION  "-Qstd:c++14")
  set(RBLXBUILD_CXX14_EXTENSION_COMPILE_OPTION "-Qstd:c++14")

  set(RBLXBUILD_CXX17_STANDARD_COMPILE_OPTION  "-Qstd:c++17")
  set(RBLXBUILD_CXX17_EXTENSION_COMPILE_OPTION "-Qstd:c++17")

  set(RBLXBUILD_CXX20_STANDARD_COMPILE_OPTION  "-Qstd:c++20")
  set(RBLXBUILD_CXX20_EXTENSION_COMPILE_OPTION "-Qstd:c++20")

  set(RBLXBUILD_CXX_STANDARD_LATEST 20)

  if (RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(RBLXBUILD_CXX23_STANDARD_COMPILE_OPTION "-Qstd=c++23")
    set(RBLXBUILD_CXX23_EXTENSION_COMPILE_OPTION "-Qstd=c++23")
    set(RBLXBUILD_CXX_STANDARD_LATEST 23)
  elseif(RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 2021.2.0)
    set(RBLXBUILD_CXX23_STANDARD_COMPILE_OPTION  "-Qstd:c++2b")
    set(RBLXBUILD_CXX23_EXTENSION_COMPILE_OPTION "-Qstd:c++2b")
    set(RBLXBUILD_CXX_STANDARD_LATEST 23)
  endif()

  if (RBLXBUILD_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 2024.0.0)
    set(RBLXBUILD_CXX26_STANDARD_COMPILE_OPTION "-Qstd=c++26")
    set(RBLXBUILD_CXX26_EXTENSION_COMPILE_OPTION "-Qstd=c++26")
    set(RBLXBUILD_CXX_STANDARD_LATEST 26)
  endif()

endif()

__compiler_check_default_language_standard(CXX 2020 14)
