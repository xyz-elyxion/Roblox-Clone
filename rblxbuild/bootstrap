# Display RBLXBuild bootstrap usage
rblxbuild_usage()
{
echo '
Usage: '"$0"' [<options>...] [-- <rblxbuild-options>...]
Options: [defaults in brackets after descriptions]
Configuration:
  --help                  print this message
  --version               only print version information
  --verbose               display more information
  --parallel=n            bootstrap rblxbuild in parallel, where n is
                          number of nodes [1]
  --generator=<generator> generator to use (MSYS Makefiles, Unix Makefiles,
                          or Ninja)
  --enable-ccache         Enable ccache when building rblxbuild
  --init=FILE             load FILE as script to populate cache
  --system-libs           use all system-installed third-party libraries
                          (for use only by package maintainers)
  --no-system-libs        use all rblxbuild-provided third-party libraries
                          (default)
  --system-cppdap         use system-installed cppdap library
  --no-system-cppdap      use rblxbuild-provided cppdap library (default)
  --system-curl           use system-installed curl library (default on macOS)
  --no-system-curl        use rblxbuild-provided curl library (default elsewhere)
  --system-expat          use system-installed expat library
  --no-system-expat       use rblxbuild-provided expat library (default)
  --system-jsoncpp        use system-installed jsoncpp library
  --no-system-jsoncpp     use rblxbuild-provided jsoncpp library (default)
  --system-zlib           use system-installed zlib library
  --no-system-zlib        use rblxbuild-provided zlib library (default)
  --system-bzip2          use system-installed bzip2 library
  --no-system-bzip2       use rblxbuild-provided bzip2 library (default)
  --system-liblzma        use system-installed liblzma library
  --no-system-liblzma     use rblxbuild-provided liblzma library (default)
  --system-nghttp2        use system-installed nghttp2 library
  --no-system-nghttp2     use rblxbuild-provided nghttp2 library (default)
  --system-zstd           use system-installed zstd library
  --no-system-zstd        use rblxbuild-provided zstd library (default)
  --system-libarchive     use system-installed libarchive library
  --no-system-libarchive  use rblxbuild-provided libarchive library (default)
  --system-librhash       use system-installed librhash library
  --no-system-librhash    use rblxbuild-provided librhash library (default)
  --system-libuv          use system-installed libuv library
  --no-system-libuv       use rblxbuild-provided libuv library (default)

  --bootstrap-system-libuv use system-installed libuv library for bootstrap
  --bootstrap-system-jsoncpp use system-installed jsoncpp library for bootstrap
  --bootstrap-system-librhash use system-installed librhash library for bootstrap

  --qt-gui                build the Qt-based GUI (requires Qt >= 4.2)
  --no-qt-gui             do not build the Qt-based GUI (default)
  --qt-qmake=<qmake>      use <qmake> as the qmake executable to find Qt

  --debugger              enable debugger support (default if supported)
  --no-debugger           disable debugger support

  --sphinx-info             build Info manual with Sphinx
  --sphinx-man              build man pages with Sphinx
  --sphinx-html             build html help with Sphinx
  --sphinx-html-copybutton  build html help with the sphinx-copybutton extension
  --sphinx-qthelp           build qch help with Sphinx
  --sphinx-latexpdf         build PDF with Sphinx using LaTeX
  --sphinx-build=<sb>       use <sb> as the sphinx-build executable
  --sphinx-flags=<flags>    pass <flags> to sphinx-build executable

Directory and file names:
  --prefix=PREFIX         install files in tree rooted at PREFIX
                          ['"${rblxbuild_default_prefix}"']
  --bindir=DIR            install binaries in PREFIX/DIR
                          ['"${rblxbuild_bin_dir_default}"']
  --datadir=DIR           install data files in PREFIX/DIR
                          ['"${rblxbuild_data_dir_default}"']
  --docdir=DIR            install documentation files in PREFIX/DIR
                          ['"${rblxbuild_doc_dir_default}"']
  --mandir=DIR            install man pages files in PREFIX/DIR/manN
                          ['"${rblxbuild_man_dir_default}"']
  --xdgdatadir=DIR        install XDG specific files in PREFIX/DIR
                          ['"${rblxbuild_xdgdata_dir_default}"']
'
  exit 10
}

# Display RBLXBuild bootstrap usage
rblxbuild_version_display()
{
  echo "RBLXBuild ${rblxbuild_version}, ${rblxbuild_copyright}"
}

# Display RBLXBuild bootstrap error, display the log file and exit
rblxbuild_error()
{
  res=$1
  shift 1
  echo "---------------------------------------------"
  echo "Error when bootstrapping RBLXBuild:"
  echo "$*"
  echo "---------------------------------------------"
  if test -f rblxbuild_bootstrap.log; then
    echo "Log of errors: `pwd`/rblxbuild_bootstrap.log"
    #cat rblxbuild_bootstrap.log
    echo "---------------------------------------------"
  fi
  exit ${res}
}

rblxbuild_generate_file_tmp ()
{
  OUTFILE="$1"
  TMPFILE="$2"
  if "${_diff}" "$TMPFILE" "$OUTFILE" > /dev/null 2> /dev/null ; then
    rm -f "$TMPFILE"
  else
    mv -f "$TMPFILE" "$OUTFILE"
  fi
}

rblxbuild_generate_file ()
{
  OUTFILE="$1"
  CONTENT="$2"
  echo "$CONTENT" > "$OUTFILE.tmp"
  rblxbuild_generate_file_tmp "$OUTFILE" "$OUTFILE.tmp"
}

# Replace KWSYS_NAMESPACE with cmsys
rblxbuild_replace_string ()
{
  INFILE="$1"
  OUTFILE="$2"
  SEARCHFOR="$3"
  REPLACEWITH="$4"
  if test -f "${INFILE}" || ${rblxbuild_system_openvms}; then
    sed "s/\@${SEARCHFOR}\@/${REPLACEWITH}/g" "${INFILE}" > "${OUTFILE}${_tmp}"
    if test -f "${OUTFILE}${_tmp}"; then
      if "${_diff}" "${OUTFILE}" "${OUTFILE}${_tmp}" > /dev/null 2> /dev/null ; then
        #echo "Files are the same"
        rm -f "${OUTFILE}${_tmp}"
      else
        mv -f "${OUTFILE}${_tmp}" "${OUTFILE}"
      fi
    fi
  else
    rblxbuild_error 1 "Cannot find file ${INFILE}"
  fi
}

rblxbuild_kwsys_config_replace_string ()
{
  INFILE="$1"
  OUTFILE="$2"
  shift 2
  APPEND="$*"
  if test -f "${INFILE}" || ${rblxbuild_system_openvms}; then
    echo "${APPEND}" > "${OUTFILE}${_tmp}"
    sed "/./ {s/\@KWSYS_NAMESPACE\@/cmsys/g;
              s/@KWSYS_BUILD_SHARED@/${KWSYS_BUILD_SHARED}/g;
              s/@KWSYS_LFS_AVAILABLE@/${KWSYS_LFS_AVAILABLE}/g;
              s/@KWSYS_LFS_REQUESTED@/${KWSYS_LFS_REQUESTED}/g;
              s/@KWSYS_NAME_IS_KWSYS@/${KWSYS_NAME_IS_KWSYS}/g;
              s/@KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H@/${KWSYS_CXX_HAS_EXT_STDIO_FILEBUF_H}/g;
             }" "${INFILE}" >> "${OUTFILE}${_tmp}"
    if test -f "${OUTFILE}${_tmp}"; then
      if "${_diff}" "${OUTFILE}" "${OUTFILE}${_tmp}" > /dev/null 2> /dev/null ; then
        #echo "Files are the same"
        rm -f "${OUTFILE}${_tmp}"
      else
        mv -f "${OUTFILE}${_tmp}" "${OUTFILE}"
      fi
    fi
  else
    rblxbuild_error 2 "Cannot find file ${INFILE}"
  fi
}
# Write string into a file
rblxbuild_report ()
{
  FILE=$1
  shift
  echo "$*" >> ${FILE}
}

# Escape spaces in strings for artifacts
rblxbuild_escape_artifact ()
{
  if test "${rblxbuild_bootstrap_generator}" = "Ninja"; then
    echo $1 | sed "s/ /$ /g"
  else
    echo $1 | sed "s/ /\\\\ /g"
  fi
}

# Escape spaces in strings for shell
rblxbuild_escape_shell ()
{
  echo $1 | sed "s/ /\\\\ /g"
}

# Encode object file names.
rblxbuild_obj ()
{
  echo $1 | sed 's/\//-/g' | sed 's/$/\.o/'
}

# Strip prefix from argument
rblxbuild_arg ()
{
  echo "$1" | sed "s/^${2-[^=]*=}//"
}

# Write message to the log
rblxbuild_log ()
{
  echo "$*" >> rblxbuild_bootstrap.log
}

# Return temp file
rblxbuild_tmp_file ()
{
  echo "rblxbuild_bootstrap_$$_test"
}

# Run a compiler test. First argument is compiler, second one are compiler
# flags, third one is test source file to be compiled
rblxbuild_try_run ()
{
  COMPILER=$1
  FLAGS=$2
  TESTFILE=$3
  if test ! -f "${TESTFILE}"; then
    echo "Test file ${TESTFILE} missing. Please verify your RBLXBuild source tree."
    exit 4
  fi
  TMPFILE=`rblxbuild_tmp_file`
  echo "Try: ${COMPILER}"
  echo "Line: ${COMPILER} ${FLAGS} ${TESTFILE} -o ${TMPFILE}"
  echo "----------  file   -----------------------"
  cat "${TESTFILE}"
  echo "------------------------------------------"
  ${COMPILER} ${FLAGS} "${TESTFILE}" -o "${TMPFILE}"
  RES=$?
  if test "${RES}" -ne "0"; then
    echo "Test failed to compile"
    return 1
  fi
  if test ! -f "${TMPFILE}" && test ! -f "${TMPFILE}.exe"; then
    echo "Test failed to produce executable"
    return 2
  fi
  ./${TMPFILE}
  RES=$?
  rm -f "${TMPFILE}"
  if test "${RES}" -ne "0"; then
    echo "Test produced non-zero return code"
    return 3
  fi
  echo "Test succeeded"
  return 0
}

# Run a make test. First argument is the make interpreter.
rblxbuild_try_make ()
{
  MAKE_PROC="$1"
  MAKE_FLAGS="$2"
  echo "Try: ${MAKE_PROC}"
  "${MAKE_PROC}" ${MAKE_FLAGS}
  RES=$?
  if test "${RES}" -ne "0"; then
    echo "${MAKE_PROC} does not work"
    return 1
  fi
  if test ! -f "test" && test ! -f "test.exe"; then
    echo "${COMPILER} does not produce output"
    return 2
  fi
  ./test
  RES=$?
  rm -f "test"
  if test "${RES}" -ne "0"; then
    echo "${MAKE_PROC} produces strange executable"
    return 3
  fi
  echo "${MAKE_PROC} works"
  return 0
}

# Parse arguments
rblxbuild_verbose=
rblxbuild_parallel_make=
rblxbuild_ccache_enabled=
rblxbuild_prefix_dir="${rblxbuild_default_prefix}"
bootstrap_system_libuv=
bootstrap_system_jsoncpp=
bootstrap_system_librhash=
while test $# != 0; do
  case "$1" in
  --prefix=*) dir=`rblxbuild_arg "$1"`
              rblxbuild_prefix_dir=`rblxbuild_fix_slashes "$dir"` ;;
  --parallel=*) rblxbuild_parallel_make=`rblxbuild_arg "$1"` ;;
  --generator=*) rblxbuild_bootstrap_generator=`rblxbuild_arg "$1"` ;;
  --bindir=*) rblxbuild_bin_dir=`rblxbuild_arg "$1"` ;;
  --datadir=*) rblxbuild_data_dir=`rblxbuild_arg "$1"` ;;
  --docdir=*) rblxbuild_doc_dir=`rblxbuild_arg "$1"` ;;
  --mandir=*) rblxbuild_man_dir=`rblxbuild_arg "$1"` ;;
  --xdgdatadir=*) rblxbuild_xdgdata_dir=`rblxbuild_arg "$1"` ;;
  --init=*) rblxbuild_init_file=`rblxbuild_arg "$1"` ;;
  --system-libs) rblxbuild_bootstrap_system_libs="${rblxbuild_bootstrap_system_libs} -DRBLXBUILD_USE_SYSTEM_LIBRARIES=1" ;;
  --no-system-libs) rblxbuild_bootstrap_system_libs="${rblxbuild_bootstrap_system_libs} -DRBLXBUILD_USE_SYSTEM_LIBRARIES=0" ;;
  --system-bzip2|--system-cppdap|--system-curl|--system-expat|--system-jsoncpp|--system-libarchive|--system-librhash|--system-zlib|--system-liblzma|--system-nghttp2|--system-zstd|--system-libuv)
    lib=`rblxbuild_arg "$1" "--system-"`
    rblxbuild_bootstrap_system_libs="${rblxbuild_bootstrap_system_libs} -DRBLXBUILD_USE_SYSTEM_LIBRARY_`rblxbuild_toupper $lib`=1" ;;
  --no-system-bzip2|--no-system-cppdap|--no-system-curl|--no-system-expat|--no-system-jsoncpp|--no-system-libarchive|--no-system-librhash|--no-system-zlib|--no-system-liblzma|--no-system-nghttp2|--no-system-zstd|--no-system-libuv)
    lib=`rblxbuild_arg "$1" "--no-system-"`
    rblxbuild_bootstrap_system_libs="${rblxbuild_bootstrap_system_libs} -DRBLXBUILD_USE_SYSTEM_LIBRARY_`rblxbuild_toupper $lib`=0" ;;
  --bootstrap-system-libuv) bootstrap_system_libuv="1" ;;
  --bootstrap-system-jsoncpp) bootstrap_system_jsoncpp="1" ;;
  --bootstrap-system-librhash) bootstrap_system_librhash="1" ;;
  --qt-gui) rblxbuild_bootstrap_qt_gui="1" ;;
  --no-qt-gui) rblxbuild_bootstrap_qt_gui="0" ;;
  --qt-qmake=*) rblxbuild_bootstrap_qt_qmake=`rblxbuild_arg "$1"` ;;
  --debugger) rblxbuild_bootstrap_debugger="1" ;;
  --no-debugger) rblxbuild_bootstrap_debugger="0" ;;
  --sphinx-info) rblxbuild_sphinx_info="1" ;;
  --sphinx-man) rblxbuild_sphinx_man="1" ;;
  --sphinx-html) rblxbuild_sphinx_html="1" ;;
  --sphinx-html-copybutton) rblxbuild_sphinx_html_copybutton="1" ;;
  --sphinx-qthelp) rblxbuild_sphinx_qthelp="1" ;;
  --sphinx-latexpdf) rblxbuild_sphinx_latexpdf="1" ;;
  --sphinx-build=*) rblxbuild_sphinx_build=`rblxbuild_arg "$1"` ;;
  --sphinx-flags=*) rblxbuild_sphinx_flags=`rblxbuild_arg "$1"` ;;
  --help) rblxbuild_usage ;;
  --version) rblxbuild_version_display ; exit 2 ;;
  --verbose) rblxbuild_verbose=TRUE ;;
  --enable-ccache) rblxbuild_ccache_enabled=TRUE ;;
  CC=*) CC=`rblxbuild_arg "$1"` ;;
  CXX=*) CXX=`rblxbuild_arg "$1"` ;;
  CFLAGS=*) CFLAGS=`rblxbuild_arg "$1"` ;;
  CXXFLAGS=*) CXXFLAGS=`rblxbuild_arg "$1"` ;;
  LDFLAGS=*) LDFLAGS=`rblxbuild_arg "$1"` ;;
  --) shift; break ;;
  *) die "Unknown option: $1" ;;
  esac
  shift
done

# Make sure the generator is valid
case "${rblxbuild_bootstrap_generator}" in
  'MSYS Makefiles'|'Unix Makefiles'|'Ninja') ;;
  *) rblxbuild_error 10 "Invalid generator: ${rblxbuild_bootstrap_generator}"
esac

# If verbose, display some information about bootstrap
if test -n "${rblxbuild_verbose}"; then
  echo "---------------------------------------------"
  echo "Source directory: ${rblxbuild_source_dir}"
  echo "Binary directory: ${rblxbuild_binary_dir}"
  echo "Prefix directory: ${rblxbuild_prefix_dir}"
  echo "System:           ${rblxbuild_system}"
  echo "Generator:        ${rblxbuild_bootstrap_generator}"
  if test "x${rblxbuild_parallel_make}" != "x"; then
    echo "Doing parallel make: ${rblxbuild_parallel_make}"
  fi
  echo ""
fi

echo "---------------------------------------------"
# Get RBLXBuild version
echo "`rblxbuild_version_display`"

# Check for in-source build
rblxbuild_in_source_build=
if test -f "${rblxbuild_binary_dir}/Source/rblxbuild.cxx" &&
     test -f "${rblxbuild_binary_dir}/Source/rblxbuild.h"; then
  if test -n "${rblxbuild_verbose}"; then
    echo "Warning: This is an in-source build"
  fi
  rblxbuild_in_source_build=TRUE
fi

# If this is not an in-source build, then Bootstrap stuff should not exist.
if test -z "${rblxbuild_in_source_build}"; then
  # Did somebody bootstrap in the source tree?
  if test -d "${rblxbuild_source_dir}/Bootstrap${_cmk}"; then
    rblxbuild_error 10 "Found directory \"${rblxbuild_source_dir}/Bootstrap${_cmk}\".
Looks like somebody did bootstrap RBLXBuild in the source tree, but now you are
trying to do bootstrap in the binary tree. Please remove Bootstrap${_cmk}
directory from the source tree."
  fi
  # Is there a cache in the source tree?
  for rblxbuild_problematic_file in ${RBLXBUILD_PROBLEMATIC_FILES}; do
    if test -f "${rblxbuild_source_dir}/${rblxbuild_problematic_file}"; then
      rblxbuild_error 10 "Found \"${rblxbuild_source_dir}/${rblxbuild_problematic_file}\".
Looks like somebody tried to build RBLXBuild in the source tree, but now you are
trying to do bootstrap in the binary tree. Please remove \"${rblxbuild_problematic_file}\"
from the source tree."
    fi
  done
fi

# Make bootstrap directory
test -d "${rblxbuild_bootstrap_dir}" || mkdir "${rblxbuild_bootstrap_dir}"
if test ! -d "${rblxbuild_bootstrap_dir}"; then
  rblxbuild_error 3 "Cannot create directory ${rblxbuild_bootstrap_dir} to bootstrap RBLXBuild."
fi
cd "${rblxbuild_bootstrap_dir}"

test -d "cmsys" || mkdir "cmsys"
if test ! -d "cmsys"; then
  rblxbuild_error 4 "Cannot create directory ${rblxbuild_bootstrap_dir}/cmsys"
fi

# Delete all the bootstrap files
rm -f "${rblxbuild_bootstrap_dir}/rblxbuild_bootstrap.log"
rm -f "${rblxbuild_bootstrap_dir}/cmConfigure.h${_tmp}"
rm -f "${rblxbuild_bootstrap_dir}/cmVersionConfig.h${_tmp}"

# If building in-source, remove any cmConfigure.h that may
# have been created by a previous run of the bootstrap rblxbuild.
if test -n "${rblxbuild_in_source_build}"; then
  rm -f "${rblxbuild_source_dir}/Source/cmConfigure.h"
fi

# If exist compiler flags, set them
rblxbuild_c_flags=${CFLAGS}
rblxbuild_cxx_flags=${CXXFLAGS}
rblxbuild_ld_flags=${LDFLAGS}

# Add generator-specific files
if test "${rblxbuild_bootstrap_generator}" = "Ninja"; then
  RBLXBUILD_CXX_SOURCES="${RBLXBUILD_CXX_SOURCES} \
    cmFortranParserImpl \
    cmGlobalNinjaGenerator \
    cmLocalNinjaGenerator \
    cmNinjaLinkLineComputer \
    cmNinjaLinkLineDeviceComputer \
    cmNinjaNormalTargetGenerator \
    cmNinjaTargetGenerator \
    cmNinjaUtilityTargetGenerator \
    "

  LexerParser_CXX_SOURCES="${LexerParser_CXX_SOURCES} \
    cmFortranLexer \
    cmFortranParser \
    "
else
  RBLXBUILD_CXX_SOURCES="${RBLXBUILD_CXX_SOURCES} \
    cmDepends \
    cmDependsC \
    cmDependsCompiler \
    cmGlobalUnixMakefileGenerator3 \
    cmLocalUnixMakefileGenerator3 \
    cmMakefileExecutableTargetGenerator \
    cmMakefileLibraryTargetGenerator \
    cmMakefileTargetGenerator \
    cmMakefileUtilityTargetGenerator \
    cmProcessTools \
    "
fi

# Add Cygwin-specific flags
if ${rblxbuild_system_cygwin} || ${rblxbuild_system_msys}; then
  rblxbuild_ld_flags="${LDFLAGS} -Wl,--enable-auto-import"
fi

# Add CoreFoundation framework on Darwin
if ${rblxbuild_system_darwin}; then
  rblxbuild_ld_flags="${LDFLAGS} -framework CoreFoundation"
fi

# Add BeOS toolkits...
if ${rblxbuild_system_beos}; then
  rblxbuild_ld_flags="${LDFLAGS} -lroot -lbe"
fi

# Add Haiku toolkits...
if ${rblxbuild_system_haiku}; then
  rblxbuild_ld_flags="${LDFLAGS} -lroot -lbe"
fi

# Add AIX arch-specific link flags.
if ${rblxbuild_system_aix}; then
  if uname -p | grep powerpc >/dev/null 2>&1; then
    rblxbuild_ld_flags="${LDFLAGS} -Wl,-bbigtoc"
  fi
fi

#-----------------------------------------------------------------------------
# Detect known toolchains on some platforms.
rblxbuild_toolchains=''
case "${rblxbuild_system}" in
  *AIX*)   rblxbuild_toolchains='XL GNU' ;;
  *CYGWIN*) rblxbuild_toolchains='GNU' ;;
  *MSYS*) rblxbuild_toolchains='GNU' ;;
  *Darwin*) rblxbuild_toolchains='Clang GNU' ;;
  *Linux*) rblxbuild_toolchains='GNU Clang XL PGI PathScale' ;;
  *MINGW*) rblxbuild_toolchains='GNU' ;;
esac

# Toolchain compiler name table.
rblxbuild_toolchain_Clang_CC='clang'
rblxbuild_toolchain_Clang_CXX='clang++'
rblxbuild_toolchain_GNU_CC='gcc'
rblxbuild_toolchain_GNU_CXX='g++'
rblxbuild_toolchain_PGI_CC='pgcc'
rblxbuild_toolchain_PGI_CXX='pgCC'
rblxbuild_toolchain_PathScale_CC='pathcc'
rblxbuild_toolchain_PathScale_CXX='pathCC'
rblxbuild_toolchain_XL_CC='xlc'
rblxbuild_toolchain_XL_CXX='xlC'

rblxbuild_toolchain_try()
{
  tc="$1"
  TMPFILE=`rblxbuild_tmp_file`

  eval "tc_CC=\${rblxbuild_toolchain_${tc}_CC}"
  echo 'int main() { return 0; }' > "${TMPFILE}.c"
  rblxbuild_try_run "$tc_CC" "" "${TMPFILE}.c" >> rblxbuild_bootstrap.log 2>&1
  tc_result_CC="$?"
  rm -f "${TMPFILE}.c"
  test "${tc_result_CC}" = "0" || return 1

  eval "tc_CXX=\${rblxbuild_toolchain_${tc}_CXX}"
  echo 'int main() { return 0; }' > "${TMPFILE}.cpp"
  rblxbuild_try_run "$tc_CXX" "" "${TMPFILE}.cpp" >> rblxbuild_bootstrap.log 2>&1
  tc_result_CXX="$?"
  rm -f "${TMPFILE}.cpp"
  test "${tc_result_CXX}" = "0" || return 1

  rblxbuild_toolchain="$tc"
}

rblxbuild_toolchain_detect()
{
  rblxbuild_toolchain=
  for tc in ${rblxbuild_toolchains}; do
    echo "Checking for $tc toolchain" >> rblxbuild_bootstrap.log 2>&1
    rblxbuild_toolchain_try "$tc" &&
    echo "Found $tc toolchain" &&
    break
  done
}

if test -z "${CC}" && test -z "${CXX}"; then
  rblxbuild_toolchain_detect
fi

thread_flags=''
case "${rblxbuild_system}" in
  *AIX*)   thread_flags='-pthread' ;;
esac

#-----------------------------------------------------------------------------
# Test C compiler
rblxbuild_c_compiler=

# If CC is set, use that for compiler, otherwise use list of known compilers
if test -n "${rblxbuild_toolchain}"; then
  eval rblxbuild_c_compilers="\${rblxbuild_toolchain_${rblxbuild_toolchain}_CC}"
else
  rblxbuild_c_compilers="${RBLXBUILD_KNOWN_C_COMPILERS}"
fi

rblxbuild_c_compiler_try_set()
{
  test_compiler="$1"
  test_thread_flags="$2"

  # Check if C compiler works
  TMPFILE=`rblxbuild_tmp_file`
  echo '
#ifdef __cplusplus
# error "The RBLXBUILD_C_COMPILER is set to a C++ compiler"
#endif

#if defined(_AIX) && defined(__GNUC__) && !defined(_THREAD_SAFE)
#error "On AIX with GNU we need the -pthread flag."
#endif

#if defined(__sun) && __STDC_VERSION__ < 199901L
#error "On Solaris we need C99."
#endif

#if defined(__hpux) && !(defined(__GNUC__) && ((__GNUC__ * 100) + __GNUC_MINOR__) >= 409)
#error "On HP-UX we need GCC 4.9 or higher."
#endif

#include <stdio.h>

int main(int argc, char* argv[])
{
  printf("%d%c", (argv != 0), (char)0x0a);
  return argc - 1;
}
' > "${TMPFILE}.c"
  for std in 11 99 90; do
    std_flags="`rblxbuild_extract_standard_flags \"${rblxbuild_toolchain}\" C \"${std}\"`"
    for std_flag in '' $std_flags; do
      for thread_flag in '' $test_thread_flags; do
        echo "Checking whether '${test_compiler} ${rblxbuild_c_flags} ${rblxbuild_ld_flags} ${std_flag} ${thread_flag}' works." >> rblxbuild_bootstrap.log 2>&1
        if rblxbuild_try_run "${test_compiler}" "${rblxbuild_c_flags} ${rblxbuild_ld_flags} ${std_flag} ${thread_flag}" \
          "${TMPFILE}.c" >> rblxbuild_bootstrap.log 2>&1; then
          rblxbuild_c_compiler="${test_compiler}"
          rblxbuild_c_flags="${rblxbuild_c_flags} ${std_flag} ${thread_flag}"
          rm -f "${TMPFILE}.c"
          return 0
        fi
      done
    done
  done
  rm -f "${TMPFILE}.c"
  return 1
}

if test -n "${CC}"; then
  rblxbuild_c_compiler_try_set "${CC}" "${thread_flags}"
else
  for compiler in ${rblxbuild_c_compilers}; do
    if rblxbuild_c_compiler_try_set "${compiler}" "${thread_flags}"; then
      break
    fi
  done
fi

if test -z "${rblxbuild_c_compiler}"; then
  rblxbuild_error 6 "Cannot find appropriate C compiler on this system.
Please specify one using environment variable CC.
See rblxbuild_bootstrap.log for compilers attempted.
"
fi
echo "C compiler on this system is: ${rblxbuild_c_compiler} ${rblxbuild_c_flags}"

#-----------------------------------------------------------------------------
# Test CXX compiler
rblxbuild_cxx_compiler=

# On Mac OSX, CC is the same as cc, so make sure not to try CC as c++ compiler.

# If CC is set, use that for compiler, otherwise use list of known compilers
if test -n "${rblxbuild_toolchain}"; then
  eval rblxbuild_cxx_compilers="\${rblxbuild_toolchain_${rblxbuild_toolchain}_CXX}"
else
  rblxbuild_cxx_compilers="${RBLXBUILD_KNOWN_CXX_COMPILERS}"
fi

# Check if C++ compiler works
rblxbuild_cxx_compiler_try_set()
{
  test_compiler="$1"
  test_thread_flags="$2"

  TMPFILE=`rblxbuild_tmp_file`
echo '
#include <iostream>
#include <memory>
#include <unordered_map>

#if __cplusplus < 201103L
#error "Compiler is not in a mode aware of C++11."
#endif

#if defined(_AIX) && defined(__GNUC__) && !defined(_THREAD_SAFE)
#error "On AIX with GNU we need the -pthread flag."
#endif

#if defined(__SUNPRO_CC) && __SUNPRO_CC < 0x5140
#error "SunPro <= 5.13 mode not supported due to bug in move semantics."
#endif

#if defined(__hpux) && !(defined(__GNUC__) && ((__GNUC__ * 100) + __GNUC_MINOR__) >= 409)
#error "On HP-UX we need GCC 4.9 or higher."
#endif

#if __cplusplus > 201103L
#include <iterator>
int check_cxx14()
{
  int a[] = { 0, 1, 2 };
  auto ai = std::cbegin(a);

  int b[] = { 2, 1, 0 };
  auto bi = std::cend(b);

  return *ai + *(bi - 1);
}
#else
int check_cxx14()
{
  return 0;
}
#endif

#if (__cplusplus >= 201703L || defined(__INTEL_COMPILER) && defined(__cpp_deduction_guides))
#include <optional>
template <typename T,
          typename std::invoke_result<decltype(&T::get), T>::type = nullptr>
typename T::pointer get_ptr(T& item)
{
  return item.get();
}

int check_cxx17()
{
  // Intel compiler do not handle correctly 'decltype' inside 'invoke_result'
  std::unique_ptr<int> u(new int(0));
  get_ptr(u);
  std::optional<int> oi = 0;
  return oi.value();
}
#else
int check_cxx17()
{
  return 0;
}
#endif

class Class
{
public:
  int Get() const { return this->Member; }
private:
  int Member = 1;
};
int main()
{
  auto const c = std::unique_ptr<Class>(new Class);
  std::cout << c->Get() << check_cxx14() << check_cxx17() << std::endl;
  return 0;
}
' > "${TMPFILE}.cxx"
  for std in 17 14 11; do
    std_flags="`rblxbuild_extract_standard_flags \"${rblxbuild_toolchain}\" CXX \"${std}\"`"
    for std_flag in '' $std_flags; do
      for thread_flag in '' $test_thread_flags; do
        echo "Checking whether '${test_compiler} ${rblxbuild_cxx_flags} ${rblxbuild_ld_flags} ${std_flag} ${thread_flag}' works." >> rblxbuild_bootstrap.log 2>&1
        if rblxbuild_try_run "${test_compiler}" "${rblxbuild_cxx_flags} ${rblxbuild_ld_flags} ${std_flag} ${thread_flag}" \
          "${TMPFILE}.cxx" >> rblxbuild_bootstrap.log 2>&1; then
          rblxbuild_cxx_compiler="${test_compiler}"
          rblxbuild_cxx_flags="${rblxbuild_cxx_flags} ${std_flag} ${thread_flag} "
          rm -f "${TMPFILE}.cxx"
          return 0
        fi
      done
    done
  done
  rm -f "${TMPFILE}.cxx"
  return 1
}

if test -n "${CXX}"; then
  rblxbuild_cxx_compiler_try_set "${CXX}" "${thread_flags}"
else
  for compiler in ${rblxbuild_cxx_compilers}; do
    if rblxbuild_cxx_compiler_try_set "${compiler}" "${thread_flags}"; then
      break
    fi
  done
fi

if test -z "${rblxbuild_cxx_compiler}"; then
rblxbuild_error 7 "Cannot find a C++ compiler that supports both C++11 and the specified C++ flags.
Please specify one using environment variable CXX.
The C++ flags are \"$rblxbuild_cxx_flags\".
They can be changed using the environment variable CXXFLAGS.
See rblxbuild_bootstrap.log for compilers attempted."
fi
echo "C++ compiler on this system is: ${rblxbuild_cxx_compiler} ${rblxbuild_cxx_flags}"

#-----------------------------------------------------------------------------
# Test CXX features

rblxbuild_cxx_features="make_unique filesystem"

for feature in ${rblxbuild_cxx_features}; do
  eval "rblxbuild_have_cxx_${feature}=0"
  echo "Checking whether '${rblxbuild_cxx_compiler} ${rblxbuild_cxx_flags} ${rblxbuild_ld_flags}' supports '${feature}'." >> rblxbuild_bootstrap.log 2>&1
  if rblxbuild_try_run "${rblxbuild_cxx_compiler}" "${rblxbuild_cxx_flags} ${rblxbuild_ld_flags}" \
                   "${rblxbuild_source_dir}/Source/Checks/cm_cxx_${feature}.cxx" >> rblxbuild_bootstrap.log 2>&1; then
    eval "rblxbuild_have_cxx_${feature}=1"
  fi
done

rblxbuild_have_cxx_features=""
for feature in ${rblxbuild_cxx_features}; do
  feature_variable="rblxbuild_have_cxx_${feature}"
  eval "feature_value=\${${feature_variable}}"
  if test "${feature_value}" -eq "1"; then
    rblxbuild_have_cxx_features="${rblxbuild_have_cxx_features} -DRBLXBuild_HAVE_CXX_`rblxbuild_toupper ${feature}`=${feature_value}"
  fi
done

rblxbuild_generate_file "${rblxbuild_bootstrap_dir}/cmSTL.hxx" ""


