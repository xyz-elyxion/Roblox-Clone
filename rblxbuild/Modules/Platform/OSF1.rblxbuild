set(RBLXBUILD_DL_LIBS "")

if(RBLXBUILD_SYSTEM MATCHES "OSF1-1.[012]")
endif()
if(RBLXBUILD_SYSTEM MATCHES "OSF1-1")
  # OSF/1 1.3 from OSF using ELF, and derivatives, including AD2
  set(RBLXBUILD_C_COMPILE_OPTIONS_PIC "-fpic")
  set(RBLXBUILD_C_COMPILE_OPTIONS_PIE "-fpie")
  set(RBLXBUILD_SHARED_LIBRARY_C_FLAGS "-fpic")     # -pic
  set(RBLXBUILD_SHARED_LIBRARY_CXX_FLAGS "-fpic")   # -pic
endif()



if(RBLXBUILD_SYSTEM MATCHES "OSF1-V")
  set(RBLXBUILD_SHARED_LIBRARY_CREATE_C_FLAGS "-shared -Wl,-expect_unresolved,\\*")       # -shared
  if(RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_CXX_FLAG "-Wl,-rpath,")
  else()
    set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_CXX_FLAG "-rpath ")
  endif()
  if(RBLXBUILD_C_COMPILER_ID STREQUAL "GNU")
    set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG "-Wl,-rpath,")
  else()
    set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG "-rpath ")
  endif()
  set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG_SEP ":")
endif()

set(RBLXBUILD_MAKE_INCLUDE_FROM_ROOT 1) # include $(RBLXBUILD_BINARY_DIR)/...

if(RBLXBUILD_CXX_COMPILER_ID STREQUAL "GNU")
  # include the gcc flags
else ()
  # use default OSF compiler flags
  set (RBLXBUILD_C_FLAGS_INIT "")
  set (RBLXBUILD_C_FLAGS_DEBUG_INIT "-g")
  set (RBLXBUILD_C_FLAGS_MINSIZEREL_INIT "-O2 -DNDEBUG")
  set (RBLXBUILD_C_FLAGS_RELEASE_INIT "-O2 -DNDEBUG")
  set (RBLXBUILD_C_FLAGS_RELWITHDEBINFO_INIT "-O2")
  set (RBLXBUILD_CXX_FLAGS_INIT "")
  set (RBLXBUILD_CXX_FLAGS_DEBUG_INIT "-g")
  set (RBLXBUILD_CXX_FLAGS_MINSIZEREL_INIT "-O2 -DNDEBUG")
  set (RBLXBUILD_CXX_FLAGS_RELEASE_INIT "-O2 -DNDEBUG")
  set (RBLXBUILD_CXX_FLAGS_RELWITHDEBINFO_INIT "-O2")
endif()
include(Platform/UnixPaths)
