include(Compiler/Intel)
__compiler_intel(Fortran)

set(RBLXBUILD_Fortran_SUBMODULE_SEP "@")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".smod")

set(RBLXBUILD_Fortran_MODDIR_FLAG "-module ")
set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-fixed")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-free")

set(RBLXBUILD_Fortran_COMPILE_WITH_DEFINES 1)

set(RBLXBUILD_Fortran_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
set(RBLXBUILD_Fortran_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")

if(RBLXBUILD_HOST_WIN32)
  # MSVC-like
  set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
    "<RBLXBUILD_Fortran_COMPILER> -fpp <DEFINES> <INCLUDES> <FLAGS> -P <SOURCE> -Fi<PREPROCESSED_SOURCE>")
else()
  # GNU-like
  set(RBLXBUILD_Fortran_PREPROCESS_SOURCE
    "<RBLXBUILD_Fortran_COMPILER> -fpp <DEFINES> <INCLUDES> <FLAGS> -P <SOURCE> -o <PREPROCESSED_SOURCE>")
endif()

set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-fpp")
set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-nofpp")
