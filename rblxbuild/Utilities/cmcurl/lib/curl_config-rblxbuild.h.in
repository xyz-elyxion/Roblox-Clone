/* disables POP3 */
#rblxbuilddefine CURL_DISABLE_POP3 1

/* disables built-in progress meter */
#rblxbuilddefine CURL_DISABLE_PROGRESS_METER 1

/* disables proxies */
#rblxbuilddefine CURL_DISABLE_PROXY 1

/* disables IPFS from the curl tool */
#rblxbuilddefine CURL_DISABLE_IPFS 1

/* disables RTSP */
#rblxbuilddefine CURL_DISABLE_RTSP 1

/* disables SHA-512/256 hash algorithm */
#rblxbuilddefine CURL_DISABLE_SHA512_256 1

/* disabled shuffle DNS feature */
#rblxbuilddefine CURL_DISABLE_SHUFFLE_DNS 1

/* disables SMTP */
#rblxbuilddefine CURL_DISABLE_SMTP 1

/* disabled WebSocket */
#rblxbuilddefine CURL_DISABLE_WEBSOCKETS 1

/* disables use of socketpair for curl_multi_poll() */
#rblxbuilddefine CURL_DISABLE_SOCKETPAIR 1

/* disables TELNET */
#rblxbuilddefine CURL_DISABLE_TELNET 1

/* disables TFTP */
#rblxbuilddefine CURL_DISABLE_TFTP 1

/* disables verbose strings */
#rblxbuilddefine CURL_DISABLE_VERBOSE_STRINGS 1

/* disables unsafe CA bundle search on Windows from the curl tool */
