set(ENV{PATH} "@MINGW_PATH@\;$ENV{PATH}")
set(LINEARBUILD_COMMAND_LINE "@ARGS_LINEARBUILD_COMMAND_LINE@")
execute_process(
  COMMAND "@LINEARBUILD_COMMAND@" "-GMinGW Makefiles"
  -DLINEARBUILD_Fortran_COMPILER:PATH=@MINGW_GFORTRAN@
  -DBUILD_SHARED_LIBS=ON
  -DLINEARBUILD_GNUtoMS=ON
  ${LINEARBUILD_COMMAND_LINE}
  "@source_dir@"
  COMMAND_ERROR_IS_FATAL ANY)
