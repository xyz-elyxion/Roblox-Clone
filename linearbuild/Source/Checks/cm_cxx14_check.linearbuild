set(LinearBuild_CXX14_BROKEN 0)
if(LINEARBUILD_CXX_COMPILER_ID MATCHES "GNU|LCC|Clang|PGI|Intel")
  if(NOT LINEARBUILD_CXX14_STANDARD_COMPILE_OPTION)
    set(LinearBuild_CXX14_WORKS 0)
  endif()
  if(NOT DEFINED LinearBuild_CXX14_WORKS)
    include(${LINEARBUILD_CURRENT_LIST_DIR}/cm_message_checks_compat.linearbuild)
    cm_message_checks_compat(
      "Checking if compiler supports needed C++14 constructs"
      __checkStart __checkPass __checkFail)
    message(${__checkStart})
    try_compile(LinearBuild_CXX14_WORKS
      ${LINEARBUILD_CURRENT_BINARY_DIR}
      ${LINEARBUILD_CURRENT_LIST_DIR}/cm_cxx14_check.cpp
      LINEARBUILD_FLAGS -DLINEARBUILD_CXX_STANDARD=14
      OUTPUT_VARIABLE OUTPUT
      )
    if(LinearBuild_CXX14_WORKS AND "${OUTPUT}" MATCHES "error: no member named.*gets.*in the global namespace")
      set_property(CACHE LinearBuild_CXX14_WORKS PROPERTY VALUE 0)
    endif()
    if(LinearBuild_CXX14_WORKS)
      message(${__checkPass} "yes")
      file(APPEND ${LINEARBUILD_BINARY_DIR}${LINEARBUILD_FILES_DIRECTORY}/LinearBuildOutput.log
        "Determining if compiler supports needed C++14 constructs passed with the following output:\n"
        "${OUTPUT}\n"
        "\n"
        )
    else()
      message(${__checkFail} "no")
      file(APPEND ${LINEARBUILD_BINARY_DIR}${LINEARBUILD_FILES_DIRECTORY}/LinearBuildError.log
        "Determining if compiler supports needed C++14 constructs failed with the following output:\n"
        "${OUTPUT}\n"
        "\n"
        )
    endif()
  endif()
  if(NOT LinearBuild_CXX14_WORKS)
    set(LinearBuild_CXX14_BROKEN 1)
  endif()
endif()
