# search for additional tools required for C/C++ (and other languages ?)
#
# If the internal linearbuild variable _LINEARBUILD_TOOLCHAIN_PREFIX is set, this is used
# as prefix for the tools (e.g. arm-elf-gcc etc.)
# If the linearbuild variable _LINEARBUILD_TOOLCHAIN_LOCATION is set, the compiler is
# searched only there. The other tools are at first searched there, then
# also in the default locations.
#
# Sets the following variables:
#   LINEARBUILD_AR
#   LINEARBUILD_RANLIB
#   LINEARBUILD_LINKER
#   LINEARBUILD_MT
#   LINEARBUILD_OBJDUMP
#   LINEARBUILD_STRIP
#   LINEARBUILD_INSTALL_NAME_TOOL

# on UNIX, cygwin and mingw

# Resolve full path of LINEARBUILD_TOOL from user-defined name and SEARCH_PATH.
function(__resolve_tool_path LINEARBUILD_TOOL SEARCH_PATH DOCSTRING)

  if(${LINEARBUILD_TOOL})
    # We only get here if LINEARBUILD_TOOL was
    # specified using -D or a pre-made LinearBuildCache.txt (e.g. via ctest)
    # or set in LINEARBUILD_TOOLCHAIN_FILE.

    get_filename_component(_LINEARBUILD_USER_TOOL_PATH "${${LINEARBUILD_TOOL}}" DIRECTORY)
    # Is LINEARBUILD_TOOL a user-defined name instead of a full path?
    if(NOT _LINEARBUILD_USER_TOOL_PATH)

      # Find LINEARBUILD_TOOL in the SEARCH_PATH directory by user-defined name.
      find_program(_LINEARBUILD_TOOL_WITH_PATH NO_CACHE NAMES ${${LINEARBUILD_TOOL}} HINTS ${SEARCH_PATH} NO_LINEARBUILD_PATH NO_LINEARBUILD_ENVIRONMENT_PATH)
      if(_LINEARBUILD_TOOL_WITH_PATH)

        # Overwrite LINEARBUILD_TOOL with full path found in SEARCH_PATH.
        set(${LINEARBUILD_TOOL} ${_LINEARBUILD_TOOL_WITH_PATH} PARENT_SCOPE)

        get_property(_LINEARBUILD_TOOL_CACHED CACHE ${LINEARBUILD_TOOL} PROPERTY TYPE)
        # If LINEARBUILD_TOOL is present in the LinearBuild Cache, then overwrit it as well.
        if(_LINEARBUILD_TOOL_CACHED)
          set(${LINEARBUILD_TOOL} "${_LINEARBUILD_TOOL_WITH_PATH}" CACHE STRING ${DOCSTRING} FORCE)
        endif()

      endif()

    endif()

  endif()

endfunction()

__resolve_tool_path(LINEARBUILD_LINKER "${_LINEARBUILD_TOOLCHAIN_LOCATION}" "Default Linker")
__resolve_tool_path(LINEARBUILD_MT     "${_LINEARBUILD_TOOLCHAIN_LOCATION}" "Default Manifest Tool")

macro(__resolve_linker_path __linker_type __name __search_path __doc)
  if(NOT LINEARBUILD_LINKER_${__linker_type})
    set( LINEARBUILD_LINKER_${__linker_type} "${__name}")
  endif()
  __resolve_tool_path(LINEARBUILD_LINKER_${__linker_type} "${__search_path}" "${__doc}")
endmacro()

set(_LINEARBUILD_TOOL_VARS "")

# if it's the MS C/CXX compiler, search for link
if(("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_SIMULATE_ID}" STREQUAL "xMSVC" AND
   ("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_FRONTEND_VARIANT}" STREQUAL "xMSVC"
     OR NOT "x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Clang|DPClang)$"))
   OR "x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xMSVC"
   OR (LINEARBUILD_HOST_WIN32 AND "x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xPGI")
   OR (LINEARBUILD_HOST_WIN32 AND "x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xNVIDIA")
   OR (LINEARBUILD_HOST_WIN32 AND "x${_LINEARBUILD_PROCESSING_LANGUAGE}" STREQUAL "xISPC")
   OR (LINEARBUILD_GENERATOR MATCHES "Visual Studio"
       AND NOT LINEARBUILD_VS_PLATFORM_NAME STREQUAL "Tegra-Android"))

  # Start with the canonical names.
  set(_LINEARBUILD_LINKER_NAMES "link")
  set(_LINEARBUILD_AR_NAMES "lib")
  set(_LINEARBUILD_MT_NAMES "mt")

  # Prepend toolchain-specific names.
  if("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Clang|DPClang|LLVMFlang)$")
    set(_LINEARBUILD_NM_NAMES "llvm-nm" "nm")
    list(PREPEND _LINEARBUILD_AR_NAMES "llvm-lib")
    if("${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}" VERSION_GREATER_EQUAL 14.0.2 OR
       (LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID STREQUAL "DPClang" AND
        LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION_INTERNAL VERSION_GREATER_EQUAL 14.0.2))
      list(PREPEND _LINEARBUILD_MT_NAMES "llvm-mt")
    endif()
    list(PREPEND _LINEARBUILD_LINKER_NAMES "lld-link")
    list(APPEND _LINEARBUILD_TOOL_VARS NM)
  elseif("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xIntel")
    list(PREPEND _LINEARBUILD_AR_NAMES "xilib")
    list(PREPEND _LINEARBUILD_LINKER_NAMES "xilink")
  endif()

  list(APPEND _LINEARBUILD_TOOL_VARS LINKER MT AR)

  # look-up for possible usable linker
  __resolve_linker_path(LINK "link" "${_LINEARBUILD_TOOLCHAIN_LOCATION}" "link Linker")
  __resolve_linker_path(LLD "lld-link" "${_LINEARBUILD_TOOLCHAIN_LOCATION}" "lld-link Linker")

elseif("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Open)?Watcom$")
  set(_LINEARBUILD_LINKER_NAMES "wlink")
  set(_LINEARBUILD_AR_NAMES "wlib")
  list(APPEND _LINEARBUILD_TOOL_VARS LINKER AR)

elseif("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL "xPellesC")
  set(_LINEARBUILD_LINKER_NAMES "polink")
  set(_LINEARBUILD_AR_NAMES "polib")
  list(APPEND _LINEARBUILD_TOOL_VARS LINKER AR)

elseif("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^xIAR$")
  # Detect the `<lang>` compiler name
  get_filename_component(__iar_selected_compiler "${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER}" NAME)
  # Strip out the `icc`,`iasm`,`a` prefixes and other `_suffixes leaving only the `<target>`
  string(TOLOWER "${__iar_selected_compiler}" __iar_arch_id)
  string(REGEX REPLACE "^x(icc|iasm|a)|(_.*)$" "" __iar_arch_id "x${__iar_arch_id}")
  # IAR Archive Tool
  set(_LINEARBUILD_AR_NAMES
    "iarchive" "iarchive.exe"
    "xar" "xar.exe"
  )
  # IAR Linker
  set(_LINEARBUILD_LINKER_NAMES
    "ilink${__iar_arch_id}" "ilink${__iar_arch_id}.exe"
    "xlink${__iar_arch_id}" "xlink${__iar_arch_id}.exe"
    "xlink" "xlink.exe"
  )
  # IAR ELF Dumper
  set(_LINEARBUILD_IAR_ELFDUMP_NAMES
    "ielfdump${__iar_arch_id}" "ielfdump${__iar_arch_id}.exe"
  )
  # IAR ELF Tool
  set(_LINEARBUILD_IAR_ELFTOOL_NAMES
    "ielftool" "ielftool.exe"
  )
  # IAR ELF Exe to Object Tool
  set(_LINEARBUILD_IAR_EXE2OBJ_NAMES
    "iexe2obj" "iexe2obj.exe"
  )
  # IAR Object File Manipulator
  set(_LINEARBUILD_IAR_OBJMANIP_NAMES
    "iobjmanip" "iobjmanip.exe"
  )
  # IAR Absolute Symbol Exporter
  set(_LINEARBUILD_IAR_SYMEXPORT_NAMES
    "isymexport" "isymexport.exe"
  )
  # IAR C-STAT Command Line Interface
  set(_LINEARBUILD_IAR_CSTAT_NAMES
    "icstat" "icstat.exe"
  )
  # IAR C-STAT Checks Manifest Handler
  set(_LINEARBUILD_IAR_CHECKS_NAMES
    "ichecks" "ichecks.exe"
  )
  # IAR C-STAT Report Generator
  set(_LINEARBUILD_IAR_REPORT_NAMES
    "ireport" "ireport.exe"
  )
  list(APPEND _LINEARBUILD_TOOL_VARS
    AR LINKER IAR_ELFDUMP IAR_ELFTOOL IAR_EXE2OBJ IAR_OBJMANIP IAR_SYMEXPORT
    IAR_CSTAT IAR_CHECKS IAR_REPORT
  )
  unset(__iar_selected_compiler)
  unset(__iar_arch_id)

# in all other cases search for ar, ranlib, etc.
else()
  if(LINEARBUILD_C_COMPILER_EXTERNAL_TOOLCHAIN)
    set(_LINEARBUILD_TOOLCHAIN_LOCATION ${_LINEARBUILD_TOOLCHAIN_LOCATION} ${LINEARBUILD_C_COMPILER_EXTERNAL_TOOLCHAIN}/bin)
  endif()
  if(LINEARBUILD_CXX_COMPILER_EXTERNAL_TOOLCHAIN)
    set(_LINEARBUILD_TOOLCHAIN_LOCATION ${_LINEARBUILD_TOOLCHAIN_LOCATION} ${LINEARBUILD_CXX_COMPILER_EXTERNAL_TOOLCHAIN}/bin)
  endif()

  # Start with the canonical names.
  set(_LINEARBUILD_AR_NAMES "ar")
  set(_LINEARBUILD_RANLIB_NAMES "ranlib")
  set(_LINEARBUILD_STRIP_NAMES "strip")
  set(_LINEARBUILD_LINKER_NAMES "ld")
  set(_LINEARBUILD_NM_NAMES "nm")
  set(_LINEARBUILD_OBJDUMP_NAMES "objdump")
  set(_LINEARBUILD_OBJCOPY_NAMES "objcopy")
  set(_LINEARBUILD_READELF_NAMES "readelf")
  set(_LINEARBUILD_DLLTOOL_NAMES "dlltool")
  set(_LINEARBUILD_ADDR2LINE_NAMES "addr2line")
  set(_LINEARBUILD_TAPI_NAMES "tapi")

  # Prepend toolchain-specific names.
  if("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^x(Clang|DPClang|IntelLLVM|LLVMFlang)$")
    if("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_SIMULATE_ID}" STREQUAL "xMSVC")
      list(PREPEND _LINEARBUILD_LINKER_NAMES "lld-link")
    elseif(NOT APPLE)
      list(PREPEND _LINEARBUILD_LINKER_NAMES "ld.lld")
    endif()
    # llvm-ar does not generate a symbol table that the Apple ld64 linker accepts.
    if(NOT APPLE)
      list(PREPEND _LINEARBUILD_AR_NAMES "llvm-ar")
    endif()
    list(PREPEND _LINEARBUILD_RANLIB_NAMES "llvm-ranlib")
    # llvm-strip versions prior to 11 require additional flags we do not yet add.
    if("${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}" VERSION_GREATER_EQUAL 11)
      # llvm-strip does not seem to support chained fixup format on macOS correctly.
      if(NOT APPLE)
        list(PREPEND _LINEARBUILD_STRIP_NAMES "llvm-strip")
      endif()
    endif()
    list(PREPEND _LINEARBUILD_NM_NAMES "llvm-nm")
    if("${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_VERSION}" VERSION_GREATER_EQUAL 9)
      # llvm-objcopy and llvm-objdump on versions prior to 9 did not support everything we need.
      list(PREPEND _LINEARBUILD_OBJCOPY_NAMES "llvm-objcopy")
      list(PREPEND _LINEARBUILD_OBJDUMP_NAMES "llvm-objdump")
    endif()
    list(PREPEND _LINEARBUILD_READELF_NAMES "llvm-readelf")
    list(PREPEND _LINEARBUILD_DLLTOOL_NAMES "llvm-dlltool")
    list(PREPEND _LINEARBUILD_ADDR2LINE_NAMES "llvm-addr2line")
  elseif("${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" STREQUAL ARMClang)
    list(PREPEND _LINEARBUILD_AR_NAMES "armar")
    list(PREPEND _LINEARBUILD_LINKER_NAMES "armlink")
  endif()

  if(EMSCRIPTEN)
    list(PREPEND _LINEARBUILD_AR_NAMES "emar")
    list(PREPEND _LINEARBUILD_RANLIB_NAMES "emranlib")
  endif()

  list(APPEND _LINEARBUILD_TOOL_VARS AR RANLIB STRIP LINKER NM OBJDUMP OBJCOPY READELF DLLTOOL ADDR2LINE TAPI)
endif()

foreach(_LINEARBUILD_TOOL IN LISTS _LINEARBUILD_TOOL_VARS)
  # Build the final list of prefixed/suffixed names.
  set(_LINEARBUILD_${_LINEARBUILD_TOOL}_FIND_NAMES "")
  foreach(_LINEARBUILD_TOOL_NAME IN LISTS _LINEARBUILD_${_LINEARBUILD_TOOL}_NAMES)
    list(APPEND _LINEARBUILD_${_LINEARBUILD_TOOL}_FIND_NAMES
      ${_LINEARBUILD_TOOLCHAIN_PREFIX}${_LINEARBUILD_TOOL_NAME}${_LINEARBUILD_TOOLCHAIN_SUFFIX}
      ${_LINEARBUILD_TOOLCHAIN_PREFIX}${_LINEARBUILD_TOOL_NAME}
      ${_LINEARBUILD_TOOL_NAME}${_LINEARBUILD_TOOLCHAIN_SUFFIX}
      ${_LINEARBUILD_TOOL_NAME}
      )
  endforeach()
  list(REMOVE_DUPLICATES _LINEARBUILD_${_LINEARBUILD_TOOL}_FIND_NAMES)

  find_program(LINEARBUILD_${_LINEARBUILD_TOOL} NAMES ${_LINEARBUILD_${_LINEARBUILD_TOOL}_FIND_NAMES} HINTS ${_LINEARBUILD_TOOLCHAIN_LOCATION} NO_LINEARBUILD_PATH NO_LINEARBUILD_ENVIRONMENT_PATH)
  unset(_LINEARBUILD_${_LINEARBUILD_TOOL}_FIND_NAMES)
endforeach()

if(NOT LINEARBUILD_RANLIB)
    set(LINEARBUILD_RANLIB : CACHE INTERNAL "noop for ranlib")
endif()

if(APPLE AND "TAPI" IN_LIST _LINEARBUILD_TOOL_VARS AND NOT LINEARBUILD_TAPI)
  # try to pick-up from Apple toolchain
  execute_process(COMMAND xcrun --find tapi
    OUTPUT_VARIABLE _xcrun_out
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE _xcrun_failed)
  if(NOT _xcrun_failed AND EXISTS "${_xcrun_out}")
    set_property(CACHE LINEARBUILD_TAPI PROPERTY VALUE "${_xcrun_out}")
  endif()
  unset(_xcrun_out)
  unset(_xcrun_failed)
endif()


if(LINEARBUILD_PLATFORM_HAS_INSTALLNAME)
  find_program(LINEARBUILD_INSTALL_NAME_TOOL NAMES ${_LINEARBUILD_TOOLCHAIN_PREFIX}install_name_tool llvm-install-name-tool HINTS ${_LINEARBUILD_TOOLCHAIN_LOCATION} NO_LINEARBUILD_PATH NO_LINEARBUILD_ENVIRONMENT_PATH)
  if(NOT LINEARBUILD_INSTALL_NAME_TOOL)
    message(FATAL_ERROR "Could not find install_name_tool, please check your installation.")
  endif()

  list(APPEND _LINEARBUILD_TOOL_VARS INSTALL_NAME_TOOL)
endif()

# Mark any tool cache entries as advanced.
foreach(_LINEARBUILD_TOOL IN LISTS _LINEARBUILD_TOOL_VARS)
  get_property(_LINEARBUILD_TOOL_CACHED CACHE LINEARBUILD_${_LINEARBUILD_TOOL} PROPERTY TYPE)
  if(_LINEARBUILD_TOOL_CACHED)
    mark_as_advanced(LINEARBUILD_${_LINEARBUILD_TOOL})
  endif()
  unset(_LINEARBUILD_${_LINEARBUILD_TOOL}_NAMES)
endforeach()
unset(_LINEARBUILD_TOOL_VARS)
unset(_LINEARBUILD_TOOL_CACHED)
unset(_LINEARBUILD_TOOL_NAME)
unset(_LINEARBUILD_TOOL)

if("x${LINEARBUILD_${_LINEARBUILD_PROCESSING_LANGUAGE}_COMPILER_ID}" MATCHES "^xIAR$")
  # Set for backwards compatibility
  set(LINEARBUILD_IAR_ARCHIVE "${LINEARBUILD_AR}" CACHE FILEPATH "The IAR archiver")
  set(LINEARBUILD_IAR_LINKER "${LINEARBUILD_LINKER}" CACHE FILEPATH "The IAR ILINK linker")
  mark_as_advanced(LINEARBUILD_IAR_LINKER LINEARBUILD_IAR_AR)
endif()
