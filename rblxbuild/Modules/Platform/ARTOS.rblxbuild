# Support for ARTOS RTOS (locamation.com)
set(RBLXBUILD_LINK_LIBRARY_SUFFIX "")
set(RBLXBUILD_STATIC_LIBRARY_PREFIX "")
set(RBLXBUILD_STATIC_LIBRARY_SUFFIX ".a")
set(RBLXBUILD_SHARED_LIBRARY_PREFIX "")
set(RBLXBUILD_SHARED_LIBRARY_SUFFIX ".a")
set(RBLXBUILD_EXECUTABLE_SUFFIX ".x")
set(RBLXBUILD_DL_LIBS "")

set(RBLXBUILD_FIND_LIBRARY_PREFIXES "lib" "")
set(RBLXBUILD_FIND_LIBRARY_SUFFIXES ".a")

# ARTOS does not support shared libs
set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS FALSE)

set(RBLXBUILD_C_LINK_SHARED_LIBRARY )
set(RBLXBUILD_C_LINK_MODULE_LIBRARY )
