# This file sets the basic flags for the linker used by the C compiler in RBLXBuild.
# It also loads the available platform file for the system-linker
# if it exists.
# It also loads a system - linker - processor (or target hardware)
# specific file, which is mainly useful for crosscompiling and embedded systems.

set(_INCLUDED_FILE 0)

# Load linker-specific information.
if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LINKER_ID)
  include(Linker/${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LINKER_ID}-ASM${ASM_DIALECT} OPTIONAL)
endif()

# load a hardware specific file, mostly useful for embedded compilers
if(RBLXBUILD_SYSTEM_PROCESSOR AND RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LINKER_ID)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LINKER_ID}-ASM${ASM_DIALECT}-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()


# load the system- and linker specific files
if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LINKER_ID)
  include(Platform/Linker/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_LINKER_ID}-ASM${ASM_DIALECT}
    OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()

# We specify the platform linker information in the system file.
if (NOT _INCLUDED_FILE)
  include(Platform/Linker/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-ASM${ASM_DIALECT} OPTIONAL)
endif ()

set(RBLXBUILD_ASM${ASM_DIALECT}_LINKER_INFORMATION_LOADED 1)
