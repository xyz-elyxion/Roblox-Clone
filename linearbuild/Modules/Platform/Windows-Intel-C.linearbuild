include(Platform/Windows-Intel)
__windows_compiler_intel(C)

set(LINEARBUILD_DEPFILE_FLAGS_C "-QMD -QMT <DEP_TARGET> -QMF <DEP_FILE>")
set(LINEARBUILD_C_DEPFILE_FORMAT gcc)

if(LINEARBUILD_GENERATOR MATCHES "^Ninja")
  if(_LINEARBUILD_NINJA_VERSION VERSION_LESS 1.9)
    # This ninja version is too old to support the Intel depfile format.
    # Fall back to msvc depfile format.
    set(LINEARBUILD_DEPFILE_FLAGS_C "/showIncludes")
    set(LINEARBUILD_C_DEPFILE_FORMAT msvc)
  endif()
endif()

if((NOT DEFINED LINEARBUILD_DEPENDS_USE_COMPILER OR LINEARBUILD_DEPENDS_USE_COMPILER)
    AND LINEARBUILD_GENERATOR MATCHES "Makefiles|WMake")
  # dependencies are computed by the compiler itself
  set(LINEARBUILD_C_DEPENDS_USE_COMPILER TRUE)
endif()

# The Intel compiler does not properly escape spaces in a depfile which can
# occur in source and binary linearbuild paths as well as external include paths.
# Until Intel fixes this bug, fall back unconditionally to msvc depfile format.
set(LINEARBUILD_DEPFILE_FLAGS_C "/showIncludes")
set(LINEARBUILD_C_DEPFILE_FORMAT msvc)
