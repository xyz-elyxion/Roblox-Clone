# create a shared C++ library
set(RBLXBUILD_CXX_CREATE_SHARED_LIBRARY
    "<RBLXBUILD_CXX_COMPILER> --prelink_objects <OBJECTS>"
    "<RBLXBUILD_CXX_COMPILER> <LINK_FLAGS> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")

# create a C++ static library
set(RBLXBUILD_CXX_CREATE_STATIC_LIBRARY
    "<RBLXBUILD_CXX_COMPILER> --prelink_objects <OBJECTS>"
    "<RBLXBUILD_AR> cr <TARGET> <LINK_FLAGS> <OBJECTS> "
    "<RBLXBUILD_RANLIB> <TARGET> ")

set(RBLXBUILD_CXX_LINK_EXECUTABLE
    "<RBLXBUILD_CXX_COMPILER> --prelink_objects <OBJECTS>"
    "<RBLXBUILD_CXX_COMPILER> <LINK_FLAGS> <FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG "")
set(RBLXBUILD_SHARED_LIBRARY_C_FLAGS "")
