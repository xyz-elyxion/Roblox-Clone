if(__COMPILER_TICLANG)
  return()
endif()
set(__COMPILER_TICLANG TRUE)

include(Compiler/RBLXBuildCommonCompilerMacros)

# get linker supported cpu list
macro(__compiler_ticlang lang)
  set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "-Xlinker ")

  set(RBLXBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")

  set(RBLXBUILD_${lang}_CREATE_ASSEMBLY_SOURCE "<RBLXBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")

  set(RBLXBUILD_${lang}_COMPILE_OBJECT  "<RBLXBUILD_${lang}_COMPILER> -c <SOURCE> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT>")

  set(RBLXBUILD_${lang}_LINK_EXECUTABLE "<RBLXBUILD_${lang}_COMPILER> <FLAGS> -Xlinker --output_file=<TARGET> -Xlinker --map_file=<TARGET_NAME>.map -Xlinker --rom_model <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES>")

  set(RBLXBUILD_${lang}_ARCHIVE_CREATE  "<RBLXBUILD_AR> cr <TARGET> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_APPEND  "<RBLXBUILD_AR> r <TARGET> <OBJECTS>")
  set(RBLXBUILD_${lang}_ARCHIVE_FINISH  "")

  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG "-Xlinker" " ")
  set(RBLXBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP)

  set(RBLXBUILD_${lang}_LINK_MODE DRIVER)
endmacro()

set(RBLXBUILD_EXECUTABLE_SUFFIX ".out")
set(RBLXBUILD_LIBRARY_PATH_FLAG "-Wl,--search_path=")
set(RBLXBUILD_LINK_LIBRARY_FLAG "-Wl,--library=")
