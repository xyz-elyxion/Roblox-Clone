include_guard()

set(LINEARBUILD_LIBRARY_PATH_FLAG "-libpath:")
set(LINEARBUILD_LINK_DEF_FILE_FLAG "-def:")
set(LINEARBUILD_LINK_LIBRARY_FLAG "")

set(LINEARBUILD_BUILD_TYPE_INIT Debug)

# Select a default architecture based on the LIB search path.
string(TOLOWER "$ENV{LIB}" _PellesC_LIB)
if(_PellesC_LIB MATCHES [[[\/]+lib[\/]+win64[\/]*(;|$)]])
  set(_PellesC_ARCH "x64")
elseif(_PellesC_LIB MATCHES [[[\/]+lib[\/]+win[\/]*(;|$)]])
  set(_PellesC_ARCH "x86")
else()
  set(_PellesC_ARCH "")
endif()

macro(__windows_compiler_pellesc lang)
  if(_PellesC_ARCH)
    set(_PellesC_LINK_FLAGS " -machine:${_PellesC_ARCH}")
  else()
    set(_PellesC_LINK_FLAGS "")
  endif()

  set(LINEARBUILD_${lang}_CREATE_STATIC_LIBRARY "<LINEARBUILD_AR> <LINK_FLAGS> -out:<TARGET> <OBJECTS>")

  set(LINEARBUILD_${lang}_CREATE_SHARED_LIBRARY
    "<LINEARBUILD_LINKER> <OBJECTS> ${LINEARBUILD_START_TEMP_FILE} -out:<TARGET> -implib:<TARGET_IMPLIB> -dll -version:<TARGET_VERSION_MAJOR>.<TARGET_VERSION_MINOR>${_PellesC_LINK_FLAGS} <LINK_FLAGS> <LINK_LIBRARIES> ${LINEARBUILD_END_TEMP_FILE}")
  set(LINEARBUILD_${lang}_CREATE_SHARED_MODULE "${LINEARBUILD_${lang}_CREATE_SHARED_LIBRARY}")
  set(LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "")

  set(LINEARBUILD_${lang}_USE_RESPONSE_FILE_FOR_OBJECTS 1)
  set(LINEARBUILD_${lang}_LINK_EXECUTABLE
    "<LINEARBUILD_LINKER> <OBJECTS> ${LINEARBUILD_START_TEMP_FILE} -out:<TARGET> -implib:<TARGET_IMPLIB> -version:<TARGET_VERSION_MAJOR>.<TARGET_VERSION_MINOR>${_PellesC_LINK_FLAGS} <LINK_FLAGS> <LINK_LIBRARIES> ${LINEARBUILD_END_TEMP_FILE}")

  set(LINEARBUILD_${lang}_LINK_DEF_FILE_FLAG "${LINEARBUILD_LINK_DEF_FILE_FLAG}")

  set(LINEARBUILD_${lang}_CREATE_WIN32_EXE "-subsystem:windows")
  set(LINEARBUILD_${lang}_CREATE_CONSOLE_EXE "-subsystem:console")

  if(NOT LINEARBUILD_RC_COMPILER_INIT)
    set(LINEARBUILD_RC_COMPILER_INIT porc)
  endif()
  enable_language(RC)

  unset(_PellesC_LINK_FLAGS)
endmacro()

foreach (t IN ITEMS EXE SHARED MODULE)
  string(APPEND LINEARBUILD_${t}_LINKER_FLAGS_DEBUG_INIT " -debug -debugtype:both -dbg")
  string(APPEND LINEARBUILD_${t}_LINKER_FLAGS_RELWITHDEBINFO_INIT " -debug -debugtype:both -dbg")
endforeach ()
