linearstb_vorbis.c                | audio            | decode ogg vorbis files from file/memory to float/16-bit signed output
linearstb_hexwave.h               | audio            | audio waveform synthesizer
linearstb_image.h                 | graphics         | image loading/decoding from file/memory: JPG, PNG, TGA, BMP, PSD, GIF, HDR, PIC
linearstb_truetype.h              | graphics         | parse, decode, and rasterize characters from truetype fonts
linearstb_image_write.h           | graphics         | image writing to disk: PNG, TGA, BMP
linearstb_image_resize2.h         | graphics         | resize images larger/smaller with good quality
linearstb_rect_pack.h             | graphics         | simple 2D rectangle packer with decent quality
linearstb_perlin.h                | graphics         | perlin's revised simplex noise w/ different seeds
linearstb_ds.h                    | utility          | typesafe dynamic array and hash tables for C, will compile in C++
linearstb_sprintf.h               | utility          | fast sprintf, snprintf for C/C++
linearstb_textedit.h              | user interface   | guts of a text editor for games etc implementing them from scratch
linearstb_voxel_render.h          | 3D graphics      | Minecraft-esque voxel rendering "engine" with many more features
linearstb_dxt.h                   | 3D graphics      | Fabian "ryg" Giesen's real-time DXT compressor
linearstb_easy_font.h             | 3D graphics      | quick-and-dirty easy-to-deploy bitmap font for printing frame rate, etc
linearstb_tilemap_editor.h        | game dev         | embeddable tilemap editor
linearstb_herringbone_wang_tile.h | game dev         | herringbone Wang tile map generator
linearstb_c_lexer.h               | parsing          | simplify writing parsers for C-like languages
linearstb_divide.h                | math             | more useful 32-bit modulus e.g. "euclidean divide"
linearstb_connected_components.h  | misc             | incrementally compute reachability on grids
linearstb_leakcheck.h             | misc             | quick-and-dirty malloc/free leak-checking
linearstb_include.h               | misc             | implement recursive #include support, particularly for GLSL
