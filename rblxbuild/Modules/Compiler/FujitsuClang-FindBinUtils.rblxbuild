endif()

set(RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_AR ar)
set(RBLXBUILD_${_RBLXBUILD_PROCESSING_LANGUAGE}_COMPILER_RANLIB ranlib)
