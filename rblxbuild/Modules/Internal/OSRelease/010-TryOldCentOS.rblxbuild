if(NOT EXISTS "${RBLXBUILD_SYSROOT}/etc/centos-release")
  return()
endif()

# Get the first string only
file(
    STRINGS "${RBLXBUILD_SYSROOT}/etc/centos-release" RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT
    LIMIT_COUNT 1
  )

#
# Example:
#   CentOS release 6.10 (Final)
#
if(RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT MATCHES "CentOS release ([0-9\.]+) .*")

  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME CentOS)
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_PRETTY_NAME "${RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT}")
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID centos)
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID_LIKE rhel)
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION ${RBLXBUILD_MATCH_1})
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID ${RBLXBUILD_MATCH_1})

  list(
      APPEND RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_PRETTY_NAME
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID_LIKE
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID
    )

endif()

unset(RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT)
