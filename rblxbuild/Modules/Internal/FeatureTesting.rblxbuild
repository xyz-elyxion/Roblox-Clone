
macro(_record_compiler_features lang compile_flags feature_list)
  include("${RBLXBUILD_ROOT}/Modules/Compiler/${RBLXBUILD_${lang}_COMPILER_ID}-${lang}-FeatureTests.rblxbuild" OPTIONAL)

  string(TOLOWER ${lang} lang_lc)
  file(REMOVE "${RBLXBUILD_BINARY_DIR}/RBLXBuildFiles/feature_tests.bin")
  set(_content "
  const char features[] = {\"\\n\"\n")

  get_property(known_features GLOBAL PROPERTY RBLXBUILD_${lang}_KNOWN_FEATURES)

  foreach(feature ${known_features})
    if (_rblxbuild_feature_test_${feature})
      if (${_rblxbuild_feature_test_${feature}} STREQUAL 1)
        set(_feature_condition "\"1\" ")
      else()
        set(_feature_condition "#if ${_rblxbuild_feature_test_${feature}}\n\"1\"\n#else\n\"0\"\n#endif\n")
      endif()
      string(APPEND _content
        "\"${lang}_FEATURE:\"\n${_feature_condition}\"${feature}\\n\"\n")
    endif()
  endforeach()
  string(APPEND _content
    "\n};\n\nint main(int argc, char** argv) { (void)argv; return features[argc]; }\n")

  if(RBLXBUILD_${lang}_LINK_WITH_STANDARD_COMPILE_OPTION)
    # This toolchain requires use of the language standard flag
    # when linking in order to use the matching standard library.
    set(compile_flags_for_link "${compile_flags}")
  else()
    set(compile_flags_for_link "")
  endif()

  try_compile(RBLXBUILD_${lang}_FEATURE_TEST
    SOURCE_FROM_VAR "feature_tests.${lang_lc}" _content
    COMPILE_DEFINITIONS "${compile_flags}"
    LINK_LIBRARIES "${compile_flags_for_link}"
    COPY_FILE "${RBLXBUILD_BINARY_DIR}/RBLXBuildFiles/feature_tests.bin"
    COPY_FILE_ERROR _copy_error
    NO_CACHE
    __RBLXBUILD_INTERNAL FEATURE_TESTING
    )
  if(NOT RBLXBUILD_${lang}_FEATURE_TEST)
    set(_result 255)
  elseif(_copy_error)
    set(_result 255)
    message(WARNING "${_copy_error}")
  else()
    set(_result 0)
  endif()
  unset(RBLXBUILD_${lang}_FEATURE_TEST)
  unset(compile_flags_for_link)

  if (_result EQUAL 0)
    if(EXISTS "${RBLXBUILD_BINARY_DIR}/RBLXBuildFiles/feature_tests.bin")
      rblxbuild_policy(PUSH)
      rblxbuild_policy(SET CMP0159 NEW) # file(STRINGS) with REGEX updates RBLXBUILD_MATCH_<n>
      file(STRINGS "${RBLXBUILD_BINARY_DIR}/RBLXBuildFiles/feature_tests.bin"
        features REGEX "${lang}_FEATURE:.*")
      rblxbuild_policy(POP)
      foreach(info ${features})
        string(REPLACE "${lang}_FEATURE:" "" info ${info})
        string(SUBSTRING ${info} 0 1 has_feature)
        if(has_feature)
          string(REGEX REPLACE "^1" "" feature ${info})
          list(APPEND ${feature_list} ${feature})
        endif()
      endforeach()
    endif()
  endif()
endmacro()

macro(_record_compiler_features_c std)
  list(APPEND RBLXBUILD_C${std}_COMPILE_FEATURES c_std_${std})

  get_property(lang_level_has_features GLOBAL PROPERTY RBLXBUILD_C${std}_KNOWN_FEATURES)
  if(lang_level_has_features)
    _record_compiler_features(C "${RBLXBUILD_C${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_C${std}_COMPILE_FEATURES)
  endif()
  unset(lang_level_has_features)
endmacro()

macro(_record_compiler_features_cxx std)
  list(APPEND RBLXBUILD_CXX${std}_COMPILE_FEATURES cxx_std_${std})

  get_property(lang_level_has_features GLOBAL PROPERTY RBLXBUILD_CXX${std}_KNOWN_FEATURES)
  if(lang_level_has_features)
    _record_compiler_features(CXX "${RBLXBUILD_CXX${std}_STANDARD_COMPILE_OPTION}" RBLXBUILD_CXX${std}_COMPILE_FEATURES)
  endif()
  unset(lang_level_has_features)
endmacro()

