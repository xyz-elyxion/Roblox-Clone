if(RBLXBUILD_CUDA_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(RBLXBUILD_CUDA_COMPILER_WORKS TRUE)
  return()
endif()

include(RBLXBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${RBLXBUILD_TRY_COMPILE_TARGET_TYPE})
if(_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older RBLXBuild version.
# We now store this in RBLXBuildCUDACompiler.rblxbuild.
unset(RBLXBUILD_CUDA_COMPILER_WORKS CACHE)

# If the compiler was not identified, required compiler-specific variables
# such as _RBLXBUILD_CUDA_WHOLE_FLAG will not be set.  Issue a clear diagnostic
# rather than the cryptic "required internal RBLXBuild variable not set" message
# that the generator would otherwise emit.
if(NOT RBLXBUILD_CUDA_COMPILER_ID)
  PrintTestCompilerStatus("CUDA")
  PrintTestCompilerResult(CHECK_FAIL "broken")
  message(FATAL_ERROR "The CUDA compiler\n  \"${RBLXBUILD_CUDA_COMPILER}\"\n"
    "is not able to compile a simple test program.\nThe compiler could not "
    "be identified as a supported CUDA compiler.\n\n"
    "RBLXBuild will not be able to correctly generate this project.")
endif()

# Try to identify the ABI and configure it into RBLXBuildCUDACompiler.rblxbuild
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerABI.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_ABI(CUDA ${RBLXBUILD_ROOT}/Modules/RBLXBuildCUDACompilerABI.cu)
if(RBLXBUILD_CUDA_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(RBLXBUILD_CUDA_COMPILER_WORKS TRUE)
  message(STATUS "Check for working CUDA compiler: ${RBLXBUILD_CUDA_COMPILER} - skipped")

  include(Internal/RBLXBuildCUDAArchitecturesNative)
  # Run the test binary to get:
  # - RBLXBUILD_CUDA_ARCHITECTURES_NATIVE
  rblxbuild_cuda_architectures_native(CUDA)
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected cuda compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and rblxbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT RBLXBUILD_CUDA_COMPILER_WORKS)
  PrintTestCompilerStatus("CUDA")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testCudaCompilerSource
    "#ifndef __CUDACC__\n"
    "# error \"The RBLXBUILD_CUDA_COMPILER is set to an invalid CUDA compiler\"\n"
    "#endif\n"
    "int main(){return 0;}\n")

  # Clear result from normal variable.
  unset(RBLXBUILD_CUDA_COMPILER_WORKS)

  # Puts test result in cache variable.
  try_compile(RBLXBUILD_CUDA_COMPILER_WORKS
    SOURCE_FROM_VAR main.cu __TestCompiler_testCudaCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __RBLXBUILD_CUDA_COMPILER_OUTPUT)
  unset(__TestCompiler_testCudaCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT RBLXBUILD_CUDA_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__RBLXBUILD_CUDA_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The CUDA compiler\n  \"${RBLXBUILD_CUDA_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "RBLXBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerSupport.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_SUPPORT(CUDA)

if("x${RBLXBUILD_CUDA_SIMULATE_ID}" STREQUAL "xMSVC")
  set(RBLXBUILD_CUDA_IMPLICIT_LINK_LIBRARIES "${RBLXBUILD_CUDA_HOST_IMPLICIT_LINK_LIBRARIES}")
  set(RBLXBUILD_CUDA_IMPLICIT_LINK_DIRECTORIES "${RBLXBUILD_CUDA_HOST_IMPLICIT_LINK_DIRECTORIES}")
endif()

include(Internal/RBLXBuildCUDAFilterImplicitLibs)
# Filter out implicit link libraries that should not be passed unconditionally.
rblxbuild_cuda_filter_implicit_libs(RBLXBUILD_CUDA_IMPLICIT_LINK_LIBRARIES)

if(RBLXBUILD_CUDA_COMPILER_ID STREQUAL "NVIDIA")
  include(Internal/RBLXBuildNVCCFilterImplicitInfo)
  # Match arguments with rblxbuild_nvcc_parse_implicit_info call in RBLXBuildDetermineCUDACompiler.
  rblxbuild_nvcc_filter_implicit_info(CUDA RBLXBUILD_CUDA_)
endif()

# Re-configure to save learned information.
configure_file(
  ${RBLXBUILD_ROOT}/Modules/RBLXBuildCUDACompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildCUDACompiler.rblxbuild
  @ONLY
  )
include(${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildCUDACompiler.rblxbuild)

set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__RBLXBUILD_CUDA_COMPILER_OUTPUT)
