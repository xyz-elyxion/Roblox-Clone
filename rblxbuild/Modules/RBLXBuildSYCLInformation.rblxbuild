include(RBLXBuildLanguageInformation)

if(UNIX)
  set(RBLXBUILD_SYCL_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_SYCL_OUTPUT_EXTENSION .obj)
endif()

set(_INCLUDED_FILE 0)

if(RBLXBUILD_SYCL_COMPILER_ID)
  include(Compiler/${RBLXBUILD_SYCL_COMPILER_ID}-SYCL OPTIONAL)
endif()

set(RBLXBUILD_BASE_NAME)
get_filename_component(RBLXBUILD_BASE_NAME "${RBLXBUILD_SYCL_COMPILER}" NAME_WE)
if(RBLXBUILD_SYSTEM_PROCESSOR)
  if(RBLXBUILD_SYCL_COMPILER_ID)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_SYCL_COMPILER_ID}-SYCL-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
  endif()
  if(NOT _INCLUDED_FILE)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME}-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
endif()

if(RBLXBUILD_SYCL_COMPILER_ID)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_SYCL_COMPILER_ID}-SYCL OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()
if(NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_BASE_NAME} OPTIONAL RESULT_VARIABLE _INCLUDED_FILE)
endif()

if(RBLXBUILD_SYCL_COMPILER_WRAPPER)
  __rblxbuild_include_compiler_wrapper(SYCL)
endif()

if(NOT _INCLUDED_FILE)
  include(Platform/${RBLXBUILD_SYSTEM_NAME} OPTIONAL)
endif()

if(RBLXBUILD_GENERATOR MATCHES "Visual Studio")
  if(NOT RBLXBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    message(FATAL_ERROR "Visual Studio SYCL support requires an MSVC-like compiler frontend.")
  endif()
endif()

if(RBLXBUILD_SYCL_SIZEOF_DATA_PTR)
  foreach(f IN LISTS RBLXBUILD_SYCL_ABI_FILES)
    include(${f})
  endforeach()
  unset(RBLXBUILD_SYCL_ABI_FILES)
endif()

if(_RBLXBUILD_SYCL_REQUIRED_FLAG AND RBLXBUILD_SYCL_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
  foreach(rule CREATE_PREPROCESSED_SOURCE CREATE_ASSEMBLY_SOURCE)
    if(RBLXBUILD_SYCL_${rule})
      string(REPLACE "<RBLXBUILD_SYCL_COMPILER>" "<RBLXBUILD_SYCL_COMPILER> ${_RBLXBUILD_SYCL_REQUIRED_FLAG}"
        RBLXBUILD_SYCL_${rule} "${RBLXBUILD_SYCL_${rule}}")
    endif()
  endforeach()
endif()

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE)
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE "${_override}")
endif()

if(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_SYCL)
  include(${RBLXBUILD_USER_MAKE_RULES_OVERRIDE_SYCL} RESULT_VARIABLE _override)
  set(RBLXBUILD_USER_MAKE_RULES_OVERRIDE_SYCL "${_override}")
endif()

set(RBLXBUILD_SYCL_FLAGS_INIT "$ENV{SYCLFLAGS} ${RBLXBUILD_SYCL_FLAGS_INIT}")

rblxbuild_initialize_per_config_variable(RBLXBUILD_SYCL_FLAGS "Flags used by the SYCL compiler")

if(RBLXBUILD_SYCL_STANDARD_LIBRARIES_INIT)
  set(RBLXBUILD_SYCL_STANDARD_LIBRARIES "${RBLXBUILD_SYCL_STANDARD_LIBRARIES_INIT}"
    CACHE STRING "Libraries linked by default with all SYCL applications.")
  mark_as_advanced(RBLXBUILD_SYCL_STANDARD_LIBRARIES)
endif()

if(NOT RBLXBUILD_SYCL_COMPILER_LAUNCHER AND DEFINED ENV{RBLXBUILD_SYCL_COMPILER_LAUNCHER})
  set(RBLXBUILD_SYCL_COMPILER_LAUNCHER "$ENV{RBLXBUILD_SYCL_COMPILER_LAUNCHER}"
    CACHE STRING "Compiler launcher for SYCL.")
endif()

if(NOT RBLXBUILD_SYCL_LINKER_LAUNCHER AND DEFINED ENV{RBLXBUILD_SYCL_LINKER_LAUNCHER})
  set(RBLXBUILD_SYCL_LINKER_LAUNCHER "$ENV{RBLXBUILD_SYCL_LINKER_LAUNCHER}"
    CACHE STRING "Linker launcher for SYCL.")
endif()

include(RBLXBuildCommonLanguageInclude)
_rblxbuild_common_language_platform_flags(SYCL)

if(NOT RBLXBUILD_SYCL_CREATE_SHARED_LIBRARY)
  set(RBLXBUILD_SYCL_CREATE_SHARED_LIBRARY
      "<RBLXBUILD_SYCL_COMPILER> ${_RBLXBUILD_SYCL_REQUIRED_FLAG} <RBLXBUILD_SHARED_LIBRARY_SYCL_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
endif()

if(NOT RBLXBUILD_SYCL_CREATE_SHARED_MODULE)
  set(RBLXBUILD_SYCL_CREATE_SHARED_MODULE ${RBLXBUILD_SYCL_CREATE_SHARED_LIBRARY})
endif()

if(NOT DEFINED RBLXBUILD_SYCL_ARCHIVE_CREATE)
  set(RBLXBUILD_SYCL_ARCHIVE_CREATE "<RBLXBUILD_AR> qc <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_SYCL_ARCHIVE_APPEND)
  set(RBLXBUILD_SYCL_ARCHIVE_APPEND "<RBLXBUILD_AR> q <TARGET> <LINK_FLAGS> <OBJECTS>")
endif()
if(NOT DEFINED RBLXBUILD_SYCL_ARCHIVE_FINISH)
  set(RBLXBUILD_SYCL_ARCHIVE_FINISH "<RBLXBUILD_RANLIB> <TARGET>")
endif()

if(NOT RBLXBUILD_SYCL_COMPILE_OBJECT)
  set(RBLXBUILD_SYCL_COMPILE_OBJECT
    "<RBLXBUILD_SYCL_COMPILER> ${_RBLXBUILD_SYCL_REQUIRED_FLAG} <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")
endif()

if(NOT RBLXBUILD_SYCL_LINK_EXECUTABLE)
  set(RBLXBUILD_SYCL_LINK_EXECUTABLE
    "<RBLXBUILD_SYCL_COMPILER> ${_RBLXBUILD_SYCL_REQUIRED_FLAG} <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
endif()

if(RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS)
  set(RBLXBUILD_SYCL_DEVICE_LINK_MODE DRIVER)
  set(RBLXBUILD_SYCL_DEVICE_LINKER_WRAPPER_FLAG ${RBLXBUILD_SYCL_LINKER_WRAPPER_FLAG})
  set(RBLXBUILD_SYCL_DEVICE_LINKER_WRAPPER_FLAG_SEP ${RBLXBUILD_SYCL_LINKER_WRAPPER_FLAG_SEP})
  set(RBLXBUILD_SYCL_RESPONSE_FILE_DEVICE_LINK_FLAG "@")
  string(JOIN " " pic_options ${RBLXBUILD_SYCL_COMPILE_OPTIONS_PIC})
  string(JOIN " " device_options ${RBLXBUILD_SYCL_DEVICE_LINK_OPTIONS})
  if(NOT RBLXBUILD_SYCL_DEVICE_LINK_LIBRARY)
    set(RBLXBUILD_SYCL_DEVICE_LINK_LIBRARY
      "<RBLXBUILD_SYCL_COMPILER> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${pic_options} ${device_options} -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
  endif()
  if(NOT RBLXBUILD_SYCL_DEVICE_LINK_EXECUTABLE)
    set(RBLXBUILD_SYCL_DEVICE_LINK_EXECUTABLE "${RBLXBUILD_SYCL_DEVICE_LINK_LIBRARY}")
  endif()
  unset(device_options)
  unset(pic_options)
endif()

mark_as_advanced(RBLXBUILD_VERBOSE_MAKEFILE)

set(RBLXBUILD_SYCL_USE_LINKER_INFORMATION TRUE)

set(RBLXBUILD_SYCL_INFORMATION_LOADED 1)
