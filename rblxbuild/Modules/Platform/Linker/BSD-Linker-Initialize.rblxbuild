if(NOT _RBLXBUILD_SYSTEM_LINKER_TYPE)
  block(SCOPE_FOR VARIABLES)
    execute_process(COMMAND "${RBLXBUILD_LINKER}" --version
                    RESULT_VARIABLE result
                    OUTPUT_VARIABLE output
                    ERROR_VARIABLE output)
    if(NOT result EQUAL 0 OR NOT output MATCHES "LLD")
      # assume GNU as default linker
      set(_RBLXBUILD_SYSTEM_LINKER_TYPE GNU CACHE INTERNAL "System linker type")
    else()
      set(_RBLXBUILD_SYSTEM_LINKER_TYPE LLD CACHE INTERNAL "System linker type")
    endif()
  endblock()
endif()
