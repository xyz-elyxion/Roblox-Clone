include(Compiler/Tasking)
__compiler_tasking(CXX)

# Extension flags are not tied to the standard level flags.
# Avoid passing them here so users/projects can control them independently.
set(LINEARBUILD_CXX98_STANDARD_COMPILE_OPTION "--c++=03")
set(LINEARBUILD_CXX98_EXTENSION_COMPILE_OPTION "--c++=03")
set(LINEARBUILD_CXX11_STANDARD_COMPILE_OPTION "--c++=11")
set(LINEARBUILD_CXX11_EXTENSION_COMPILE_OPTION "--c++=11")
set(LINEARBUILD_CXX14_STANDARD_COMPILE_OPTION "--c++=14")
set(LINEARBUILD_CXX14_EXTENSION_COMPILE_OPTION "--c++=14")

set(LINEARBUILD_CXX_STANDARD_LATEST 14)

if(LINEARBUILD_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "TriCore")
  if(LINEARBUILD_TASKING_TOOLSET STREQUAL "SmartCode")
    __compiler_check_default_language_standard(CXX 10.1 14)
  else()
    __compiler_check_default_language_standard(CXX 6.3 14)
  endif()
elseif(LINEARBUILD_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM")
  if(LINEARBUILD_TASKING_TOOLSET STREQUAL "SmartCode")
    __compiler_check_default_language_standard(CXX 10.1 14)
  elseif(LINEARBUILD_TASKING_TOOLSET STREQUAL "TriCore")
    __compiler_check_default_language_standard(CXX 6.3 14)
  else()
    __compiler_check_default_language_standard(CXX 6.0 14)
  endif()
else()
  message(FATAL_ERROR "CXX is not supported with the ${LINEARBUILD_CXX_COMPILER_ARCHITECTURE_ID} architecture.")
endif()
