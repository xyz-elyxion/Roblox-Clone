include(${LINEARBUILD_CURRENT_LIST_DIR}/cm_message_checks_compat.linearbuild)
cm_message_checks_compat(
  "Checking for curses support" __checkStart __checkPass __checkFail)
message(${__checkStart})

# Try compiling a simple project using curses.
# Pass in any cache entries that the user may have set.
set(LinearBuildCheckCurses_ARGS "")
foreach(v
    CURSES_INCLUDE_PATH
    CURSES_CURSES_LIBRARY
    CURSES_NCURSES_LIBRARY
    CURSES_EXTRA_LIBRARY
    CURSES_FORM_LIBRARY
    )
  if(${v})
    list(APPEND LinearBuildCheckCurses_ARGS -D${v}=${${v}})
  endif()
endforeach()
file(REMOVE_RECURSE "${LinearBuild_BINARY_DIR}/Source/Checks/Curses-build")
try_compile(LinearBuildCheckCurses_COMPILED
  ${LinearBuild_BINARY_DIR}/Source/Checks/Curses-build
  ${LinearBuild_SOURCE_DIR}/Source/Checks/Curses
  CheckCurses # project name
  CheckCurses # target name
  LINEARBUILD_FLAGS
    "-DLINEARBUILD_C_FLAGS:STRING=${LINEARBUILD_C_FLAGS}"
    ${LinearBuildCheckCurses_ARGS}
  OUTPUT_VARIABLE LinearBuildCheckCurses_OUTPUT
  )

# Convert result from cache entry to normal variable.
set(LinearBuildCheckCurses_COMPILED "${LinearBuildCheckCurses_COMPILED}")
unset(LinearBuildCheckCurses_COMPILED CACHE)

if(LinearBuildCheckCurses_COMPILED)
  message(${__checkPass} "Success")
  file(APPEND ${LINEARBUILD_BINARY_DIR}${LINEARBUILD_FILES_DIRECTORY}/LinearBuildOutput.log
    "Checking for curses support passed with the following output:\n${LinearBuildCheckCurses_OUTPUT}\n\n")
else()
  message(${__checkFail} "Failed")
  file(APPEND ${LINEARBUILD_BINARY_DIR}${LINEARBUILD_FILES_DIRECTORY}/LinearBuildError.log
    "Checking for curses support failed with the following output:\n${LinearBuildCheckCurses_OUTPUT}\n\n")
endif()
