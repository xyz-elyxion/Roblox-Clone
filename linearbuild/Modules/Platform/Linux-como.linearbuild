# create a shared C++ library
set(LINEARBUILD_CXX_CREATE_SHARED_LIBRARY
    "<LINEARBUILD_CXX_COMPILER> --prelink_objects <OBJECTS>"
    "<LINEARBUILD_CXX_COMPILER> <LINK_FLAGS> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")

# create a C++ static library
set(LINEARBUILD_CXX_CREATE_STATIC_LIBRARY
    "<LINEARBUILD_CXX_COMPILER> --prelink_objects <OBJECTS>"
    "<LINEARBUILD_AR> cr <TARGET> <LINK_FLAGS> <OBJECTS> "
    "<LINEARBUILD_RANLIB> <TARGET> ")

set(LINEARBUILD_CXX_LINK_EXECUTABLE
    "<LINEARBUILD_CXX_COMPILER> --prelink_objects <OBJECTS>"
    "<LINEARBUILD_CXX_COMPILER> <LINK_FLAGS> <FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(LINEARBUILD_SHARED_LIBRARY_RUNTIME_C_FLAG "")
set(LINEARBUILD_SHARED_LIBRARY_C_FLAGS "")
