  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Source\"` \
  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Source/LexerParser\"` \
  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Utilities\"`"
rblxbuild_cxx_flags="${rblxbuild_cxx_flags} \
  -DRBLXBUILD_BOOTSTRAP \
  ${rblxbuild_have_cxx_features} \
  -I`rblxbuild_escape_shell \"${rblxbuild_bootstrap_dir}\"` \
  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Source\"` \
  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Source/LexerParser\"` \
  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Utilities/std\"` \
  -I`rblxbuild_escape_shell \"${rblxbuild_source_dir}/Utilities\"`"
if test "${rblxbuild_bootstrap_generator}" = "Ninja"; then
  echo "cc = ${rblxbuild_c_compiler}" > "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "cxx = ${rblxbuild_cxx_compiler}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "cflags = ${rblxbuild_c_flags}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "cxxflags = ${rblxbuild_cxx_flags}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "ldflags = ${rblxbuild_ld_flags}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "rule cc" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "  command = \$cc \$cflags \$srcflags -c \$in -o \$out" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "rule cxx" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "  command = \$cxx \$cxxflags \$srcflags -c \$in -o \$out" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "rule link" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "  command = \$cxx \$ldflags \$cxxflags \$in \$libs -o \$out" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "build rblxbuild: link ${objs}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
  echo "  libs = ${libs}" >> "${rblxbuild_bootstrap_dir}/build.ninja"
else
  echo "rblxbuild: ${objs}" > "${rblxbuild_bootstrap_dir}/Makefile"
  echo "${tab}${rblxbuild_cxx_compiler} ${rblxbuild_ld_flags} ${rblxbuild_cxx_flags} ${objs} ${libs} -o rblxbuild" >> "${rblxbuild_bootstrap_dir}/Makefile"
fi
for a in ${RBLXBUILD_CXX_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Source/${a}.cxx"`
  src_flags=`eval echo \\${rblxbuild_cxx_flags_\${a}}`
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
for a in ${RBLXBUILD_C_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Source/${a}.c"`
  write_source_rule "c" "${a}.o" "${src}" ""
done
for a in ${RBLXBUILD_STD_CXX_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Utilities/std/cm/bits/${a}.cxx"`
  src_flags=`eval echo \\${rblxbuild_cxx_flags_\${a}}`
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
for a in ${LexerParser_CXX_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Source/LexerParser/${a}.cxx"`
  src_flags=`eval echo \\${rblxbuild_cxx_flags_\${a}}`
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
for a in ${LexerParser_C_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Source/LexerParser/${a}.c"`
  write_source_rule "c" "${a}.o" "${src}" ""
done
for a in ${KWSYS_C_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Source/kwsys/${a}.c"`
  src_flags="`eval echo \\${rblxbuild_c_flags_\${a}}` -DKWSYS_NAMESPACE=cmsys"
  write_source_rule "c" "${a}.o" "${src}" "${src_flags}"
done
for a in ${KWSYS_CXX_SOURCES}; do
  src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Source/kwsys/${a}.cxx"`
  src_flags="`eval echo \\${rblxbuild_cxx_flags_\${a}}` -DKWSYS_NAMESPACE=cmsys"
  write_source_rule "cxx" "${a}.o" "${src}" "${src_flags}"
done
if test "x${bootstrap_system_libuv}" = "x"; then
  for a in ${LIBUV_C_SOURCES}; do
    src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Utilities/cmlibuv/${a}"`
    write_source_rule "c" "uv-`rblxbuild_obj ${a}`" "${src}" "${uv_c_flags}"
  done
fi
if test "x${bootstrap_system_librhash}" = "x"; then
  for a in ${LIBRHASH_C_SOURCES}; do
    src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Utilities/cmlibrhash/${a}"`
    write_source_rule "c" "rhash-`rblxbuild_obj ${a}`" "${src}" "${librhash_c_flags}"
  done
fi
if test "x${bootstrap_system_jsoncpp}" = "x"; then
  for a in ${JSONCPP_CXX_SOURCES}; do
    src=`rblxbuild_escape_artifact "${rblxbuild_source_dir}/Utilities/cmjsoncpp/${a}"`
    write_source_rule "cxx" "jsoncpp-`rblxbuild_obj ${a}`" "${src}" "${jsoncpp_cxx_flags}"
  done
fi
if test "${rblxbuild_bootstrap_generator}" = "Ninja"; then
  echo "
rule rebuild_cache
  command = cd \"${rblxbuild_binary_dir}\" && \"${rblxbuild_source_dir}/bootstrap\" --generator=\"${rblxbuild_bootstrap_generator}\"
  generator = 1
build build.ninja : rebuild_cache
" >> "${rblxbuild_bootstrap_dir}/build.ninja"
else
  echo "
rebuild_cache:
${tab}cd \"${rblxbuild_binary_dir}\" && \"${rblxbuild_source_dir}/bootstrap\" --generator=\"${rblxbuild_bootstrap_generator}\"
" >> "${rblxbuild_bootstrap_dir}/Makefile"
fi

# Write our default settings to Bootstrap${_cmk}/InitialCacheFlags.rblxbuild.
echo '
# Generated by '"${rblxbuild_source_dir}"'/bootstrap
# Default rblxbuild settings.  These may be overridden any settings below.
set (RBLXBUILD_BUILD_TYPE "Release" CACHE STRING "Choose the type of build.") # not FORCE to preserve defaults specified elsewhere
set (RBLXBUILD_INSTALL_PREFIX "'"${rblxbuild_prefix_dir}"'" CACHE PATH "Install path prefix, prepended onto install directories." FORCE)
set (RBLXBUILD_DOC_DIR "'"${rblxbuild_doc_dir}"'" CACHE PATH "Install location for documentation (relative to prefix)." FORCE)
set (RBLXBUILD_MAN_DIR "'"${rblxbuild_man_dir}"'" CACHE PATH "Install location for man pages (relative to prefix)." FORCE)
set (RBLXBUILD_BIN_DIR "'"${rblxbuild_bin_dir}"'" CACHE PATH "Install location for binaries (relative to prefix)." FORCE)
set (RBLXBUILD_DATA_DIR "'"${rblxbuild_data_dir}"'" CACHE PATH "Install location for data (relative to prefix)." FORCE)
set (RBLXBUILD_XDGDATA_DIR "'"${rblxbuild_xdgdata_dir}"'" CACHE PATH "Install location for XDG specific files (relative to prefix)." FORCE)
' > "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"

# Add configuration settings given as command-line options.
if test "x${rblxbuild_bootstrap_qt_gui}" != "x"; then
  echo '
set (BUILD_QtDialog '"${rblxbuild_bootstrap_qt_gui}"' CACHE BOOL "Build Qt dialog for RBLXBuild" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_bootstrap_qt_qmake}" != "x"; then
  echo '
set (QT_QMAKE_EXECUTABLE "'"${rblxbuild_bootstrap_qt_qmake}"'" CACHE FILEPATH "Location of Qt qmake" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_bootstrap_debugger}" != "x"; then
  echo '
set (RBLXBuild_ENABLE_DEBUGGER '"${rblxbuild_bootstrap_debugger}"' CACHE BOOL "Enable RBLXBuild debugger support" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_html_copybutton}" != "x"; then
  echo '
set (SPHINX_HTML_COPYBUTTON "'"${rblxbuild_sphinx_html_copybutton}"'" CACHE BOOL "Build html help with the sphinx-copybutton extension" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_info}" != "x"; then
  echo '
set (SPHINX_INFO "'"${rblxbuild_sphinx_info}"'" CACHE BOOL "Build Info manual with Sphinx" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_man}" != "x"; then
  echo '
set (SPHINX_MAN "'"${rblxbuild_sphinx_man}"'" CACHE BOOL "Build man pages with Sphinx" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_html}" != "x"; then
  echo '
set (SPHINX_HTML "'"${rblxbuild_sphinx_html}"'" CACHE BOOL "Build html help with Sphinx" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_qthelp}" != "x"; then
  echo '
set (SPHINX_QTHELP "'"${rblxbuild_sphinx_qthelp}"'" CACHE BOOL "Build qch help with Sphinx" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_latexpdf}" != "x"; then
  echo '
set (SPHINX_LATEXPDF "'"${rblxbuild_sphinx_latexpdf}"'" CACHE BOOL "Build PDF help with Sphinx using LaTeX" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_build}" != "x"; then
  echo '
set (SPHINX_EXECUTABLE "'"${rblxbuild_sphinx_build}"'" CACHE FILEPATH "Location of Qt sphinx-build" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
if test "x${rblxbuild_sphinx_flags}" != "x"; then
  echo '
set (SPHINX_FLAGS [==['"${rblxbuild_sphinx_flags}"']==] CACHE STRING "Flags to pass to sphinx-build" FORCE)
' >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi

# Add user-specified settings.  Handle relative-path case for
# specification of rblxbuild_init_file.
(
cd "${rblxbuild_binary_dir}"
if test -f "${rblxbuild_init_file}"; then
  cat "${rblxbuild_init_file}" >> "${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild"
fi
)

echo "---------------------------------------------"

# Run make to build bootstrap rblxbuild
if test "${rblxbuild_bootstrap_generator}" = "Ninja"; then
  ninja_v=-v
else
  ninja_v=
fi
if test "x${rblxbuild_parallel_make}" != "x"; then
  ${rblxbuild_make_processor} ${rblxbuild_make_flags} ${ninja_v}
else
  ${rblxbuild_make_processor} ${ninja_v}
fi
RES=$?
if test "${RES}" -ne "0"; then
  rblxbuild_error 9 "Problem while running ${rblxbuild_make_processor}"
fi
cd "${rblxbuild_binary_dir}"

# Set C, CXX, and MAKE environment variables, so that real real rblxbuild will be
# build with same compiler and make
CC="${rblxbuild_c_compiler}"
CXX="${rblxbuild_cxx_compiler}"
MAKE="${rblxbuild_make_processor}"
export CC
export CXX
export MAKE
export CFLAGS
export CXXFLAGS
export LDFLAGS

# Run bootstrap RBLXBuild to configure real RBLXBuild
rblxbuild_options="-DRBLXBUILD_BOOTSTRAP=1"
if test -n "${rblxbuild_verbose}"; then
  rblxbuild_options="${rblxbuild_options} -DRBLXBUILD_VERBOSE_MAKEFILE=1"
fi
"${rblxbuild_bootstrap_dir}/rblxbuild" "${rblxbuild_source_dir}" "-C${rblxbuild_bootstrap_dir}/InitialCacheFlags.rblxbuild" "-G${rblxbuild_bootstrap_generator}" ${rblxbuild_options} ${rblxbuild_bootstrap_system_libs} "$@"
RES=$?
if test "${RES}" -ne "0"; then
  rblxbuild_error 11 "Problem while running initial RBLXBuild"
fi

echo "---------------------------------------------"

# And we are done. Now just run make
echo "RBLXBuild has bootstrapped.  Now run ${rblxbuild_make_processor}."
