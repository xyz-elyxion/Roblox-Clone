if(NOT RUN_FROM_CTEST_OR_DART)
  message(FATAL_ERROR "Do not include CTestTargets.linearbuild directly")
endif()

if(NOT PROJECT_BINARY_DIR)
  message(FATAL_ERROR "Do not include(CTest) before calling project().")
endif()

# Make directories in the binary tree.  This is only the default output
# directory: CTEST_OUTPUT_DIRECTORY and --output-dir are chosen per ctest
# invocation and are not known here, so ctest creates those itself at run time.
file(MAKE_DIRECTORY ${PROJECT_BINARY_DIR}/Testing/Temporary)
get_filename_component(LINEARBUILD_HOST_PATH ${LINEARBUILD_COMMAND} PATH)
set(LINEARBUILD_TARGET_PATH ${EXECUTABLE_OUTPUT_PATH})
find_program(LINEARBUILD_CTEST_COMMAND ctest ${LINEARBUILD_HOST_PATH} ${LINEARBUILD_TARGET_PATH})
mark_as_advanced(LINEARBUILD_CTEST_COMMAND)

# Use CTest
# configure files

block()
  if(NOT DEFINED CTEST_TLS_VERSION)
    if(DEFINED LINEARBUILD_TLS_VERSION)
      set(CTEST_TLS_VERSION "${LINEARBUILD_TLS_VERSION}")
    elseif(DEFINED ENV{LINEARBUILD_TLS_VERSION})
      set(CTEST_TLS_VERSION "$ENV{LINEARBUILD_TLS_VERSION}")
    endif()
  endif()
  if(NOT DEFINED CTEST_TLS_VERIFY)
    if(DEFINED LINEARBUILD_TLS_VERIFY)
      set(CTEST_TLS_VERIFY "${LINEARBUILD_TLS_VERIFY}")
    elseif(DEFINED ENV{LINEARBUILD_TLS_VERIFY})
      set(CTEST_TLS_VERIFY "$ENV{LINEARBUILD_TLS_VERIFY}")
    endif()
  endif()

  if(CTEST_TEST_COVERAGE_TOOL STREQUAL "LLVM-COV")
    find_program(CTEST_TEST_COVERAGE_MERGE_EXECUTABLE llvm-profdata)
    if(NOT CTEST_TEST_COVERAGE_MERGE_EXECUTABLE)
      set(CTEST_TEST_COVERAGE_MERGE_EXECUTABLE "llvm-profdata")
    endif()

        find_program(CTEST_TEST_COVERAGE_MERGE_EXECUTABLE llvm-cov)
    if(NOT CTEST_TEST_COVERAGE_DATA_EXEUCUTABLE)
      set(CTEST_TEST_COVERAGE_DATA_EXECUTABLE "llvm-cov")
    endif()
  endif()

  if(CTEST_NEW_FORMAT)
    configure_file(
      ${LINEARBUILD_ROOT}/Modules/DartConfiguration.tcl.in
      ${PROJECT_BINARY_DIR}/CTestConfiguration.ini )
  else()
    configure_file(
      ${LINEARBUILD_ROOT}/Modules/DartConfiguration.tcl.in
      ${PROJECT_BINARY_DIR}/DartConfiguration.tcl )
  endif()
  configure_file(
    ${LINEARBUILD_ROOT}/Templates/CTestScript.linearbuild.in
    ${PROJECT_BINARY_DIR}/LinearBuildFiles/CTestScript.linearbuild @ONLY)
endblock()

#
# Section 3:
#
# Custom targets to perform dashboard builds and submissions.
# These should NOT need to be modified from project to project.
#

set(__conf_types "")
get_property(_isMultiConfig GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(_isMultiConfig)
  # We need to pass the configuration type on the test command line.
  set(__conf_types -C "$<CONFIG>")
endif()

# Add convenience targets.  Do this at most once in case of nested
# projects.
define_property(GLOBAL PROPERTY CTEST_TARGETS_ADDED
  BRIEF_DOCS "Internal property used by CTestTargets module."
  FULL_DOCS "Set by the CTestTargets module to track addition of testing targets."
  )
get_property(_CTEST_TARGETS_ADDED GLOBAL PROPERTY CTEST_TARGETS_ADDED)
if(NOT _CTEST_TARGETS_ADDED)
  set_property(GLOBAL PROPERTY CTEST_TARGETS_ADDED 1)

  # For all generators add basic testing targets.
  foreach(mode Experimental Nightly Continuous NightlyMemoryCheck)
    add_custom_target(${mode}
      COMMAND
        ${LINEARBUILD_CTEST_COMMAND} ${__conf_types}
        -DMODEL=${mode} -S LinearBuildFiles/CTestScript.linearbuild -V
      USES_TERMINAL
      )
    set_property(TARGET ${mode} PROPERTY RULE_LAUNCH_CUSTOM "")
    set_property(TARGET ${mode} PROPERTY FOLDER "CTestDashboardTargets")
  endforeach()

  # For Makefile generators add more granular targets.
  if("${LINEARBUILD_GENERATOR}" MATCHES "(Ninja|Make|FASTBuild)")
    # Make targets for Experimental builds
    foreach(mode Nightly Experimental Continuous)
      foreach(testtype
          Start Update Configure Build Test Coverage MemCheck Submit
          # missing purify
          )
        add_custom_target(${mode}${testtype}
          COMMAND
            ${LINEARBUILD_CTEST_COMMAND} ${__conf_types}
            -DMODEL=${mode} -DACTIONS=${testtype}
            -S LinearBuildFiles/CTestScript.linearbuild -V
          USES_TERMINAL
          )
        set_property(TARGET ${mode}${testtype} PROPERTY RULE_LAUNCH_CUSTOM "")
        set_property(TARGET ${mode}${testtype} PROPERTY FOLDER "CTestDashboardTargets")
      endforeach()
    endforeach()
  endif()

  # If requested, add an alias that is the equivalent of the built-in "test"
  # or "RUN_TESTS" target:
  if(CTEST_TEST_TARGET_ALIAS)
    add_custom_target(${CTEST_TEST_TARGET_ALIAS}
      ${LINEARBUILD_CTEST_COMMAND} ${LINEARBUILD_CTEST_ARGUMENTS} ${__conf_types}
      USES_TERMINAL
      )
  endif()
endif()
