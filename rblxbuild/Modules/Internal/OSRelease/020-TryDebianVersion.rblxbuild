if(NOT EXISTS "${RBLXBUILD_SYSROOT}/etc/debian_version")
  return()
endif()

# Get the first string only
file(
    STRINGS "${RBLXBUILD_SYSROOT}/etc/debian_version" RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT
    LIMIT_COUNT 1
  )

#
# Example:
#   6.0.10          # Old debian
#   wheezy/sid      # Ubuntu
#
if(RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT MATCHES "[0-9]+(\.[0-9]+)*")

  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME Debian)
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID debian)
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION ${RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT})
  set(RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID ${RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT})

  list(
      APPEND RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_NAME
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_ID
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION
      RBLXBUILD_GET_OS_RELEASE_FALLBACK_RESULT_VERSION_ID
    )

endif()

unset(RBLXBUILD_GET_OS_RELEASE_FALLBACK_CONTENT)
