# Compiler options depend on the underlying compiler, not the AdaptiveCpp
# release number.  Restore the public version after initializing the options.
set(_LINEARBUILD_SYCL_ADAPTIVECPP_VERSION "${LINEARBUILD_SYCL_COMPILER_VERSION}")
set(LINEARBUILD_SYCL_COMPILER_VERSION "${LINEARBUILD_SYCL_HOST_COMPILER_VERSION}")
set(_LINEARBUILD_SYCL_REQUIRED_FLAG "")
if(LINEARBUILD_SYCL_HOST_COMPILER_ID STREQUAL "Clang")
  include(Compiler/Clang-SYCL)
elseif(LINEARBUILD_SYCL_HOST_COMPILER_ID STREQUAL "GNU")
  include(Compiler/GNU)
  __compiler_gnu(SYCL)
  __compiler_gnu_cxx_standards(SYCL)
  set(LINEARBUILD_SYCL_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN
    "-fvisibility-inlines-hidden")
else()
  message(FATAL_ERROR
    "AdaptiveCpp host compiler '${LINEARBUILD_SYCL_HOST_COMPILER_ID}' is not supported.")
endif()
set(LINEARBUILD_SYCL_COMPILER_VERSION "${_LINEARBUILD_SYCL_ADAPTIVECPP_VERSION}")
unset(_LINEARBUILD_SYCL_ADAPTIVECPP_VERSION)

foreach(std IN ITEMS 98 11 14)
  unset(LINEARBUILD_SYCL${std}_STANDARD_COMPILE_OPTION)
  unset(LINEARBUILD_SYCL${std}_EXTENSION_COMPILE_OPTION)
endforeach()
