if(UNIX)
  set(RBLXBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_ASM${ASM_DIALECT}_OUTPUT_EXTENSION .obj)
endif()

set(RBLXBUILD_ASM${ASM_DIALECT}_COMPILE_OBJECT "<RBLXBUILD_ASM${ASM_DIALECT}_COMPILER> <INCLUDES> <FLAGS> -o <OBJECT> <SOURCE>")

set(RBLXBUILD_ASM${ASM_DIALECT}_CREATE_STATIC_LIBRARY
      "<RBLXBUILD_AR> cr <TARGET> <LINK_FLAGS> <OBJECTS> "
      "<RBLXBUILD_RANLIB> <TARGET> ")

set(RBLXBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE
    "<RBLXBUILD_LINKER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

# to be done
set(RBLXBUILD_ASM${ASM_DIALECT}_CREATE_SHARED_LIBRARY)
set(RBLXBUILD_ASM${ASM_DIALECT}_CREATE_SHARED_MODULE)
