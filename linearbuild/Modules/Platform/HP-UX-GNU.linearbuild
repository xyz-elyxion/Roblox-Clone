# This module is shared by multiple languages; use include blocker.
if(__HPUX_COMPILER_GNU)
  return()
endif()
set(__HPUX_COMPILER_GNU 1)

macro(__hpux_compiler_gnu lang)
  string(APPEND LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS " -Wl,-E,-b,+nodefaultrpath")
  set(LINEARBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS "-Wl,-E")
  set(LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG "-Wl,+b")
  set(LINEARBUILD_SHARED_LIBRARY_RUNTIME_${lang}_FLAG_SEP ":")
  set(LINEARBUILD_SHARED_LIBRARY_SONAME_${lang}_FLAG "-Wl,+h")

  set(LINEARBUILD_EXECUTABLE_CREATE_${lang}_FLAGS "-Wl,+s,+nodefaultrpath")
  linearbuild_policy(GET CMP0210 _CMP0210)
  if (NOT _CMP0210 STREQUAL "NEW")
    set(LINEARBUILD_${lang}_LINK_FLAGS "${LINEARBUILD_EXECUTABLE_CREATE_${lang}_FLAGS}")
  endif()
  unset(_CMP0210)

  unset(LINEARBUILD_${lang}_COMPILE_OPTIONS_VISIBILITY)
endmacro()
