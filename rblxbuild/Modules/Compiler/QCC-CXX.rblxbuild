# To include compiler feature detection
include(Compiler/GNU-CXX)

include(Compiler/QCC)
__compiler_qcc(CXX)

# If the toolchain uses qcc for RBLXBUILD_CXX_COMPILER instead of QCC, the
# default for the driver is not c++.
if (RBLXBUILD_CXX_COMPILER_VERSION VERSION_LESS "12.2.0") # QNX 8.0 toolchain
  set(_rblxbuild_qcc_cxx_lang_compile_flag "-lang-c++")
  set(_rblxbuild_qcc_cxx_lang_link_flag "-lang-c++")
else ()
  set(_rblxbuild_qcc_cxx_lang_compile_flag "-x c++")
  set(_rblxbuild_qcc_cxx_lang_link_flag "")
endif ()
set(RBLXBUILD_CXX_COMPILE_OBJECT
  "<RBLXBUILD_CXX_COMPILER> ${_rblxbuild_qcc_cxx_lang_compile_flag} <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT> -c <SOURCE>")
set(RBLXBUILD_CXX_LINK_EXECUTABLE
  "<RBLXBUILD_CXX_COMPILER> ${_rblxbuild_qcc_cxx_lang_link_flag} <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
unset(_rblxbuild_qcc_cxx_lang_compile_flag)
unset(_rblxbuild_qcc_cxx_lang_link_flag)

set(RBLXBUILD_CXX_COMPILE_OPTIONS_VISIBILITY_INLINES_HIDDEN "-fvisibility-inlines-hidden")
