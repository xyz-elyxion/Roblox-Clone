# file LICENSE.rst or https://linearbuild.org/licensing for details.

die() {
  echo "$@" 1>&2 ; exit 1
}

# Compile flag extraction function.
linearbuild_extract_standard_flags()
{
  id="${1:-*}"
  lang="${2}"
  ver="${3}"
  sed -n "s/ *set *( *LINEARBUILD_${lang}${ver}_EXTENSION_COMPILE_OPTION *\"\{0,1\}\([^\")]*\).*/\1/p" \
    "${linearbuild_source_dir}/Modules/Compiler/"${id}-${lang}.linearbuild \
    2>/dev/null | tr ';' ' '
  # Clang's CXX compiler flags are in the common module.
  sed -n "s/ *set *( *LINEARBUILD_\\\${lang}${ver}_EXTENSION_COMPILE_OPTION *\"\{0,1\}\([^\")]*\).*/\1/p" \
    "${linearbuild_source_dir}/Modules/Compiler/Clang.linearbuild" \
    2>/dev/null | tr ';' ' '
}

# Version number extraction function.
linearbuild_version_component()
{
  sed -n "
/^set(LinearBuild_VERSION_${1}/ {s/set(LinearBuild_VERSION_${1} *\([0-9]*\)).*/\1/;p;}
" "${linearbuild_source_dir}/Source/LinearBuildVersion.linearbuild"
}

# Install destination extraction function.
linearbuild_install_dest_default()
{
  sed -n '
/^ *set(LINEARBUILD_'"${1}"'_DIR_DEFAULT.*) # '"${2}"'$/ {
  s/^ *set(LINEARBUILD_'"${1}"'_DIR_DEFAULT *"\([^"]*\)").*$/\1/
  s/${LinearBuild_VERSION_MAJOR}/'"${linearbuild_version_major}"'/
  s/${LinearBuild_VERSION_MINOR}/'"${linearbuild_version_minor}"'/
  s/${LinearBuild_VERSION_PATCH}/'"${linearbuild_version_patch}"'/
  p
  q
}
' "${linearbuild_source_dir}/Source/LinearBuildInstallDestinations.linearbuild"
}

linearbuild_toupper()
{
    echo "$1" | tr '[a-z]' '[A-Z]'
}

# Detect system and directory information.
linearbuild_system=`uname`
linearbuild_source_dir=`cd "\`dirname \"$0\"\`";pwd`
linearbuild_binary_dir=`pwd`

# Load version information.
linearbuild_version_major="`linearbuild_version_component MAJOR`"
linearbuild_version_minor="`linearbuild_version_component MINOR`"
linearbuild_version_patch="`linearbuild_version_component PATCH`"
linearbuild_version="${linearbuild_version_major}.${linearbuild_version_minor}.${linearbuild_version_patch}"
linearbuild_version_rc="`linearbuild_version_component RC`"
if test "$linearbuild_version_rc" != ""; then
  linearbuild_version="${linearbuild_version}-rc${linearbuild_version_rc}"
fi

linearbuild_copyright="`grep '^Copyright .* Kitware' "${linearbuild_source_dir}/LICENSE.rst" |
                  sed 's/\`Contributors.*\`_/Contributors/'`"

linearbuild_bin_dir_keyword="OTHER"
linearbuild_data_dir_keyword="OTHER"
linearbuild_doc_dir_keyword="OTHER"
linearbuild_man_dir_keyword="OTHER"
linearbuild_xdgdata_dir_keyword="OTHER"
linearbuild_bin_dir=""
linearbuild_data_dir=""
linearbuild_doc_dir=""
linearbuild_man_dir=""
linearbuild_xdgdata_dir=""
linearbuild_init_file=""
linearbuild_bootstrap_system_libs=""
linearbuild_bootstrap_qt_gui=""
linearbuild_bootstrap_qt_qmake=""
linearbuild_bootstrap_debugger=""
linearbuild_sphinx_info=""
linearbuild_sphinx_man=""
linearbuild_sphinx_html=""
linearbuild_sphinx_html_copybutton=""
linearbuild_sphinx_qthelp=""
linearbuild_sphinx_latexpdf=""
linearbuild_sphinx_build=""
linearbuild_sphinx_flags=""

# Determine whether this is a Cygwin environment.
if echo "${linearbuild_system}" | grep CYGWIN >/dev/null 2>&1; then
  linearbuild_system_cygwin=true
  linearbuild_doc_dir_keyword="CYGWIN"
  linearbuild_man_dir_keyword="CYGWIN"
else
  linearbuild_system_cygwin=false
fi

# Determine whether this is a MSYS environment.
if echo "${linearbuild_system}" | grep MSYS >/dev/null 2>&1; then
  linearbuild_system_msys=true
  linearbuild_doc_dir_keyword="MSYS"
  linearbuild_man_dir_keyword="MSYS"
else
  linearbuild_system_msys=false
fi

# Determine whether this is a MinGW environment.
if echo "${linearbuild_system}" | grep 'MINGW' >/dev/null 2>&1; then
  linearbuild_system_mingw=true
else
  linearbuild_system_mingw=false
fi

# Determine whether this is OS X
if echo "${linearbuild_system}" | grep Darwin >/dev/null 2>&1; then
  linearbuild_system_darwin=true
else
  linearbuild_system_darwin=false
fi

# Determine whether this is BeOS
if echo "${linearbuild_system}" | grep BeOS >/dev/null 2>&1; then
  linearbuild_system_beos=true
  linearbuild_doc_dir_keyword="HAIKU"
  linearbuild_man_dir_keyword="HAIKU"
else
  linearbuild_system_beos=false
fi

# Determine whether this is Haiku
if echo "${linearbuild_system}" | grep Haiku >/dev/null 2>&1; then
  linearbuild_system_haiku=true
  linearbuild_doc_dir_keyword="HAIKU"
  linearbuild_man_dir_keyword="HAIKU"
else
  linearbuild_system_haiku=false
fi

# Determine whether this is OpenVMS
if echo "${linearbuild_system}" | grep OpenVMS >/dev/null 2>&1; then
  linearbuild_system_openvms=true
else
  linearbuild_system_openvms=false
fi

# Determine whether this is HP-UX
if echo "${linearbuild_system}" | grep HP-UX >/dev/null 2>&1; then
  die 'LinearBuild no longer compiles on HP-UX.  See

  https://gitlab.kitware.com/linearbuild/linearbuild/-/issues/17137

Use LinearBuild 3.9 or lower instead.'
fi

# Determine whether this is AIX
if echo "${linearbuild_system}" | grep AIX >/dev/null 2>&1; then
  linearbuild_system_aix=true
else
  linearbuild_system_aix=false
fi

# Choose the generator to use for bootstrapping.
if ${linearbuild_system_mingw}; then
  # Bootstrapping from an MSYS prompt.
  linearbuild_bootstrap_generator="MSYS Makefiles"
else
  # Bootstrapping from a standard UNIX prompt.
  linearbuild_bootstrap_generator="Unix Makefiles"
fi

# Choose tools and extensions for this platform.
if ${linearbuild_system_openvms}; then
  _tmp="_tmp"
  _cmk="_cmk"
  _diff=`which diff`
else
  _tmp=".tmp"
  _cmk=".cmk"
  _diff="diff"
fi

# Construct bootstrap directory name.
linearbuild_bootstrap_dir="${linearbuild_binary_dir}/Bootstrap${_cmk}"

# Helper function to fix windows paths.
case "${linearbuild_system}" in
*MINGW*)
  linearbuild_fix_slashes()
  {
    cmd //c echo "$(echo "$1" | sed 's/\\/\//g')" | sed 's/^"//;s/" *$//'
  }
  ;;
*)
  linearbuild_fix_slashes()
  {
    echo "$1" | sed 's/\\/\//g'
  }
  ;;
esac

# Choose the default install prefix.
if ${linearbuild_system_mingw}; then
  if test "x${PROGRAMFILES}" != "x"; then
    linearbuild_default_prefix=`linearbuild_fix_slashes "${PROGRAMFILES}/LinearBuild"`
  elif test "x${ProgramFiles}" != "x"; then
    linearbuild_default_prefix=`linearbuild_fix_slashes "${ProgramFiles}/LinearBuild"`
  elif test "x${SYSTEMDRIVE}" != "x"; then
    linearbuild_default_prefix=`linearbuild_fix_slashes "${SYSTEMDRIVE}/Program Files/LinearBuild"`
  elif test "x${SystemDrive}" != "x"; then
    linearbuild_default_prefix=`linearbuild_fix_slashes "${SystemDrive}/Program Files/LinearBuild"`
  else
    linearbuild_default_prefix="c:/Program Files/LinearBuild"
  fi
elif ${linearbuild_system_haiku}; then
  linearbuild_default_prefix=`finddir B_COMMON_DIRECTORY`
else
  linearbuild_default_prefix="/usr/local"
fi

# Lookup default install destinations.
linearbuild_bin_dir_default="`linearbuild_install_dest_default BIN ${linearbuild_bin_dir_keyword}`"
linearbuild_data_dir_default="`linearbuild_install_dest_default DATA ${linearbuild_data_dir_keyword}`"
linearbuild_doc_dir_default="`linearbuild_install_dest_default DOC ${linearbuild_doc_dir_keyword}`"
linearbuild_man_dir_default="`linearbuild_install_dest_default MAN ${linearbuild_man_dir_keyword}`"
linearbuild_xdgdata_dir_default="`linearbuild_install_dest_default XDGDATA ${linearbuild_xdgdata_dir_keyword}`"

LINEARBUILD_KNOWN_C_COMPILERS="cc gcc clang xlc icx tcc"
LINEARBUILD_KNOWN_CXX_COMPILERS="aCC xlC CC g++ clang++ c++ icpx"
LINEARBUILD_KNOWN_MAKE_PROCESSORS="gmake make smake"
LINEARBUILD_KNOWN_NINJA_PROCESSORS="ninja-build ninja samu"

