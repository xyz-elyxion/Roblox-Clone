if(LINEARBUILD_C_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(LINEARBUILD_C_COMPILER_WORKS TRUE)
  return()
endif()

include(LinearBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${LINEARBUILD_TRY_COMPILE_TARGET_TYPE})
if(_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${_LINEARBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older LinearBuild version.
# We now store this in LinearBuildCCompiler.linearbuild.
unset(LINEARBUILD_C_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into LinearBuildCCompiler.linearbuild
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerABI.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_ABI(C ${LINEARBUILD_ROOT}/Modules/LinearBuildCCompilerABI.c)
if(LINEARBUILD_C_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(LINEARBUILD_C_COMPILER_WORKS TRUE)
  message(STATUS "Check for working C compiler: ${LINEARBUILD_C_COMPILER} - skipped")
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that that selected C compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and linearbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT LINEARBUILD_C_COMPILER_WORKS)
  PrintTestCompilerStatus("C")
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testCCompilerSource
    "#ifdef __cplusplus\n"
    "# error \"The LINEARBUILD_C_COMPILER is set to a C++ compiler\"\n"
    "#endif\n"
    "#if defined(__CLASSIC_C__)\n"
    "int main(argc, argv)\n"
    "  int argc;\n"
    "  char* argv[];\n"
    "#else\n"
    "int main(int argc, char* argv[])\n"
    "#endif\n"
    "{ (void)argv; return argc-1;}\n")
  # Clear result from normal variable.
  unset(LINEARBUILD_C_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(LINEARBUILD_C_COMPILER_WORKS
    SOURCE_FROM_VAR testCCompiler.c __TestCompiler_testCCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __LINEARBUILD_C_COMPILER_OUTPUT)
  unset(__TestCompiler_testCCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT LINEARBUILD_C_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__LINEARBUILD_C_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The C compiler\n  \"${LINEARBUILD_C_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "LinearBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerSupport.linearbuild)
LINEARBUILD_DETERMINE_COMPILER_SUPPORT(C)

# Re-configure to save learned information.
configure_file(
  ${LINEARBUILD_ROOT}/Modules/LinearBuildCCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCCompiler.linearbuild
  @ONLY
  )
include(${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCCompiler.linearbuild)

if(LINEARBUILD_C_SIZEOF_DATA_PTR)
  foreach(f ${LINEARBUILD_C_ABI_FILES})
    include(${f})
  endforeach()
  unset(LINEARBUILD_C_ABI_FILES)
endif()

set(LINEARBUILD_TRY_COMPILE_TARGET_TYPE ${__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__LINEARBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__LINEARBUILD_C_COMPILER_OUTPUT)
