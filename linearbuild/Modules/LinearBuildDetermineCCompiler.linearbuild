# determine the compiler to use for C programs
# NOTE, a generator may set LINEARBUILD_C_COMPILER before
# loading this file to force a compiler.
# use environment variable CC first if defined by user, next use
# the linearbuild variable LINEARBUILD_GENERATOR_CC which can be defined by a generator
# as a default compiler
# If the internal linearbuild variable _LINEARBUILD_TOOLCHAIN_PREFIX is set, this is used
# as prefix for the tools (e.g. arm-elf-gcc, arm-elf-ar etc.). This works
# currently with the GNU crosscompilers.
#
# Sets the following variables:
#   LINEARBUILD_C_COMPILER
#   LINEARBUILD_AR
#   LINEARBUILD_RANLIB
#
# If not already set before, it also sets
#   _LINEARBUILD_TOOLCHAIN_PREFIX

include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompiler.linearbuild)

# Load system-specific compiler preferences for this language.
include(Platform/${LINEARBUILD_SYSTEM_NAME}-Determine-C OPTIONAL)
include(Platform/${LINEARBUILD_SYSTEM_NAME}-C OPTIONAL)
if(NOT LINEARBUILD_C_COMPILER_NAMES)
  set(LINEARBUILD_C_COMPILER_NAMES cc)
endif()

if(${LINEARBUILD_GENERATOR} MATCHES "Visual Studio")
elseif("${LINEARBUILD_GENERATOR}" MATCHES "Green Hills MULTI")
elseif("${LINEARBUILD_GENERATOR}" MATCHES "Xcode")
  set(LINEARBUILD_C_COMPILER_XCODE_TYPE sourcecode.c.c)
  _linearbuild_find_compiler_path(C)
else()
  if(NOT LINEARBUILD_C_COMPILER)
    set(LINEARBUILD_C_COMPILER_INIT NOTFOUND)

    # prefer the environment variable CC
    if(NOT $ENV{CC} STREQUAL "")
      get_filename_component(LINEARBUILD_C_COMPILER_INIT $ENV{CC} PROGRAM PROGRAM_ARGS LINEARBUILD_C_FLAGS_ENV_INIT)
      if(LINEARBUILD_C_FLAGS_ENV_INIT)
        set(LINEARBUILD_C_COMPILER_ARG1 "${LINEARBUILD_C_FLAGS_ENV_INIT}" CACHE STRING "Arguments to C compiler")
      endif()
      if(NOT EXISTS ${LINEARBUILD_C_COMPILER_INIT})
        message(FATAL_ERROR "Could not find the compiler specified in the environment variable CC:\n$ENV{CC}.")
      endif()
    endif()

    # next try prefer the compiler specified by the generator
    if(LINEARBUILD_GENERATOR_CC)
      if(NOT LINEARBUILD_C_COMPILER_INIT)
        set(LINEARBUILD_C_COMPILER_INIT ${LINEARBUILD_GENERATOR_CC})
      endif()
    endif()

    # finally list compilers to try
    if(NOT LINEARBUILD_C_COMPILER_INIT)
      set(LINEARBUILD_C_COMPILER_LIST ${_LINEARBUILD_TOOLCHAIN_PREFIX}cc ${_LINEARBUILD_TOOLCHAIN_PREFIX}gcc cl bcc64x bcc xlc icx clang dpclang)
    endif()

    _linearbuild_find_compiler(C)

  else()
    _linearbuild_find_compiler_path(C)
  endif()
  mark_as_advanced(LINEARBUILD_C_COMPILER)

  # Each entry in this list is a set of extra flags to try
  # adding to the compile line to see if it helps produce
  # a valid identification file.
  set(LINEARBUILD_C_COMPILER_ID_TEST_FLAGS_FIRST)
  set(LINEARBUILD_C_COMPILER_ID_TEST_FLAGS
    # Try compiling to an object file only.
    "-c"

    # Try enabling ANSI mode on HP.
    "-Aa"

    # Try compiling K&R-compatible code (needed by Bruce C Compiler).
    "-D__CLASSIC_C__"

    # ARMClang need target options
    "--target=arm-arm-none-eabi -mcpu=cortex-m3"

    # MSVC needs at least one include directory for __has_include to function,
    # but custom toolchains may run MSVC with no INCLUDE env var and no -I flags.
    # Also avoid linking so this works with no LIB env var.
    "-c -I__does_not_exist__"
    )
endif()
if(LINEARBUILD_C_COMPILER_TARGET)
  set(LINEARBUILD_C_COMPILER_ID_TEST_FLAGS_FIRST "-c --target=${LINEARBUILD_C_COMPILER_TARGET}")
endif()
# Build a small source file to identify the compiler.
if(NOT LINEARBUILD_C_COMPILER_ID_RUN)
  set(LINEARBUILD_C_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(LINEARBUILD_C_COMPILER_ID)
  set(LINEARBUILD_C_PLATFORM_ID)
  file(READ ${LINEARBUILD_ROOT}/Modules/LinearBuildPlatformId.h.in
    LINEARBUILD_C_COMPILER_ID_PLATFORM_CONTENT)

  # The IAR compiler produces weird output.
  # See https://gitlab.kitware.com/linearbuild/linearbuild/-/issues/10176#note_153591
  list(APPEND LINEARBUILD_C_COMPILER_ID_VENDORS IAR)
  set(LINEARBUILD_C_COMPILER_ID_VENDOR_FLAGS_IAR )
  set(LINEARBUILD_C_COMPILER_ID_VENDOR_REGEX_IAR "IAR .+ Compiler")

  # Match the link line from xcodebuild output of the form
  #  Ld ...
  #      ...
  #      /path/to/cc ...CompilerIdC/...
  # to extract the compiler front-end for the language.
  set(LINEARBUILD_C_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdC/(\\./)?(CompilerIdC.(framework|xctest|build/[^ \t\r\n]+)/)?CompilerIdC[ \t\n\\\"]")
  set(LINEARBUILD_C_COMPILER_ID_TOOL_MATCH_INDEX 2)

  include(${LINEARBUILD_ROOT}/Modules/LinearBuildDetermineCompilerId.linearbuild)
  LINEARBUILD_DETERMINE_COMPILER_ID(C CFLAGS LinearBuildCCompilerId.c)

  _linearbuild_find_compiler_sysroot(C)

  # Set old compiler and platform id variables.
  if(LINEARBUILD_C_COMPILER_ID STREQUAL "GNU")
    set(LINEARBUILD_COMPILER_IS_GNUCC 1)
  endif()
else()
  if(NOT DEFINED LINEARBUILD_C_COMPILER_FRONTEND_VARIANT)
    # Some toolchain files set our internal LINEARBUILD_C_COMPILER_ID_RUN
    # variable but are not aware of LINEARBUILD_C_COMPILER_FRONTEND_VARIANT.
    # They pre-date our support for the GNU-like variant targeting the
    # MSVC ABI so we do not consider that here.
    if(LINEARBUILD_C_COMPILER_ID STREQUAL "Clang"
      OR "x${LINEARBUILD_C_COMPILER_ID}" STREQUAL "xDPClang"
      OR "x${LINEARBUILD_C_COMPILER_ID}" STREQUAL "xIntelLLVM")
      if("x${LINEARBUILD_C_SIMULATE_ID}" STREQUAL "xMSVC")
        set(LINEARBUILD_C_COMPILER_FRONTEND_VARIANT "MSVC")
      else()
        set(LINEARBUILD_C_COMPILER_FRONTEND_VARIANT "GNU")
      endif()
    else()
      set(LINEARBUILD_C_COMPILER_FRONTEND_VARIANT "")
    endif()
  endif()
endif()

if (NOT _LINEARBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_LINEARBUILD_TOOLCHAIN_LOCATION "${LINEARBUILD_C_COMPILER}" PATH)
endif ()

# If we have a gcc cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-gcc, arm-elf-gcc or i586-mingw32msvc-gcc, optionally
# with a 3-component version number at the end (e.g. arm-eabi-gcc-4.5.2).
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gcc.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"
if (NOT _LINEARBUILD_TOOLCHAIN_PREFIX)

  if(LINEARBUILD_C_COMPILER_ID MATCHES "GNU|Clang|QCC|LCC")
    get_filename_component(COMPILER_BASENAME "${LINEARBUILD_C_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+-)?(dpclang|clang|g?cc)(-cl)?(-?[0-9]+(\\.[0-9]+)*)?(-[^.]+)?(\\.exe)?$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
      set(_LINEARBUILD_TOOLCHAIN_SUFFIX ${LINEARBUILD_MATCH_4})
      set(_LINEARBUILD_COMPILER_SUFFIX ${LINEARBUILD_MATCH_6})
    elseif(LINEARBUILD_C_COMPILER_ID MATCHES "TIClang")
       if (COMPILER_BASENAME MATCHES "^(.+)?clang(\\.exe)?$")
         set(_LINEARBUILD_TOOLCHAIN_PREFIX "${LINEARBUILD_MATCH_1}")
         set(_LINEARBUILD_TOOLCHAIN_SUFFIX "${LINEARBUILD_MATCH_2}")
       endif()
    elseif(LINEARBUILD_C_COMPILER_ID MATCHES "Clang")
      if(LINEARBUILD_C_COMPILER_TARGET)
        set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_C_COMPILER_TARGET}-)
      endif()
    elseif(COMPILER_BASENAME MATCHES "qcc(\\.exe)?$")
      if(LINEARBUILD_C_COMPILER_TARGET MATCHES "gcc_nto([a-z0-9]+_[0-9]+|[^_le]+)(le)?")
        set(_LINEARBUILD_TOOLCHAIN_PREFIX nto${LINEARBUILD_MATCH_1}-)
      endif()
    endif ()

    # if "llvm-" is part of the prefix, remove it, since llvm doesn't have its own binutils
    # but uses the regular ar, objcopy, etc. (instead of llvm-objcopy etc.)
    if ("${_LINEARBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX ${LINEARBUILD_MATCH_1})
    endif ()
  elseif(LINEARBUILD_C_COMPILER_ID MATCHES "TI")
    # TI compilers are named e.g. cl6x, cl470 or armcl.exe
    get_filename_component(COMPILER_BASENAME "${LINEARBUILD_C_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+)?cl([^.]+)?(\\.exe)?$")
      set(_LINEARBUILD_TOOLCHAIN_PREFIX "${LINEARBUILD_MATCH_1}")
      set(_LINEARBUILD_TOOLCHAIN_SUFFIX "${LINEARBUILD_MATCH_2}")
    endif ()
  endif()

endif ()

set(_LINEARBUILD_PROCESSING_LANGUAGE "C")
include(LinearBuildFindBinUtils)
include(Compiler/${LINEARBUILD_C_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_LINEARBUILD_PROCESSING_LANGUAGE)

if(LINEARBUILD_C_COMPILER_SYSROOT)
  string(CONCAT _SET_LINEARBUILD_C_COMPILER_SYSROOT
    "set(LINEARBUILD_C_COMPILER_SYSROOT \"${LINEARBUILD_C_COMPILER_SYSROOT}\")\n"
    "set(LINEARBUILD_COMPILER_SYSROOT \"${LINEARBUILD_C_COMPILER_SYSROOT}\")")
else()
  set(_SET_LINEARBUILD_C_COMPILER_SYSROOT "")
endif()

if(MSVC_C_ARCHITECTURE_ID)
  set(SET_MSVC_C_ARCHITECTURE_ID
    "set(MSVC_C_ARCHITECTURE_ID ${MSVC_C_ARCHITECTURE_ID})")
endif()

if(LINEARBUILD_C_MSVC_I18N_DIR)
  set(SET_LINEARBUILD_C_MSVC_I18N_DIR
    "set(LINEARBUILD_C_MSVC_I18N_DIR ${LINEARBUILD_C_MSVC_I18N_DIR})")
endif()

if(LINEARBUILD_C_XCODE_ARCHS)
  set(SET_LINEARBUILD_XCODE_ARCHS
    "set(LINEARBUILD_XCODE_ARCHS \"${LINEARBUILD_C_XCODE_ARCHS}\")")
endif()

# configure variables set in this file for fast reload later on
configure_file(${LINEARBUILD_ROOT}/Modules/LinearBuildCCompiler.linearbuild.in
  ${LINEARBUILD_PLATFORM_INFO_DIR}/LinearBuildCCompiler.linearbuild
  @ONLY
  )
set(LINEARBUILD_C_COMPILER_ENV_VAR "CC")
