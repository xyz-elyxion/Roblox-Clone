set(LINEARBUILD_C_VERBOSE_FLAG "-v")

set(LINEARBUILD_C_CREATE_ASSEMBLY_SOURCE "<LINEARBUILD_C_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
set(LINEARBUILD_C_CREATE_PREPROCESSED_SOURCE "<LINEARBUILD_C_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")

set(LINEARBUILD_C_LINKER_WRAPPER_FLAG "-Wl,")
set(LINEARBUILD_C_LINKER_WRAPPER_FLAG_SEP ",")

set(LINEARBUILD_C_LINK_MODE DRIVER)
