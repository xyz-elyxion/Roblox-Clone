set(RBLXBUILD_CXX_COMPILER_ENV_VAR "CXX")

set(RBLXBUILD_CXX_COMPILER_ID_RUN 1)
set(RBLXBUILD_CXX_SOURCE_FILE_EXTENSIONS C;M;c++;cc;cpp;cxx;m;mm;mpp;CPP;ixx;cppm;ccm;cxxm;c++m)
set(RBLXBUILD_CXX_IGNORE_EXTENSIONS inl;h;hpp;HPP;H;o;O;obj;OBJ;def;DEF;rc;RC)

foreach (lang IN ITEMS C OBJC OBJCXX)
  if (RBLXBUILD_${lang}_COMPILER_ID_RUN)
    foreach(extension IN LISTS RBLXBUILD_${lang}_SOURCE_FILE_EXTENSIONS)
      list(REMOVE_ITEM RBLXBUILD_CXX_SOURCE_FILE_EXTENSIONS ${extension})
    endforeach()
  endif()
endforeach()

set(RBLXBUILD_CXX_LINKER_PREFERENCE 30)
