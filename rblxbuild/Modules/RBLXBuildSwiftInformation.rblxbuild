if(UNIX)
  set(RBLXBUILD_Swift_OUTPUT_EXTENSION .o)
else()
  set(RBLXBUILD_Swift_OUTPUT_EXTENSION .obj)
endif()

# Load compiler-specific information.
if(RBLXBUILD_Swift_COMPILER_ID)
  include(Compiler/${RBLXBUILD_Swift_COMPILER_ID}-Swift OPTIONAL)

  if(RBLXBUILD_SYSTEM_PROCESSOR)
    include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_Swift_COMPILER_ID}-Swift-${RBLXBUILD_SYSTEM_PROCESSOR} OPTIONAL)
  endif()
  include(Platform/${RBLXBUILD_EFFECTIVE_SYSTEM_NAME}-${RBLXBUILD_Swift_COMPILER_ID}-Swift OPTIONAL)
endif()

set(RBLXBUILD_INCLUDE_FLAG_Swift "-I ")

# FIXME: Move compiler- and platform-specific flags to the above-included modules.
if(RBLXBUILD_SYSTEM_NAME STREQUAL "Darwin" OR RBLXBUILD_SYSTEM_NAME STREQUAL "iOS"
    OR RBLXBUILD_SYSTEM_NAME STREQUAL "tvOS" OR RBLXBUILD_SYSTEM_NAME STREQUAL "visionOS"
    OR RBLXBUILD_SYSTEM_NAME STREQUAL "watchOS")
  set(RBLXBUILD_SHARED_LIBRARY_SONAME_Swift_FLAG "-Xlinker -install_name -Xlinker ")
elseif(NOT RBLXBUILD_SYSTEM_NAME STREQUAL Windows)
  set(RBLXBUILD_SHARED_LIBRARY_SONAME_Swift_FLAG "-Xlinker -soname -Xlinker ")
endif()
if(NOT RBLXBUILD_SYSTEM_NAME STREQUAL Windows)
  set(RBLXBUILD_EXECUTABLE_RUNTIME_Swift_FLAG "-Xlinker -rpath -Xlinker ")
  set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_Swift_FLAG "-Xlinker -rpath -Xlinker ")
  if(RBLXBUILD_SYSTEM_NAME STREQUAL "Darwin" OR RBLXBUILD_SYSTEM_NAME STREQUAL "iOS"
      OR RBLXBUILD_SYSTEM_NAME STREQUAL "tvOS" OR RBLXBUILD_SYSTEM_NAME STREQUAL "visionOS"
      OR RBLXBUILD_SYSTEM_NAME STREQUAL "watchOS")
    set(RBLXBUILD_EXECUTABLE_RUNTIME_Swift_FLAG_SEP "")
    set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_Swift_FLAG_SEP "")
  else()
    set(RBLXBUILD_EXECUTABLE_RUNTIME_Swift_FLAG_SEP ":")
    set(RBLXBUILD_SHARED_LIBRARY_RUNTIME_Swift_FLAG_SEP ":")
  endif()
endif()

set(RBLXBUILD_Swift_COMPILE_OPTIONS_TARGET "-target ")
set(RBLXBUILD_Swift_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN "-tools-directory ")
# NOTE(compnerd) the `-sdk` support is not yet ready in the compiler; when that
# is fully working, we should be able to enable this.
# set(RBLXBUILD_Swift_COMPILE_OPTIONS_SYSROOT "-sdk ")
# NOTE(compnerd) do not setup `-frontend` as we use the compiler as the driver
# during the link phase and use that to drive the compilation
set(RBLXBUILD_Swift_COMPILER_ARG1 "")
set(RBLXBUILD_Swift_DEFINE_FLAG -D)
set(RBLXBUILD_Swift_FRAMEWORK_SEARCH_FLAG "-F ")
set(RBLXBUILD_Swift_LIBRARY_PATH_FLAG "-L ")
set(RBLXBUILD_Swift_LIBRARY_PATH_TERMINATOR "")
set(RBLXBUILD_Swift_LINK_LIBRARY_FLAG "-l")
set(RBLXBUILD_Swift_LINKER_WRAPPER_FLAG "-Xlinker" " ")
set(RBLXBUILD_Swift_RESPONSE_FILE_LINK_FLAG @)
set(RBLXBUILD_Swift_RESPONSE_FILE_FLAG @)
set(RBLXBUILD_Swift_COMPILE_OPTIONS_COLOR_DIAGNOSTICS -color-diagnostics)
set(RBLXBUILD_Swift_COMPILE_OPTIONS_COLOR_DIAGNOSTICS_OFF -no-color-diagnostics)
set(RBLXBUILD_Swift_PACKAGE_NAME_FLAG -package-name)

set(RBLXBUILD_Swift_LINKER_PREFERENCE 50)
set(RBLXBUILD_Swift_LINKER_PREFERENCE_PROPAGATES 1)

# NOTE(compnerd) use the short form for convenience and ease of search.  They
# are treated equivalent to their long form names as well as custom Swift
# specific names.
set(RBLXBUILD_Swift_COMPILE_OPTIONS_MSVC_RUNTIME_LIBRARY_MultiThreaded -libc MT)
set(RBLXBUILD_Swift_COMPILE_OPTIONS_MSVC_RUNTIME_LIBRARY_MultiThreadedDLL -libc MD)
set(RBLXBUILD_Swift_COMPILE_OPTIONS_MSVC_RUNTIME_LIBRARY_MultiThreadedDebug -libc MTd)
set(RBLXBUILD_Swift_COMPILE_OPTIONS_MSVC_RUNTIME_LIBRARY_MultiThreadedDebugDLL -libc MDd)

set(RBLXBUILD_Swift_FLAGS_DEBUG_INIT "-Onone -g")
set(RBLXBUILD_Swift_FLAGS_RELEASE_INIT "-O")
set(RBLXBUILD_Swift_FLAGS_RELWITHDEBINFO_INIT "-O -g")
set(RBLXBUILD_Swift_FLAGS_MINSIZEREL_INIT "-Osize")

if(RBLXBUILD_GENERATOR STREQUAL "Xcode")
  string(APPEND RBLXBUILD_Swift_FLAGS_DEBUG_INIT " ${RBLXBUILD_Swift_FLAGS_DEBUG_LINKER_FLAGS}")
  string(APPEND RBLXBUILD_Swift_FLAGS_RELWITHDEBINFO_INIT " ${RBLXBUILD_Swift_FLAGS_RELWITHDEBINFO_LINKER_FLAGS}")
endif()

# Warns if unset and uses old policy.
# Old policy flag-smashes the wmo and incremental flags onto the compiler flags.
# New policy respects the Swift_COMPILATION_MODE target property to add
# incremental and wholemodule optimization flags as appropriate.
rblxbuild_policy(GET CMP0157 __SWIFT_COMP_MODE_CMP0157)
if(__SWIFT_COMP_MODE_CMP0157 STREQUAL "NEW")
  set(RBLXBUILD_Swift_COMPILATION_MODE_DEFAULT "incremental")
else()
  # Xcode has a separate Xcode project option (SWIFT_COMPILATION_MODE) used to set
  # whether compiling with whole-module optimizations or incrementally. Setting
  # these options here will have no effect when compiling with the built-in driver,
  # and will explode violently, leaving build products in the source directory, when
  # using the old swift driver. Don't append `-incremental` or `-wmo` to the
  # flags in the Xcode generator.
  if(NOT RBLXBUILD_GENERATOR STREQUAL "Xcode")
    # Enable Whole Module Optimization by default unless the old
    # C++ driver is being used, which behaves differently under WMO.
    if(NOT RBLXBUILD_Swift_COMPILER_USE_OLD_DRIVER)
      string(APPEND RBLXBUILD_Swift_FLAGS_RELEASE_INIT " -wmo")
      string(APPEND RBLXBUILD_Swift_FLAGS_RELWITHDEBINFO_INIT " -wmo")
      string(APPEND RBLXBUILD_Swift_FLAGS_MINSIZEREL_INIT " -wmo")
    endif()
    string(APPEND RBLXBUILD_Swift_FLAGS_DEBUG_INIT " -incremental")
  endif()
endif()
unset(__SWIFT_COMP_MODE_CMP0157)

# Separate Swift module emission (see policy CMP0215) is available only in the
# split build model selected by policy CMP0157, and it writes the module into
# the Swift module directory structure selected by policy CMP0195.  When
# CMP0215 is NEW, require both to also be NEW.  This is a Ninja-only feature,
# so only enforce the requirement for Ninja generators.
if(RBLXBUILD_GENERATOR MATCHES "Ninja")
  rblxbuild_policy(GET CMP0215 __SWIFT_SEPARATE_MODULE_CMP0215)
  if(__SWIFT_SEPARATE_MODULE_CMP0215 STREQUAL "NEW")
    set(__SWIFT_SEPARATE_MODULE_UNMET "")
    rblxbuild_policy(GET CMP0157 __SWIFT_SEPARATE_MODULE_CMP0157)
    if(NOT __SWIFT_SEPARATE_MODULE_CMP0157 STREQUAL "NEW")
      list(APPEND __SWIFT_SEPARATE_MODULE_UNMET CMP0157)
    endif()
    rblxbuild_policy(GET CMP0195 __SWIFT_SEPARATE_MODULE_CMP0195)
    if(NOT __SWIFT_SEPARATE_MODULE_CMP0195 STREQUAL "NEW")
      list(APPEND __SWIFT_SEPARATE_MODULE_UNMET CMP0195)
    endif()
    if(__SWIFT_SEPARATE_MODULE_UNMET)
      list(LENGTH __SWIFT_SEPARATE_MODULE_UNMET __SWIFT_SEPARATE_MODULE_UNMET_COUNT)
      list(JOIN __SWIFT_SEPARATE_MODULE_UNMET " and " __SWIFT_SEPARATE_MODULE_UNMET_STR)
      if(__SWIFT_SEPARATE_MODULE_UNMET_COUNT GREATER 1)
        set(__SWIFT_SEPARATE_MODULE_VERB "are")
      else()
        set(__SWIFT_SEPARATE_MODULE_VERB "is")
      endif()
      message(FATAL_ERROR
        "Policy CMP0215 is set to 'NEW', which requires policies CMP0157 and "
        "CMP0195 to be set to 'NEW', but ${__SWIFT_SEPARATE_MODULE_UNMET_STR} "
        "${__SWIFT_SEPARATE_MODULE_VERB} not.  Note that CMP0157 must be set "
        "before the Swift language is enabled.")
    endif()
    unset(__SWIFT_SEPARATE_MODULE_CMP0157)
    unset(__SWIFT_SEPARATE_MODULE_CMP0195)
    unset(__SWIFT_SEPARATE_MODULE_UNMET)
    unset(__SWIFT_SEPARATE_MODULE_UNMET_COUNT)
    unset(__SWIFT_SEPARATE_MODULE_UNMET_STR)
    unset(__SWIFT_SEPARATE_MODULE_VERB)
  endif()
  unset(__SWIFT_SEPARATE_MODULE_CMP0215)
endif()

rblxbuild_initialize_per_config_variable(RBLXBUILD_Swift_FLAGS "Swift Compiler Flags")

if(NOT RBLXBUILD_Swift_NUM_THREADS MATCHES "^[0-9]+$")
  rblxbuild_host_system_information(RESULT RBLXBUILD_Swift_NUM_THREADS QUERY NUMBER_OF_LOGICAL_CORES)
endif()

# Swift split-compilation requires CMP0157 NEW policy
if(RBLXBUILD_Swift_COMPILATION_MODE_DEFAULT)
  set(RBLXBUILD_Swift_PARALLEL_FLAGS "-j ${RBLXBUILD_Swift_NUM_THREADS} -num-threads ${RBLXBUILD_Swift_NUM_THREADS}")
  if(NOT RBLXBUILD_Swift_COMPILE_OBJECT)
    # Omit the object output. The output is controlled by the output-file-map
    # for normal builds. For wholemodule builds, RBLXBuild appends the appropriate
    # flags.
    set(RBLXBUILD_Swift_COMPILE_OBJECT "<RBLXBUILD_Swift_COMPILER> ${RBLXBUILD_Swift_PARALLEL_FLAGS} <DEFINES> <FLAGS> <INCLUDES> <SOURCE>")
  endif()

  if(NOT RBLXBUILD_Swift_CREATE_SHARED_LIBRARY)
    set(RBLXBUILD_Swift_CREATE_SHARED_LIBRARY "<RBLXBUILD_Swift_COMPILER> ${RBLXBUILD_Swift_PARALLEL_FLAGS} -emit-library <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${RBLXBUILD_Swift_IMPLIB_LINKER_FLAGS} <SONAME_FLAG> <TARGET_INSTALLNAME_DIR><TARGET_SONAME> -o <TARGET> ${RBLXBUILD_Swift_PDB_LINKER_FLAGS} <OBJECTS> <LINK_LIBRARIES>")
  endif()

  if(NOT RBLXBUILD_Swift_CREATE_SHARED_MODULE)
    set(RBLXBUILD_Swift_CREATE_SHARED_MODULE "${RBLXBUILD_Swift_CREATE_SHARED_LIBRARY}")
  endif()

  if(NOT RBLXBUILD_Swift_LINK_EXECUTABLE)
    set(RBLXBUILD_Swift_LINK_EXECUTABLE "<RBLXBUILD_Swift_COMPILER> ${RBLXBUILD_Swift_PARALLEL_FLAGS} -emit-executable -o <TARGET> <FLAGS> <OBJECTS> <LINK_FLAGS> ${RBLXBUILD_Swift_PDB_LINKER_FLAGS} <LINK_LIBRARIES>")
  endif()

  if(NOT RBLXBUILD_Swift_CREATE_STATIC_LIBRARY)
    set(RBLXBUILD_Swift_CREATE_STATIC_LIBRARY "<RBLXBUILD_Swift_COMPILER> -emit-library -static -o <TARGET> <OBJECTS> <LINK_FLAGS>")
    set(RBLXBUILD_Swift_ARCHIVE_CREATE "<RBLXBUILD_AR> crs <TARGET> <OBJECTS>")
    set(RBLXBUILD_Swift_ARCHIVE_FINISH "")
  endif()
  unset(RBLXBUILD_Swift_PARALLEL_FLAGS)
else()
  # NOTE(compnerd) we do not have an object compile rule since we build the objects as part of the link step
  if(NOT RBLXBUILD_Swift_COMPILE_OBJECT)
    set(RBLXBUILD_Swift_COMPILE_OBJECT ":")
  endif()

  if(NOT RBLXBUILD_Swift_CREATE_SHARED_LIBRARY)
    set(RBLXBUILD_Swift_CREATE_SHARED_LIBRARY "<RBLXBUILD_Swift_COMPILER> -j ${RBLXBUILD_Swift_NUM_THREADS} -num-threads ${RBLXBUILD_Swift_NUM_THREADS} -emit-library -o <TARGET> -module-name <SWIFT_MODULE_NAME> -module-link-name <SWIFT_LIBRARY_NAME> -emit-module -emit-module-path <SWIFT_MODULE> -emit-dependencies <DEFINES> <FLAGS> <INCLUDES> <SWIFT_SOURCES> <LINK_FLAGS> <SONAME_FLAG> <TARGET_INSTALLNAME_DIR><TARGET_SONAME> ${RBLXBUILD_Swift_IMPLIB_LINKER_FLAGS} ${RBLXBUILD_Swift_PDB_LINKER_FLAGS} <LINK_LIBRARIES>")
  endif()

  if(NOT RBLXBUILD_Swift_CREATE_SHARED_MODULE)
    set(RBLXBUILD_Swift_CREATE_SHARED_MODULE "${RBLXBUILD_Swift_CREATE_SHARED_LIBRARY}")
  endif()

  if(NOT RBLXBUILD_Swift_LINK_EXECUTABLE)
    set(RBLXBUILD_Swift_LINK_EXECUTABLE "<RBLXBUILD_Swift_COMPILER> -j ${RBLXBUILD_Swift_NUM_THREADS} -num-threads ${RBLXBUILD_Swift_NUM_THREADS} -emit-executable -o <TARGET> -emit-dependencies <DEFINES> <FLAGS> <INCLUDES> <SWIFT_SOURCES> <LINK_FLAGS> ${RBLXBUILD_Swift_PDB_LINKER_FLAGS} <LINK_LIBRARIES>")
  endif()

  if(NOT RBLXBUILD_Swift_LINK_EXECUTABLE_WITH_EXPORTS)
    set(RBLXBUILD_Swift_LINK_EXECUTABLE_WITH_EXPORTS "${RBLXBUILD_Swift_LINK_EXECUTABLE} -emit-module -emit-module-path <SWIFT_MODULE> ${RBLXBUILD_Swift_IMPLIB_LINKER_FLAGS}")
  endif()

  if(NOT RBLXBUILD_Swift_CREATE_STATIC_LIBRARY)
    set(RBLXBUILD_Swift_CREATE_STATIC_LIBRARY "<RBLXBUILD_Swift_COMPILER> -j ${RBLXBUILD_Swift_NUM_THREADS} -num-threads ${RBLXBUILD_Swift_NUM_THREADS} -emit-library -static -o <TARGET> -module-name <SWIFT_MODULE_NAME> -module-link-name <SWIFT_LIBRARY_NAME> -emit-module -emit-module-path <SWIFT_MODULE> -emit-dependencies <DEFINES> <FLAGS> <INCLUDES> <SWIFT_SOURCES> <LINK_FLAGS> <LINK_LIBRARIES>")

    set(RBLXBUILD_Swift_ARCHIVE_CREATE "<RBLXBUILD_AR> crs <TARGET> <OBJECTS>")
    set(RBLXBUILD_Swift_ARCHIVE_FINISH "")
  endif()
endif()

set(RBLXBUILD_Swift_USE_LINKER_INFORMATION TRUE)

set(RBLXBUILD_Swift_INFORMATION_LOADED 1)
