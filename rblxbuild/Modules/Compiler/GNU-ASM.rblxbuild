# This file is loaded when gcc/g++ is used for assembler files (the "ASM" rblxbuild language)
include(Compiler/GNU)

set(RBLXBUILD_ASM_SOURCE_FILE_EXTENSIONS s;S;asm)

__compiler_gnu(ASM)

if(RBLXBUILD_ASM${ASM_DIALECT}_COMPILER_ID_VENDOR_MATCH STREQUAL "GNU assembler")
  set(RBLXBUILD_DEPFILE_FLAGS_ASM${ASM_DIALECT} "--MD <DEP_FILE>")
  set(RBLXBUILD_ASM${ASM_DIALECT}_LINK_EXECUTABLE
    "<RBLXBUILD_LINKER> <FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
  set(RBLXBUILD_ASM_DEFINE_FLAG "--defsym ")
endif()
