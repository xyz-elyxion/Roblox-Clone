include(Platform/Generic-ADSP-Common)

set(RBLXBUILD_ASM_SOURCE_FILE_EXTENSIONS asm)
set(RBLXBUILD_ASM_OUTPUT_EXTENSION ".doj" )
set(RBLXBUILD_ASM_COMPILE_OBJECT
    "<RBLXBUILD_ASM_COMPILER> <INCLUDES> <FLAGS> -proc ${ADSP_PROCESSOR} -si-revision ${ADSP_PROCESSOR_SILICIUM_REVISION} -o <OBJECT> <SOURCE>")
