# Find the MS ARM assembler (marmasm or marmasm64)

set(ASM_DIALECT "_MARMASM")

# if we are using the 64bit cl compiler, assume we also want the 64bit assembler
if(";${LINEARBUILD_VS_PLATFORM_NAME};${LINEARBUILD_C_COMPILER_ARCHITECTURE_ID};${LINEARBUILD_CXX_COMPILER_ARCHITECTURE_ID};"
    MATCHES ";(ARM64);")
  set(LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_INIT armasm64)
else()
  set(LINEARBUILD_ASM${ASM_DIALECT}_COMPILER_INIT armasm)
endif()

include(LinearBuildDetermineASMCompiler)
set(ASM_DIALECT)
