if(RBLXBUILD_SYSTEM MATCHES "MP-RAS-02*.")
  set(RBLXBUILD_C_COMPILE_OPTIONS_PIC -K PIC)
  set(RBLXBUILD_C_COMPILE_OPTIONS_PIE -K PIE)
  set(RBLXBUILD_SHARED_LIBRARY_C_FLAGS "-K PIC")
else()
  set(RBLXBUILD_C_COMPILE_OPTIONS_PIC -K PIC)
  set(RBLXBUILD_C_COMPILE_OPTIONS_PIE -K PIE)
  set(RBLXBUILD_SHARED_LIBRARY_C_FLAGS "-K PIC")
  set(RBLXBUILD_SHARED_LIBRARY_LINK_C_FLAGS "-Wl,-Bexport")
endif()

include(Platform/UnixPaths)
