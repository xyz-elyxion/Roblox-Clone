include(Compiler/Clang)
__compiler_clang(CUDA)

# Set explicitly, because __compiler_clang() doesn't set this if we're simulating MSVC.
set(RBLXBUILD_DEPFILE_FLAGS_CUDA "-MD -MT <DEP_TARGET> -MF <DEP_FILE>")
if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
    AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake")
  # dependencies are computed by the compiler itself
  set(RBLXBUILD_CUDA_DEPFILE_FORMAT gcc)
  set(RBLXBUILD_CUDA_DEPENDS_USE_COMPILER TRUE)
endif()

# C++03 isn't supported for CXX, but is for CUDA, so we need to set these manually.
# Do this before __compiler_clang_cxx_standards() since that adds the feature.
set(RBLXBUILD_CUDA03_STANDARD_COMPILE_OPTION "-std=c++03")
set(RBLXBUILD_CUDA03_EXTENSION_COMPILE_OPTION "-std=gnu++03")
__compiler_clang_cxx_standards(CUDA)

set(RBLXBUILD_CUDA_COMPILER_HAS_DEVICE_LINK_PHASE TRUE)
set(_RBLXBUILD_COMPILE_AS_CUDA_FLAG "-x cuda")
set(_RBLXBUILD_CUDA_WHOLE_FLAG "-c")
set(_RBLXBUILD_CUDA_RDC_FLAG "-fgpu-rdc")
set(_RBLXBUILD_CUDA_PTX_FLAG "--cuda-device-only -S")

if (RBLXBUILD_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 20.0)
  # Starting in 20.0, clang supports device linking as part of the host link phase
  set(RBLXBUILD_CUDA_COMPILER_HAS_DEVICE_LINK_PHASE FALSE)
  if(RBLXBUILD_CUDA_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(_RBLXBUILD_CUDA_RDC_LINK_FLAG "-clang:--offload-link")
  else()
    set(_RBLXBUILD_CUDA_RDC_LINK_FLAG "--offload-link")
  endif()
endif()

# Device linking is just regular linking so these are the same.
set(RBLXBUILD_CUDA_DEVICE_LINKER_WRAPPER_FLAG ${RBLXBUILD_CUDA_LINKER_WRAPPER_FLAG})
set(RBLXBUILD_CUDA_DEVICE_LINKER_WRAPPER_FLAG_SEP ${RBLXBUILD_CUDA_LINKER_WRAPPER_FLAG_SEP})

set(RBLXBUILD_CUDA_DEVICE_LINK_MODE DRIVER)

# RulePlaceholderExpander expands crosscompile variables like sysroot and target only for RBLXBUILD_<LANG>_COMPILER. Override the default.
set(RBLXBUILD_CUDA_LINK_EXECUTABLE "<RBLXBUILD_CUDA_COMPILER> <FLAGS> <LINK_FLAGS> ${_RBLXBUILD_CUDA_RDC_LINK_FLAG} <OBJECTS> -o <TARGET> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")
set(RBLXBUILD_CUDA_CREATE_SHARED_LIBRARY "<RBLXBUILD_CUDA_COMPILER> <RBLXBUILD_SHARED_LIBRARY_CUDA_FLAGS> <LANGUAGE_COMPILE_FLAGS> <LINK_FLAGS> ${_RBLXBUILD_CUDA_RDC_LINK_FLAG} <SONAME_FLAG><TARGET_SONAME> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>${__IMPLICIT_LINKS}")

set(RBLXBUILD_CUDA_RUNTIME_LIBRARY_DEFAULT "STATIC")
set(RBLXBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_STATIC "cudadevrt;cudart_static")
set(RBLXBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_SHARED "cudadevrt;cudart")
set(RBLXBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_NONE   "")

# Clang doesn't support CUDA device LTO
set(_RBLXBUILD_CUDA_IPO_SUPPORTED_BY_RBLXBUILD NO)
set(_RBLXBUILD_CUDA_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)

if(UNIX)
  list(APPEND RBLXBUILD_CUDA_RUNTIME_LIBRARY_LINK_OPTIONS_STATIC "rt" "pthread" "dl")
endif()
