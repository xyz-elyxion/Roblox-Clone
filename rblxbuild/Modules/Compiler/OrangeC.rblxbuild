include_guard()

macro(__compiler_orangec lang)
  if ("x${lang}" MATCHES "^x(C|CXX)$")
    set(RBLXBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<RBLXBUILD_${lang}_COMPILER> ${_ORANGEC_COMPILE_${lang}} -! <SOURCE> <DEFINES> <INCLUDES> <FLAGS> +i -o <PREPROCESSED_SOURCE>")
    set(RBLXBUILD_${lang}_CREATE_ASSEMBLY_SOURCE     "<RBLXBUILD_${lang}_COMPILER> ${_ORANGEC_COMPILE_${lang}} -! <SOURCE> <DEFINES> <INCLUDES> <FLAGS> -S -o <ASSEMBLY_SOURCE>")
  endif()
  set(RBLXBUILD_${lang}_COMPILE_OBJECT             "<RBLXBUILD_${lang}_COMPILER> ${_ORANGEC_COMPILE_${lang}} -! -c <SOURCE> <DEFINES> <INCLUDES> <FLAGS> -o <OBJECT>")
  unset(_ORANGEC_COMPILE_${lang})

  set(RBLXBUILD_DEPFILE_FLAGS_${lang} "-MD -MT <DEP_TARGET> -MF <DEP_FILE>")
  set(RBLXBUILD_${lang}_DEPFILE_FORMAT gcc)
  set(RBLXBUILD_${lang}_DEPENDS_USE_COMPILER TRUE)

  set(RBLXBUILD_${lang}_LINK_MODE DRIVER)

  string(APPEND RBLXBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND RBLXBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELEASE_INIT " -O2 -DNDEBUG")
  string(APPEND RBLXBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -O1 -DNDEBUG")
  string(APPEND RBLXBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -g -DNDEBUG")

  set(RBLXBUILD_${lang}_CREATE_STATIC_LIBRARY
    "<RBLXBUILD_${lang}_COMPILER> -! -static -o <TARGET> <LINK_FLAGS> <OBJECTS> ")
  set(RBLXBUILD_${lang}_LINK_EXECUTABLE
    "<RBLXBUILD_${lang}_COMPILER> -! <FLAGS> -o <TARGET> --out-implib <TARGET_IMPLIB> <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES>")
  set(RBLXBUILD_${lang}_CREATE_SHARED_LIBRARY
    "<RBLXBUILD_${lang}_COMPILER> -! <RBLXBUILD_SHARED_LIBRARY_${lang}_FLAGS> <LANGUAGE_COMPILE_FLAGS> -o <TARGET> --out-implib <TARGET_IMPLIB> <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES>")
  set(RBLXBUILD_${lang}_CREATE_SHARED_MODULE "${RBLXBUILD_${lang}_CREATE_SHARED_LIBRARY}")

  set(RBLXBUILD_LIBRARY_PATH_FLAG "-L")
  set(RBLXBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-shared")

  set(RBLXBUILD_${lang}_RESPONSE_FILE_FLAG "@")
  set(RBLXBUILD_${lang}_RESPONSE_FILE_LINK_FLAG "@")
endmacro()
