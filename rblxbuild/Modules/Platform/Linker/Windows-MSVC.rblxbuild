# This module is shared by multiple languages; use include blocker.
include_guard()

# Features for LINK_LIBRARY generator expression
if(MSVC_VERSION GREATER "1900")
  ## WHOLE_ARCHIVE: Force loading all members of an archive
  set(RBLXBUILD_LINK_LIBRARY_USING_WHOLE_ARCHIVE "LINKER:/WHOLEARCHIVE:<LIBRARY>")
  set(RBLXBUILD_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED TRUE)
  set(RBLXBUILD_LINK_LIBRARY_WHOLE_ARCHIVE_ATTRIBUTES LIBRARY_TYPE=STATIC DEDUPLICATION=YES OVERRIDE=DEFAULT)
endif()

macro(__windows_linker_msvc lang)
  set(RBLXBUILD_${lang}_PLATFORM_LINKER_ID MSVC)
  set(RBLXBUILD_${lang}_LINK_LIBRARIES_PROCESSING ORDER=FORWARD DEDUPLICATION=ALL)

  # Features for LINK_LIBRARY generator expression
  if(NOT RBLXBUILD_${lang}_COMPILER_LINKER_VERSION STREQUAL "")
    if (RBLXBUILD_${lang}_COMPILER_LINKER_VERSION GREATER_EQUAL "14.10")
      ## WHOLE_ARCHIVE: Force loading all members of an archive
      set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE "LINKER:/WHOLEARCHIVE:<LIBRARY>")
      set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED TRUE)
      set(RBLXBUILD_${lang}_LINK_LIBRARY_WHOLE_ARCHIVE_ATTRIBUTES LIBRARY_TYPE=STATIC DEDUPLICATION=YES OVERRIDE=DEFAULT)
    else()
      set(RBLXBUILD_${lang}_LINK_LIBRARY_USING_WHOLE_ARCHIVE_SUPPORTED FALSE)
    endif()
  endif()
endmacro()
