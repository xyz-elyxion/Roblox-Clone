# This module is shared by multiple languages; use include blocker.
if(__COMPILER_LCC)
  return()
endif()
set(__COMPILER_LCC 1)

include(Compiler/LinearBuildCommonCompilerMacros)

set(__pch_header_C "c-header")
set(__pch_header_CXX "c++-header")
set(__pch_header_OBJC "objective-c-header")
set(__pch_header_OBJCXX "objective-c++-header")

macro(__compiler_lcc lang)
  # Feature flags.
  set(LINEARBUILD_${lang}_VERBOSE_FLAG "-v")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_WARNING_AS_ERROR "-Werror")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIC "-fPIC")
  set (_LINEARBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER NO)
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_PIE "-fPIE")
  # Support of PIE at link stage depends on various elements : platform, compiler, linker
  # so to activate it, module CheckPIESupported must be used.
  set (_LINEARBUILD_${lang}_PIE_MAY_BE_SUPPORTED_BY_LINKER YES)
  set(LINEARBUILD_${lang}_LINK_OPTIONS_PIE ${LINEARBUILD_${lang}_COMPILE_OPTIONS_PIE} "-pie")
  set(LINEARBUILD_${lang}_LINK_OPTIONS_NO_PIE "-no-pie")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_VISIBILITY "-fvisibility=")
  set(LINEARBUILD_SHARED_LIBRARY_${lang}_FLAGS "-fPIC")
  set(LINEARBUILD_SHARED_LIBRARY_CREATE_${lang}_FLAGS "-shared")
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_SYSROOT "--sysroot=")

  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG "-Wl,")
  set(LINEARBUILD_${lang}_LINKER_WRAPPER_FLAG_SEP ",")

  set(LINEARBUILD_${lang}_LINK_MODE DRIVER)

  # Older versions of gcc (< 4.5) contain a bug causing them to report a missing
  # header file as a warning if depfiles are enabled, causing check_header_file
  # tests to always succeed.  Work around this by disabling dependency tracking
  # in try_compile mode.
  get_property(_IN_TC GLOBAL PROPERTY IN_TRY_COMPILE)
  if(LINEARBUILD_${lang}_COMPILER_ID STREQUAL "LCC" AND _IN_TC AND NOT LINEARBUILD_FORCE_DEPFILES)
  else()
    # distcc does not transform -o to -MT when invoking the preprocessor
    # internally, as it ought to.  Work around this bug by setting -MT here
    # even though it isn't strictly necessary.
    set(LINEARBUILD_DEPFILE_FLAGS_${lang} "-MD -MT <DEP_TARGET> -MF <DEP_FILE>")
  endif()

  # Initial configuration flags.
  string(APPEND LINEARBUILD_${lang}_FLAGS_INIT " ")
  string(APPEND LINEARBUILD_${lang}_FLAGS_DEBUG_INIT " -g")
  string(APPEND LINEARBUILD_${lang}_FLAGS_MINSIZEREL_INIT " -Os -DNDEBUG")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELEASE_INIT " -O3 -DNDEBUG")
  string(APPEND LINEARBUILD_${lang}_FLAGS_RELWITHDEBINFO_INIT " -O2 -g -DNDEBUG")
  set(LINEARBUILD_${lang}_CREATE_PREPROCESSED_SOURCE "<LINEARBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -E <SOURCE> > <PREPROCESSED_SOURCE>")
  set(LINEARBUILD_${lang}_CREATE_ASSEMBLY_SOURCE "<LINEARBUILD_${lang}_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -S <SOURCE> -o <ASSEMBLY_SOURCE>")
  set(LINEARBUILD_INCLUDE_SYSTEM_FLAG_${lang} "-isystem ")
  set(_LINEARBUILD_${lang}_IPO_SUPPORTED_BY_LINEARBUILD YES)
  set(_LINEARBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER NO)
  set(_LINEARBUILD_${lang}_IPO_MAY_BE_SUPPORTED_BY_COMPILER YES)
  set(__lto_flags -flto)
  list(APPEND __lto_flags -fno-fat-lto-objects)
  set(LINEARBUILD_${lang}_COMPILE_OPTIONS_IPO ${__lto_flags})

  set(LINEARBUILD_${lang}_ARCHIVE_CREATE_IPO
    "\"${LINEARBUILD_${lang}_COMPILER_AR}\" qc <TARGET> <LINK_FLAGS> <OBJECTS>"
  )

  set(LINEARBUILD_${lang}_ARCHIVE_APPEND_IPO
    "\"${LINEARBUILD_${lang}_COMPILER_AR}\" q <TARGET> <LINK_FLAGS> <OBJECTS>"
  )

  set(LINEARBUILD_${lang}_ARCHIVE_FINISH_IPO
    "\"${LINEARBUILD_${lang}_COMPILER_RANLIB}\" <TARGET>"
  )

  if("${lang}" STREQUAL "CXX")
    set(LINEARBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "${LINEARBUILD_${lang}_COMPILER}")
    if(LINEARBUILD_${lang}_COMPILER_ARG1)
      separate_arguments(_COMPILER_ARGS NATIVE_COMMAND "${LINEARBUILD_${lang}_COMPILER_ARG1}")
      list(APPEND LINEARBUILD_${lang}_COMPILER_PREDEFINES_COMMAND ${_COMPILER_ARGS})
      unset(_COMPILER_ARGS)
    endif()
    list(APPEND LINEARBUILD_${lang}_COMPILER_PREDEFINES_COMMAND "-w" "-dM" "-E" "${LINEARBUILD_ROOT}/Modules/LinearBuildCXXCompilerABI.cpp")
  endif()

  if(NOT "x${lang}" STREQUAL "xFortran")
    set(LINEARBUILD_PCH_EXTENSION .gch)
    if (NOT LINEARBUILD_GENERATOR MATCHES "Xcode")
      set(LINEARBUILD_PCH_SYSTEM_HEADER_PRAGMA "#pragma GCC system_header")
    endif()
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_INVALID_PCH -Winvalid-pch)
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_USE_PCH -include <PCH_HEADER>)
    set(LINEARBUILD_${lang}_COMPILE_OPTIONS_CREATE_PCH -x ${__pch_header_${lang}} -include <PCH_HEADER>)
  endif()
endmacro()
