prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@

Name: LINEARWIN
Description: A multi-platform library for OpenGL, window and input
Version: @LINEARWIN_VERSION@
URL: https://www.linearwin.org/
Requires.private: @LINEARWIN_PKG_DEPS@
Libs: -L${libdir} -l@LINEARWIN_LIB_NAME@
Libs.private: @LINEARWIN_PKG_LIBS@
Cflags: -I${includedir}
