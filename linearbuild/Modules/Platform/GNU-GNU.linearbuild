# This module is shared by multiple languages; use include blocker.
if(__GNU_COMPILER_GNU)
  return()
endif()
set(__GNU_COMPILER_GNU 1)

macro(__gnu_compiler_gnu lang)
  # We pass this for historical reasons.  Projects may have
  # executables that use dlopen but do not set ENABLE_EXPORTS.
  set(LINEARBUILD_SHARED_LIBRARY_LINK_${lang}_FLAGS "-rdynamic")

  set(LINEARBUILD_${lang}_VERBOSE_LINK_FLAG "-Wl,-v")

  # linker selection
  set(LINEARBUILD_${lang}_USING_LINKER_SYSTEM "")
  set(LINEARBUILD_${lang}_USING_LINKER_LLD "-fuse-ld=lld")
  set(LINEARBUILD_${lang}_USING_LINKER_BFD "-fuse-ld=bfd")
  set(LINEARBUILD_${lang}_USING_LINKER_GOLD "-fuse-ld=gold")
  if(NOT LINEARBUILD_${lang}_COMPILER_ID STREQUAL "GNU"
      OR LINEARBUILD_${lang}_COMPILER_VERSION VERSION_GREATER_EQUAL "12.1")
    set(LINEARBUILD_${lang}_USING_LINKER_MOLD "-fuse-ld=mold")
  endif()
endmacro()
