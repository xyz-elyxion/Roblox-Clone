include_guard(GLOBAL)

#[=======================================================================[.rst:
RBLXBuildPushCheckState
-------------------

This module provides commands for managing the state of variables that influence
how various RBLXBuild check commands (e.g., :command:`check_symbol_exists`, etc.)
are performed.

Load this module in a RBLXBuild project with:

.. code-block:: rblxbuild

  include(RBLXBuildPushCheckState)

This module provides the following commands, which are useful for scoped
configuration, for example, in RBLXBuild modules or when performing checks in a
controlled environment, ensuring that temporary modifications are isolated
to the scope of the check and do not propagate into other parts of the build
system:

* :command:`rblxbuild_push_check_state`
* :command:`rblxbuild_reset_check_state`
* :command:`rblxbuild_pop_check_state`

Affected Variables
^^^^^^^^^^^^^^^^^^

The following RBLXBuild variables are saved, reset, and restored by this module's
commands:

.. include:: /module/include/RBLXBUILD_REQUIRED_FLAGS.rst

.. include:: /module/include/RBLXBUILD_REQUIRED_DEFINITIONS.rst

.. include:: /module/include/RBLXBUILD_REQUIRED_INCLUDES.rst

.. include:: /module/include/RBLXBUILD_REQUIRED_LINK_OPTIONS.rst

.. include:: /module/include/RBLXBUILD_REQUIRED_LIBRARIES.rst

.. include:: /module/include/RBLXBUILD_REQUIRED_LINK_DIRECTORIES.rst

.. include:: /module/include/RBLXBUILD_REQUIRED_QUIET.rst

``RBLXBUILD_EXTRA_INCLUDE_FILES``
  .. versionadded:: 3.6
    Previously used already by the :command:`check_type_size` command;  now
    also supported by this module.

  A :ref:`semicolon-separated list <RBLXBuild Language Lists>` of extra header
  files to include when performing the check.

.. note::

  Other RBLXBuild variables, such as :variable:`RBLXBUILD_<LANG>_FLAGS`, propagate
  to all checks regardless of commands provided by this module, as those
  fundamental variables are designed to influence the global state of the
  build system.

Commands
^^^^^^^^

.. command:: rblxbuild_push_check_state

  Pushes (saves) the current states of the above variables onto a stack:

  .. code-block:: rblxbuild

    rblxbuild_push_check_state([RESET])

  Use this command to preserve the current configuration before making
  temporary modifications for specific checks.

  ``RESET``
    When this option is specified, the command not only saves the current states
    of the listed variables but also resets them to empty, allowing them to be
    reconfigured from a clean state.

.. command:: rblxbuild_reset_check_state

  Resets (clears) the contents of the variables listed above to empty states:

  .. code-block:: rblxbuild

    rblxbuild_reset_check_state()

  Use this command when performing multiple sequential checks that require
  entirely new configurations, ensuring no previous configuration
  unintentionally carries over.

.. command:: rblxbuild_pop_check_state

  Restores the states of the variables listed above to their values at the time
  of the most recent ``rblxbuild_push_check_state()`` call:

  .. code-block:: rblxbuild

    rblxbuild_pop_check_state()

  Use this command to revert temporary changes made during a check.  To
  prevent unexpected behavior, pair each ``rblxbuild_push_check_state()`` with a
  corresponding ``rblxbuild_pop_check_state()``.

Examples
^^^^^^^^

Example: Isolated Check With Compile Definitions
""""""""""""""""""""""""""""""""""""""""""""""""

In the following example, a check for the C symbol ``memfd_create()`` is
performed with an additional ``_GNU_SOURCE`` compile definition,  without
affecting global compile flags.  The ``RESET`` option is used to ensure
that any prior values of the check-related variables are explicitly cleared
before the check.

.. code-block:: rblxbuild

  include(RBLXBuildPushCheckState)

  # Save and reset the current state
  rblxbuild_push_check_state(RESET)

  # Perform check with specific compile definitions
  set(RBLXBUILD_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
  include(CheckSymbolExists)
  check_symbol_exists(memfd_create "sys/mman.h" HAVE_MEMFD_CREATE)

  # Restore the original state
  rblxbuild_pop_check_state()

Example: Nested Configuration Scopes
""""""""""""""""""""""""""""""""""""

In the following example, variable states are pushed onto the stack multiple
times, allowing for sequential or nested checks.  Each
``rblxbuild_pop_check_state()`` restores the most recent pushed states.

.. code-block:: rblxbuild

  include(RBLXBuildPushCheckState)

  # Save and reset the current state
  rblxbuild_push_check_state(RESET)

  # Perform the first check with additional libraries
  set(RBLXBUILD_REQUIRED_LIBRARIES ${RBLXBUILD_DL_LIBS})
  include(CheckSymbolExists)
  check_symbol_exists(dlopen "dlfcn.h" HAVE_DLOPEN)

  # Save current state
  rblxbuild_push_check_state()

  # Perform the second check with libraries and additional compile definitions
  set(RBLXBUILD_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
  check_symbol_exists(dladdr "dlfcn.h" HAVE_DLADDR)

  message(STATUS "${RBLXBUILD_REQUIRED_DEFINITIONS}")
  # Output: -D_GNU_SOURCE

  # Restore the previous state
  rblxbuild_pop_check_state()

  message(STATUS "${RBLXBUILD_REQUIRED_DEFINITIONS}")
  # Output here is empty

  # Reset variables to prepare for the next check
  rblxbuild_reset_check_state()

  # Perform the next check only with additional compile definitions
  set(RBLXBUILD_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
  check_symbol_exists(dl_iterate_phdr "link.h" HAVE_DL_ITERATE_PHDR)

  # Restore the original state
  rblxbuild_pop_check_state()
#]=======================================================================]

macro(RBLXBUILD_RESET_CHECK_STATE)

  set(RBLXBUILD_EXTRA_INCLUDE_FILES)
  set(RBLXBUILD_REQUIRED_INCLUDES)
  set(RBLXBUILD_REQUIRED_DEFINITIONS)
  set(RBLXBUILD_REQUIRED_LINK_OPTIONS)
  set(RBLXBUILD_REQUIRED_LIBRARIES)
  set(RBLXBUILD_REQUIRED_LINK_DIRECTORIES)
  set(RBLXBUILD_REQUIRED_FLAGS)
  set(RBLXBUILD_REQUIRED_QUIET)

endmacro()

macro(RBLXBUILD_PUSH_CHECK_STATE)

  if(NOT DEFINED _RBLXBUILD_PUSH_CHECK_STATE_COUNTER)
    set(_RBLXBUILD_PUSH_CHECK_STATE_COUNTER 0)
  endif()

  math(EXPR _RBLXBUILD_PUSH_CHECK_STATE_COUNTER "${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}+1")

  set(_RBLXBUILD_EXTRA_INCLUDE_FILES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}        ${RBLXBUILD_EXTRA_INCLUDE_FILES})
  set(_RBLXBUILD_REQUIRED_INCLUDES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}          ${RBLXBUILD_REQUIRED_INCLUDES})
  set(_RBLXBUILD_REQUIRED_DEFINITIONS_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}       ${RBLXBUILD_REQUIRED_DEFINITIONS})
  set(_RBLXBUILD_REQUIRED_LINK_OPTIONS_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}      ${RBLXBUILD_REQUIRED_LINK_OPTIONS})
  set(_RBLXBUILD_REQUIRED_LIBRARIES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}         ${RBLXBUILD_REQUIRED_LIBRARIES})
  set(_RBLXBUILD_REQUIRED_LINK_DIRECTORIES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}  ${RBLXBUILD_REQUIRED_LINK_DIRECTORIES})
  set(_RBLXBUILD_REQUIRED_FLAGS_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}             ${RBLXBUILD_REQUIRED_FLAGS})
  set(_RBLXBUILD_REQUIRED_QUIET_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}             ${RBLXBUILD_REQUIRED_QUIET})

  if (${ARGC} GREATER 0 AND "${ARGV0}" STREQUAL "RESET")
    rblxbuild_reset_check_state()
  endif()

endmacro()

macro(RBLXBUILD_POP_CHECK_STATE)

# don't pop more than we pushed
  if("${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}" GREATER "0")

    set(RBLXBUILD_EXTRA_INCLUDE_FILES       ${_RBLXBUILD_EXTRA_INCLUDE_FILES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_INCLUDES         ${_RBLXBUILD_REQUIRED_INCLUDES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_DEFINITIONS      ${_RBLXBUILD_REQUIRED_DEFINITIONS_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_LINK_OPTIONS     ${_RBLXBUILD_REQUIRED_LINK_OPTIONS_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_LIBRARIES        ${_RBLXBUILD_REQUIRED_LIBRARIES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_LINK_DIRECTORIES ${_RBLXBUILD_REQUIRED_LINK_DIRECTORIES_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_FLAGS            ${_RBLXBUILD_REQUIRED_FLAGS_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})
    set(RBLXBUILD_REQUIRED_QUIET            ${_RBLXBUILD_REQUIRED_QUIET_SAVE_${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}})

    math(EXPR _RBLXBUILD_PUSH_CHECK_STATE_COUNTER "${_RBLXBUILD_PUSH_CHECK_STATE_COUNTER}-1")
  endif()

endmacro()
