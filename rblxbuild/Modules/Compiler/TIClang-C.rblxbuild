include(Compiler/Clang-C)
include(Compiler/TIClang)
__compiler_ticlang(C)

if((NOT DEFINED RBLXBUILD_DEPENDS_USE_COMPILER OR RBLXBUILD_DEPENDS_USE_COMPILER)
    AND RBLXBUILD_GENERATOR MATCHES "Makefiles|WMake"
    AND RBLXBUILD_DEPFILE_FLAGS_C)
  # dependencies are computed by the compiler itself
  set(RBLXBUILD_C_DEPFILE_FORMAT gcc)
  set(RBLXBUILD_C_DEPENDS_USE_COMPILER TRUE)
endif()

set(RBLXBUILD_C90_STANDARD_COMPILE_OPTION "-std=c90")
set(RBLXBUILD_C90_EXTENSION_COMPILE_OPTION "-std=gnu90")
set(RBLXBUILD_C90_STANDARD__HAS_FULL_SUPPORT ON)

set(RBLXBUILD_C99_STANDARD_COMPILE_OPTION "-std=c99")
set(RBLXBUILD_C99_EXTENSION_COMPILE_OPTION "-std=gnu99")
set(RBLXBUILD_C99_STANDARD__HAS_FULL_SUPPORT ON)

set(RBLXBUILD_C11_STANDARD_COMPILE_OPTION "-std=c11")
set(RBLXBUILD_C11_EXTENSION_COMPILE_OPTION "-std=gnu11")
set(RBLXBUILD_C11_STANDARD__HAS_FULL_SUPPORT ON)

if(RBLXBUILD_C_COMPILER_VERSION VERSION_GREATER_EQUAL 1.3)
  set(RBLXBUILD_C17_STANDARD_COMPILE_OPTION "-std=c17")
  set(RBLXBUILD_C17_EXTENSION_COMPILE_OPTION "-std=gnu17")
  set(RBLXBUILD_C17_STANDARD__HAS_FULL_SUPPORT ON)
  set(RBLXBUILD_C_STANDARD_LATEST 17)
else()
  set(RBLXBUILD_C_STANDARD_LATEST 11)
endif()


# Including the "${RBLXBUILD_ROOT}/Modules/Compiler/Clang-C.rblxbuild" script above may set several other compile option
# variables which do not necessarily apply here. So, we unset those variables accordingly.

if(RBLXBUILD_C_COMPILER_VERSION VERSION_LESS 1.3)
  unset(RBLXBUILD_C17_STANDARD_COMPILE_OPTION)
  unset(RBLXBUILD_C17_EXTENSION_COMPILE_OPTION)
endif()

unset(RBLXBUILD_C23_STANDARD_COMPILE_OPTION)
unset(RBLXBUILD_C23_EXTENSION_COMPILE_OPTION)
