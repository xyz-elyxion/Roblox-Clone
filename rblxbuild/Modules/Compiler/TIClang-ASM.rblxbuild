include(Compiler/TIClang)

set(RBLXBUILD_ASM_OUTPUT_EXTENSION ".o")
set(RBLXBUILD_ASM_OUTPUT_EXTENSION_REPLACE 1)

set(RBLXBUILD_ASM_COMPILE_OBJECT       "<RBLXBUILD_ASM_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -c -o <OBJECT> <SOURCE>")
set(RBLXBUILD_ASM_SOURCE_FILE_EXTENSIONS S;s;asm;msa)

__compiler_ticlang(ASM)
