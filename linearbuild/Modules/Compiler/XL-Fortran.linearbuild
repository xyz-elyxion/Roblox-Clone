include(Compiler/XL)
__compiler_xl(Fortran)

set(LINEARBUILD_Fortran_SUBMODULE_SEP "_")
set(LINEARBUILD_Fortran_SUBMODULE_EXT ".smod")

set(LINEARBUILD_Fortran_FORMAT_FIXED_FLAG "-qfixed") # [=<right_margin>]
set(LINEARBUILD_Fortran_FORMAT_FREE_FLAG "-qfree") # [=f90|ibm]

set(LINEARBUILD_Fortran_MODDIR_FLAG "-qmoddir=")
set(LINEARBUILD_Fortran_MODDIR_INCLUDE_FLAG "-I") # -qmoddir= does not affect search path

set(LINEARBUILD_Fortran_DEFINE_FLAG "-WF,-D")

# -qthreaded     = Ensures that all optimizations will be thread-safe
# -qhalt=e       = Halt on error messages (rather than just severe errors)
string(APPEND LINEARBUILD_Fortran_FLAGS_INIT " -qthreaded -qhalt=e")

# xlf: 1501-214 (W) command option E reserved for future use - ignored
set(LINEARBUILD_Fortran_CREATE_PREPROCESSED_SOURCE)
set(LINEARBUILD_Fortran_CREATE_ASSEMBLY_SOURCE)

set(LINEARBUILD_Fortran_PREPROCESS_SOURCE
  "<LINEARBUILD_Fortran_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -qpreprocess -qnoobject -qsuppress=1517-020 -tF -B \"${LINEARBUILD_CURRENT_LIST_DIR}/XL-Fortran/\" -WF,--cpp,\"${LINEARBUILD_Fortran_XL_CPP}\",--out,<PREPROCESSED_SOURCE> <SOURCE>"
  )

if (NOT LINEARBUILD_Fortran_COMPILER_VERSION VERSION_LESS 15.1.6)
  set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-qpreprocess")
  set(LINEARBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-qnopreprocess")
endif()
