if(RBLXBUILD_CXX_COMPILER_FORCED)
  # The compiler configuration was forced by the user.
  # Assume the user has configured all compiler information.
  set(RBLXBUILD_CXX_COMPILER_WORKS TRUE)
  return()
endif()

include(RBLXBuildTestCompilerCommon)

# work around enforced code signing and / or missing executable target type
set(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE ${RBLXBUILD_TRY_COMPILE_TARGET_TYPE})
if(_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE)
  set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${_RBLXBUILD_FEATURE_DETECTION_TARGET_TYPE})
endif()

# Remove any cached result from an older RBLXBuild version.
# We now store this in RBLXBuildCXXCompiler.rblxbuild.
unset(RBLXBUILD_CXX_COMPILER_WORKS CACHE)

# Try to identify the ABI and configure it into RBLXBuildCXXCompiler.rblxbuild
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerABI.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_ABI(CXX ${RBLXBUILD_ROOT}/Modules/RBLXBuildCXXCompilerABI.cpp)
if(RBLXBUILD_CXX_ABI_COMPILED)
  # The compiler worked so skip dedicated test below.
  set(RBLXBUILD_CXX_COMPILER_WORKS TRUE)
  message(STATUS "Check for working CXX compiler: ${RBLXBUILD_CXX_COMPILER} - skipped")
endif()

# This file is used by EnableLanguage in cmGlobalGenerator to
# determine that the selected C++ compiler can actually compile
# and link the most basic of programs.   If not, a fatal error
# is set and rblxbuild stops processing commands and will not generate
# any makefiles or projects.
if(NOT RBLXBUILD_CXX_COMPILER_WORKS)
  PrintTestCompilerStatus("CXX")
  # FIXME: Use a block() to isolate the variables we set/unset here.
  if(DEFINED RBLXBUILD_CXX_SCAN_FOR_MODULES)
    set(__RBLXBUILD_SAVED_CXX_SCAN_FOR_MODULES "${RBLXBUILD_CXX_SCAN_FOR_MODULES}")
  else()
    unset(__RBLXBUILD_SAVED_CXX_SCAN_FOR_MODULES)
  endif()
  set(RBLXBUILD_CXX_SCAN_FOR_MODULES OFF)
  __TestCompiler_setTryCompileTargetType()
  string(CONCAT __TestCompiler_testCXXCompilerSource
    "#ifndef __cplusplus\n"
    "# error \"The RBLXBUILD_CXX_COMPILER is set to a C compiler\"\n"
    "#endif\n"
    "int main(){return 0;}\n")
  # Clear result from normal variable.
  unset(RBLXBUILD_CXX_COMPILER_WORKS)
  # Puts test result in cache variable.
  try_compile(RBLXBUILD_CXX_COMPILER_WORKS
    SOURCE_FROM_VAR testCXXCompiler.cxx __TestCompiler_testCXXCompilerSource
    NO_CACHE
    OUTPUT_VARIABLE __RBLXBUILD_CXX_COMPILER_OUTPUT)
  if(DEFINED __RBLXBUILD_SAVED_CXX_SCAN_FOR_MODULES)
    set(RBLXBUILD_CXX_SCAN_FOR_MODULES "${__RBLXBUILD_SAVED_CXX_SCAN_FOR_MODULES}")
    unset(__RBLXBUILD_SAVED_CXX_SCAN_FOR_MODULES)
  else()
    unset(RBLXBUILD_CXX_SCAN_FOR_MODULES)
  endif()
  unset(__TestCompiler_testCXXCompilerSource)
  __TestCompiler_restoreTryCompileTargetType()
  if(NOT RBLXBUILD_CXX_COMPILER_WORKS)
    PrintTestCompilerResult(CHECK_FAIL "broken")
    string(REPLACE "\n" "\n  " _output "${__RBLXBUILD_CXX_COMPILER_OUTPUT}")
    message(FATAL_ERROR "The C++ compiler\n  \"${RBLXBUILD_CXX_COMPILER}\"\n"
      "is not able to compile a simple test program.\nIt fails "
      "with the following output:\n  ${_output}\n\n"
      "RBLXBuild will not be able to correctly generate this project.")
  endif()
  PrintTestCompilerResult(CHECK_PASS "works")
endif()

# Try to identify the compiler features
include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerSupport.rblxbuild)
RBLXBUILD_DETERMINE_COMPILER_SUPPORT(CXX)

# Re-configure to save learned information.
configure_file(
  ${RBLXBUILD_ROOT}/Modules/RBLXBuildCXXCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildCXXCompiler.rblxbuild
  @ONLY
  )
include(${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildCXXCompiler.rblxbuild)

if(RBLXBUILD_CXX_SIZEOF_DATA_PTR)
  foreach(f ${RBLXBUILD_CXX_ABI_FILES})
    include(${f})
  endforeach()
  unset(RBLXBUILD_CXX_ABI_FILES)
endif()

set(RBLXBUILD_TRY_COMPILE_TARGET_TYPE ${__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE})
unset(__RBLXBUILD_SAVED_TRY_COMPILE_TARGET_TYPE)
unset(__RBLXBUILD_CXX_COMPILER_OUTPUT)
