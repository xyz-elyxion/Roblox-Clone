prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@

Name: RBLXWIN
Description: A multi-platform library for OpenGL, window and input
Version: @RBLXWIN_VERSION@
URL: https://www.rblxwin.org/
Requires.private: @RBLXWIN_PKG_DEPS@
Libs: -L${libdir} -l@RBLXWIN_LIB_NAME@
Libs.private: @RBLXWIN_PKG_LIBS@
Cflags: -I${includedir}
