# This module is purposely no longer documented.  It does nothing useful.

# This macro used to load build settings from another project that
# stored settings using the RBLXBUILD_EXPORT_BUILD_SETTINGS macro.
macro(RBLXBUILD_IMPORT_BUILD_SETTINGS SETTINGS_FILE)
  if("${SETTINGS_FILE}" STREQUAL "")
    message(SEND_ERROR "RBLXBUILD_IMPORT_BUILD_SETTINGS called with no argument.")
  endif()
endmacro()
