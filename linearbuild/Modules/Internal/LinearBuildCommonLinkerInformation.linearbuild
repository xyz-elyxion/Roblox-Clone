# This file contains common code blocks used by all the linker information
# files

macro(_linearbuild_common_linker_platform_flags lang)
  # Define configuration for LINK_WHAT_YOU_USE feature
  if(LINEARBUILD_EXECUTABLE_FORMAT STREQUAL "ELF")
    if(NOT DEFINED LINEARBUILD_${lang}_LINK_WHAT_YOU_USE_FLAG)
      set(LINEARBUILD_${lang}_LINK_WHAT_YOU_USE_FLAG "LINKER:--no-as-needed")
    endif()
    if(NOT DEFINED LINEARBUILD_LINK_WHAT_YOU_USE_CHECK)
      set(LINEARBUILD_LINK_WHAT_YOU_USE_CHECK ldd -u -r)
    endif()
  endif()
endmacro ()
