# determine the compiler to use for ISPC programs

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompiler.rblxbuild)

if( NOT (("${RBLXBUILD_GENERATOR}" MATCHES "Make") OR ("${RBLXBUILD_GENERATOR}" MATCHES "Ninja")) )
  message(FATAL_ERROR "ISPC language not currently supported by \"${RBLXBUILD_GENERATOR}\" generator")
endif()

# Load system-specific compiler preferences for this language.
include(Platform/${RBLXBUILD_SYSTEM_NAME}-Determine-ISPC OPTIONAL)
include(Platform/${RBLXBUILD_SYSTEM_NAME}-ISPC OPTIONAL)
if(NOT RBLXBUILD_ISPC_COMPILER_NAMES)
  set(RBLXBUILD_ISPC_COMPILER_NAMES ispc)
endif()


if(NOT RBLXBUILD_ISPC_COMPILER)

  set(RBLXBUILD_ISPC_COMPILER_INIT NOTFOUND)

  # prefer the environment variable CC
  if(NOT $ENV{ISPC} STREQUAL "")
    get_filename_component(RBLXBUILD_ISPC_COMPILER_INIT $ENV{ISPC} PROGRAM PROGRAM_ARGS RBLXBUILD_ISPC_FLAGS_ENV_INIT)
    if(RBLXBUILD_ISPC_FLAGS_ENV_INIT)
      set(RBLXBUILD_ISPC_COMPILER_ARG1 "${RBLXBUILD_ISPC_FLAGS_ENV_INIT}" CACHE STRING "First argument to ISPC compiler")
    endif()
    if(NOT EXISTS ${RBLXBUILD_ISPC_COMPILER_INIT})
      message(FATAL_ERROR "Could not find the compiler specified in the environment variable ISPC:\n$ENV{ISPC}.")
    endif()
  endif()

  # next try prefer the compiler specified by the generator
  if(RBLXBUILD_GENERATOR_ISPC)
    if(NOT RBLXBUILD_ISPC_COMPILER_INIT)
      set(RBLXBUILD_ISPC_COMPILER_INIT ${RBLXBUILD_GENERATOR_ISPC})
    endif()
  endif()

  # finally list compilers to try
  if(NOT RBLXBUILD_ISPC_COMPILER_INIT)
    set(RBLXBUILD_ISPC_COMPILER_LIST ${_RBLXBUILD_TOOLCHAIN_PREFIX}ispc ispc)
  endif()

  # Find the compiler.
  _rblxbuild_find_compiler(ISPC)

else()
  _rblxbuild_find_compiler_path(ISPC)
endif()
mark_as_advanced(RBLXBUILD_ISPC_COMPILER)

if(NOT RBLXBUILD_ISPC_COMPILER_ID_RUN)
set(RBLXBUILD_ISPC_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(RBLXBUILD_ISPC_COMPILER_ID)
  set(RBLXBUILD_ISPC_PLATFORM_ID)


  set(RBLXBUILD_ISPC_COMPILER_ID_TEST_FLAGS_FIRST
  # setup logic to make sure ISPC outputs a file
  "-o rblxbuild_ispc_output"
  )

  include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerId.rblxbuild)
  RBLXBUILD_DETERMINE_COMPILER_ID(ISPC ISPCFLAGS RBLXBuildISPCCompilerId.ispc)

  _rblxbuild_find_compiler_sysroot(ISPC)
endif()

if (NOT _RBLXBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_RBLXBUILD_TOOLCHAIN_LOCATION "${RBLXBUILD_ISPC_COMPILER}" PATH)
endif ()

set(_RBLXBUILD_PROCESSING_LANGUAGE "ISPC")
include(RBLXBuildFindBinUtils)
include(Compiler/${RBLXBUILD_ISPC_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_RBLXBUILD_PROCESSING_LANGUAGE)

if(RBLXBUILD_ISPC_COMPILER_ID_VENDOR_MATCH)
  set(_SET_RBLXBUILD_ISPC_COMPILER_ID_VENDOR_MATCH
    "set(RBLXBUILD_ISPC_COMPILER_ID_VENDOR_MATCH [==[${RBLXBUILD_ISPC_COMPILER_ID_VENDOR_MATCH}]==])")
else()
  set(_SET_RBLXBUILD_ISPC_COMPILER_ID_VENDOR_MATCH "")
endif()


# configure variables set in this file for fast reload later on
configure_file(${RBLXBUILD_ROOT}/Modules/RBLXBuildISPCCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildISPCCompiler.rblxbuild @ONLY)

set(RBLXBUILD_ISPC_COMPILER_ENV_VAR "ISPC")
