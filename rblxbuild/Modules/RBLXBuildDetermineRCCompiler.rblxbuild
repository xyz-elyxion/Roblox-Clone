# determine the compiler to use for RC programs
# NOTE, a generator may set RBLXBUILD_RC_COMPILER before
# loading this file to force a compiler.
# use environment variable RC first if defined by user, next use
# the rblxbuild variable RBLXBUILD_GENERATOR_RC which can be defined by a generator
# as a default compiler
if(NOT RBLXBUILD_RC_COMPILER)
  # prefer the environment variable RC
  if(NOT $ENV{RC} STREQUAL "")
    get_filename_component(RBLXBUILD_RC_COMPILER_INIT $ENV{RC} PROGRAM PROGRAM_ARGS RBLXBUILD_RC_FLAGS_ENV_INIT)
    if(RBLXBUILD_RC_FLAGS_ENV_INIT)
      set(RBLXBUILD_RC_COMPILER_ARG1 "${RBLXBUILD_RC_FLAGS_ENV_INIT}" CACHE STRING "Arguments to RC compiler")
    endif()
    if(EXISTS ${RBLXBUILD_RC_COMPILER_INIT})
    else()
      message(FATAL_ERROR "Could not find the compiler specified in the environment variable RC:\n$ENV{RC}.")
    endif()
  endif()

  # next try prefer the compiler specified by the generator
  if(RBLXBUILD_GENERATOR_RC)
    if(NOT RBLXBUILD_RC_COMPILER_INIT)
      set(RBLXBUILD_RC_COMPILER_INIT ${RBLXBUILD_GENERATOR_RC})
    endif()
  endif()

  # finally list compilers to try
  if(RBLXBUILD_RC_COMPILER_INIT)
    set(_RBLXBUILD_RC_COMPILER_LIST     ${RBLXBUILD_RC_COMPILER_INIT})
    set(_RBLXBUILD_RC_COMPILER_FALLBACK ${RBLXBUILD_RC_COMPILER_INIT})
  elseif(NOT _RBLXBUILD_RC_COMPILER_LIST)
    set(_RBLXBUILD_RC_COMPILER_LIST rc)
  endif()

  # Find the compiler.
  find_program(RBLXBUILD_RC_COMPILER NAMES ${_RBLXBUILD_RC_COMPILER_LIST} DOC "RC compiler")
  if(_RBLXBUILD_RC_COMPILER_FALLBACK AND NOT RBLXBUILD_RC_COMPILER)
    set(RBLXBUILD_RC_COMPILER "${_RBLXBUILD_RC_COMPILER_FALLBACK}" CACHE FILEPATH "RC compiler" FORCE)
  endif()
  unset(_RBLXBUILD_RC_COMPILER_FALLBACK)
  unset(_RBLXBUILD_RC_COMPILER_LIST)
endif()

mark_as_advanced(RBLXBUILD_RC_COMPILER)

get_filename_component(_RBLXBUILD_RC_COMPILER_NAME_WE ${RBLXBUILD_RC_COMPILER} NAME_WE)
if(_RBLXBUILD_RC_COMPILER_NAME_WE STREQUAL "windres")
  set(RBLXBUILD_RC_OUTPUT_EXTENSION .obj)
else()
  set(RBLXBUILD_RC_OUTPUT_EXTENSION .res)
endif()

# configure variables set in this file for fast reload later on
configure_file(${RBLXBUILD_ROOT}/Modules/RBLXBuildRCCompiler.rblxbuild.in
               ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildRCCompiler.rblxbuild)
set(RBLXBUILD_RC_COMPILER_ENV_VAR "RC")
