include(Compiler/ARMClang)

set(LINEARBUILD_ASM_OUTPUT_EXTENSION ".o")
set(LINEARBUILD_ASM_OUTPUT_EXTENSION_REPLACE 1)

set(LINEARBUILD_ASM_COMPILE_OBJECT       "<LINEARBUILD_ASM_COMPILER> <DEFINES> <INCLUDES> <FLAGS> -c -o <OBJECT> <SOURCE>")
set(LINEARBUILD_ASM_SOURCE_FILE_EXTENSIONS S;s;asm;msa)

__compiler_armclang(ASM)
