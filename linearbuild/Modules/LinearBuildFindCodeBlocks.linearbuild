# This file is included in LinearBuildSystemSpecificInformation.linearbuild if
# the CodeBlocks extra generator has been selected.

find_program(LINEARBUILD_CODEBLOCKS_EXECUTABLE NAMES codeblocks DOC "The CodeBlocks executable")

if(LINEARBUILD_CODEBLOCKS_EXECUTABLE)
  set(LINEARBUILD_OPEN_PROJECT_COMMAND "${LINEARBUILD_CODEBLOCKS_EXECUTABLE} <PROJECT_FILE>" )
endif()

# Determine builtin macros and include dirs:
include(${LINEARBUILD_CURRENT_LIST_DIR}/LinearBuildExtraGeneratorDetermineCompilerMacrosAndIncludeDirs.linearbuild)

# Try to find out how many CPUs we have and set the -j argument for make accordingly
set(_LINEARBUILD_CODEBLOCKS_INITIAL_MAKE_ARGS "")

include(ProcessorCount)
ProcessorCount(_LINEARBUILD_CODEBLOCKS_PROCESSOR_COUNT)

# Only set -j if we are under UNIX and if the make-tool used actually has "make" in the name
# (we may also get here in the future e.g. for ninja)
if("${_LINEARBUILD_CODEBLOCKS_PROCESSOR_COUNT}" GREATER 1  AND  LINEARBUILD_HOST_UNIX  AND  "${LINEARBUILD_MAKE_PROGRAM}" MATCHES make)
  set(_LINEARBUILD_CODEBLOCKS_INITIAL_MAKE_ARGS "-j${_LINEARBUILD_CODEBLOCKS_PROCESSOR_COUNT}")
endif()

# This variable is used by the CodeBlocks generator and appended to the make invocation commands.
set(LINEARBUILD_CODEBLOCKS_MAKE_ARGUMENTS "${_LINEARBUILD_CODEBLOCKS_INITIAL_MAKE_ARGS}" CACHE STRING "Additional command line arguments when CodeBlocks invokes make. Enter e.g. -j<some_number> to get parallel builds")

# This variable is used by the CodeBlocks generator and allows the user to overwrite the autodetected CodeBlocks compiler id
set(LINEARBUILD_CODEBLOCKS_COMPILER_ID "" CACHE STRING "Id string of the compiler for the CodeBlocks IDE. Automatically detected when left empty")
