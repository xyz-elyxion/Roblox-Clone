# determine the compiler to use for Objective-C++ programs
# NOTE, a generator may set RBLXBUILD_OBJCXX_COMPILER before
# loading this file to force a compiler.
# use environment variable OBJCXX first if defined by user, next use
# the rblxbuild variable RBLXBUILD_GENERATOR_OBJCXX which can be defined by a generator
# as a default compiler
# If the internal rblxbuild variable _RBLXBUILD_TOOLCHAIN_PREFIX is set, this is used
# as prefix for the tools (e.g. arm-elf-g++, arm-elf-ar etc.)
#
# Sets the following variables:
#   RBLXBUILD_OBJCXX_COMPILER
#   RBLXBUILD_AR
#   RBLXBUILD_RANLIB
#
# If not already set before, it also sets
#   _RBLXBUILD_TOOLCHAIN_PREFIX

include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompiler.rblxbuild)

# Load system-specific compiler preferences for this language.
include(Platform/${RBLXBUILD_SYSTEM_NAME}-Determine-OBJCXX OPTIONAL)
include(Platform/${RBLXBUILD_SYSTEM_NAME}-OBJCXX OPTIONAL)
if(NOT RBLXBUILD_OBJCXX_COMPILER_NAMES)
  set(RBLXBUILD_OBJCXX_COMPILER_NAMES clang++)
endif()

if("${RBLXBUILD_GENERATOR}" MATCHES "Xcode")
  set(RBLXBUILD_OBJCXX_COMPILER_XCODE_TYPE sourcecode.cpp.objcpp)
else()
  if(NOT RBLXBUILD_OBJCXX_COMPILER)
    set(RBLXBUILD_OBJCXX_COMPILER_INIT NOTFOUND)

    # prefer the environment variable OBJCXX or CXX
    foreach(var OBJCXX CXX)
      if($ENV{${var}} MATCHES ".+")
        get_filename_component(RBLXBUILD_OBJCXX_COMPILER_INIT $ENV{${var}} PROGRAM PROGRAM_ARGS RBLXBUILD_OBJCXX_FLAGS_ENV_INIT)
        if(RBLXBUILD_OBJCXX_FLAGS_ENV_INIT)
          set(RBLXBUILD_OBJCXX_COMPILER_ARG1 "${RBLXBUILD_OBJCXX_FLAGS_ENV_INIT}" CACHE STRING "Arguments to Objective-C++ compiler")
        endif()
        if(NOT EXISTS ${RBLXBUILD_OBJCXX_COMPILER_INIT})
          message(FATAL_ERROR "Could not find the compiler specified in the environment variable ${var}:\n  $ENV{${var}}")
        endif()
        break()
      endif()
    endforeach()

    # next prefer the generator specified compiler
    if(RBLXBUILD_GENERATOR_OBJCXX)
      if(NOT RBLXBUILD_OBJCXX_COMPILER_INIT)
        set(RBLXBUILD_OBJCXX_COMPILER_INIT ${RBLXBUILD_GENERATOR_OBJCXX})
      endif()
    endif()

    # finally list compilers to try
    if(NOT RBLXBUILD_OBJCXX_COMPILER_INIT)
      set(RBLXBUILD_OBJCXX_COMPILER_LIST ${_RBLXBUILD_TOOLCHAIN_PREFIX}c++ ${_RBLXBUILD_TOOLCHAIN_PREFIX}g++ clang++)
    endif()

    _rblxbuild_find_compiler(OBJCXX)

  else()
    # we only get here if RBLXBUILD_OBJCXX_COMPILER was specified using -D or a pre-made RBLXBuildCache.txt
    # (e.g. via ctest) or set in RBLXBUILD_TOOLCHAIN_FILE
    # if RBLXBUILD_OBJCXX_COMPILER is a list, use the first item as
    # RBLXBUILD_OBJCXX_COMPILER and the rest as RBLXBUILD_OBJCXX_COMPILER_ARG1
    set(RBLXBUILD_OBJCXX_COMPILER_ARG1 "${RBLXBUILD_OBJCXX_COMPILER}")
    list(POP_FRONT RBLXBUILD_OBJCXX_COMPILER_ARG1 RBLXBUILD_OBJCXX_COMPILER)
    list(JOIN RBLXBUILD_OBJCXX_COMPILER_ARG1 " " RBLXBUILD_OBJCXX_COMPILER_ARG1)

    # if a compiler was specified by the user but without path,
    # now try to find it with the full path
    # if it is found, force it into the cache,
    # if not, don't overwrite the setting (which was given by the user) with "NOTFOUND"
    # if the C compiler already had a path, reuse it for searching the CXX compiler
    get_filename_component(_RBLXBUILD_USER_OBJCXX_COMPILER_PATH "${RBLXBUILD_OBJCXX_COMPILER}" PATH)
    if(NOT _RBLXBUILD_USER_OBJCXX_COMPILER_PATH)
      find_program(RBLXBUILD_OBJCXX_COMPILER_WITH_PATH NO_CACHE NAMES ${RBLXBUILD_OBJCXX_COMPILER})
      if(RBLXBUILD_OBJCXX_COMPILER_WITH_PATH)
        set(RBLXBUILD_OBJCXX_COMPILER ${RBLXBUILD_OBJCXX_COMPILER_WITH_PATH} CACHE STRING "Objective-C++ compiler" FORCE)
      endif()
    endif()

  endif()
  mark_as_advanced(RBLXBUILD_OBJCXX_COMPILER)

  # Each entry in this list is a set of extra flags to try
  # adding to the compile line to see if it helps produce
  # a valid identification file.
  set(RBLXBUILD_OBJCXX_COMPILER_ID_TEST_FLAGS_FIRST)
  set(RBLXBUILD_OBJCXX_COMPILER_ID_TEST_FLAGS
    # Try compiling to an object file only.
    "-c"

    # ARMClang need target options
    "--target=arm-arm-none-eabi -mcpu=cortex-m3"
    )
endif()

# Build a small source file to identify the compiler.
if(NOT RBLXBUILD_OBJCXX_COMPILER_ID_RUN)
  set(RBLXBUILD_OBJCXX_COMPILER_ID_RUN 1)

  # Try to identify the compiler.
  set(RBLXBUILD_OBJCXX_COMPILER_ID)
  file(READ ${RBLXBUILD_ROOT}/Modules/RBLXBuildPlatformId.h.in
    RBLXBUILD_OBJCXX_COMPILER_ID_PLATFORM_CONTENT)

  # Match the link line from xcodebuild output of the form
  #  Ld ...
  #      ...
  #      /path/to/cc ...CompilerIdOBJCXX/...
  # to extract the compiler front-end for the language.
  set(RBLXBUILD_OBJCXX_COMPILER_ID_TOOL_MATCH_REGEX "\nLd[^\n]*(\n[ \t]+[^\n]*)*\n[ \t]+([^ \t\r\n]+)[^\r\n]*-o[^\r\n]*CompilerIdOBJCXX/(\\./)?(CompilerIdOBJCXX.(framework|xctest|build/[^ \t\r\n]+)/)?CompilerIdOBJCXX[ \t\n\\\"]")
  set(RBLXBUILD_OBJCXX_COMPILER_ID_TOOL_MATCH_INDEX 2)

  include(${RBLXBUILD_ROOT}/Modules/RBLXBuildDetermineCompilerId.rblxbuild)
  RBLXBUILD_DETERMINE_COMPILER_ID(OBJCXX OBJCXXFLAGS RBLXBuildOBJCXXCompilerId.mm)

  # Set old compiler and platform id variables.
  if(RBLXBUILD_OBJCXX_COMPILER_ID MATCHES "GNU")
    set(RBLXBUILD_COMPILER_IS_GNUOBJCXX 1)
  endif()
  if(RBLXBUILD_OBJCXX_COMPILER_ID MATCHES "Clang")
    set(RBLXBUILD_COMPILER_IS_CLANGOBJCXX 1)
  endif()
endif()

if (NOT _RBLXBUILD_TOOLCHAIN_LOCATION)
  get_filename_component(_RBLXBUILD_TOOLCHAIN_LOCATION "${RBLXBUILD_OBJCXX_COMPILER}" PATH)
endif ()

# if we have a g++ cross compiler, they have usually some prefix, like
# e.g. powerpc-linux-g++, arm-elf-g++ or i586-mingw32msvc-g++ , optionally
# with a 3-component version number at the end (e.g. arm-eabi-gcc-4.5.2).
# The other tools of the toolchain usually have the same prefix
# NAME_WE cannot be used since then this test will fail for names like
# "arm-unknown-nto-qnx6.3.0-gcc.exe", where BASENAME would be
# "arm-unknown-nto-qnx6" instead of the correct "arm-unknown-nto-qnx6.3.0-"


if (NOT _RBLXBUILD_TOOLCHAIN_PREFIX)

  if("${RBLXBUILD_OBJCXX_COMPILER_ID}" MATCHES "GNU|Clang|QCC")
    get_filename_component(COMPILER_BASENAME "${RBLXBUILD_OBJCXX_COMPILER}" NAME)
    if (COMPILER_BASENAME MATCHES "^(.+-)(clan)?[gc]\\+\\+(-[0-9]+(\\.[0-9]+)*)?(-[^.]+)?(\\.exe)?$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
      set(_RBLXBUILD_COMPILER_SUFFIX ${RBLXBUILD_MATCH_5})
    elseif("${RBLXBUILD_OBJCXX_COMPILER_ID}" MATCHES "Clang")
      if(RBLXBUILD_OBJCXX_COMPILER_TARGET)
        set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_OBJCXX_COMPILER_TARGET}-)
      endif()
    elseif(COMPILER_BASENAME MATCHES "QCC(\\.exe)?$")
      if(RBLXBUILD_OBJCXX_COMPILER_TARGET MATCHES "gcc_nto([a-z0-9]+_[0-9]+|[^_le]+)(le)")
        set(_RBLXBUILD_TOOLCHAIN_PREFIX nto${RBLXBUILD_MATCH_1}-)
      endif()
    endif ()

    # if "llvm-" is part of the prefix, remove it, since llvm doesn't have its own binutils
    # but uses the regular ar, objcopy, etc. (instead of llvm-objcopy etc.)
    if ("${_RBLXBUILD_TOOLCHAIN_PREFIX}" MATCHES "(.+-)?llvm-$")
      set(_RBLXBUILD_TOOLCHAIN_PREFIX ${RBLXBUILD_MATCH_1})
    endif ()
  endif()

endif ()

set(_RBLXBUILD_PROCESSING_LANGUAGE "OBJCXX")
include(RBLXBuildFindBinUtils)
include(Compiler/${RBLXBUILD_OBJCXX_COMPILER_ID}-FindBinUtils OPTIONAL)
unset(_RBLXBUILD_PROCESSING_LANGUAGE)

if(RBLXBUILD_OBJCXX_XCODE_ARCHS)
  set(SET_RBLXBUILD_XCODE_ARCHS
    "set(RBLXBUILD_XCODE_ARCHS \"${RBLXBUILD_OBJCXX_XCODE_ARCHS}\")")
endif()

# configure all variables set in this file
configure_file(${RBLXBUILD_ROOT}/Modules/RBLXBuildOBJCXXCompiler.rblxbuild.in
  ${RBLXBUILD_PLATFORM_INFO_DIR}/RBLXBuildOBJCXXCompiler.rblxbuild
  @ONLY
  )

set(RBLXBUILD_OBJCXX_COMPILER_ENV_VAR "OBJCXX")
