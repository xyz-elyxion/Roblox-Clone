include(Compiler/Intel)
__compiler_intel(ASM)

string(APPEND LINEARBUILD_ASM_FLAGS_MINSIZEREL_INIT " -DNDEBUG")
string(APPEND LINEARBUILD_ASM_FLAGS_RELEASE_INIT " -DNDEBUG")
string(APPEND LINEARBUILD_ASM_FLAGS_RELWITHDEBINFO_INIT " -DNDEBUG")

if(UNIX)
  set(LINEARBUILD_ASM_SOURCE_FILE_EXTENSIONS s;S)
else()
  set(LINEARBUILD_ASM_SOURCE_FILE_EXTENSIONS asm)
endif()
