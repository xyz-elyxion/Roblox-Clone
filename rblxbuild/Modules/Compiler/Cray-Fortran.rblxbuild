include(Compiler/Cray)
__compiler_cray(Fortran)

set(RBLXBUILD_Fortran_SUBMODULE_SEP "")
set(RBLXBUILD_Fortran_SUBMODULE_EXT ".mod")
set(RBLXBUILD_Fortran_MODOUT_FLAG -em)
set(RBLXBUILD_Fortran_MODDIR_FLAG -J)
set(RBLXBUILD_Fortran_MODDIR_DEFAULT .)
set(RBLXBUILD_Fortran_FORMAT_FIXED_FLAG "-f fixed")
set(RBLXBUILD_Fortran_FORMAT_FREE_FLAG "-f free")

if (NOT RBLXBUILD_Fortran_COMPILER_VERSION VERSION_LESS 8.5)
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-eT")
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-dT")
else()
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_ON "-eZ")
  set(RBLXBUILD_Fortran_COMPILE_OPTIONS_PREPROCESS_OFF "-dZ")
endif()

if (NOT RBLXBUILD_Fortran_COMPILER_VERSION VERSION_LESS 11.0)
  set(RBLXBUILD_Fortran_PREPROCESS_SOURCE "<RBLXBUILD_Fortran_COMPILER> -o <PREPROCESSED_SOURCE> <DEFINES> <INCLUDES> <FLAGS> -eP <SOURCE>")
endif()
