# file LICENSE.rst or https://rblxbuild.org/licensing for details.

die() {
  echo "$@" 1>&2 ; exit 1
}

# Compile flag extraction function.
rblxbuild_extract_standard_flags()
{
  id="${1:-*}"
  lang="${2}"
  ver="${3}"
  sed -n "s/ *set *( *RBLXBUILD_${lang}${ver}_EXTENSION_COMPILE_OPTION *\"\{0,1\}\([^\")]*\).*/\1/p" \
    "${rblxbuild_source_dir}/Modules/Compiler/"${id}-${lang}.rblxbuild \
    2>/dev/null | tr ';' ' '
  # Clang's CXX compiler flags are in the common module.
  sed -n "s/ *set *( *RBLXBUILD_\\\${lang}${ver}_EXTENSION_COMPILE_OPTION *\"\{0,1\}\([^\")]*\).*/\1/p" \
    "${rblxbuild_source_dir}/Modules/Compiler/Clang.rblxbuild" \
    2>/dev/null | tr ';' ' '
}

# Version number extraction function.
rblxbuild_version_component()
{
  sed -n "
/^set(RBLXBuild_VERSION_${1}/ {s/set(RBLXBuild_VERSION_${1} *\([0-9]*\)).*/\1/;p;}
" "${rblxbuild_source_dir}/Source/RBLXBuildVersion.rblxbuild"
}

# Install destination extraction function.
rblxbuild_install_dest_default()
{
  sed -n '
/^ *set(RBLXBUILD_'"${1}"'_DIR_DEFAULT.*) # '"${2}"'$/ {
  s/^ *set(RBLXBUILD_'"${1}"'_DIR_DEFAULT *"\([^"]*\)").*$/\1/
  s/${RBLXBuild_VERSION_MAJOR}/'"${rblxbuild_version_major}"'/
  s/${RBLXBuild_VERSION_MINOR}/'"${rblxbuild_version_minor}"'/
  s/${RBLXBuild_VERSION_PATCH}/'"${rblxbuild_version_patch}"'/
  p
  q
}
' "${rblxbuild_source_dir}/Source/RBLXBuildInstallDestinations.rblxbuild"
}

rblxbuild_toupper()
{
    echo "$1" | tr '[a-z]' '[A-Z]'
}

# Detect system and directory information.
rblxbuild_system=`uname`
rblxbuild_source_dir=`cd "\`dirname \"$0\"\`";pwd`
rblxbuild_binary_dir=`pwd`

# Load version information.
rblxbuild_version_major="`rblxbuild_version_component MAJOR`"
rblxbuild_version_minor="`rblxbuild_version_component MINOR`"
rblxbuild_version_patch="`rblxbuild_version_component PATCH`"
rblxbuild_version="${rblxbuild_version_major}.${rblxbuild_version_minor}.${rblxbuild_version_patch}"
rblxbuild_version_rc="`rblxbuild_version_component RC`"
if test "$rblxbuild_version_rc" != ""; then
  rblxbuild_version="${rblxbuild_version}-rc${rblxbuild_version_rc}"
fi

rblxbuild_copyright="`grep '^Copyright .* Kitware' "${rblxbuild_source_dir}/LICENSE.rst" |
                  sed 's/\`Contributors.*\`_/Contributors/'`"

rblxbuild_bin_dir_keyword="OTHER"
rblxbuild_data_dir_keyword="OTHER"
rblxbuild_doc_dir_keyword="OTHER"
rblxbuild_man_dir_keyword="OTHER"
rblxbuild_xdgdata_dir_keyword="OTHER"
rblxbuild_bin_dir=""
rblxbuild_data_dir=""
rblxbuild_doc_dir=""
rblxbuild_man_dir=""
rblxbuild_xdgdata_dir=""
rblxbuild_init_file=""
rblxbuild_bootstrap_system_libs=""
rblxbuild_bootstrap_qt_gui=""
rblxbuild_bootstrap_qt_qmake=""
rblxbuild_bootstrap_debugger=""
rblxbuild_sphinx_info=""
rblxbuild_sphinx_man=""
rblxbuild_sphinx_html=""
rblxbuild_sphinx_html_copybutton=""
rblxbuild_sphinx_qthelp=""
rblxbuild_sphinx_latexpdf=""
rblxbuild_sphinx_build=""
rblxbuild_sphinx_flags=""

# Determine whether this is a Cygwin environment.
if echo "${rblxbuild_system}" | grep CYGWIN >/dev/null 2>&1; then
  rblxbuild_system_cygwin=true
  rblxbuild_doc_dir_keyword="CYGWIN"
  rblxbuild_man_dir_keyword="CYGWIN"
else
  rblxbuild_system_cygwin=false
fi

# Determine whether this is a MSYS environment.
if echo "${rblxbuild_system}" | grep MSYS >/dev/null 2>&1; then
  rblxbuild_system_msys=true
  rblxbuild_doc_dir_keyword="MSYS"
  rblxbuild_man_dir_keyword="MSYS"
else
  rblxbuild_system_msys=false
fi

# Determine whether this is a MinGW environment.
if echo "${rblxbuild_system}" | grep 'MINGW' >/dev/null 2>&1; then
  rblxbuild_system_mingw=true
else
  rblxbuild_system_mingw=false
fi

# Determine whether this is OS X
if echo "${rblxbuild_system}" | grep Darwin >/dev/null 2>&1; then
  rblxbuild_system_darwin=true
else
  rblxbuild_system_darwin=false
fi

# Determine whether this is BeOS
if echo "${rblxbuild_system}" | grep BeOS >/dev/null 2>&1; then
  rblxbuild_system_beos=true
  rblxbuild_doc_dir_keyword="HAIKU"
  rblxbuild_man_dir_keyword="HAIKU"
else
  rblxbuild_system_beos=false
fi

# Determine whether this is Haiku
if echo "${rblxbuild_system}" | grep Haiku >/dev/null 2>&1; then
  rblxbuild_system_haiku=true
  rblxbuild_doc_dir_keyword="HAIKU"
  rblxbuild_man_dir_keyword="HAIKU"
else
  rblxbuild_system_haiku=false
fi

# Determine whether this is OpenVMS
if echo "${rblxbuild_system}" | grep OpenVMS >/dev/null 2>&1; then
  rblxbuild_system_openvms=true
else
  rblxbuild_system_openvms=false
fi

# Determine whether this is HP-UX
if echo "${rblxbuild_system}" | grep HP-UX >/dev/null 2>&1; then
  die 'RBLXBuild no longer compiles on HP-UX.  See

  https://gitlab.kitware.com/rblxbuild/rblxbuild/-/issues/17137

Use RBLXBuild 3.9 or lower instead.'
fi

# Determine whether this is AIX
if echo "${rblxbuild_system}" | grep AIX >/dev/null 2>&1; then
  rblxbuild_system_aix=true
else
  rblxbuild_system_aix=false
fi

# Choose the generator to use for bootstrapping.
if ${rblxbuild_system_mingw}; then
  # Bootstrapping from an MSYS prompt.
  rblxbuild_bootstrap_generator="MSYS Makefiles"
else
  # Bootstrapping from a standard UNIX prompt.
  rblxbuild_bootstrap_generator="Unix Makefiles"
fi

# Choose tools and extensions for this platform.
if ${rblxbuild_system_openvms}; then
  _tmp="_tmp"
  _cmk="_cmk"
  _diff=`which diff`
else
  _tmp=".tmp"
  _cmk=".cmk"
  _diff="diff"
fi

# Construct bootstrap directory name.
rblxbuild_bootstrap_dir="${rblxbuild_binary_dir}/Bootstrap${_cmk}"

# Helper function to fix windows paths.
case "${rblxbuild_system}" in
*MINGW*)
  rblxbuild_fix_slashes()
  {
    cmd //c echo "$(echo "$1" | sed 's/\\/\//g')" | sed 's/^"//;s/" *$//'
  }
  ;;
*)
  rblxbuild_fix_slashes()
  {
    echo "$1" | sed 's/\\/\//g'
  }
  ;;
esac

# Choose the default install prefix.
if ${rblxbuild_system_mingw}; then
  if test "x${PROGRAMFILES}" != "x"; then
    rblxbuild_default_prefix=`rblxbuild_fix_slashes "${PROGRAMFILES}/RBLXBuild"`
  elif test "x${ProgramFiles}" != "x"; then
    rblxbuild_default_prefix=`rblxbuild_fix_slashes "${ProgramFiles}/RBLXBuild"`
  elif test "x${SYSTEMDRIVE}" != "x"; then
    rblxbuild_default_prefix=`rblxbuild_fix_slashes "${SYSTEMDRIVE}/Program Files/RBLXBuild"`
  elif test "x${SystemDrive}" != "x"; then
    rblxbuild_default_prefix=`rblxbuild_fix_slashes "${SystemDrive}/Program Files/RBLXBuild"`
  else
    rblxbuild_default_prefix="c:/Program Files/RBLXBuild"
  fi
elif ${rblxbuild_system_haiku}; then
  rblxbuild_default_prefix=`finddir B_COMMON_DIRECTORY`
else
  rblxbuild_default_prefix="/usr/local"
fi

# Lookup default install destinations.
rblxbuild_bin_dir_default="`rblxbuild_install_dest_default BIN ${rblxbuild_bin_dir_keyword}`"
rblxbuild_data_dir_default="`rblxbuild_install_dest_default DATA ${rblxbuild_data_dir_keyword}`"
rblxbuild_doc_dir_default="`rblxbuild_install_dest_default DOC ${rblxbuild_doc_dir_keyword}`"
rblxbuild_man_dir_default="`rblxbuild_install_dest_default MAN ${rblxbuild_man_dir_keyword}`"
rblxbuild_xdgdata_dir_default="`rblxbuild_install_dest_default XDGDATA ${rblxbuild_xdgdata_dir_keyword}`"

RBLXBUILD_KNOWN_C_COMPILERS="cc gcc clang xlc icx tcc"
RBLXBUILD_KNOWN_CXX_COMPILERS="aCC xlC CC g++ clang++ c++ icpx"
RBLXBUILD_KNOWN_MAKE_PROCESSORS="gmake make smake"
RBLXBUILD_KNOWN_NINJA_PROCESSORS="ninja-build ninja samu"

RBLXBUILD_PROBLEMATIC_FILES="\
  RBLXBuildCache.txt \
